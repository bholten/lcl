;; 76.5 + the game's update_enemy shape: arithmetic over dict fields,
;; one record per entity, a new record out.
Bench::suite "records" {
    Bench::setup {
        let dt 0.016
        let target #{x 400.0 y 300.0}
        var es ()
        var i 0
        repeat 1000 { List::push! es [dict x [* $i 1.0] y [* $i 0.5] speed 120.0 hp 3 r 10.0]; set! i [+ $i 1] }
        let enemies $es
        proc bench_update_enemy {e dt target} {
            let dx [- [get $target x] [get $e x]]
            let dy [- [get $target y] [get $e y]]
            let d2 [+ [* $dx $dx] [* $dy $dy]]
            let inv [if [> $d2 0.0] { [/ 1.0 $d2] } else { 0.0 }]
            let s [* [get $e speed] $dt]
            put [put $e x [+ [get $e x] [* $dx [* $inv $s]]]] y [+ [get $e y] [* $dy [* $inv $s]]]
        }
    }

    Bench::case "update 1000 records via List::map" { List::map $enemies [lambda {e} { bench_update_enemy $e $dt $target }] }
    Bench::case "update 1000 records via foreach + push!" { var out (); foreach e $enemies { List::push! out [bench_update_enemy $e $dt $target] } }
    Bench::case "two puts on a 5-key record x1000" { foreach e $enemies { put [put $e x 1.0] y 2.0 } }
    Bench::case "float arith loop 10000" { var acc 0.0; var i 0; repeat 10000 { set! acc [+ $acc [* $i 0.5]]; set! i [+ $i 1] }; $acc }
    Bench::case "proc call x10000" { let e0 [get $enemies 0]; repeat 10000 { bench_update_enemy $e0 $dt $target } }
}
