;; Build examples:
;; # Release build (dynamically linked, optimized)
;; cmake -DCMAKE_BUILD_TYPE=Release ..
;;
;; # Release + fully static binary
;; cmake -DCMAKE_BUILD_TYPE=Release -DLCL_BUILD_STATIC=ON -DLCL_STATIC_BINARY=ON ..
;;
;; # Debug build with sanitizers (existing behavior)
;; cmake -DCMAKE_BUILD_TYPE=Debug -DLCL_ENABLE_ASAN=ON ..

project lcl {
    config {
        description "The Lcl programming language"
    }

    let ALL_PKGS (-DLCL_BUILD_TESTS=ON
                  -DLCL_BUILD_CURL=ON
                  -DLCL_BUILD_IO=ON
                  -DLCL_BUILD_JSON=ON
                  -DLCL_BUILD_CRYPTO=ON
                  -DLCL_BUILD_REGEX=ON
                  -DLCL_BUILD_PROCESS=ON
                  -DLCL_BUILD_TIME=ON
                  -DLCL_BUILD_MATH=ON
                  -DLCL_BUILD_EXPECT=ON
                  -DLCL_BUILD_RAYLIB=ON)

    let ALL_LIBS (-DLCL_BUILD_TEST_LIB=ON
                  -DLCL_BUILD_SH_LIB=ON
                  -DLCL_BUILD_CURL_DSL_LIB=ON)

    let DEBUG_OPTS (-DLCL_ENABLE_ASAN=ON
                    -DLCL_BUILD_TESTS=ON
                    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
                    -DCMAKE_BUILD_TYPE=Debug)

    let RELEASE_OPTS (-DCMAKE_BUILD_TYPE=Release)

    let STATIC_OPTS (-DLCL_BUILD_SHARED=OFF
                     -DLCL_BUILD_STATIC=ON
                     -DCMAKE_BUILD_TYPE=Release)

    command build {
        run [subst {
            cmake -B build ${lcl::ALL_PKGS} ${lcl::ALL_LIBS} ${lcl::DEBUG_OPTS} && \
            cmake --build build
        }]
    }

    command release {
        run [subst {
            cmake -B build ${lcl::ALL_PKGS} ${lcl::ALL_LIBS} ${lcl::RELEASE_OPTS} && \
            cmake --build build
        }]
    }

    command static {
        run [subst {
            cmake -B build ${lcl::ALL_PKGS} ${lcl::ALL_LIBS} ${lcl::STATIC_OPTS} && \
            cmake --build build
        }]
    }

    command test {
        run {
            lcl test/anaphoric_macros.lcl && lcl test/conformance_smoke.lcl
        }
    }

    command clean {
        run {
            rm -rf build
        }
    }
}
