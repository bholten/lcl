project lcl {
    config {
        description "The Lcl programming language"
    }

    let ALL_PKGS (-DLCL_BUILD_TESTS=ON
                  -DLCL_BUILD_CURL=ON
                  -DLCL_BUILD_IO=ON
                  -DLCL_BUILD_POSIX=ON
                  -DLCL_BUILD_JSON=ON
                  -DLCL_BUILD_CRYPTO=ON
                  -DLCL_BUILD_REGEX=ON
                  -DLCL_BUILD_PROCESS=ON
                  -DLCL_BUILD_TIME=ON
                  -DLCL_BUILD_MATH=ON
                  -DLCL_BUILD_RANDOM=ON
                  -DLCL_BUILD_EXPECT=ON)

    let ALL_LIBS (-DLCL_BUILD_TEST_LIB=ON
                  -DLCL_BUILD_SH_LIB=ON
                  -DLCL_BUILD_CURL_DSL_LIB=ON
                  -DLCL_BUILD_DOC_LIB=ON
                  -DLCL_BUILD_BENCH_LIB=ON)

    let DEBUG_OPTS (-DLCL_ENABLE_ASAN=ON
                    -DLCL_WERROR=ON
                    -DLCL_BUILD_TESTS=ON
                    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
                    -DCMAKE_BUILD_TYPE=Debug)

    let RELEASE_OPTS (-DCMAKE_BUILD_TYPE=Release)

    let STATIC_OPTS (-DLCL_BUILD_SHARED=OFF
                     -DLCL_BUILD_STATIC=ON
                     -DCMAKE_BUILD_TYPE=Release)

    let SOURCES [Posix::glob CMakeLists.txt cmake/*.cmake
                             include/*.h src/*.c src/*.h
                             packages/*/CMakeLists.txt
                             packages/*/include/*.h
                             packages/*/src/*.c packages/*/src/*.h
                             lib/*/src/*.lcl]

    let DOCS [Posix::glob tools/docs.lcl
                          docs/*.lcl docs/*.md
                          packages/*/docs/*.lcl packages/*/docs/*.md
                          lib/*/docs/*.lcl lib/*/docs/*.md
                          lib/*/src/*.lcl]

    task build {
        inputs ${lcl::SOURCES}
        outputs build/
        run {
            set -e
            cmake -B ${lcl::build::outputs} ${lcl::ALL_PKGS} ${lcl::ALL_LIBS} ${lcl::DEBUG_OPTS}
            cmake --build ${lcl::build::outputs} --parallel
        }
    }

    task fuzzers {
        inputs ${lcl::SOURCES}
        outputs build-fuzz/
        run {
            set -e
            export CC=clang
            cmake -B ${lcl::fuzzers::outputs} -DCMAKE_BUILD_TYPE=Debug -DLCL_BUILD_FUZZERS=ON
            cmake --build ${lcl::fuzzers::outputs} --parallel
        }
    }

    task emcc {
        inputs ${lcl::SOURCES}
        outputs build-emcc/
        run {
            set -e
            emcmake cmake -B ${lcl::emcc::outputs}
            cmake --build ${lcl::emcc::outputs} --parallel
        }
    }

    task release {
        inputs ${lcl::SOURCES}
        outputs build-release/
        run {
            set -e
            cmake -B ${lcl::release::outputs} ${lcl::ALL_PKGS} ${lcl::ALL_LIBS} ${lcl::RELEASE_OPTS}
            cmake --build ${lcl::release::outputs} --parallel
        }
    }

    task static {
        inputs ${lcl::SOURCES}
        outputs build-static/
        run {
            set -e
            cmake -B ${lcl::static::outputs} ${lcl::ALL_PKGS} ${lcl::ALL_LIBS} ${lcl::STATIC_OPTS}
            cmake --build ${lcl::static::outputs} --parallel
        }
    }

    task test {
        inputs ${lcl::SOURCES}
        outputs build/.test.sentinel
        depends_on lcl::build
        run {
            set -e
            ctest --test-dir ${lcl::build::outputs} --output-on-failure --parallel 8
            touch ${lcl::test::outputs}
        }
    }

    task doctest {
        inputs ${lcl::DOCS}
        outputs build/.doctest.sentinel
        depends_on lcl::build
        run {
            set -e
            ${lcl::build::outputs}/lcl tools/docs.lcl doctest
            touch ${lcl::doctest::outputs}
        }
    }

    task docs {
        inputs ${lcl::DOCS}
        outputs site/
        depends_on lcl::doctest
        run {
            ${lcl::build::outputs}/lcl tools/docs.lcl build ${lcl::docs::outputs}
        }
    }

    task bench {
        inputs ${lcl::SOURCES}
        depends_on lcl::release
        run {
            ${lcl::release::outputs}/lcl bench/run.lcl --baseline bench/baseline.lcl
        }
    }

    command clean {
        run {
            rm -rf ${lcl::build::outputs}
            rm -rf ${lcl::fuzzers::outputs}
            rm -rf ${lcl::emcc::outputs}
            rm -rf ${lcl::release::outputs}
            rm -rf ${lcl::static::outputs}
            rm -rf ${lcl::docs::outputs}
        }
    }
}
