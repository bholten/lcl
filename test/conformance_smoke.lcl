;; Lcl Conformance Smoke Tests
;; This test suite covers core LCL functionality using the Test framework.
;; Run with: ./lcl test/conformance_smoke.lcl

;; Top-level cell seeded for the Require suite's side-effect test.
;; Required files evaluate in an overlay whose parent is the global
;; frame, so a globally-scoped cell is visible for set!.
var require_se_counter 0
var require_lex_counter 0

;; ============================================================================
;; Immutability & Substitution
;; ============================================================================

Test::suite "Immutability & Substitution" {
    Test::case "let creates immutable binding" {
        let x 10
        Test::eq $x 10
    }
}

;; ============================================================================
;; Cells (var/ref) & set!
;; ============================================================================

Test::suite "Cells (var/ref) & set!" {
    Test::case "var creates mutable binding" {
        var n 0
        set! n [+ $n 1]
        Test::eq $n 1
    }

    Test::case "ref creates cell" {
        ;; cell? on direct ref output (not via variable, which dereferences)
        Test::assert [cell? [ref 42]]
    }
}

;; ============================================================================
;; Quoting and Subcommand Substitution
;; ============================================================================

Test::suite "Quoting and Subcommand Substitution" {
    Test::case "quoted string with substitution" {
        let a 10
        let s "x=$a [ + 1 2 ]"
        Test::eq $s {x=10 3}
    }

    Test::case "braced string is literal" {
        let a 10
        let t {x=$a [ + 1 2 ]}
        Test::eq $t {x=$a [ + 1 2 ]}
    }

    Test::case "empty quoted string equals empty braced string" {
        let a ""
        let b {}
        Test::eq $a $b
        Test::eq [String::length $a] 0
        Test::eq [String::length $b] 0
    }

    Test::case "var with empty quoted string" {
        var v ""
        Test::eq $v {}
        set! v "updated"
        Test::eq $v "updated"
    }
}

;; ============================================================================
;; Escape Sequences
;; ============================================================================

Test::suite "Escape Sequences" {
    Test::case "newline escape" {
        let esc_nl "line1\nline2"
        Test::eq [len $esc_nl] 11
    }

    Test::case "tab escape" {
        let esc_tab "col1\tcol2"
        Test::eq [len $esc_tab] 9
    }

    Test::case "backslash escape" {
        let esc_bs "a\\b"
        Test::eq [len $esc_bs] 3
    }

    Test::case "quote escape" {
        let esc_qt "say \"hi\""
        Test::eq [len $esc_qt] 8
    }

    Test::case "dollar escape prevents substitution" {
        let esc_var 100
        let esc_dol "\$esc_var"
        Test::eq $esc_dol {$esc_var}
    }

    Test::case "bracket escape prevents command substitution" {
        let esc_brk "\[+ 1 2\]"
        Test::eq $esc_brk {[+ 1 2]}
    }

    Test::case "escape in unquoted words" {
        let esc_unq hello\nworld
        Test::eq [len $esc_unq] 11
    }

    Test::case "braced strings are literal (no escapes)" {
        let esc_brace {a\nb}
        Test::eq [len $esc_brace] 4
        Test::eq $esc_brace {a\nb}
    }
}

;; ============================================================================
;; User Procs, Return, and Closures
;; ============================================================================

Test::suite "User Procs" {
    Test::case "simple proc with return" {
        proc add {a b} { return [+ $a $b] }
        Test::eq [add 20 22] 42
    }

    Test::case "closure counter" {
        proc makeCounter {start} {
            var n $start
            return [lambda {} { set! n [+ $n 1]; $n }]
        }
        let c [makeCounter 10]
        Test::eq [apply $c] 11
        Test::eq [apply $c] 12
    }

    Test::case "lambda expression" {
        let lam [lambda {x} { + $x 10 }]
        Test::eq [$lam 10] 20
    }

    Test::case "nested lambda closure" {
        let lambda_counter [lambda {start} {
            var n $start
            return [lambda {} {
                set! n [+ $n 1]
                return $n
            }]
        }]
        let lam_count [$lambda_counter 10]
        apply $lam_count
        apply $lam_count
        apply $lam_count
        Test::eq [apply $lam_count] 14
    }
}

;; ============================================================================
;; Named Lambda Self-Recursion
;; ============================================================================

Test::suite "Named Lambda Self-Recursion" {
    Test::case "factorial via named lambda" {
        let factorial [lambda factorial {n} {
            if [<= $n 1] { 1 } else { [* $n [factorial [- $n 1]]] }
        }]
        Test::eq [factorial 5] 120
    }

    Test::case "fibonacci via named lambda" {
        let fib [lambda fib {n} {
            if [< $n 2] { $n } else { [+ [fib [- $n 1]] [fib [- $n 2]]] }
        }]
        Test::eq [fib 10] 55
    }

    Test::case "proc uses named lambda internally" {
        proc fact {n} {
            if [<= $n 1] { 1 } else { [* $n [fact [- $n 1]]] }
        }
        Test::eq [fact 6] 720
    }

    Test::case "anonymous lambda still works" {
        let double [lambda {x} { [* $x 2] }]
        Test::eq [double 21] 42
    }

    Test::case "self-recursive counter" {
        ;; Uses SELF binding, no cycle
        proc counter {n acc} {
            if [== $n 0] { $acc } else { [counter [- $n 1] [+ $acc 1]] }
        }
        Test::eq [counter 100 0] 100
    }

    Test::case "named lambda with closure" {
        let base 10
        let addBase [lambda addBase {n} {
            if [== $n 0] { $base } else { [+ 1 [addBase [- $n 1]]] }
        }]
        Test::eq [addBase 5] 15
    }
}

;; ============================================================================
;; Namespaces
;; ============================================================================

Test::suite "Namespaces" {
    Test::case "namespace creates binding" {
        namespace math {
            let ten 10
        }
        Test::eq $math::ten 10
    }

    Test::case "braced variable form" {
        namespace math2 {
            let val 42
        }
        Test::eq ${math2::val} 42
    }

    Test::case "Ns:: functions" {
        namespace math3 {
            let val 42

            proc test {a b} {
                + $val 23
            }
        }

        ;; Hash iteration order is not specified — sort before comparing.
        Test::eq [List::sort [Ns::keys $math3]] (test val)
        Test::eq [Ns::name $math3] math3
        Test::eq [Ns::has? $math3 test] 1
        ;; generic has? dispatches to Ns::has? for namespaces
        Test::true [has? $math3 val]
        Test::false [has? $math3 missing]
    }

    Test::case "generic len and get on namespaces" {
        namespace math4 {
            let val 42
            var ctr 7
        }
        Test::eq [len $math4] 2
        Test::eq [get $math4 val] 42
        ;; var bindings are cells — get derefs like $math4::ctr does
        Test::eq [get $math4 ctr] 7
        Test::eq [get $math4 missing "fallback"] "fallback"
        Test::raises { get $math4 missing }
        Ns::del $math4 val
        Test::eq [len $math4] 1
        Ns::clear $math4
        Test::eq [len $math4] 0
    }
}

;; ============================================================================
;; Eval
;; ============================================================================

Test::suite "Eval" {
    Test::case "basic eval" {
        Test::eq [eval {+ 1 2}] 3
    }

    Test::case "eval accesses outer variables" {
        let ev_x 42
        Test::eq [eval {+ $ev_x 1}] 43
    }

    Test::case "eval defines in current frame" {
        eval {let ev_y 100}
        Test::eq $ev_y 100
    }

    Test::case "eval with multiple args" {
        let ev_cmd1 "let ev_z"
        let ev_cmd2 "200"
        eval $ev_cmd1 $ev_cmd2
        Test::eq $ev_z 200
    }

    Test::case "return inside eval in proc" {
        proc testEvalReturn {} {
            eval { return 999 }
        }
        Test::eq [testEvalReturn] 999
    }
}

;; ============================================================================
;; Subst
;; ============================================================================

Test::suite "Subst" {
    Test::case "variable substitution" {
        let sub_x 42
        Test::eq [subst {x is $sub_x}] {x is 42}
    }

    Test::case "subcommand substitution" {
        Test::eq [subst {sum=[+ 1 2]}] {sum=3}
    }

    Test::case "braced variable form" {
        let sub_foo bar
        Test::eq [subst {${sub_foo}!}] {bar!}
    }

    Test::case "backslash escapes" {
        Test::eq [subst {literal \$x}] {literal $x}
    }

    Test::case "braces are literal" {
        Test::eq [subst {braces {} ok}] {braces {} ok}
    }
}

;; ============================================================================
;; Namespace
;; ============================================================================

Test::suite "Namespace" {
    Test::case "define values in namespace" {
        namespace myns {
            let val 100
        }
        Test::eq $myns::val 100
    }

    Test::case "define procs in namespace" {
        namespace funcs {
            proc double {n} { return [+ $n $n] }
        }
        Test::eq [funcs::double 7] 14
    }

    Test::case "nested namespace path" {
        namespace outer::inner::leaf {
            let deep 42
        }
        Test::eq $outer::inner::leaf::deep 42
    }

    Test::case "multiple evals on same namespace" {
        namespace ns1 { let x 1 }
        namespace ns1 { let y 2 }
        Test::eq $ns1::x 1
        Test::eq $ns1::y 2
    }

    Test::case "namespace changes lookup resolution" {
        namespace ns3 {
            let x 1

            proc foo {bar} {
                $bar
            }

            namespace ns4 {
                let y 1

                proc qux {} {
                    42
                }
            }
        }

        namespace ns3 {
            Test::eq [foo 123] 123
            Test::eq $x 1

            namespace ns4 {
                Test::eq [qux] 42
            }

            Test::eq [ns4::qux] 42
        }

        Test::eq [ns3::foo 321] 321
        Test::eq $ns3::x 1
        Test::eq [ns3::ns4::qux] 42

        namespace ns5 {
            let v 42

            proc foo {} {
                $v
            }

            proc bar {} {
                foo
            }
        }

        Test::eq [ns5::foo] 42
        Test::eq [ns5::bar] 42

        ;; Reopening should work
        namespace ns5 {
            proc qux {} {
                foo
            }
        }

        Test::eq [ns5::qux] 42
    }

    ;; --- Qualified path root anchoring (regression) ---
    ;; `namespace foo::bar { ... }` inside an enclosing `namespace baz`
    ;; used to create the root `foo` in the builder's overlay frame,
    ;; orphaning the sub-namespace when the overlay popped. Roots now
    ;; anchor at the global frame so the qualified path is always
    ;; reachable absolutely.

    Test::case "qualified path with new root inside enclosing namespace" {
        namespace qroot_outer1 {
            namespace qroot_new1::qleaf1 { let x 1 }
        }
        ;; Root is created at global and reachable absolutely.
        Test::eq $qroot_new1::qleaf1::x 1
    }

    Test::case "qualified path with existing root inside enclosing namespace" {
        ;; Pre-existing root: should be found via lexical chain, not re-created.
        namespace qroot_existing { let initial 1 }
        namespace qroot_outer2 {
            namespace qroot_existing::qleaf2 { let y 2 }
        }
        Test::eq $qroot_existing::initial 1
        Test::eq $qroot_existing::qleaf2::y 2
    }

    Test::case "qualified path inside proc body (Dagwood pattern)" {
        ;; namespace ${proj}::${task} inside a proc that itself
        ;; runs inside namespace ${proj} { ... }.
        namespace qrootD { let marker 1 }
        proc qrootD_helper {leaf} {
            namespace qrootD::$leaf { let from_proc 7 }
        }
        namespace qrootD {
            qrootD_helper task1
        }
        Test::eq $qrootD::task1::from_proc 7
        Test::eq $qrootD::marker 1
    }
}

;; ============================================================================
;; Qualified self-reference inside a namespace builder
;; ============================================================================
;; Regression for LCL_FEATURE_REQUESTS.md feature 6: while the body of
;; `namespace foo { ... }` is running, foo isn't yet bound as a namespace
;; value, so `$foo::X` used to fail with "undefined variable". Fix:
;; lcl_env_get_value's qualified-path resolution walks the def_target
;; stack for a name that matches a "::"-bounded prefix of the key, and
;; resolves the suffix from that target's overlay.

Test::suite "Qualified self-reference" {
    Test::case "self-reference reads let binding while still building" {
        namespace qsr_simple {
            let X "value"
            Test::eq $qsr_simple::X "value"
        }
    }

    Test::case "self-reference reads var (cell) and dereferences it" {
        namespace qsr_cell {
            var counter 0
            set! counter [+ $qsr_cell::counter 1]
            Test::eq $qsr_cell::counter 1
        }
    }

    Test::case "self-reference works from inside a proc defined in the namespace" {
        namespace qsr_proc {
            let Y "via proc"
            proc qsr_reader {} { $qsr_proc::Y }
            Test::eq [qsr_reader] "via proc"
        }
    }

    Test::case "self-reference works through nested namespace" {
        namespace qsr_outer {
            namespace qsr_inner { let X 99 }
            Test::eq $qsr_outer::qsr_inner::X 99
        }
    }

    Test::case "self-reference works with qualified namespace name" {
        namespace qsr_alpha::qsr_beta {
            let Z 42
            Test::eq $qsr_alpha::qsr_beta::Z 42
        }
    }

    Test::case "self-reference fails for non-existent binding" {
        namespace qsr_missing {
            let present 1
            Test::raises { puts $qsr_missing::absent }
        }
    }

    Test::case {bare $foo (no qualifier) inside namespace foo still fails} {
        ;; The partial-build state isn't a first-class value; only
        ;; suffix-bearing keys go through the def_target fallback.
        Test::raises {
            namespace qsr_bare {
                let X 1
                puts $qsr_bare
            }
        }
    }

    Test::case "sibling namespace lookup uses already-built namespace, not target" {
        namespace qsr_sibling::first { let A 1 }
        namespace qsr_sibling::second {
            ;; first is already a real namespace value; resolution
            ;; should go through normal env_get_simple, not def_target.
            Test::eq $qsr_sibling::first::A 1
            let B 2
            ;; self-reference for the in-progress namespace still works
            Test::eq $qsr_sibling::second::B 2
        }
    }

    ;; --- Self-reference through proc-call boundary ---
    ;; Regression: user-proc calls raise def_floor (to block helper
    ;; bindings from leaking into the caller's namespace) but must
    ;; NOT raise def_lookup_floor. So $foo::X from inside a helper
    ;; proc called from foo's body still resolves via the def_target
    ;; overlay fallback.

    Test::case "self-reference works through a helper proc that evals body" {
        proc qsr_reader1 {body} { eval $body }
        namespace qsr_through_proc1 {
            let X "via-proc"
            qsr_reader1 { Test::eq $qsr_through_proc1::X "via-proc" }
        }
    }

    Test::case "self-reference works through multiple nested proc calls" {
        proc qsr_layer3 {body} { eval $body }
        proc qsr_layer2 {body} { qsr_layer3 $body }
        proc qsr_layer1 {body} { qsr_layer2 $body }
        namespace qsr_through_proc2 {
            let X 42
            qsr_layer1 { Test::eq $qsr_through_proc2::X 42 }
        }
    }

    Test::case "self-reference reads a var (cell) through a proc call" {
        proc qsr_reader2 {body} { eval $body }
        namespace qsr_through_proc3 {
            var counter 7
            qsr_reader2 { Test::eq $qsr_through_proc3::counter 7 }
        }
    }

    Test::case "self-reference works for qualified ns name through proc call" {
        proc qsr_reader3 {body} { eval $body }
        namespace qsr_q1::qsr_q2 {
            let Z "qual-via-proc"
            qsr_reader3 { Test::eq $qsr_q1::qsr_q2::Z "qual-via-proc" }
        }
    }

    Test::case "isolate cuts off self-reference even through proc calls" {
        ;; Isolate is the full barrier: raises both def_floor (writes)
        ;; AND def_lookup_floor (reads). A proc call inside isolate
        ;; cannot see outer-namespace self-references.
        proc qsr_reader4 {body} { eval $body }
        namespace qsr_through_isolate {
            let X "should-be-hidden"
            isolate {
                Test::raises { qsr_reader4 { puts $qsr_through_isolate::X } }
            }
        }
    }
}

;; ============================================================================
;; Helper-proc binding leak regression (Dagwood feedback round 3)
;; ============================================================================
;; The user reported that `proc` declarations inside a helper proc
;; still leaked even after the def_floor fix. Could not reproduce
;; (likely a misread of the unknown-command-returns-string
;; fallback). These tests lock in the actual behavior: var, let,
;; proc, and macro declarations inside a helper all stay local.

Test::suite "Helper-proc binding leak (all forms)" {
    Test::case "proc inside helper does not leak (Ns::has? check)" {
        proc hlp_proc_helper {} {
            proc hlp_proc_inner {} { 42 }
        }
        namespace hlp_proc_ns1 {
            hlp_proc_helper
        }
        Test::eq [Ns::has? $hlp_proc_ns1 hlp_proc_inner] 0
    }

    Test::case "proc inside helper that evals body does not leak" {
        proc hlp_proc_helper2 {body} {
            proc hlp_proc_inner2 {} { 99 }
            eval $body
        }
        namespace hlp_proc_ns2 {
            hlp_proc_helper2 { }
        }
        Test::eq [Ns::has? $hlp_proc_ns2 hlp_proc_inner2] 0
    }

    Test::case "var inside helper that evals body does not leak" {
        proc hlp_var_helper {body} {
            var hlp_var_state "private"
            eval $body
        }
        namespace hlp_var_ns {
            hlp_var_helper { }
        }
        Test::eq [Ns::has? $hlp_var_ns hlp_var_state] 0
    }

    Test::case "let inside helper that evals body does not leak" {
        proc hlp_let_helper {body} {
            let hlp_let_const "private"
            eval $body
        }
        namespace hlp_let_ns {
            hlp_let_helper { }
        }
        Test::eq [Ns::has? $hlp_let_ns hlp_let_const] 0
    }

    Test::case "macro inside helper that evals body does not leak" {
        proc hlp_macro_helper {body} {
            macro hlp_macro_inner {} { quote {1} }
            eval $body
        }
        namespace hlp_macro_ns {
            hlp_macro_helper { }
        }
        Test::eq [Ns::has? $hlp_macro_ns hlp_macro_inner] 0
    }

    Test::case "all forms together stay local (Dagwood task_impl shape)" {
        proc hlp_task_impl {body} {
            var _task #{}
            let TASK_PRIVATE "x"
            proc hlp_attr_setter {v} { puts $v }
            macro hlp_attr_macro {} { quote {0} }
            eval $body
        }
        namespace hlp_proj {
            hlp_task_impl { }
            let proj_var 1
        }
        Test::eq [Ns::has? $hlp_proj _task] 0
        Test::eq [Ns::has? $hlp_proj TASK_PRIVATE] 0
        Test::eq [Ns::has? $hlp_proj hlp_attr_setter] 0
        Test::eq [Ns::has? $hlp_proj hlp_attr_macro] 0
        Test::eq $hlp_proj::proj_var 1
    }
}

;; ============================================================================
;; Namespace re-entry (in-place mutation)
;; ============================================================================

Test::suite "Namespace re-entry" {
    Test::case "let inside namespace re-entry from proc body persists" {
        namespace re_ns1 { var existing "ok" }
        proc add_let {} {
            namespace re_ns1 { let FROM_PROC "value" }
        }
        add_let
        Test::eq $re_ns1::FROM_PROC "value"
        Test::eq $re_ns1::existing "ok"
    }

    Test::case "var inside namespace re-entry from proc body persists" {
        namespace re_ns2 {}
        proc add_var {} {
            namespace re_ns2 { var COUNT 0 }
        }
        add_var
        Test::eq $re_ns2::COUNT 0
        set! re_ns2::COUNT 5
        Test::eq $re_ns2::COUNT 5
    }

    Test::case "proc inside namespace re-entry from proc body persists" {
        namespace re_ns3 {}
        proc add_proc {} {
            namespace re_ns3 { proc helper {} { return 42 } }
        }
        add_proc
        Test::eq [re_ns3::helper] 42
    }

    Test::case "dynamic name var inside namespace re-entry from proc body" {
        namespace re_ns4 {}
        proc bind_dynamic {n v} {
            namespace re_ns4 { var $n $v }
        }
        bind_dynamic "DYNAMIC_NAME" "dynamic_value"
        Test::eq $re_ns4::DYNAMIC_NAME "dynamic_value"
    }

    Test::case "qualified-path re-entry preserves prior bindings" {
        namespace re_qual::sub { let X 1 }
        namespace re_qual::sub { let Y 2 }
        Test::eq $re_qual::sub::X 1
        Test::eq $re_qual::sub::Y 2
    }

    Test::case "namespace value identity preserved across re-entry" {
        namespace re_ns5 { let A 1 }
        let captured $re_ns5
        namespace re_ns5 { let B 2 }
        ;; The captured reference sees the new binding because we
        ;; mutated in place.
        Test::eq [Ns::has? $captured B] 1
        Test::eq [Ns::has? $captured A] 1
    }

    Test::case "set! across re-entry still works (regression)" {
        namespace re_ns6 { var counter 0 }
        proc bump {} {
            namespace re_ns6 { set! counter [+ $counter 1] }
        }
        bump
        bump
        bump
        Test::eq $re_ns6::counter 3
    }
}

;; ============================================================================
;; Ns::set
;; ============================================================================

Test::suite "Ns::set" {
    Test::case "binds a new name into namespace" {
        namespace nsset_ns1 {}
        Ns::set $nsset_ns1 X 42
        Test::eq $nsset_ns1::X 42
        Test::eq [Ns::has? $nsset_ns1 X] 1
    }

    Test::case "overwrites existing binding" {
        namespace nsset_ns2 { let X 1 }
        Ns::set $nsset_ns2 X 99
        Test::eq $nsset_ns2::X 99
    }

    Test::case "supports the Dagwood-style def pattern" {
        namespace nsset_proj {}
        proc nsset_def {ns name value} {
            Ns::set [getvar $ns] $name $value
            return $value
        }
        nsset_def nsset_proj alpha 10
        nsset_def nsset_proj beta  "hello"
        Test::eq $nsset_proj::alpha 10
        Test::eq $nsset_proj::beta "hello"
    }

    Test::case "errors when first arg is not a namespace" {
        Test::raises { Ns::set "not a ns" X 1 }
    }

    Test::case "errors on wrong arity" {
        namespace nsset_ns3 {}
        Test::raises { Ns::set $nsset_ns3 X }
        Test::raises { Ns::set }
    }

    Test::case "value can be any type" {
        namespace nsset_ns4 {}
        Ns::set $nsset_ns4 a_list [list 1 2 3]
        Ns::set $nsset_ns4 a_dict [dict k v]
        Test::eq [len $nsset_ns4::a_list] 3
        Test::eq [get $nsset_ns4::a_dict k] v
    }
}

Test::suite "Ns::del and Ns::clear" {
    Test::case "del removes a binding and reports 1" {
        namespace nsdel_ns1 { let X 1; let Y 2 }
        Test::eq [Ns::del $nsdel_ns1 X] 1
        Test::eq [Ns::has? $nsdel_ns1 X] 0
        Test::eq $nsdel_ns1::Y 2
        Test::raises { puts $nsdel_ns1::X }
    }

    Test::case "del of absent binding reports 0" {
        namespace nsdel_ns2 { let X 1 }
        Test::eq [Ns::del $nsdel_ns2 missing] 0
        Test::eq [Ns::del $nsdel_ns2 X] 1
        Test::eq [Ns::del $nsdel_ns2 X] 0
    }

    Test::case "clear empties the namespace" {
        namespace nsclr_ns1 { let a 1; var b 2; proc f {} { 3 } }
        Test::eq [len [Ns::keys $nsclr_ns1]] 3
        Ns::clear $nsclr_ns1
        Test::eq [len [Ns::keys $nsclr_ns1]] 0
        Test::eq [Ns::has? $nsclr_ns1 f] 0
        Test::raises { nsclr_ns1::f }
    }

    Test::case "clear preserves namespace identity for re-entry" {
        namespace nsclr_ns2 { let old 1 }
        let nsclr_alias $nsclr_ns2
        Ns::clear $nsclr_ns2
        namespace nsclr_ns2 { let fresh 9 }
        Test::eq $nsclr_ns2::fresh 9
        ;; alias references the same value, so it sees clear + repopulate
        Test::eq [Ns::has? $nsclr_alias old] 0
        Test::eq $nsclr_alias::fresh 9
    }

    Test::case "imported cells survive clear" {
        namespace nsclr_ctr { var nsclr_cell 5 }
        import nsclr_ctr nsclr_cell
        Ns::clear $nsclr_ctr
        Test::eq $nsclr_cell 5
        set! nsclr_cell 6
        Test::eq $nsclr_cell 6
    }

    Test::case "errors on non-namespace or wrong arity" {
        Test::raises { Ns::clear "not a ns" }
        Test::raises { Ns::del "not a ns" x }
        Test::raises { Ns::clear }
        namespace nsdel_ns3 {}
        Test::raises { Ns::del $nsdel_ns3 }
    }
}

;; ============================================================================
;; Require
;; ============================================================================

Test::suite "Require" {
    Test::case "namespace is lifted into caller" {
        require test/require_fixtures/clean_lib.lcl
        Test::eq $cleanlib::version "1.0"
        Test::eq [cleanlib::greet "world"] "hi world"
        Test::eq [cleanlib::add 2 3] 5
    }

    Test::case "loose top-level let is discarded" {
        require test/require_fixtures/leaky_lib.lcl
        ;; The lifted namespace is present.
        Test::eq [leakylib::serve] 9090
        ;; LOOSE_CONST, loose_counter, loose_helper must NOT leak.
        Test::raises { $LOOSE_CONST }
        Test::raises { $loose_counter }
        ;; Bareword `loose_helper` with no args would silently fall
        ;; back to the literal string "loose_helper" (lcl-eval.c), so
        ;; we invoke it with an arg to force unknown-command resolution.
        Test::raises { loose_helper junk }
    }

    Test::case "nested-path namespaces lift" {
        require test/require_fixtures/nested_ns_lib.lcl
        Test::eq $nestedlib::top_v 1
        Test::eq $nestedlib::sub::deep_v 42
    }

    Test::case "procs in namespace see file-level constants via closure" {
        require test/require_fixtures/closure_lib.lcl
        Test::eq [closurelib::get_helper_const] 42
        ;; But HELPER_CONST is not visible at caller scope.
        Test::raises { $HELPER_CONST }
    }

    Test::case "repeated require is cached (file body runs once)" {
        ;; require_se_counter is seeded as a top-level (global) cell at
        ;; the bottom of this file — required files see it via the
        ;; overlay's parent chain into the global frame.
        set! require_se_counter 0
        require test/require_fixtures/sideeffect_lib.lcl
        require test/require_fixtures/sideeffect_lib.lcl
        require test/require_fixtures/sideeffect_lib.lcl
        ;; Cache means body evaluated exactly once across the 3 calls.
        Test::eq $require_se_counter 1
        ;; Namespace is still bound after cache-served requires.
        Test::eq [selib::nop] 0
    }

    Test::case "module identity is the cleaned lexical path" {
        ;; Lcl module paths are lexical names: ".",
        ;; "..", and repeated separators are normalized by string
        ;; rules, so these spellings are all ONE module — the body
        ;; must run exactly once across the three requires.
        set! require_lex_counter 0
        require test/require_fixtures/lexical_id_lib.lcl
        require test/require_fixtures/./lexical_id_lib.lcl
        require test/require_fixtures/../require_fixtures//lexical_id_lib.lcl
        Test::eq $require_lex_counter 1
        Test::eq [lexlib::nop] 0
    }

    Test::case "missing file errors cleanly" {
        Test::raises { require /no/such/path/here.lcl }
    }

    Test::case "compile error in required file propagates" {
        Test::raises { require test/require_fixtures/compile_error_lib.lcl }
    }

    Test::case "runtime error in required file propagates" {
        Test::raises { require test/require_fixtures/runtime_error_lib.lcl }
        ;; The namespace defined before the error must NOT be cached
        ;; or lifted; the require returned an error, so partial state
        ;; should be discarded.
        Test::raises { $good_before_err::v }
    }

    Test::case "require inside namespace lifts into that namespace" {
        namespace req_outer {
            require test/require_fixtures/clean_lib.lcl
        }
        ;; cleanlib should be a member of req_outer, not at top level
        ;; (because the require ran inside a builder, its def-target
        ;; was active and lifted bindings went there).
        Test::eq [Ns::has? $req_outer cleanlib] 1
        Test::eq [req_outer::cleanlib::greet "alice"] "hi alice"
    }

    Test::case "require: too few args is an error" {
        Test::raises { require }
    }

    Test::case "require: too many args is an error" {
        Test::raises { require foo bar }
    }

    Test::case "./ paths resolve relative to the requiring file" {
        ;; rel_a requires ./rel_b.lcl, which requires ./sub/rel_c.lcl —
        ;; each "./" resolves against its own file's directory, and the
        ;; lifted namespaces cascade up to us.
        require test/require_fixtures/rel/rel_a.lcl
        Test::eq $rel_a::tag "a"
        Test::eq $rel_b::tag "b"
        Test::eq $rel_c::val 7
        ;; The chained module was also usable inside rel_b itself.
        Test::eq [rel_b::c_val] 7
    }

    Test::case "require cycle is a clear error, not runaway recursion" {
        Test::raises_with { require test/require_fixtures/cyc_a.lcl } \
            "dependency cycle"
    }

    Test::case "self-require is a cycle error" {
        Test::raises_with { require test/require_fixtures/cyc_self.lcl } \
            "dependency cycle"
    }

    Test::case "failed require names the argument and attempted paths" {
        Test::raises_with { require test/require_fixtures/no_such_mod.lcl } \
            "no_such_mod.lcl"
        Test::raises_with { require test/require_fixtures/no_such_mod.lcl } \
            "tried"
    }
}

;; ============================================================================
;; Isolate
;; ============================================================================

Test::suite "Isolate" {
    Test::case "let inside isolate does not leak to enclosing namespace" {
        namespace iso_ns1 {
            isolate { let local_leak "nope" }
            let public_one 1
        }
        ;; The isolated let should be discarded.
        Test::eq [Ns::has? $iso_ns1 local_leak] 0
        ;; But subsequent bare lets in the namespace still land in it.
        Test::eq $iso_ns1::public_one 1
    }

    Test::case "var inside isolate does not leak to enclosing namespace" {
        namespace iso_ns2 {
            isolate { var hidden_counter 0 }
        }
        Test::eq [Ns::has? $iso_ns2 hidden_counter] 0
    }

    Test::case "proc inside isolate does not leak to enclosing namespace" {
        namespace iso_ns3 {
            isolate { proc hidden_helper {} { 42 } }
            proc public_helper {} { 99 }
        }
        Test::eq [Ns::has? $iso_ns3 hidden_helper] 0
        Test::eq [iso_ns3::public_helper] 99
    }

    Test::case "isolate inside proc inside namespace (Dagwood task_impl pattern)" {
        namespace iso_ns4 {
            proc task_impl {body} {
                isolate { eval $body }
            }
        }
        namespace iso_ns4 {
            iso_ns4::task_impl { let tmp_file "out.txt" }
        }
        ;; tmp_file must not have leaked into iso_ns4
        Test::eq [Ns::has? $iso_ns4 tmp_file] 0
    }

    Test::case "isolate returns body's last value" {
        Test::eq [isolate { + 1 2 }] 3
    }

    Test::case "empty body returns empty string" {
        Test::eq [isolate { }] {}
    }

    Test::case "isolate outside any namespace is a no-op for scoping" {
        isolate { let iso_top_x 7 }
        Test::eq $iso_top_x 7
    }

    Test::case "nested isolate behaves the same as a single isolate" {
        namespace iso_ns5 {
            isolate {
                isolate { let inner_x 1 }
                let middle_x 2
            }
        }
        Test::eq [Ns::has? $iso_ns5 inner_x] 0
        Test::eq [Ns::has? $iso_ns5 middle_x] 0
    }

    Test::case "def_depth is restored after isolate error" {
        catch {
            namespace iso_ns6 {
                isolate { error "boom" }
                let after_err 42
            }
        }
        ;; After the error, the namespace's def-target was properly popped,
        ;; so a brand-new namespace builder still works normally.
        namespace iso_ns7 { let post 1 }
        Test::eq $iso_ns7::post 1
    }

    Test::case "return inside isolate returns from enclosing proc" {
        proc iso_returns {} {
            isolate { return 99 }
            ;; unreachable
            return 0
        }
        Test::eq [iso_returns] 99
    }

    Test::case "isolate: too few args is an error" {
        Test::raises { isolate }
    }

    Test::case "isolate: too many args is an error" {
        Test::raises { isolate {x} {y} }
    }

    ;; --- namespace inside isolate (regression: feature 4 in LCL_FEATURE_REQUESTS) ---
    ;; Setting def_depth=0 used to make a nested namespace's def_target_push
    ;; overwrite the enclosing namespace's def_stack slot, leaving the outer
    ;; with NULL exports and either "failed to create namespace" or a segfault.

    Test::case "unqualified namespace inside isolate inside outer namespace" {
        namespace iso_ns_inner1 {
            isolate {
                namespace just_sub_a { let inner_x 1 }
            }
            let outer_one 1
        }
        ;; The inner namespace was isolated, so it must not leak into
        ;; the outer namespace's exports. The outer's normal exports survive.
        Test::eq [Ns::has? $iso_ns_inner1 just_sub_a] 0
        Test::eq $iso_ns_inner1::outer_one 1
    }

    Test::case "qualified namespace inside top-level isolate" {
        isolate {
            namespace iso_top_root::iso_top_leaf { let qx 9 }
        }
        ;; Qualified path resolves via current frame, so the namespace
        ;; survives outside isolate (root binding made via lcl_env_let).
        Test::eq $iso_top_root::iso_top_leaf::qx 9
    }

    Test::case "re-entering an existing namespace inside isolate (regression: line 2668 NULL deref)" {
        namespace iso_reenter_root::iso_reenter_leaf { let first 1 }
        isolate {
            namespace iso_reenter_root::iso_reenter_leaf { let second 2 }
        }
        ;; Re-entry must extend the existing namespace in place, not crash.
        Test::eq $iso_reenter_root::iso_reenter_leaf::first 1
        Test::eq $iso_reenter_root::iso_reenter_leaf::second 2
    }

    Test::case "qualified namespace inside isolate inside outer namespace" {
        ;; The bug: isolate's `def_depth = 0` reset caused the inner
        ;; namespace's def_stack push to overwrite the outer's slot,
        ;; either erroring with "failed to create namespace" or, when
        ;; the qualified path hit the re-entry branch, segfaulting at
        ;; line 2668. The fix uses a def_floor so the inner push goes
        ;; to a fresh slot above the outer's. With the qualified-root
        ;; anchor fix, the inner qualified namespace also survives
        ;; (its root is anchored at the global frame).
        namespace iso_outer_q {
            isolate {
                namespace iso_qroot::iso_qleaf { let qy 7 }
            }
            let public_two 2
        }
        Test::eq $iso_outer_q::public_two 2
        Test::eq $iso_qroot::iso_qleaf::qy 7
    }
}

;; ============================================================================
;; Proc-call boundary blocks def-target leakage
;; ============================================================================
;; Regression for LCL_FEATURE_REQUESTS.md feature 5: helper procs called
;; from inside a namespace block used to leak their var/proc declarations
;; into the enclosing namespace because the def-target stack was dynamically
;; scoped through proc calls. Fix: lcl_call_user_proc raises def_floor for
;; the duration of the call, so internal bindings stay local.

Test::suite "Proc-call boundary stops def-target leakage" {
    Test::case "var inside helper proc does not leak to caller's namespace" {
        proc pclb_helper1 {} {
            var pclb_private "set by helper"
        }
        namespace pclb_ns1 {
            pclb_helper1
            let pclb_public 1
        }
        Test::eq [Ns::has? $pclb_ns1 pclb_private] 0
        Test::eq $pclb_ns1::pclb_public 1
    }

    Test::case "proc inside helper proc does not leak to caller's namespace" {
        proc pclb_helper2 {} {
            proc pclb_inner {} { 42 }
        }
        namespace pclb_ns2 {
            pclb_helper2
        }
        Test::eq [Ns::has? $pclb_ns2 pclb_inner] 0
    }

    Test::case "let inside eval body of helper does not leak (call-boundary applies through eval)" {
        proc pclb_helper3 {body} {
            eval $body
        }
        namespace pclb_ns3 {
            pclb_helper3 { let pclb_from_body "x" }
        }
        ;; eval runs in the helper's frame, which is below the floor,
        ;; so let in body stays local to the helper.
        Test::eq [Ns::has? $pclb_ns3 pclb_from_body] 0
    }

    Test::case "explicit namespace re-entry from inside helper still extends the namespace" {
        ;; Proc-call boundary only blocks IMPLICIT def-target inheritance.
        ;; Code that explicitly re-enters via `namespace foo { ... }`
        ;; pushes its own target above the floor, so let/var/proc inside
        ;; that re-entry still write to foo as expected.
        namespace pclb_ns4 { let initial 1 }
        proc pclb_extender {} {
            namespace pclb_ns4 { let added_by_proc 2 }
        }
        pclb_extender
        Test::eq $pclb_ns4::initial 1
        Test::eq $pclb_ns4::added_by_proc 2
    }

    Test::case "nested helper calls do not leak through multiple proc boundaries" {
        proc pclb_inner_helper {} {
            var deeply_nested "x"
        }
        proc pclb_outer_helper {} {
            var also_nested "y"
            pclb_inner_helper
        }
        namespace pclb_ns5 {
            pclb_outer_helper
        }
        Test::eq [Ns::has? $pclb_ns5 deeply_nested] 0
        Test::eq [Ns::has? $pclb_ns5 also_nested] 0
    }

    Test::case "helper proc with private var and helper procs (Dagwood task_impl pattern)" {
        ;; Dagwood's task_impl pattern from the bug report — no isolate
        ;; needed once the proc-call boundary blocks the leak.
        proc pclb_task_impl {task_name body} {
            var _task #{}
            proc pclb_always_run {v} { puts "always_run $v" }
            eval $body
        }
        namespace pclb_proj {
            pclb_task_impl "task1" { }
            let pclb_proj_var 1
        }
        ;; The helper's private state stays out of pclb_proj.
        Test::eq [Ns::has? $pclb_proj _task] 0
        Test::eq [Ns::has? $pclb_proj pclb_always_run] 0
        ;; The project's own bindings still land in pclb_proj.
        Test::eq $pclb_proj::pclb_proj_var 1
    }
}

;; ============================================================================
;; Import
;; ============================================================================

Test::suite "Import" {
    Test::case "import all bindings from namespace" {
        namespace imp_math_all {
            let imp_ten 10
            proc imp_square {x} { * $x $x }
        }
        import imp_math_all
        Test::eq $imp_ten 10
        Test::eq [imp_square 5] 25
    }

    Test::case "import specific bindings" {
        namespace imp_utils_spec {
            let imp_aa 1
            let imp_bb 2
            let imp_cc 3
        }
        import imp_utils_spec imp_aa imp_cc
        Test::eq $imp_aa 1
        Test::eq $imp_cc 3
        ;; imp_bb should not be imported - accessing it should error
        Test::raises { $imp_bb }
    }

    Test::case "import from nested namespace" {
        namespace imp_outer_nest {
            namespace imp_inner_nest {
                let imp_deep 42
            }
        }
        import imp_outer_nest::imp_inner_nest imp_deep
        Test::eq $imp_deep 42
    }

    Test::case "imported cells share mutation" {
        namespace imp_counter_share {
            var imp_cnt 0
            proc imp_incr {} { set! imp_cnt [+ $imp_cnt 1] }
            proc imp_getval {} { return $imp_cnt }
        }
        import imp_counter_share imp_cnt imp_incr imp_getval
        Test::eq [imp_getval] 0
        imp_incr
        Test::eq [imp_getval] 1
        set! imp_cnt 100
        Test::eq [imp_getval] 100
        Test::eq $imp_counter_share::imp_cnt 100
    }

    Test::case "import inside namespace builder" {
        namespace imp_helpers_ns {
            proc imp_helper {} { return 42 }
        }
        namespace imp_app_ns {
            import imp_helpers_ns imp_helper
            proc imp_run {} { imp_helper }
        }
        Test::eq [imp_app_ns::imp_run] 42
    }

    Test::case "import name conflict errors" {
        namespace imp_conflict_ns {
            let imp_myval 99
        }
        ;; Import twice - second import should conflict with first
        ;; Using catch directly since Test::raises creates a new frame
        import imp_conflict_ns imp_myval
        let caught [catch { import imp_conflict_ns imp_myval }]
        Test::eq $caught 1
    }

    Test::case "import name not found errors" {
        namespace imp_empty_ns {
            let imp_exists 1
        }
        Test::raises { import imp_empty_ns imp_missing }
    }

    Test::case "import with variable reference" {
        namespace imp_ref_ns {
            let imp_refval 123
        }
        let imp_ns $imp_ref_ns
        import $imp_ns imp_refval
        Test::eq $imp_refval 123
    }
}

;; ============================================================================
;; Load
;; ============================================================================

Test::suite "Load" {
    Test::case "load file and call procs" {
        load test/conformance_lib.lcl
        Test::eq [lib_add 10 20] 30
        Test::eq $LIB_CONST 42
    }

    Test::case "load into namespace" {
        namespace imported {
            load test/conformance_lib.lcl
        }
        Test::eq [imported::lib_add 5 5] 10
        Test::eq $imported::LIB_CONST 42
    }
}

;; ============================================================================
;; List Operations
;; ============================================================================

Test::suite "List Operations" {
    Test::case "list creation and length" {
        let mylist [list a b c d e]
        Test::eq [len $mylist] 5
    }

    Test::case "empty list literal ()" {
        let empty ()
        Test::eq [len $empty] 0
        Test::assert [list? $empty]
        Test::eq $empty [list]
    }

    Test::case "get elements by index" {
        let mylist [list a b c d e]
        Test::eq [get $mylist 0] a
        Test::eq [get $mylist 2] c
        Test::eq [get $mylist 4] e
    }

    Test::case "has? on lists is membership, not index bounds" {
        let hs_list [list a b c]
        Test::true [has? $hs_list b]
        Test::false [has? $hs_list z]
        ;; index-shaped needles are still just members (or not)
        Test::false [has? $hs_list 0]
        Test::false [has? $hs_list ()]
    }

    Test::case "has? uses deep equality with numeric coercion" {
        let hs_nums [list [+ 1 1] 3]
        Test::true [has? $hs_nums 2]
        Test::true [has? $hs_nums "2"]
        Test::false [has? $hs_nums 4]
        let hs_nested [list (1 2) (3 4)]
        Test::true [has? $hs_nested (1 2)]
        Test::false [has? $hs_nested (2 1)]
    }

    Test::case "List::slice" {
        let mylist [list a b c d e]
        let slice [List::slice $mylist 1 4]
        Test::eq [len $slice] 3
        Test::eq [get $slice 0] b
        Test::eq [get $slice 2] d
    }

    Test::case "List::concat" {
        let list1 [list 1 2]
        let list2 [list 3 4]
        let combined [List::concat $list1 $list2]
        Test::eq [len $combined] 4
        Test::eq [get $combined 0] 1
        Test::eq [get $combined 3] 4
    }

    Test::case "String::join" {
        let mylist [list a b c d e]
        Test::eq [String::join $mylist -] {a-b-c-d-e}
        Test::eq [String::join $mylist {}] {abcde}
    }

    Test::case "String::split" {
        let parts [String::split "hello,world,test" ","]
        Test::eq [len $parts] 3
        Test::eq [get $parts 0] hello
        Test::eq [get $parts 1] world
    }

    Test::case "List::push" {
        let nums [list 1 2 3]
        let nums [List::push $nums 4]
        let nums [List::push $nums 5]
        Test::eq [len $nums] 5
        Test::eq [get $nums 4] 5
    }

    Test::case "put modifies element" {
        let items [list a b c]
        let items [put $items 1 B]
        Test::eq [get $items 0] a
        Test::eq [get $items 1] B
        Test::eq [get $items 2] c
    }

    Test::case "nested list indexing" {
        let nested [list [list x y] [list z w]]
        Test::eq [get [get $nested 0] 0] x
        Test::eq [get [get $nested 0] 1] y
        Test::eq [get [get $nested 1] 0] z
    }

    Test::case "merge via splat operator" {
        let list1 (1 2 3 4)
        let list2 (5 6 7 8)
        let list3 (@$list1 @$list2)

        Test::eq $list3 (1 2 3 4 5 6 7 8)
        Test::eq $list3 [List::concat $list1 $list2]
        Test::eq [+ [len $list1] [len $list2]] [len $list3]
    }

    Test::case "nested splat" {
        let list1 (1 2 3 4)
        let list2 (4 5 6 7)
        let list3 (1 2 3 (4 5 6 7 @$list2))

        Test::eq $list3 (1 2 3 (4 5 6 7 4 5 6 7))
    }

    Test::case "multi-line lambda inside list literal" {
        ;; Regression test: multi-line lambda bodies in () list literals
        ;; must preserve newlines inside braces for command separation
        let handlers (
            ("key1" [lambda {x} {
                let doubled [* $x 2]
                let result [+ $doubled 10]
                $result
            }])
            ("key2" [lambda {x} {
                let tripled [* $x 3]
                $tripled
            }])
        )
        ;; Verify the list structure
        Test::eq [len $handlers] 2
        Test::eq [get [get $handlers 0] 0] "key1"
        Test::eq [get [get $handlers 1] 0] "key2"
        ;; Call the lambdas and verify they work
        let fn1 [get [get $handlers 0] 1]
        let fn2 [get [get $handlers 1] 1]
        Test::eq [$fn1 5] 20   ;; (5*2) + 10 = 20
        Test::eq [$fn2 5] 15   ;; 5*3 = 15
    }
}

;; ============================================================================
;; Dict Operations
;; ============================================================================

Test::suite "Dict Operations" {
    Test::case "dict create and size" {
        let d [dict a 1 b 2 c 3]
        Test::eq [len $d] 3
    }

    Test::case "empty dict literal #{}" {
        let empty #{}
        Test::eq [len $empty] 0
        Test::assert [dict? $empty]
        Test::eq $empty [dict]
    }

    Test::case "get by key" {
        let d [dict a 1 b 2 c 3]
        Test::eq [get $d a] 1
        Test::eq [get $d b] 2
        Test::eq [get $d c] 3
    }

    Test::case "has? checks key existence" {
        let d [dict a 1 b 2]
        Test::true [has? $d a]
        Test::false [has? $d missing]
    }

    Test::case "has? on strings is substring containment" {
        Test::true [has? "hello world" "lo wo"]
        Test::true [has? "hello" "hello"]
        Test::true [has? "hello" ""]
        Test::false [has? "hello" "xyz"]
        Test::false [has? "" "x"]
    }

    Test::case "Dict::keys" {
        let d [dict a 1 b 2 c 3]
        Test::eq [len [Dict::keys $d]] 3
    }

    Test::case "Dict::values" {
        let d [dict a 1 b 2 c 3]
        Test::eq [len [Dict::values $d]] 3
    }

    Test::case "put updates dict" {
        var md [dict x 10]
        set! md [put $md x 20]
        Test::eq [get $md x] 20
        set! md [put $md y 30]
        Test::eq [get $md y] 30
        Test::eq [len $md] 2
    }

    Test::case "del removes key" {
        var md [dict x 10 y 20]
        set! md [del $md x]
        Test::eq [len $md] 1
        Test::false [has? $md x]
    }

    Test::case "empty dict" {
        let empty [dict]
        Test::eq [len $empty] 0
    }

    Test::case "nested dict" {
        let nested [dict outer [dict inner 42]]
        Test::eq [get [get $nested outer] inner] 42
    }

    Test::case "multi-line lambda inside dict literal" {
        ;; Regression test: multi-line lambda bodies in #{} dict literals
        ;; must preserve newlines inside braces for command separation
        let handlers #{
            process [lambda {x} {
                let doubled [* $x 2]
                let result [+ $doubled 5]
                $result
            }]
            transform [lambda {x} {
                let squared [* $x $x]
                $squared
            }]
        }
        ;; Verify the dict structure
        Test::eq [len $handlers] 2
        Test::true [has? $handlers process]
        Test::true [has? $handlers transform]
        ;; Call the lambdas and verify they work
        let fn1 [get $handlers process]
        let fn2 [get $handlers transform]
        Test::eq [$fn1 10] 25   ;; (10*2) + 5 = 25
        Test::eq [$fn2 5] 25    ;; 5*5 = 25
    }
}

;; ============================================================================
;; Control Flow: if/else
;; ============================================================================

Test::suite "If/Else" {
    Test::case "simple true" {
        var result 0
        if 1 { set! result 1 }
        Test::eq $result 1
    }

    Test::case "simple false" {
        var result 0
        if 0 { set! result 1 }
        Test::eq $result 0
    }

    Test::case "if-else with keyword" {
        var result {}
        if 0 { set! result yes } else { set! result no }
        Test::eq $result no
    }

    Test::case "if-else positional (no keyword)" {
        var result {}
        if 0 { set! result yes } { set! result no }
        Test::eq $result no
    }

    Test::case "nested if (replaces elseif)" {
        var result {}
        if 0 {
            set! result first
        } {
            if 1 {
                set! result second
            } {
                set! result third
            }
        }
        Test::eq $result second
    }

    Test::case "computed condition" {
        let x 5
        var result 0
        if [+ $x 0] { set! result 1 }
        Test::eq $result 1
    }

    Test::case "string truthiness" {
        var result 0
        if hello { set! result 1 }
        Test::eq $result 1
    }

    Test::case "empty string is false" {
        var result 0
        if {} { set! result 1 } else { set! result 2 }
        Test::eq $result 2
    }

    Test::case "if returns last value" {
        let result [if 1 { + 10 20 }]
        Test::eq $result 30
    }
}

;; ============================================================================
;; Control Flow: cond (multi-branch conditional)
;; ============================================================================

Test::suite "Cond" {
    Test::case "first truthy clause wins" {
        let result [cond 0 {first} 1 {second} else {default}]
        Test::eq $result "second"
    }

    Test::case "else clause when no match" {
        let result [cond 0 {first} 0 {second} else {default}]
        Test::eq $result "default"
    }

    Test::case "first clause matches" {
        let result [cond 1 {first} 1 {second} else {default}]
        Test::eq $result "first"
    }

    Test::case "cond with comparisons" {
        let n 5
        let result [cond
                    [== $n 0] {zero}
                    [< $n 0] {negative}
                    else {positive}]
        Test::eq $result "positive"
    }

    Test::case "cond with negative number" {
        let n -3
        let result [cond
                    [== $n 0] {zero}
                    [< $n 0] {negative}
                    else {positive}]
        Test::eq $result "negative"
    }

    Test::case "cond evaluates expression result" {
        let a 10
        let b 20
        let result [cond 0 {wrong} 1 [+ $a $b] else {default}]
        Test::eq $result 30
    }

    Test::case "cond short-circuits" {
        var counter 0
        proc inc_and_check {} {
            set! counter [+ $counter 1]
            0
        }
        ;; Only first two tests should be evaluated
        let result [cond [inc_and_check] {a} [inc_and_check] {b} 1 {c} [inc_and_check] {d}]
        Test::eq $result "c"
        Test::eq $counter 2
    }

    Test::case "cond without else errors on no match" {
        let errored [catch {cond 0 {a} 0 {b}}]
        Test::eq $errored 1
    }
}

;; ============================================================================
;; Control Flow: case (value dispatch)
;; ============================================================================

Test::suite "Case" {
    Test::case "basic string dispatch" {
        let op {add}
        let result [case $op {add} {addition} {sub} {subtraction} else {unknown}]
        Test::eq $result "addition"
    }

    Test::case "else clause when no match" {
        let op {div}
        let result [case $op {add} {addition} {sub} {subtraction} else {unknown}]
        Test::eq $result "unknown"
    }

    Test::case "numeric dispatch" {
        let code 404
        let result [case $code 200 {OK} 404 {Not Found} 500 {Error} else {Other}]
        Test::eq $result "Not Found"
    }

    Test::case "dispatch with variable as key" {
        let expected {mul}
        let op {mul}
        let result [case $op $expected {matched} else {not matched}]
        Test::eq $result "matched"
    }

    Test::case "case evaluates expression result" {
        let op {add}
        let num1 10
        let num2 5
        let result [case $op \
                        {add} [+ $num1 $num2] \
                        {sub} [- $num1 $num2] \
                        else {0}]
        Test::eq $result 15
    }

    Test::case "case short-circuits" {
        var counter 0
        proc inc_and_return {val} {
            set! counter [+ $counter 1]
            $val
        }
        let target {y}
        ;; Only first two keys should be evaluated before match
        let result [case $target \
                        [inc_and_return x] {X} \
                        [inc_and_return y] {Y} \
                        [inc_and_return z] {Z}]
        Test::eq $result "Y"
        Test::eq $counter 2
    }

    Test::case "case without else errors on no match" {
        let errored [catch {case {x} {a} {A} {b} {B}}]
        Test::eq $errored 1
    }

    Test::case "case with list equality" {
        let data [list 1 2 3]
        let result [case $data [list 1 2] {two} [list 1 2 3] {three} else {other}]
        Test::eq $result "three"
    }
}

;; ============================================================================
;; Control Flow: while
;; ============================================================================

Test::suite "While Loop" {
    Test::case "basic countdown" {
        var i 3
        var results [list]
        while $i {
            set! results [List::push $results $i]
            set! i [+ $i -1]
        }
        Test::eq $results [list 3 2 1]
    }

    Test::case "condition false initially" {
        var ran 0
        while 0 { set! ran 1 }
        Test::eq $ran 0
    }

    Test::case "while returns last body value" {
        var x 3
        let result [while $x { set! x [+ $x -1] }]
        Test::eq $result 0
    }
}

;; ============================================================================
;; Control Flow: for
;; ============================================================================

Test::suite "For Loop" {
    Test::case "basic for loop" {
        var results [list]
        for {var i 3} {$i} {set! i [+ $i -1]} {
            set! results [List::push $results $i]
        }
        Test::eq $results [list 3 2 1]
    }

    Test::case "condition false initially" {
        var ran 0
        for {var j 0} {$j} {set! j [+ $j -1]} {
            set! ran 1
        }
        Test::eq $ran 0
    }

    Test::case "for returns last body value" {
        let result [for {var m 3} {$m} {set! m [+ $m -1]} { $m }]
        Test::eq $result 1
    }
}

;; ============================================================================
;; Control Flow: foreach
;; ============================================================================

Test::suite "Foreach Loop" {
    Test::case "basic foreach" {
        var results [list]
        foreach x [list a b c] {
            set! results [List::push $results $x]
        }
        Test::eq $results [list a b c]
    }

    Test::case "foreach over list variable" {
        let items [list 1 2 3]
        var sum 0
        foreach item $items {
            set! sum [+ $sum $item]
        }
        Test::eq $sum 6
    }

    Test::case "empty list" {
        var ran 0
        foreach y [list] {
            set! ran 1
        }
        Test::eq $ran 0
    }

    Test::case "foreach returns last body value" {
        let result [foreach z [list x y z] { $z }]
        Test::eq $result z
    }
}

;; ============================================================================
;; Control Flow: break
;; ============================================================================

Test::suite "Break" {
    Test::case "break in while" {
        var i 5
        var results [list]
        while 1 {
            set! results [List::push $results $i]
            set! i [+ $i -1]
            if $i { } else { break }
        }
        Test::eq $results [list 5 4 3 2 1]
    }

    Test::case "break in for" {
        var count 0
        for {var j 1} {1} {set! j [+ $j 1]} {
            set! count [+ $count 1]
            break
        }
        Test::eq $count 1
    }

    Test::case "break in foreach" {
        var first {}
        foreach x [list a b c] {
            set! first $x
            break
        }
        Test::eq $first a
    }
}

;; ============================================================================
;; Control Flow: continue
;; ============================================================================

Test::suite "Continue" {
    Test::case "continue in while" {
        var i 3
        var results [list]
        while $i {
            let cur $i
            set! i [+ $i -1]
            if [== $cur 2] { continue }
            set! results [List::push $results $cur]
        }
        Test::eq $results [list 3 1]
    }

    Test::case "continue in for" {
        var results [list]
        for {var j 3} {$j} {set! j [+ $j -1]} {
            if [== $j 2] { continue }
            set! results [List::push $results $j]
        }
        Test::eq $results [list 3 1]
    }

    Test::case "continue in foreach" {
        var count 0
        foreach x [list a b c] {
            set! count [+ $count 1]
            continue
        }
        Test::eq $count 3
    }
}

;; ============================================================================
;; Error Handling
;; ============================================================================

Test::suite "Error Handling" {
    Test::case "catch success returns 0" {
        let caught [catch { + 1 2 }]
        Test::eq $caught 0
    }

    Test::case "catch error returns 1" {
        let caught [catch { error "test error" }]
        Test::eq $caught 1
    }

    Test::case "catch with result variable (success)" {
        if [catch { + 10 20 } res msg] {
            Test::assert 0
        } else {
            Test::eq $res 30
        }
    }

    Test::case "catch with error variable" {
        if [catch { error "my error" } res msg] {
            Test::eq $msg {my error}
        } else {
            Test::assert 0
        }
    }

    Test::case "catch nested error" {
        proc may_fail {x} {
            if [== $x 0] {
                error "cannot be zero"
            }
            return [+ $x 1]
        }
        if [catch { may_fail 0 } res msg] {
            Test::eq $msg {cannot be zero}
        } else {
            Test::assert 0
        }
    }

    Test::case "catch nested success" {
        proc may_fail2 {x} {
            if [== $x 0] {
                error "cannot be zero"
            }
            return [+ $x 1]
        }
        if [catch { may_fail2 5 } res msg] {
            Test::assert 0
        } else {
            Test::eq $res 6
        }
    }

    Test::case "catch unknown command returns 1" {
        let caught [catch { definitely_not_a_command 1 2 } res msg]
        Test::eq $caught 1
    }

    Test::case "catch traps syntax error in dynamic script" {
        let code {this is [syntactically bad}
        let caught [catch $code res msg]
        Test::eq $caught 1
        Test::assert [> [len $msg] 0]
    }

    Test::case "catch traps syntax error in braced literal" {
        let caught [catch {oops [unclosed} res msg]
        Test::eq $caught 1
    }

    Test::case "error variable empty on success" {
        let caught [catch { + 1 1 } res msg]
        Test::eq $caught 0
        Test::eq $msg {}
    }

    Test::case "result variable empty on failure" {
        let caught [catch { error "boom" } res msg]
        Test::eq $caught 1
        Test::eq $res {}
    }

    Test::case "nested catch: inner catches, outer sees success" {
        let outer [catch {
            let inner [catch { error "inner boom" } ires imsg]
            if [!= $inner 1] { error "inner did not catch" }
        } ores omsg]
        Test::eq $outer 0
    }

    Test::case "error state cleared after successful catch" {
        catch { error "transient" } res msg
        ;; a following command must evaluate cleanly
        Test::eq [+ 2 2] 4
    }

    Test::case "catch propagates substitution failure of its argument" {
        ;; $no_such_script fails while constructing the argument, before
        ;; catch owns a script; the outer catch observes that error.
        let outer [catch { catch $no_such_script res msg } ores omsg]
        Test::eq $outer 1
    }
}

;; ============================================================================
;; Type Inspection (type / repr / String::from)
;; ============================================================================

Test::suite "Type inspection and conversion" {
    Test::case "type names" {
        Test::eq [type "hello"] string
        Test::eq [type [+ 1 2]] int
        Test::eq [type [+ 1.5 1]] float
        Test::eq [type (1 2)] list
        Test::eq [type #{a 1}] dict
        Test::eq [type [ref 5]] cell
        Test::eq [type [lambda {} {1}]] proc
        Test::eq [type $List] namespace
    }

    Test::case "bare numeric literals are typed at compile time" {
        Test::eq [type 42] int
        Test::eq [type 3.14] float
        Test::eq [type [int 42]] int
        ;; quoting/bracing is the explicit "this is text" spelling
        Test::eq [type "42"] string
        Test::eq [type {42}] string
    }

    Test::case "repr distinguishes list from string" {
        let l (a b)
        let s "a b"
        Test::eq [repr $l] {("a" "b")}
        Test::eq [repr $s] {"a b"}
    }

    Test::case "repr of numbers and nesting" {
        Test::eq [repr [+ 1 2]] 3
        Test::eq [repr [list [+ 1 1] (x)]] {(2 ("x"))}
        Test::eq [repr #{k v}] {#{"k" "v"}}
    }

    Test::case "repr escapes quotes in strings" {
        ;; repr of the 3-char string a"b is the 6-char text "a\"b"
        Test::eq [len [repr {a"b}]] 6
    }

    Test::case "repr of cells and procs" {
        Test::eq [repr [ref [+ 1 1]]] {<cell 2>}
        proc repr_named {} { 1 }
        Test::eq [repr $repr_named] {<proc repr_named>}
        Test::eq [repr [lambda {} {1}]] {<lambda>}
    }

    Test::case "String::from converts explicitly" {
        let l (a b)
        let s [String::from $l]
        Test::eq [type $s] string
        Test::eq $s "a b"
        Test::eq [String::from [+ 1 2]] "3"
    }
}

;; ============================================================================
;; Short-Circuit and/or
;; ============================================================================

Test::suite "Short-circuit and/or" {
    Test::case "and returns first falsy operand" {
        Test::eq [and 1 0 2] 0
        Test::eq [and 1 {} 2] {}
    }

    Test::case "and returns final operand when all truthy" {
        Test::eq [and 1 2 3] 3
        Test::eq [and "a" "b"] "b"
    }

    Test::case "or returns first truthy operand" {
        Test::eq [or 0 {} 5 7] 5
    }

    Test::case "or returns final operand when all falsy" {
        Test::eq [or 0 {}] {}
        Test::eq [or {} 0] 0
    }

    Test::case "identities and single operand" {
        Test::eq [and] 1
        Test::eq [or] 0
        Test::eq [and 7] 7
        Test::eq [or {}] {}
    }

    Test::case "or as default-value idiom" {
        let configured ""
        let editor [or $configured "vi"]
        Test::eq $editor "vi"
    }

    Test::case "and short-circuits side effects" {
        var sc_hits 0
        proc sc_bump {} { set! sc_hits [+ $sc_hits 1]; return 1 }
        let r [and 0 [sc_bump]]
        Test::eq $r 0
        Test::eq $sc_hits 0
    }

    Test::case "or short-circuits side effects" {
        var sc_hits2 0
        proc sc_bump2 {} { set! sc_hits2 [+ $sc_hits2 1]; return 1 }
        let r [or 5 [sc_bump2]]
        Test::eq $r 5
        Test::eq $sc_hits2 0
    }

    Test::case "later operands do evaluate when reached" {
        var sc_hits3 0
        proc sc_bump3 {} { set! sc_hits3 [+ $sc_hits3 1]; return 9 }
        let r [and 1 [sc_bump3]]
        Test::eq $r 9
        Test::eq $sc_hits3 1
    }

    Test::case "and guards out-of-bounds indexing" {
        let xs (1 2 3)
        let i 5
        let r [and [< $i [len $xs]] [get $xs $i]]
        Test::eq $r 0
    }

    Test::case "@ spread is rejected" {
        let sc_conds (1 1)
        let caught [catch { and @$sc_conds } res msg]
        Test::eq $caught 1
    }

    Test::case "operand error propagates" {
        let caught [catch { or 0 [no_such_proc_xyz 1] } res msg]
        Test::eq $caught 1
    }
}

;; ============================================================================
;; Arity Diagnostics
;; ============================================================================

Test::suite "Arity Diagnostics" {
    Test::case "too many args names the proc" {
        proc sq_arity {x} { * $x $x }
        let caught [catch { sq_arity 1 2 } res msg]
        Test::eq $caught 1
        Test::eq $msg {sq_arity: expected 1 argument, got 2}
    }

    Test::case "too few args" {
        proc add_arity {a b} { + $a $b }
        catch { add_arity 1 } res msg
        Test::eq $msg {add_arity: expected 2 arguments, got 1}
    }

    Test::case "zero-param proc" {
        proc noargs_arity {} { 42 }
        catch { noargs_arity 1 } res msg
        Test::eq $msg {noargs_arity: expected 0 arguments, got 1}
    }

    Test::case "range with optional params" {
        proc rng_arity {a (b 2) (c 3)} { + $a $b }
        catch { rng_arity 1 2 3 4 } res msg
        Test::eq $msg {rng_arity: expected 1 to 3 arguments, got 4}
    }

    Test::case "rest param reports at-least" {
        proc rest_arity {a b *rest} { + $a $b }
        catch { rest_arity 1 } res msg
        Test::eq $msg {rest_arity: expected at least 2 arguments, got 1}
    }

    Test::case "alias reports invoked name, not definition name" {
        proc canonical_arity {x} { $x }
        let alias_arity $canonical_arity
        catch { alias_arity 1 2 } res msg
        Test::eq $msg {alias_arity: expected 1 argument, got 2}
    }
}

;; ============================================================================
;; @ Expansion Operator
;; ============================================================================

Test::suite "@ Expansion Operator" {
    Test::case "expand list to operator" {
        let nums [list 1 2 3 4 5]
        Test::eq [+ @$nums] 15
    }

    Test::case "expand in list construction" {
        let a [list 1 2]
        let b [list 3 4]
        let combined [list @$a @$b]
        Test::eq $combined [list 1 2 3 4]
    }

    Test::case "expand single value" {
        let single 42
        Test::eq [+ 1 @$single] 43
    }

    Test::case "expand empty list" {
        let empty [list]
        let result [list a @$empty b]
        Test::eq $result [list a b]
    }

    Test::case "expand in proc arguments" {
        proc sum3 {a b c} { + $a [+ $b $c] }
        let args [list 10 20 30]
        Test::eq [sum3 @$args] 60
    }

    Test::case "multiple expansions" {
        let x [list 1 2]
        let y [list 3 4]
        Test::eq [+ @$x @$y] 10
    }
}

;; ============================================================================
;; Equality Operators
;; ============================================================================

Test::suite "Equality Operators" {
    Test::case "== value equality" {
        Test::true [== 1 1]
        Test::false [== 1 2]
        Test::true [== hello hello]
        Test::false [== hello world]
    }

    Test::case "numeric promotion" {
        Test::true [== 1 1.0]
    }

    Test::case "list deep equality" {
        let l1 [list 1 2 3]
        let l2 [list 1 2 3]
        let l3 [list 1 2 4]
        Test::true [== $l1 $l2]
        Test::false [== $l1 $l3]
    }

    Test::case "dict deep equality" {
        let d1 [dict a 1 b 2]
        let d2 [dict a 1 b 2]
        let d3 [dict a 1 b 3]
        Test::true [== $d1 $d2]
        Test::false [== $d1 $d3]
    }

    Test::case "!= inequality" {
        Test::false [!= 1 1]
        Test::true [!= 1 2]
    }

    Test::case "same? identity" {
        let x 42
        Test::true [same? $x $x]
        let y 42
        Test::false [same? $x $y]
    }

    Test::case "cell? predicate" {
        Test::true [cell? [ref 1]]
        Test::false [cell? 1]
    }

    Test::case "same-binding? for cells" {
        var p 100
        var q 200
        Test::true [same-binding? p p]
        Test::false [same-binding? p q]
    }
}

;; ============================================================================
;; Equality with Control Flow
;; ============================================================================

Test::suite "Equality with Control Flow" {
    Test::case "while with != condition" {
        var i 5
        var target 2
        while [!= $i $target] {
            set! i [+ $i -1]
        }
        Test::eq $i $target
    }

    Test::case "for loop with list comparison" {
        var built [list]
        for {var j 1} {[!= $j 4]} {set! j [+ $j 1]} {
            set! built [List::push $built $j]
        }
        Test::eq $built [list 1 2 3]
    }

    Test::case "foreach find matching element" {
        let haystack [list apple banana cherry date]
        var found 0
        foreach item $haystack {
            if [== $item cherry] {
                set! found 1
                break
            }
        }
        Test::eq $found 1
    }

    Test::case "foreach filter with !=" {
        var kept [list]
        foreach x [list a skip b skip c] {
            if [!= $x skip] {
                set! kept [List::push $kept $x]
            }
        }
        Test::eq $kept [list a b c]
    }

    Test::case "continue with equality check" {
        var sum 0
        foreach n [list 1 2 3 4 5] {
            if [== $n 3] {
                continue
            }
            set! sum [+ $sum $n]
        }
        Test::eq $sum 12
    }
}

;; ============================================================================
;; Lexical Scoping
;; ============================================================================

Test::suite "Lexical Scoping" {
    Test::case "closure captures outer variable" {
        let outer 100
        proc get_outer {} {
            $outer
        }
        Test::eq [get_outer] 100
    }

    Test::case "shadowing" {
        let shadow outer
        proc test_shadow {} {
            let shadow inner
            $shadow
        }
        Test::eq [test_shadow] inner
        Test::eq $shadow outer
    }

    Test::case "closure captures value at definition time" {
        let capture_val A
        proc capture_test {} {
            $capture_val
        }
        let capture_val B
        Test::eq [capture_test] A
    }

    Test::case "cell mutation through closure" {
        var counter 0
        proc incr_counter {} {
            set! counter [+ $counter 1]
            $counter
        }
        Test::eq [incr_counter] 1
        Test::eq [incr_counter] 2
        Test::eq $counter 2
    }

    Test::case "multiple closures sharing cell" {
        var shared 0
        proc add_to_shared {n} {
            set! shared [+ $shared $n]
        }
        proc get_shared {} {
            $shared
        }
        add_to_shared 10
        add_to_shared 5
        Test::eq [get_shared] 15
    }

    Test::case "nested closures" {
        proc make_adder {x} {
            lambda {y} {
                + $x $y
            }
        }
        let add5 [make_adder 5]
        let add10 [make_adder 10]
        Test::eq [$add5 3] 8
        Test::eq [$add10 3] 13
    }

    Test::case "counter factory - independent counters" {
        proc make_counter {} {
            var n 0
            lambda {} {
                set! n [+ $n 1]
                $n
            }
        }
        let c1 [make_counter]
        let c2 [make_counter]
        Test::eq [apply $c1] 1
        Test::eq [apply $c1] 2
        Test::eq [apply $c2] 1
    }

    Test::case "proc parameter shadows outer" {
        let param_test outer_value
        proc param_shadow {param_test} {
            $param_test
        }
        Test::eq [param_shadow inner_value] inner_value
        Test::eq $param_test outer_value
    }

    Test::case "closures capture each iteration value" {
        var closures [list]
        foreach iter_val [list 1 2 3] {
            set! closures [List::push $closures [lambda {} { $iter_val }]]
        }
        Test::eq [apply [get $closures 0]] 1
        Test::eq [apply [get $closures 1]] 2
        Test::eq [apply [get $closures 2]] 3
    }

    Test::case "mutual recursion is rejected" {
        ;; Mutual recursion via cells creates reference cycles that cannot
        ;; be freed with reference counting (no GC). Both cells exist before
        ;; either lambda is created, so both lambdas capture both cells:
        ;;   cell_A -> lambda_A -> cell_B -> lambda_B -> cell_A  (cycle!)
        ;; LCL detects and rejects this at set! time.
        var is_even_fn {}
        var is_odd_fn {}
        set! is_even_fn [lambda {n} {
            if [== $n 0] { return 1 }
            [$is_odd_fn [+ $n -1]]
        }]
        ;; This should fail - is_odd_fn captures is_even_fn which captures is_odd_fn
        Test::raises {
            set! is_odd_fn [lambda {n} {
                if [== $n 0] { return 0 }
                [$is_even_fn [+ $n -1]]
            }]
        }
    }

    Test::case "proc mutual recursion works (no cycle)" {
        ;; Unlike var/set!, sequential proc definitions do NOT create
        ;; reference cycles. When even? is defined, odd? doesn't exist
        ;; yet, so it's skipped during upvalue capture (forward reference).
        ;; odd? captures even? as an upvalue. The reference graph is a DAG:
        ;;   odd? -> even?  (one-way, no cycle)
        ;; At runtime, even? finds odd? through the caller's frame chain.
        proc mr_even? {n} {
            if [== $n 0] { return 1 }
            mr_odd? [- $n 1]
        }
        proc mr_odd? {n} {
            if [== $n 0] { return 0 }
            mr_even? [- $n 1]
        }
        Test::eq [mr_even? 0] 1
        Test::eq [mr_even? 1] 0
        Test::eq [mr_even? 4] 1
        Test::eq [mr_odd? 0] 0
        Test::eq [mr_odd? 1] 1
        Test::eq [mr_odd? 5] 1
        Test::eq [mr_odd? 13] 1
    }

    Test::case "proc mutual recursion hits depth limit" {
        ;; Mutual recursion is NOT tail-call optimized (TCO only applies
        ;; to self-recursive calls). Each mutual call consumes a stack
        ;; frame, so deep mutual recursion hits the max depth (1024).
        proc deep_even? {n} {
            if [== $n 0] { return 1 }
            deep_odd? [- $n 1]
        }
        proc deep_odd? {n} {
            if [== $n 0] { return 0 }
            deep_even? [- $n 1]
        }
        Test::raises {
            deep_even? 2000
        }
    }
}

;; ============================================================================
;; Threading Operators
;; ============================================================================

Test::suite "Threading Operators" {
    Test::case "-> thread-first with get" {
        let d [dict a 1 b 2 c 3]
        Test::eq [-> $d {get b}] 2
    }

    Test::case "-> chained" {
        let d [dict a 1 b 2]
        let d2 [-> $d {put c 3} {del a}]
        Test::true [has? $d2 c]
        Test::false [has? $d2 a]
    }

    Test::case "-> identity" {
        Test::eq [-> 42] 42
    }

    Test::case "-> with String::upper" {
        Test::eq [-> hello {String::upper}] HELLO
    }

    Test::case "->> thread-last" {
        proc greet {greeting name} {
            return "$greeting, $name!"
        }
        Test::eq [->> World {greet Hello}] {Hello, World!}
    }

    Test::case "->> identity" {
        Test::eq [->> hello] hello
    }

    Test::case "-> with lambda" {
        let inc [lambda {x} {+ $x 1}]
        Test::eq [-> 10 {$inc}] 11
    }

    Test::case "-> with inline lambda" {
        Test::eq [-> 10 {[lambda {x} {+ $x 100}]}] 110
    }

    Test::case "-> return propagates value from enclosing proc" {
        proc t {} { -> 5 return; puts "unreached" }
        Test::eq [t] 5
    }

    Test::case "->> return propagates value from enclosing proc" {
        proc t2 {} { ->> 7 return; puts "unreached" }
        Test::eq [t2] 7
    }
}

;; ============================================================================
;; Functional Primitives
;; ============================================================================

Test::suite "Functional Primitives" {
    Test::case "List::map" {
        let lst [list 1 2 3 4 5]
        let doubled [List::map $lst [lambda {x} {* $x 2}]]
        Test::eq $doubled [list 2 4 6 8 10]
    }

    Test::case "List::filter" {
        let lst [list 1 2 3 4 5]
        let evens [List::filter $lst [lambda {x} {== [% $x 2] 0}]]
        Test::eq $evens [list 2 4]
    }

    Test::case "List::reduce" {
        let lst [list 1 2 3 4 5]
        let sum [List::reduce $lst 0 [lambda {acc x} {+ $acc $x}]]
        Test::eq $sum 15
    }

    Test::case "Dict::map" {
        let d [dict a 1 b 2 c 3]
        let mapped [Dict::map $d [lambda {k v} {* $v 10}]]
        Test::eq [len [Dict::keys $mapped]] 3
    }

    Test::case "Dict::filter" {
        let d [dict a 1 b 2 c 3]
        let filtered [Dict::filter $d [lambda {k v} {> $v 1}]]
        Test::eq [len [Dict::keys $filtered]] 2
    }

    Test::case "Dict::reduce" {
        let d [dict a 1 b 2 c 3]
        let sum [Dict::reduce $d 0 [lambda {acc k v} {+ $acc $v}]]
        Test::eq $sum 6
    }
}

;; ============================================================================
;; List:: Namespace Functions
;; ============================================================================

Test::suite "List:: Namespace" {
    Test::case "List::new" {
        Test::eq [List::new a b c] [list a b c]
    }

    Test::case "List::push" {
        Test::eq [List::push [list 1 2] 3] [list 1 2 3]
        Test::eq [List::push [list] x] [list x]
    }

    Test::case "List::pop" {
        Test::eq [List::pop [list a b c]] [list a b]
        Test::eq [len [List::pop [list x]]] 0
    }

    Test::case "List::slice" {
        Test::eq [List::slice [list a b c d e] 1 4] [list b c d]
        Test::eq [List::slice [list 1 2 3 4 5] 0 3] [list 1 2 3]
    }

    Test::case "List::concat" {
        Test::eq [List::concat [list a b] [list c d]] [list a b c d]
        Test::eq [List::concat [list 1 2] [list]] [list 1 2]
    }

    Test::case "List::reverse" {
        Test::eq [List::reverse [list 1 2 3 4]] [list 4 3 2 1]
        Test::eq [List::reverse [list x]] [list x]
        Test::eq [len [List::reverse [list]]] 0
    }

    Test::case "List::index" {
        Test::eq [List::index [list a b c d] 2] c
    }

    Test::case "List::range" {
        Test::eq [List::range 1 5] [list 1 2 3 4]
        Test::eq [List::range 0 10 2] [list 0 2 4 6 8]
        Test::eq [List::range 5 0 -1] [list 5 4 3 2 1]
        Test::eq [len [List::range 5 5]] 0
    }

    Test::case "List::sort" {
        let sorted [List::sort [list banana apple cherry]]
        Test::eq [get $sorted 0] apple
        Test::eq [get $sorted 1] banana
        Test::eq [get $sorted 2] cherry
    }

    Test::case "List::sort orders numbers numerically" {
        Test::eq [List::sort (10 9 2)] (2 9 10)
        Test::eq [List::sort (2.5 10 -3)] (-3 2.5 10)
    }

    Test::case "List::sort_with takes a comparator" {
        let nums [list 10 2 5 1 20]
        let cmp [lambda {a b} { if [< $a $b] { return -1 }; if [> $a $b] { return 1 }; return 0 }]
        let sorted [List::sort_with $nums $cmp]
        Test::eq $sorted [list 1 2 5 10 20]
    }

    Test::case "List::sort_with descending" {
        let cmp [lambda {a b} { if [> $a $b] { return -1 }; if [< $a $b] { return 1 }; return 0 }]
        Test::eq [List::sort_with (3 1 2) $cmp] (3 2 1)
    }

    Test::case "List::sort_with comparator error propagates" {
        let cmp [lambda {a b} { error "bad comparator" }]
        let caught [catch { List::sort_with $cmp (3 1 2) } res msg]
        Test::eq $caught 1
    }

    Test::case "List::sort_by takes a key function" {
        let rows [list (bob 30) (amy 25) (cal 28)]
        let by_age [List::sort_by $rows [lambda {r} {get $r 1}]]
        Test::eq $by_age [list (amy 25) (cal 28) (bob 30)]
    }

    Test::case "List::sort_by calls keyfn once per element" {
        var key_calls 0
        proc count_key {x} { set! key_calls [+ $key_calls 1]; return $x }
        let sorted [List::sort_by (4 2 3 1 5) $count_key]
        Test::eq $sorted (1 2 3 4 5)
        Test::eq $key_calls 5
    }

    Test::case "sorts are stable (layered ordering)" {
        let rows [list (bob 2) (amy 1) (ann 1)]
        let by_name [List::sort_by $rows [lambda {r} {get $r 0}]]
        ;; amy ann bob; then a stable sort on priority keeps amy before ann
        let by_prio [List::sort_by $by_name [lambda {r} {get $r 1}]]
        Test::eq $by_prio [list (amy 1) (ann 1) (bob 2)]
    }

    Test::case "List::sort_by keyfn error propagates" {
        let caught [catch { List::sort_by [lambda {x} { error "bad key" }] (1 2) } res msg]
        Test::eq $caught 1
    }

    Test::case "List::find" {
        let lst [list 1 5 10 15 20]
        Test::eq [List::find $lst [lambda {x} {> $x 8}]] 10
        Test::empty [List::find $lst [lambda {x} {> $x 100}]]
    }

    Test::case "List::any?" {
        let lst [list 1 2 3 4 5]
        Test::true [List::any? $lst [lambda {x} {> $x 4}]]
        Test::false [List::any? $lst [lambda {x} {> $x 100}]]
        Test::false [List::any? () [lambda {x} {== $x 1}]]
    }

    Test::case "List::all?" {
        let lst [list 1 2 3 4 5]
        Test::true [List::all? $lst [lambda {x} {> $x 0}]]
        Test::false [List::all? $lst [lambda {x} {> $x 3}]]
        Test::true [List::all? () [lambda {x} {== $x impossible}]]
    }

    Test::case "List::unique" {
        let dupes [list a b a c b d a]
        let unique [List::unique $dupes]
        Test::eq [len $unique] 4
        Test::eq [get $unique 0] a
        Test::eq [get $unique 1] b
        Test::eq [get $unique 2] c
        Test::eq [get $unique 3] d
    }

    Test::case "List::flatten" {
        let nested [list [list 1 2] [list 3 4] 5]
        let flat [List::flatten $nested]
        Test::eq [len $flat] 5
        Test::eq [get $flat 0] 1
        Test::eq [get $flat 4] 5
    }

    Test::case "List::flatten recurses to any depth" {
        let nested [list a [list b [list c [list d e]]] f]
        let flat [List::flatten $nested]
        Test::eq [len $flat] 6
        Test::eq [get $flat 0] a
        Test::eq [get $flat 3] d
        Test::eq [get $flat 5] f

        ;; empty sublists vanish at every depth
        Test::eq [len [List::flatten [list [list] [list 1 [list]] 2]]] 2

        ;; flattening an empty list
        Test::eq [len [List::flatten [list]]] 0
    }

    Test::case "List::flatten optional depth" {
        let nested [list a [list b [list c [list d]]]]

        ;; depth 0: unchanged
        let d0 [List::flatten $nested 0]
        Test::eq [len $d0] 2
        Test::eq [type [get $d0 1]] list

        ;; depth 1: one level unwrapped
        let d1 [List::flatten $nested 1]
        Test::eq [len $d1] 3
        Test::eq [get $d1 1] b
        Test::eq [type [get $d1 2]] list

        ;; depth 2
        let d2 [List::flatten $nested 2]
        Test::eq [len $d2] 4
        Test::eq [get $d2 2] c
        Test::eq [type [get $d2 3]] list

        ;; depth beyond actual nesting: same as full
        Test::eq [len [List::flatten $nested 99]] 4

        ;; negative depth: unlimited (same as omitted)
        let dn [List::flatten $nested -1]
        Test::eq [len $dn] 4
        Test::eq [get $dn 3] d

        ;; non-integer depth errors
        Test::eq [catch { List::flatten $nested bogus }] 1
    }

    Test::case "List::flatten deep nesting does not overflow" {
        var deep [list 42]
        var i 0
        while {[< $i 10000]} {
            set! deep [list $deep]
            set! i [+ $i 1]
        }
        let flat [List::flatten $deep]
        Test::eq [len $flat] 1
        Test::eq [get $flat 0] 42
    }
}

;; ============================================================================
;; Dict:: Namespace Functions
;; ============================================================================

Test::suite "Dict:: Namespace" {
    Test::case "Dict::new" {
        let d [Dict::new x 1 y 2]
        Test::eq [len $d] 2
        Test::eq [get $d x] 1
    }

    Test::case "Dict::keys" {
        Test::eq [len [Dict::keys [dict a 1 b 2 c 3]]] 3
    }

    Test::case "Dict::values" {
        Test::eq [len [Dict::values [dict a 10 b 20 c 30]]] 3
    }

    Test::case "Dict::items" {
        let items [Dict::items [dict x 1 y 2]]
        Test::eq [len $items] 2
        Test::eq [len [get $items 0]] 2
    }

    Test::case "Dict::merge" {
        let d1 [dict a 1 b 2]
        let d2 [dict b 20 c 30]
        let merged [Dict::merge $d1 $d2]
        Test::eq [len $merged] 3
        Test::eq [get $merged a] 1
        Test::eq [get $merged b] 20
        Test::eq [get $merged c] 30
    }

    Test::case "Dict::map" {
        let mapped [Dict::map [dict a 1 b 2 c 3] [lambda {k v} {* $v 2}]]
        Test::eq [get $mapped a] 2
        Test::eq [get $mapped b] 4
        Test::eq [get $mapped c] 6
    }

    Test::case "Dict::filter" {
        let filtered [Dict::filter [dict a 1 b 2 c 3] [lambda {k v} {> $v 1}]]
        Test::eq [len [Dict::keys $filtered]] 2
        Test::false [has? $filtered a]
        Test::true [has? $filtered b]
    }

    Test::case "Dict::reduce" {
        let sum [Dict::reduce [dict a 1 b 2 c 3] 0 [lambda {acc k v} {+ $acc $v}]]
        Test::eq $sum 6
    }
}

;; ============================================================================
;; String:: Namespace Functions
;; ============================================================================

Test::suite "String:: Namespace" {
    Test::case "String::upper" {
        Test::eq [String::upper hello] HELLO
        Test::eq [String::upper HeLLo] HELLO
        Test::eq [String::upper abc123] ABC123
    }

    Test::case "String::lower" {
        Test::eq [String::lower HELLO] hello
        Test::eq [String::lower HeLLo] hello
        Test::eq [String::lower ABC123] abc123
    }

    Test::case "String::find" {
        Test::eq [String::find hello ll] 2
        Test::eq [String::find hello h] 0
        Test::eq [String::find hello o] 4
        Test::eq [String::find hello xyz] -1
    }

    Test::case "String::replace" {
        Test::eq [String::replace hello ll LL] heLLo
        Test::eq [String::replace hello he HE] HEllo
        Test::eq [String::replace hello lo LO] helLO
        Test::eq [String::replace hello ll {}] heo
        Test::eq [String::replace hello xyz ZZZ] hello
    }

    Test::case "String::split" {
        Test::eq [String::split "a,b,c" ","] [list a b c]
        Test::eq [len [String::split hello ","]] 1
    }

    Test::case "String::join" {
        Test::eq [String::join [list a b c] -] a-b-c
        Test::eq [String::join [list x y z] {}] xyz
        Test::eq [String::join [list 1 2 3] ", "] {1, 2, 3}
        Test::eq [String::join [list only] -] only
        Test::eq [String::join [list] -] {}
    }

    Test::case "String::length" {
        Test::eq [String::length hello] 5
        Test::eq [String::length {}] 0
        Test::eq [String::length "hello world"] 11
    }

    Test::case "String::index" {
        Test::eq [String::index hello 0] h
        Test::eq [String::index hello 4] o
        Test::eq [String::index hello -1] o
        Test::eq [String::index hello -2] l
    }

    Test::case "String::range" {
        Test::eq [String::range hello 1 4] ell
        Test::eq [String::range hello 0 2] he
        Test::eq [String::range hello 0 -1] hell
        Test::eq [String::range hello -3 -1] ll
    }

    Test::case "String::trim" {
        Test::eq [String::trim "  hello  "] hello
        Test::eq [String::trim "\thello\n"] hello
        Test::eq [String::trim hello] hello
        Test::eq [String::trim "   "] {}
    }
}

;; ============================================================================
;; Tail Call Optimization
;; ============================================================================

Test::suite "Tail Call Optimization" {
    Test::case "deep self-recursion doesn't overflow" {
        proc count {n} {
            if [== $n 0] { 0 } else { [count [- $n 1]] }
        }
        ;; Would overflow without TCO (default max_depth is 1024)
        Test::eq [count 5000] 0
    }

    Test::case "tail position in if branch" {
        proc factorial {n acc} {
            if [<= $n 1] { $acc } else { [factorial [- $n 1] [* $n $acc]] }
        }
        Test::eq [factorial 10 1] 3628800
    }

    Test::case "named lambda gets TCO" {
        let sum_to [lambda sum_to {n acc} {
            if [== $n 0] { $acc } else { [sum_to [- $n 1] [+ $n $acc]] }
        }]
        Test::eq [sum_to 1000 0] 500500
    }

    Test::case "non-tail call still works" {
        proc sum {n} {
            if [== $n 0] { 0 } else { [+ $n [sum [- $n 1]]] }
        }
        ;; Not a tail call - + happens after recursive call
        Test::eq [sum 10] 55
    }

    Test::case "anonymous lambda no TCO" {
        ;; Anonymous lambdas have no self_name so can't do TCO
        ;; This should work for small n but would overflow for large n
        let anon [lambda {n} {
            if [== $n 0] { $n } else { [$anon [- $n 1]] }
        }]
        Test::eq [$anon 10] 0
    }
}

;; ============================================================================
;; Type Conversion
;; ============================================================================

Test::suite "Type Conversion" {
    Test::case "int from integer string" {
        Test::eq [int 42] 42
        Test::eq [int -10] -10
        Test::eq [int 0] 0
    }

    Test::case "int from float string truncates" {
        Test::eq [int 3.14] 3
        Test::eq [int 3.99] 3
        Test::eq [int -2.7] -2
    }

    Test::case "int from float value truncates" {
        let f [float 3.14]
        Test::eq [int $f] 3
    }

    Test::case "int preserves int value" {
        let i [int 42]
        Test::eq [int $i] 42
        Test::true [int? [int 42]]
    }

    Test::case "float from float string" {
        let f [float 3.14]
        Test::true [float? $f]
    }

    Test::case "float from integer" {
        let f [float 42]
        Test::true [float? $f]
    }

    Test::case "float preserves float value" {
        let f [float 3.14]
        Test::true [float? [float $f]]
    }

    Test::case "numeric sort ascending" {
        let nums [list 1 10 2 20 3]
        let sorted [List::sort_with $nums [lambda {a b} { - [int $a] [int $b] }]]
        Test::eq [get $sorted 0] 1
        Test::eq [get $sorted 1] 2
        Test::eq [get $sorted 2] 3
        Test::eq [get $sorted 3] 10
        Test::eq [get $sorted 4] 20
    }

    Test::case "numeric sort descending" {
        let nums [list 1 10 2 20 3]
        let sorted [List::sort_with $nums [lambda {a b} { - [int $b] [int $a] }]]
        Test::eq [get $sorted 0] 20
        Test::eq [get $sorted 1] 10
        Test::eq [get $sorted 2] 3
        Test::eq [get $sorted 3] 2
        Test::eq [get $sorted 4] 1
    }
}

;; ============================================================================
;; Quasiquote
;; ============================================================================

Test::suite "Quasiquote" {
    Test::case "basic unquote with variable" {
        let x 42
        Test::eq [quasiquote {value is ,$x}] {value is 42}
    }

    Test::case "unquote with command substitution" {
        Test::eq [quasiquote {sum is ,[+ 1 2 3]}] {sum is 6}
    }

    Test::case "splice-unquote with string" {
        let items {a b c}
        Test::eq [quasiquote {list: ,@$items end}] {list: a b c end}
    }

    Test::case "splice-unquote with list value" {
        let mylist [list x y z]
        Test::eq [quasiquote {items: ,@$mylist done}] {items: x y z done}
    }

    Test::case "braced literal unquote" {
        ;; ,{...} inserts the literal text
        Test::eq [quasiquote {result: ,{name}}] {result: name}
    }

    Test::case "multiple unquotes" {
        let a 1
        let b 2
        Test::eq [quasiquote {a=,$a b=,$b}] {a=1 b=2}
    }

    Test::case "unquote with computed value" {
        let a 10
        let b 20
        Test::eq [quasiquote {total: ,[+ $a $b]}] {total: 30}
    }

    Test::case "defun macro pattern" {
        ;; Macro returns code, caller evals it
        proc defun {name params body} {
            return [quasiquote {
                proc ,$name {,@$params} {,$body}
            }]
        }
        eval [defun add2 {x y} { + $x $y }]
        Test::eq [add2 3 4] 7
    }

    Test::case "backslash preserves comma" {
        let x 42
        Test::eq [quasiquote {value is \,x}] {value is ,x}
    }

    Test::case "nested quasiquote passes comma through" {
        ;; At depth 2, a single comma should be preserved as literal
        let x 42
        Test::eq [quasiquote {quasiquote {value is ,$x}}] {quasiquote {value is ,$x}}
    }

    Test::case "nested quasiquote with double comma" {
        ;; At depth 2, ,, evaluates outer and preserves inner comma
        ;; Simple values like 42 become bare words (,42), not braced
        let x 42
        Test::eq [quasiquote {quasiquote {value is ,,$x}}] {quasiquote {value is ,42}}
    }

    Test::case "list literal in unquote" {
        ;; ,(a b c) evaluates list literal
        Test::eq [quasiquote {items: ,(a b c)}] {items: a b c}
    }

    Test::case "dict literal in unquote" {
        ;; ,#{...} evaluates dict literal
        let d [quasiquote {data: ,#{name test val 123}}]
        ;; The dict will be stringified - "name" is at position 6
        Test::eq [String::find $d "name"] 6
    }

    Test::case "unquote of value that names a proc" {
        ;; Regression: ,$var must do variable substitution, NOT command
        ;; dispatch. If the value's string form happens to match a callable
        ;; name, qq_build previously evaluated the unquote text as a
        ;; one-word program, which dispatched the proc with zero args and
        ;; raised "too few arguments" mid-expansion.
        proc GET {url} { return $url }
        let danger "GET"
        Test::eq [quasiquote {method ,$danger}] {method GET}
    }

    Test::case "unquote of value that names a builtin" {
        ;; Same regression, exercised against a built-in command name.
        let danger "puts"
        Test::eq [quasiquote {cmd ,$danger}] {cmd puts}
    }
}

;; ============================================================================
;; Multiline Subcommands
;; ============================================================================

Test::suite "Multiline Subcommands" {
    Test::case "multiline list inside brackets" {
        ;; Inside [...], newlines are whitespace - no backslash needed
        let result [list
            a
            b
            c
        ]
        Test::eq [len $result] 3
        Test::eq [get $result 0] a
        Test::eq [get $result 1] b
        Test::eq [get $result 2] c
    }

    Test::case "nested subcommands across lines" {
        ;; This was the original bug - only the last element was kept
        let result [list
            [list x y]
            [list p q]
            [list m n]
        ]
        Test::eq [len $result] 3
        Test::eq [get $result 0] [list x y]
        Test::eq [get $result 1] [list p q]
        Test::eq [get $result 2] [list m n]
    }

    Test::case "multiline case inside brackets" {
        let op {add}
        let a 10
        let b 5
        let result [case $op
            {add} [+ $a $b]
            {sub} [- $a $b]
            {mul} [* $a $b]
            else  0]
        Test::eq $result 15
    }

    Test::case "multiline cond inside brackets" {
        let x 5
        let result [cond
            [< $x 0]   {negative}
            [== $x 0]  {zero}
            else       {positive}]
        Test::eq $result positive
    }

    Test::case "semicolons inside braces preserved" {
        ;; Semicolons inside {...} must NOT be converted to spaces
        let script {echo hello; echo world}
        Test::eq $script {echo hello; echo world}
    }

    Test::case "semicolons inside braces in subcommand" {
        ;; Even inside [...], braced content keeps its semicolons
        let result [list {a; b} {c; d}]
        Test::eq [get $result 0] {a; b}
        Test::eq [get $result 1] {c; d}
    }

    Test::case "newlines inside quotes preserved" {
        let text "line1
line2"
        Test::eq [String::find $text "\n"] 5
    }

    Test::case "bare command needs backslash continuation" {
        ;; This tests that backslash continuation still works
        let result [list \
            item1 \
            item2 \
            item3]
        Test::eq [len $result] 3
    }

    Test::case "nested brackets with multiline" {
        ;; Deeply nested multiline expressions
        let result [list
            [dict
                a 1
                b 2]
            [dict
                c 3
                d 4]]
        Test::eq [len $result] 2
        Test::eq [get [get $result 0] a] 1
        Test::eq [get [get $result 1] d] 4
    }

    Test::case "multiline with list literals" {
        let result [list
            (nested list)
            (another one)
        ]
        Test::eq [len $result] 2
        Test::eq [get $result 0] (nested list)
    }

    Test::case "eval with multiline block" {
        ;; eval {...} with multiple statements still works
        let result [eval {
            let a 10
            let b 20
            + $a $b
        }]
        Test::eq $result 30
    }
}

;; ============================================================================
;; Optional Parameters
;; ============================================================================

Test::suite "Optional Parameters" {
    Test::case "optional with default" {
        proc greet {name (greeting "Hello")} {
            "$greeting, $name!"
        }
        Test::eq [greet "World"] "Hello, World!"
        Test::eq [greet "Alice" "Hi"] "Hi, Alice!"
    }

    Test::case "multiple optionals" {
        proc range_opts {(start 0) (end 10) (step 1)} {
            list $start $end $step
        }
        Test::eq [range_opts] (0 10 1)
        Test::eq [range_opts 5] (5 10 1)
        Test::eq [range_opts 5 20] (5 20 1)
        Test::eq [range_opts 5 20 2] (5 20 2)
    }

    Test::case "default references earlier param" {
        proc range_end {start (end [+ $start 10])} {
            list $start $end
        }
        Test::eq [range_end 5] (5 15)
        Test::eq [range_end 5 20] (5 20)
    }

    Test::case "default evaluated per call" {
        var counter 0
        proc incr {} { set! counter [+ $counter 1]; $counter }
        proc next_id {(id [incr])} { $id }
        Test::eq [next_id] 1
        Test::eq [next_id] 2
        Test::eq [next_id 99] 99
        Test::eq [next_id] 3
    }

    Test::case "optional with default should work with lambdas" {
        let greet [lambda {name (greeting "Hello")} {
            "$greeting, $name!"
        }]

        Test::eq [greet "world"] "Hello, world!"
        Test::eq [greet "Alice" "Hi"] "Hi, Alice!"
    }

    Test::case "multiple optionals with lambdas" {
        let range_opts [lambda {(start 0) (end 10) (step 1)} {
            list $start $end $step
        }]

        Test::eq [range_opts] (0 10 1)
        Test::eq [range_opts 5] (5 10 1)
        Test::eq [range_opts 5 20] (5 20 1)
        Test::eq [range_opts 5 20 2] (5 20 2)
    }

    Test::case "default references earlier param with lambdas" {
        let range_end [lambda {start (end [+ $start 10])} {
            list $start $end
        }]
        Test::eq [range_end 5] (5 15)
        Test::eq [range_end 5 20] (5 20)
    }

    Test::case "default evaluated per call with lambdas" {
        var counter 0
        let incr [lambda {} { set! counter [+ $counter 1]; $counter }]
        let next_id [lambda {(id [incr])} { $id }]
        Test::eq [next_id] 1
        Test::eq [next_id] 2
        Test::eq [next_id 99] 99
        Test::eq [next_id] 3
    }
}

;; ============================================================================
;; Rest Parameters
;; ============================================================================

Test::suite "Rest Parameters" {
    Test::case "basic rest parameter" {
        proc sum {*xs} {
            var acc 0
            foreach x $xs { set! acc [+ $acc $x] }
            $acc
        }
        Test::eq [sum 1 2 3 4 5] 15
        Test::eq [sum] 0
    }

    Test::case "required and rest" {
        proc join_with {sep *items} {
            if [== [len $items] 0] { return "" }
            var result [get $items 0]
            foreach item [List::slice $items 1 [len $items]] {
                set! result "$result$sep$item"
            }
            $result
        }
        Test::eq [join_with "," "a" "b" "c"] "a,b,c"
        Test::eq [join_with "-" "foo"] "foo"
        Test::eq [join_with "|"] ""
    }

    Test::case "required, optional, and rest" {
        proc window {n (step 1) *xs} {
            list $n $step $xs
        }
        Test::eq [window 3] (3 1 ())
        Test::eq [window 3 2] (3 2 ())
        Test::eq [window 3 2 "a" "b" "c"] (3 2 ("a" "b" "c"))
    }

    Test::case "basic rest parameter with lambdas" {
        let sum [lambda {*xs} {
            var acc 0
            foreach x $xs { set! acc [+ $acc $x] }
            $acc
        }]
        Test::eq [sum 1 2 3 4 5] 15
        Test::eq [sum] 0
    }

    Test::case "required and rest with lambdas" {
        let join_with [lambda {sep *items} {
            if [== [len $items] 0] { return "" }
            var result [get $items 0]
            foreach item [List::slice $items 1 [len $items]] {
                set! result "$result$sep$item"
            }
            $result
        }]
        Test::eq [join_with "," "a" "b" "c"] "a,b,c"
        Test::eq [join_with "-" "foo"] "foo"
        Test::eq [join_with "|"] ""
    }

    Test::case "required, optional, and rest with lambdas" {
        let window [lambda {n (step 1) *xs} {
            list $n $step $xs
        }]
        Test::eq [window 3] (3 1 ())
        Test::eq [window 3 2] (3 2 ())
        Test::eq [window 3 2 "a" "b" "c"] (3 2 ("a" "b" "c"))
    }
}

;; ============================================================================
;; Apply and Arity
;; ============================================================================

Test::suite "Apply and Arity" {
    Test::case "apply with c proc" {
        ;; varargs: apply fn arg1 arg2 ...
        Test::eq [apply ${+} 1 2 3] 6
        Test::eq [apply ${*} 2 3 4] 24
    }

    Test::case "apply with user proc" {
        proc sum {*xs} {
            var acc 0
            foreach x $xs { set! acc [+ $acc $x] }
            $acc
        }
        Test::eq [apply ${sum} 10 20 30] 60
        Test::eq [apply ${sum}] 0
    }

    Test::case "apply with @ spread (list splat)" {
        ;; list-splat now via @ spread rather than implicit splat
        proc window {n (step 1) *xs} { list $n $step $xs }
        let args (3 2 "a" "b" "c")
        Test::eq [apply ${window} @$args] (3 2 ("a" "b" "c"))
    }

    Test::case "apply on a stored command name (string)" {
        ;; Resolution path: STRING -> command lookup -> dispatch.
        ;; This replaces the implicit `eval $cmd` Tcl idiom.
        proc greet {who} { return "hello $who" }
        let name "greet"
        Test::eq [apply $name "world"] "hello world"
    }

    Test::case "apply on a stored builtin name (string)" {
        let op "+"
        Test::eq [apply $op 1 2 3 4] 10
    }

    Test::case "apply on a lambda value" {
        let f [lambda {x} { + $x 1 }]
        Test::eq [apply $f 41] 42
    }

    Test::case "apply on a closure" {
        proc make_counter {start} {
            var n $start
            return [lambda {} { set! n [+ $n 1]; $n }]
        }
        let c [make_counter 10]
        Test::eq [apply $c] 11
        Test::eq [apply $c] 12
    }

    Test::case "apply errors on unknown command name" {
        let rc [catch { apply "no_such_command_xyzzy" } _ err]
        Test::eq $rc 1
    }

    Test::case "apply errors on non-callable value" {
        let rc [catch { apply 42 } _ err]
        Test::eq $rc 1
    }

    Test::case "apply errors on special form" {
        ;; "if" is a special form - apply cannot dispatch it because
        ;; specials want raw words, not pre-evaluated values.
        let rc [catch { apply "if" 1 {} {} } _ err]
        Test::eq $rc 1
    }

    Test::case "apply errors on macro" {
        macro my_macro {x} { quasiquote {,$x} }
        let rc [catch { apply "my_macro" 1 } _ err]
        Test::eq $rc 1
    }

    Test::case "apply with zero args" {
        proc noargs {} { return "ok" }
        Test::eq [apply ${noargs}] "ok"
    }

    Test::case "arity of required-only proc" {
        proc foo {a b c} { + $a $b $c }
        Test::eq [arity ${foo}] (3 3)
    }

    Test::case "arity of optional proc" {
        proc bar {a (b 10)} { + $a $b }
        Test::eq [arity ${bar}] (1 2)
    }

    Test::case "arity of rest proc" {
        proc baz {*xs} { len $xs }
        Test::eq [arity ${baz}] (0 -1)
    }

    Test::case "arity of combined proc" {
        proc qux {a (b 1) *rest} { list $a $b $rest }
        Test::eq [arity ${qux}] (1 -1)
    }

    Test::case "arity of c proc" {
        ;; C procs report (0 -1) since their arity isn't tracked
        Test::eq [arity ${+}] (0 -1)
    }
}

;; ============================================================================
;; Parse-time dispatch rule (value-substitution redesign, Phase 3)
;; ============================================================================
;;
;; The argc==1 dispatch rule: a one-word command dispatches its first word
;; only when that word is a bare identifier (single-piece, unbracketed LIT).
;; Every other form yields the word's value without any command-lookup
;; attempt. This eliminates the previous runtime "is this value callable?"
;; hybrid that caused values matching proc names to silently dispatch.
;;
;; See lcl_value_substitution_redesign.md for full rationale.

Test::suite "Parse-time dispatch rule" {

    Test::case {[$x] returns value when $x names a registered proc} {
        ;; Before Phase 3: silent dispatch -> "too few arguments" error.
        ;; After Phase 3: clean variable substitution.
        proc GET {url} { return "ignored" }
        let val "GET"
        Test::eq [$val] "GET"
    }

    Test::case {[$x] returns value when $x names a builtin} {
        let val "puts"
        Test::eq [$val] "puts"
    }

    Test::case {eval {$x} returns value, not dispatch} {
        proc GET {url} { return "ignored" }
        let val "GET"
        Test::eq [eval {$val}] "GET"
    }

    Test::case {[$c] returns the closure value, not a call} {
        ;; Closure-as-value: [$c] is no longer a zero-arg invocation. Use
        ;; `apply $c` for invocation.
        let c [lambda {} { 42 }]
        Test::eq [proc? [$c]] 1
    }

    Test::case {[apply $c] invokes the closure} {
        let c [lambda {} { 42 }]
        Test::eq [apply $c] 42
    }

    Test::case {[{literal}] returns the literal string} {
        Test::eq [{hello world}] "hello world"
    }

    Test::case {[42] returns the literal value} {
        Test::eq [42] 42
    }

    Test::case "multi-piece concat one-word program returns string" {
        let a hello
        let b world
        Test::eq [eval {"$a $b"}] "hello world"
    }

    Test::case "bare-id one-word still dispatches" {
        ;; Bare identifiers retain their dispatch behavior (the Tcl idiom).
        proc plain {} { return "called" }
        Test::eq [plain] "called"
    }

    Test::case {eval $cmd dispatches stored command name (Tcl idiom)} {
        ;; `eval $cmd` compiles to a one-word program with a bare-identifier
        ;; word — so the parse-time rule routes it through dispatch. The
        ;; Tcl pattern of "run this stored command name" survives.
        proc CMD {} { return "dispatched" }
        let cmd "CMD"
        Test::eq [eval $cmd] "dispatched"
    }

    Test::case {[[expr]] needs apply now} {
        ;; The [[inner]] pattern (call the result of inner) is no longer
        ;; automatic. Inner subcommand yields the value; outer apply
        ;; dispatches it.
        let closures (
            [lambda {} { 1 }]
            [lambda {} { 2 }]
        )
        Test::eq [apply [get $closures 0]] 1
        Test::eq [apply [get $closures 1]] 2
    }

    Test::case "subcmd inside concat word unchanged" {
        ;; Within a value-position [...] inside a larger string, one-word
        ;; programs still yield values - exactly as before. This guards
        ;; against accidental semantic drift in the multi-piece word path.
        let x 42
        Test::eq "x=[$x]" "x=42"
    }
}

;; ============================================================================
;; Parameter Validation Errors
;; ============================================================================

Test::suite "Parameter Validation Errors" {
    Test::case "too few arguments" {
        proc needs_two {a b} { + $a $b }
        let errored [catch { needs_two 1 }]
        Test::eq $errored 1
    }

    Test::case "too many arguments (no rest)" {
        proc takes_two {a (b 10)} { + $a $b }
        let errored [catch { takes_two 1 2 3 }]
        Test::eq $errored 1
    }

    Test::case "rest accepts any extra" {
        proc takes_rest {a *rest} { list $a $rest }
        let errored [catch { takes_rest 1 2 3 4 5 }]
        Test::eq $errored 0
    }
}

;; ============================================================================
;; Regression Tests (from  audit)
;; ============================================================================

Test::suite " #6: Modulo by zero" {
    Test::case "modulo by zero returns error, not crash" {
        let errored [catch { % 5 0 }]
        Test::eq $errored 1
    }

    Test::case "modulo with valid divisor still works" {
        Test::eq [% 10 3] 1
    }
}

Test::suite " #7: Float precision" {
    Test::case "float conversion preserves double precision" {
        ;; pi to 15 decimal places -- should not be truncated to 32-bit float
        let pi_str "3.141592653589793"
        let pi_val [float $pi_str]
        ;; With correct double parsing, the first 15 digits should be preserved.
        ;; With the bug (32-bit float), it becomes 3.1415927410125732
        Test::assert [!= $pi_val 3.1415927410125732]
    }
}

Test::suite " #75 step 1: Compact float formatting" {
    ;; These assertions wrap the value in a concat ("<...>") to force
    ;; the rendered string; a bare Test::eq would coerce both sides
    ;; numerically and pass even with the old %.17g formatting.
    Test::case "0.1 prints compactly" {
        Test::eq "<[/ 1.0 10]>" "<0.1>"
    }

    Test::case "17-digit values keep every digit" {
        Test::eq "<[+ 0.1 0.2]>" "<0.30000000000000004>"
    }

    Test::case "float arithmetic result prints compactly" {
        Test::eq "<[* 1.5 3]>" "<4.5>"
    }

    Test::case "compact rendering parses back to the same value" {
        ;; Note: [float "[/ 1.0 10]"] would NOT test the string path --
        ;; a single-piece quoted word forwards the float unchanged
        ;; (single-piece rule). String::from forces the rendered form.
        Test::eq [float [String::from [/ 1.0 10]]] [/ 1.0 10]
    }
}

Test::suite " #75 step 2: Typed numeric literals" {
    Test::case "grammar-canonical spellings are typed" {
        Test::eq [type 42] int
        Test::eq [type -3] int
        Test::eq [type 0] int
        Test::eq [type 3.14] float
        Test::eq [type 1.50] float
        Test::eq [type 0.1] float
        Test::eq [type 1e3] float
        Test::eq [type 1.5e-3] float
        Test::eq [type -0.5] float
    }

    Test::case "non-canonical spellings stay strings" {
        ;; numeric SHAPE (never dispatches, #74) but outside the
        ;; numeric GRAMMAR (#75 rule 5) -- string value forms
        Test::eq [type 007] string
        Test::eq [type +5] string
        Test::eq [type -0] string
        Test::eq [type .5] string
        Test::eq [type 5.] string
    }

    Test::case "typed literals print their source spelling" {
        Test::eq "<42>" "<42>"
        Test::eq "<[- 0 3]>" "<-3>"
        ;; non-canonical float spellings normalize when typed
        Test::eq "<[+ 1.50 0]>" "<1.5>"
    }

    Test::case "list literal elements are typed" {
        Test::eq [type [get (1 2 3) 0]] int
        Test::eq [repr (1 2.5 x)] {(1 2.5 "x")}
    }

    Test::case "dict literal values are typed" {
        Test::eq [type [get #{a 1} a]] int
        ;; typed key collapses to its canonical string for hashing
        Test::eq [get #{1 one} "1"] one
    }

    Test::case "escaped digits are not typed" {
        ;; \x32 is '2': the bytes are "42" but the source spelling is
        ;; not the literal 42, so the word stays a string
        Test::eq [type 4\x32] string
    }

    Test::case "typed literals still work in string contexts" {
        ;; stringification is total; concat and String::from see the
        ;; canonical string. (Note: ops whose domain never included
        ;; numbers -- len, has? -- now error on typed literals exactly
        ;; as they always did on [int 42]; classification of string
        ;; contexts is the step-4 audit.)
        Test::eq [String::from 3.14] "3.14"
        Test::eq "n=[+ 40 2]" "n=42"
    }

    Test::case "int predicates see typed literals" {
        Test::true [int? 42]
        Test::true [float? 2.5]
        Test::true [number? 42]
        Test::assert [not [int? "42"]]
    }
}

Test::suite " #75 step 4: Numeric text & string domains" {
    Test::case "numeric text is liberal about data spellings" {
        ;; data has no spelling intent: leading zeros, +, and bare
        ;; dots convert in numeric contexts even though the same
        ;; spellings are not numeric literals
        Test::eq [+ 1 "007"] 8
        Test::eq [+ 1 "+5"] 6
        Test::eq [+ 0 ".5"] 0.5
        Test::eq [< "007" 8] 1
    }

    Test::case "libc extras are not numeric text" {
        ;; the language grammar decides acceptance, not strtol/strtod:
        ;; whitespace skip, hex, and partial parses are all out
        Test::eq [catch { + 1 " 42" }] 1
        Test::eq [catch { + 1 "0x10" }] 1
        Test::eq [catch { + 1 "3.14abc" }] 1
        Test::eq [number? " 42"] 0
        Test::eq [number? "0x10"] 0
        Test::eq [number? "007"] 1
    }

    Test::case "truthiness follows the grammar" {
        ;; " 0" is not numeric text, so it is an ordinary non-empty
        ;; (truthy) string; "0"/"-0" remain falsy; "0.0" remains
        ;; truthy (integer-shaped text only, as ever)
        Test::eq [if " 0" { "t" } else { "f" }] t
        Test::eq [if "-0" { "t" } else { "f" }] f
        Test::eq [if "0.0" { "t" } else { "f" }] t
    }

    Test::case "equality falls back to bytewise for non-numeric text" {
        Test::eq [== "0x10" 16] 0
        Test::eq [== "007" 7] 1
    }

    Test::case "string operators require strings" {
        let r [catch { String::upper 42 } res err]
        Test::eq $r 1
        Test::eq $err {String::upper: expected string (use String::from to render), got int}
        Test::eq [String::upper [String::from 42]] 42
        Test::eq [catch { String::length (a b) }] 1
        Test::eq [catch { String::find 3.14 "." }] 1
    }

    Test::case "String::from and interpolation remain total renderers" {
        Test::eq [String::from (1 2)] "1 2"
        Test::eq "v=[+ 1 2]" "v=3"
    }

    Test::case "float overflow text errors instead of inf" {
        ;; grammar-accepted (number? true) but range-rejected on
        ;; conversion -- loud, never inf
        Test::eq [number? "1e999"] 1
        Test::eq [catch { + 0 "1e999" }] 1
    }
}

;; Define strings with unbalanced braces at top level (the brace scanner
;; inside { } doesn't process escapes, so \} would break brace balancing)
let _i14_rbrace "a\}b"
let _i14_lbrace "a\{b"

Test::suite " #14: List brace escaping" {
    Test::case "list element with spaces round-trips" {
        ;; Elements with spaces require bracing in stringified lists
        let mylist [list "hello world" "foo bar"]
        Test::eq [len $mylist] 2
        Test::eq [get $mylist 0] "hello world"
        Test::eq [get $mylist 1] "foo bar"
    }

    Test::case "list element with dollar sign round-trips" {
        let mylist [list "a" "b\$c"]
        Test::eq [len $mylist] 2
        Test::eq [get $mylist 1] "b\$c"
    }

    Test::case "element with unbalanced close brace round-trips" {
        ;; _i14_rbrace contains an unbalanced brace - defined at top level
        let mylist [list $_i14_rbrace]
        Test::eq [len $mylist] 1
        ;; Re-parse stringified list - the element must survive
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $_i14_rbrace
    }

    Test::case "element with unbalanced open brace round-trips" {
        let mylist [list $_i14_lbrace]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $_i14_lbrace
    }

    Test::case "element with bracket round-trips" {
        let elem "x\[y"
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "element with backslash round-trips" {
        let elem "a\\b"
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "element with double quote round-trips" {
        let elem "say \"hi\""
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "element with semicolon round-trips" {
        let elem "a;b"
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "mixed bare, braced, and quoted elements" {
        ;; bare: simple, braced: has space, quoted: has unbalanced brace
        let mylist [list simple "hello world" $_i14_rbrace]
        Test::eq [len $mylist] 3
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 3
        Test::eq [get $reparsed 0] simple
        Test::eq [get $reparsed 1] "hello world"
        Test::eq [get $reparsed 2] $_i14_rbrace
    }
}

Test::suite " #16: Arithmetic type preservation" {
    Test::case "integer addition returns int" {
        Test::assert [int? [+ 1 2]]
    }

    Test::case "float addition returns float" {
        Test::assert [float? [+ 1.5 2.5]]
    }

    Test::case "mixed addition returns float" {
        Test::assert [float? [+ 1 2.5]]
    }

    Test::case "integer subtraction returns int" {
        Test::assert [int? [- 5 3]]
    }

    Test::case "integer multiplication returns int" {
        Test::assert [int? [* 3 4]]
    }
}

;; ============================================================================
;; Scanner: escape sequences
;; ============================================================================

Test::suite "Scanner: escape sequences" {
    Test::case "hex escape \\x41 produces A" {
        Test::eq "\x41" A
    }

    Test::case "hex escape requires 2 digits" {
        Test::eq [len "\x4z"] 4
        Test::eq "\x4z" "\\x4z"
    }

    Test::case "unknown escape preserves backslash" {
        Test::eq [len "\q"] 2
        Test::eq "\q" "\\q"
    }

    Test::case "octal escape \\101 produces A" {
        Test::eq "\101" A
    }

    Test::case "brace backslash balance" {
        let val {foo \} bar}
        Test::eq [String::find $val "foo"] 0
        Test::eq [String::find $val "bar"] 7
    }
}

let _test_vbrace_d #{key "v}al"}
let _test_vbrace_expect "v}al"

;; ============================================================================
;; Scanner: balanced delimiters with quotes
;; ============================================================================

Test::suite "Scanner: balanced delimiters" {
    Test::case "quoted close-paren inside list literal" {
        let result (foo ")" bar)
        Test::eq [len $result] 3
        Test::eq [get $result 0] foo
        Test::eq [get $result 1] ")"
        Test::eq [get $result 2] bar
    }

    Test::case "quoted close-bracket inside subcommand" {
        let result [list "a]b" c]
        Test::eq [len $result] 2
        Test::eq [get $result 0] "a]b"
    }

    Test::case "quoted close-brace inside dict literal" {
        Test::eq [get $_test_vbrace_d key] $_test_vbrace_expect
    }
}

;; ============================================================================
;; Scanner: comments in literals
;; ============================================================================

Test::suite "Scanner: comments in literals" {
    Test::case ";; comment stripped in list literal" {
        let result (foo ;; this is a comment
bar)
        Test::eq [len $result] 2
        Test::eq [get $result 0] foo
        Test::eq [get $result 1] bar
    }

    Test::case ";; comment stripped in dict literal" {
        let d #{
            key1 val1 ;; comment
            key2 val2
        }
        Test::eq [len $d] 2
        Test::eq [get $d key1] val1
        Test::eq [get $d key2] val2
    }

    Test::case ";; comment stripped in subcommand" {
        let result [list
            a ;; comment
            b
            c
        ]
        Test::eq [len $result] 3
        Test::eq [get $result 0] a
        Test::eq [get $result 1] b
        Test::eq [get $result 2] c
    }
}

;; ============================================================================
;; Upvalue Capture Through Braced Literals
;; ============================================================================

Test::suite "Upvalue Capture Through Braced Literals" {

    Test::case "eval sees namespace let-binding" {
        namespace _uv1 {
            let val hello
            proc test {} { eval {$val} }
        }
        Test::eq [_uv1::test] hello
    }

    Test::case "eval sees multiple namespace let-bindings" {
        namespace _uv2 {
            let a hello
            let b world
            proc test {} { eval {"$a $b"} }
        }
        Test::eq [_uv2::test] {hello world}
    }

    Test::case "foreach body sees namespace let-binding" {
        namespace _uv3 {
            let tag X
            proc test {} {
                var out ""
                foreach k {a b} {
                    set! out "$out$k:$tag "
                }
                $out
            }
        }
        Test::eq [_uv3::test] {a:X b:X }
    }

    Test::case "while body sees namespace let-binding" {
        namespace _uv4 {
            let msg hi
            proc test {} {
                var i 0
                var out ""
                while {[< $i 2]} {
                    set! out "$out$msg"
                    set! i [+ $i 1]
                }
                $out
            }
        }
        Test::eq [_uv4::test] hihi
    }

    Test::case "var-bound upvalues work in foreach (no regression)" {
        namespace _uv5 {
            var counter 0
            proc test {} {
                foreach k {a b c} {
                    set! counter [+ $counter 1]
                }
                $counter
            }
        }
        Test::eq [_uv5::test] 3
    }

    Test::case "imported proc sees namespace let-binding in eval" {
        namespace _uv6 {
            let secret 42
            proc reveal {} { eval {$secret} }
        }
        import _uv6 reveal
        Test::eq [reveal] 42
    }

    Test::case "nested braced literals capture upvalues" {
        namespace _uv7 {
            let x 10
            proc test {} {
                eval {eval {$x}}
            }
        }
        Test::eq [_uv7::test] 10
    }
}

;; ============================================================================
;; Macros
;; ============================================================================

Test::suite "Macros" {

    Test::case "basic macro definition and expansion" {
        macro bind-double {x} {
            quasiquote { let _r [+ ,$x ,$x] }
        }
        bind-double 5
        Test::eq $_r 10
    }

    Test::case "macro expansion creates bindings in caller frame" {
        macro bind-it {val} {
            quasiquote { let it ,$val }
        }
        bind-it 42
        Test::eq $it 42
    }

    Test::case "macro with quasiquote generates code" {
        macro bind-sum {a b} {
            quasiquote { let _s [+ ,$a ,$b] }
        }

        bind-sum 3 7
        Test::eq $_s 10
    }

    Test::case "macro in value position errors" {
        macro add-ten {x} {
            quasiquote { + ,$x 10 }
        }

        if [catch { eval {let x [add-ten 5]} } _res msg] {
            Test::eq $msg "macro cannot be used in value position"
        } else {
            error "expected macro value-position error"
        }
    }

    Test::case "macro calling macro (nesting)" {
        macro bind-add-one {x} {
            quasiquote { let _r [+ ,$x 1] }
        }
        macro bind-add-two {x} {
            quasiquote {
                bind-add-one [+ ,$x 1]
            }
        }
        bind-add-two 5
        Test::eq $_r 7
    }

    Test::case "macro inside if body (command position)" {
        macro set-val {name val} {
            quasiquote { let ,$name ,$val }
        }

        if 1 {
            set-val myvar 99
        }
        Test::eq $myvar 99
    }

    Test::case "macro inside while body" {
        var total 0
        var i 0

        macro add-i-to-total {} {
            quasiquote { set! total [+ $total $i] }
        }

        while [< $i 3] {
            add-i-to-total
            set! i [+ $i 1]
        }
        ;; 0 + 1 + 2 = 3
        Test::eq $total 3
    }

    Test::case "macro in namespace" {
        namespace macro_ns {
            macro bind-greet {name} {
                quasiquote { let _g [String::join (Hello " " ,$name) {}] }
            }
        }
        macro_ns::bind-greet World
        Test::eq $_g "Hello World"
    }

    Test::case "macroexpand returns template without evaluating" {
        macro add-ten {x} {
            quasiquote { + ,$x 10 }
        }
        let tmpl [macroexpand add-ten 5]
        ;; tmpl is a string containing the unexpanded template
        Test::eq [String::trim $tmpl] "+ 5 10"
    }

    Test::case "eval macroexpand for value position" {
        macro double {x} {
            quasiquote { + ,$x ,$x }
        }
        let result [eval [macroexpand double 7]]
        Test::eq $result 14
    }

    Test::case "macroexpand on non-macro errors" {
        proc not-a-macro {x} { + $x 1 }
        if [catch { macroexpand not-a-macro 5 } _res msg] {
            Test::eq $msg "macroexpand: not a macro"
        } else {
            error "expected macroexpand error on non-macro"
        }
    }

    Test::case "nested macros expand in command position" {
        macro inner-add {x} {
            quasiquote { + ,$x 1 }
        }
        macro outer-double-add {x} {
            quasiquote { inner-add [+ ,$x ,$x] }
        }
        ;; outer-double-add 3 → inner-add [+ 3 3] → inner-add 6 → + 6 1 → 7
        outer-double-add 3
        ;; Last value is 7; bind it to check
        let _r [eval [macroexpand outer-double-add 3]]
        Test::eq $_r 7
    }

    Test::case "macroexpand returns one level only" {
        macro step1 {x} {
            quasiquote { step2 ,$x }
        }
        macro step2 {x} {
            quasiquote { + ,$x 100 }
        }
        ;; macroexpand only expands step1, not step2 inside the template
        let tmpl [macroexpand step1 5]
        Test::eq [String::trim $tmpl] "step2 5"
        ;; But eval expands step2 since it's a command head
        let result [eval $tmpl]
        Test::eq $result 105
    }

    Test::case "three levels of macro nesting" {
        macro wrap3 {x} {
            quasiquote { wrap2 ,$x }
        }
        macro wrap2 {x} {
            quasiquote { wrap1 ,$x }
        }
        macro wrap1 {x} {
            quasiquote { + ,$x 1000 }
        }
        ;; All three levels expand through evaluation
        wrap3 42
        let _r [eval [macroexpand wrap3 42]]
        Test::eq $_r 1042
    }

    Test::case "nested macros with side effects at each level" {
        var trace [list]
        macro level-a {x} {
            quasiquote {
                set! trace [List::push $trace "a"]
                level-b ,$x
            }
        }
        macro level-b {x} {
            quasiquote {
                set! trace [List::push $trace "b"]
                + ,$x 1
            }
        }
        level-a 10
        ;; Both macros expanded and ran: trace has a then b
        Test::eq $trace [list a b]
    }
}

Test::suite " #23: integer conversion overflow safety" {
    Test::case "int rejects out-of-range float (positive)" {
        ;; (long)1e20 is UB on every common platform — should error,
        ;; not silently clamp to LONG_MIN/garbage.
        let errored [catch { int 1e20 }]
        Test::eq $errored 1
    }

    Test::case "int rejects out-of-range float (negative)" {
        let errored [catch { int -1e20 }]
        Test::eq $errored 1
    }

    Test::case "int rejects overflowing integer string" {
        ;; strtol returns LONG_MAX with errno=ERANGE; bug accepts as valid.
        let errored [catch { int "99999999999999999999" }]
        Test::eq $errored 1
    }

    Test::case "float rejects nan/inf text" {
        ;; The numeric-text grammar excludes nan/inf/hex, so strtod's
        ;; acceptance of them (glibc/musl) can no longer leak in. The
        ;; NaN→long UB guard this case used to reach through `float
        ;; "nan"` is now pinned at the C level (lcl-test.c, #75 step 4).
        Test::eq [catch { float "nan" }] 1
        Test::eq [catch { float "inf" }] 1
        Test::eq [catch { float "0x10" }] 1
    }

    Test::case "int still accepts in-range values" {
        Test::eq [int 42] 42
        Test::eq [int 3.7] 3
        Test::eq [int "-100"] -100
    }
}

Test::suite " #36: integer arithmetic overflow detection" {
    ;; Signed integer overflow is C UB and triggers UBSan; we detect it
    ;; explicitly and return LCL_RC_ERR so scripts can `catch` it.

    Test::case "+ near LONG_MAX errors, doesn't wrap" {
        let errored [catch { + 9223372036854775807 1 }]
        Test::eq $errored 1
    }

    Test::case "+ small ints still work" {
        Test::eq [+ 1 2 3] 6
        Test::eq [+ -5 10] 5
    }

    Test::case "- subtraction overflow errors" {
        ;; LONG_MAX - (-1) = LONG_MAX + 1 → overflow
        let errored [catch { - 9223372036854775807 -1 }]
        Test::eq $errored 1
    }

    Test::case "- small ints still work" {
        Test::eq [- 10 3 2] 5
    }

    Test::case "* overflow errors" {
        let errored [catch { * 9223372036854775000 1000 }]
        Test::eq $errored 1
    }

    Test::case "* small ints still work" {
        Test::eq [* 7 8] 56
        Test::eq [* 2 3 4] 24
    }

    Test::case "% LONG_MIN -1 returns 0 (not UB)" {
        ;; The buggy code computed LONG_MIN % -1 directly — UB on x86 because
        ;; the quotient LONG_MIN/-1 = -LONG_MIN overflows. Mathematically the
        ;; remainder is 0; we return that instead of UB-trapping or erroring.
        let long_min [- -9223372036854775807 1]
        Test::eq [% $long_min -1] 0
    }

    Test::case "% small ints still work" {
        Test::eq [% 10 3] 1
        Test::eq [% -10 3] -1
    }

    Test::case "List::range still works for normal cases" {
        Test::eq [len [List::range 0 5]] 5
        Test::eq [len [List::range 0 10 2]] 5
    }
}

Test::suite " #34: single-pass list/dict stringification" {
    ;; The previous two-pass implementation computed each element's size
    ;; via lcl_value_to_string(elem) then re-called it to write — between
    ;; calls a partial-OOM could shift an element from "" (fallback) to
    ;; its real representation, overflowing the buffer. The fix replaces
    ;; both reify functions with a single growing-buffer pass. These
    ;; smoke tests exercise the round-trip behavior across the styles
    ;; that the new code paths produce.

    Test::case "empty list stringifies" {
        Test::eq [len [list]] 0
        Test::eq [String::length [String::from [list]]] 0
    }

    Test::case "empty dict stringifies" {
        Test::eq [len [dict]] 0
        Test::eq [String::length [String::from [dict]]] 0
    }

    Test::case "nested list with mixed styles round-trips" {
        let inner [list "has space" plain "br\}ace"]
        let outer [list $inner $inner]
        Test::eq [len $outer] 2
        Test::eq [len [get $outer 0]] 3
    }

    Test::case "dict round-trips with quoted keys and values" {
        let d [dict "k 1" "v 1" plain "br\}ace"]
        Test::eq [get $d "k 1"] "v 1"
        Test::eq [get $d plain] "br\}ace"
    }

    Test::case "deeply nested list stringifies" {
        let l [list [list [list a b] c] d]
        Test::eq [len $l] 2
        Test::eq [len [get $l 0]] 2
        Test::eq [len [get [get $l 0] 0]] 2
    }
}

Test::suite " #32: dispatch handles SPECIAL CPROCs safely" {
    ;; Originally a regression test for a buggy single-subcmd dispatch path:
    ;; `[get_if]` (where get_if returned $if) routed through fn.proc instead
    ;; of fn.spec — undefined behavior.
    ;;
    ;; After the parse-time-rule redesign (Phase 3 of the value-substitution
    ;; redesign), `[get_if]` no longer dispatches its result — it returns the
    ;; value. Explicit dispatch via `apply` is the migration target, and
    ;; `apply` itself rejects special forms cleanly.
    Test::case "applying a special-form value errors cleanly" {
        proc get_if {} { return $if }
        let errored [catch { apply [get_if] }]
        Test::eq $errored 1
    }
}

Test::suite " #31: cycle detection sees through containers" {
    ;; The spec rejects mutual recursion at proc-def time because refcounting
    ;; cannot collect cycles. Before this fix, cycle_check_value only
    ;; recursed through LCL_PROC, so a proc hidden inside a list/dict/cell
    ;; was invisible to the check and the cycle was created (and leaked).

    Test::case "cell -> list -> proc -> cell cycle rejected" {
        var c [ref [list]]
        let p [lambda {} { $c }]
        let errored [catch { set! c [list $p] }]
        Test::eq $errored 1
    }

    Test::case "cell -> list -> list -> proc -> cell cycle rejected" {
        var c [ref [list]]
        let p [lambda {} { $c }]
        let errored [catch { set! c [list [list $p]] }]
        Test::eq $errored 1
    }

    Test::case "cell -> dict -> proc -> cell cycle rejected" {
        var c [ref [list]]
        let p [lambda {} { $c }]
        let errored [catch { set! c [dict k $p] }]
        Test::eq $errored 1
    }

    Test::case "cell -> cell -> proc -> cell cycle rejected" {
        var c [ref [list]]
        let p [lambda {} { $c }]
        let inner [ref $p]
        let errored [catch { set! c $inner }]
        Test::eq $errored 1
    }

    Test::case "cell can hold list with non-capturing procs" {
        var c [ref [list]]
        let p [lambda {x} { + $x 1 }]
        let errored [catch { set! c [list $p] }]
        Test::eq $errored 0
    }

    Test::case "cell can hold list of primitive values" {
        var c [ref [list]]
        let errored [catch { set! c [list 1 2 3] }]
        Test::eq $errored 0
    }
}

Test::suite " #30: String::replace handles edge cases without overflow" {
    ;; The actual size_t overflow requires ~2^64 bytes of input — not
    ;; reachable in a normal test. These cases exercise the same arithmetic
    ;; (count*(new_len-old_len)) on small inputs to lock in correctness
    ;; under the new overflow-checked code path.
    Test::case "replace shrinks (new shorter than old)" {
        Test::eq [String::replace "aaaaaa" "aa" ""] ""
    }

    Test::case "replace expands (new longer than old)" {
        Test::eq [String::replace "ab" "a" "xxx"] "xxxb"
    }

    Test::case "replace same length" {
        Test::eq [String::replace "abc" "b" "B"] "aBc"
    }

    Test::case "replace with no matches returns source" {
        Test::eq [String::replace "abc" "z" "Z"] "abc"
    }

    Test::case "replace many occurrences of long old_str" {
        ;; (old_len=4, new_len=2, count=4) — exercises count*(2-4) underflow.
        Test::eq [String::replace "abcdabcdabcdabcd" "abcd" "xy"] "xyxyxyxy"
    }
}

Test::suite " #29: integer comparison precision" {
    ;; LONG_MAX-1 (9223372036854775806) and LONG_MAX (9223372036854775807) both
    ;; round to 2^63 when converted to double, so all four comparisons would
    ;; produce wrong results when args were integers cast via double.
    Test::case "< between adjacent large ints is correct" {
        Test::assert [< 9223372036854775806 9223372036854775807]
        Test::assert [not [< 9223372036854775807 9223372036854775806]]
    }

    Test::case "> between adjacent large ints is correct" {
        Test::assert [> 9223372036854775807 9223372036854775806]
        Test::assert [not [> 9223372036854775806 9223372036854775807]]
    }

    Test::case "<= and >= behave correctly at the boundary" {
        Test::assert [<= 9223372036854775806 9223372036854775807]
        Test::assert [>= 9223372036854775807 9223372036854775806]
        Test::assert [<= 9223372036854775807 9223372036854775807]
    }

    Test::case "mixed int/float comparison still uses float path" {
        ;; When either operand is float, comparing via double is expected.
        Test::assert [< 1 2.5]
        Test::assert [> 3.5 3]
    }
}

Test::suite " #28: stray ] is a parse error, not silent truncation" {
    Test::case "stray ] at top level errors" {
        ;; Before fix: silently compiles only `list a` and ignores the rest.
        ;; After fix: compile error, eval propagates LCL_RC_ERR.
        let errored [catch { eval "list a ] list b" }]
        Test::eq $errored 1
    }

    Test::case "stray ] between commands errors" {
        let errored [catch { eval "let x 1 ; ] ; let y 2" }]
        Test::eq $errored 1
    }
}

Test::suite " #25: eval does not propagate tail position to inner commands" {
    Test::case "self-recursive call inside eval body does not escape eval" {
        ;; If `eval` doesn't reset in_tail_position per command, the
        ;; recursive `recur` call below is detected as a tail call
        ;; (saved_tail_position && callee == current_proc) and escapes
        ;; via LCL_RC_TAILCALL — abandoning the `return marker` after.
        ;;
        ;; Buggy behavior: returns the accumulator (e.g. 3).
        ;; Correct behavior: returns "marker".
        proc recur {n acc} {
            if [== $n 0] {
                return $acc
            }
            eval {
                recur [- $n 1] [+ $acc 1]
                return marker
            }
        }
        Test::eq [recur 3 0] marker
    }
}

Test::suite " #46: float stringification is locale-independent" {
    Test::case "stringified float contains ASCII '.' as decimal separator" {
        ;; Force a real FLOAT via arithmetic (not just a literal string),
        ;; then render explicitly to trigger lcl_reify_str_float.
        ;; (Note "$f" would NOT render -- a single-piece quoted word
        ;; forwards the float unchanged per the single-piece rule.)
        let f [+ 1.0 2.14]
        let s [String::from $f]
        ;; On any locale (de_DE etc. included), the serialized form must
        ;; contain ASCII '.', never ',' — spec §10 determinism.
        Test::assert [>= [String::find $s "."] 0]
    }

    Test::case "float parses ASCII '.' regardless of runtime locale" {
        ;; lcl_parse_double_c must accept '.' on any locale.
        let parsed [float "3.14"]
        ;; Round-trip approximate (cant Test::eq due to %.17g precision
        ;; widening "3.14" to "3.1400000000000001").
        let diff [- $parsed 3.14]
        Test::assert [< $diff 0.0000000001]
        Test::assert [> $diff -0.0000000001]
    }
}

Test::suite " #38: if validates the else keyword" {
    Test::case "4-arg if with bogus keyword errors when cond is false" {
        ;; Pre-fix: silently accepts and runs the 4th-arg branch.
        ;; Post-fix: errors structurally before evaluating any branch.
        let errored [catch { if 0 {+ 1 0} foobar {+ 0 1} }]
        Test::eq $errored 1
    }

    Test::case "4-arg if with bogus keyword errors when cond is true" {
        ;; Validation is syntactic — the keyword check fires regardless
        ;; of which branch the condition would have selected.
        let errored [catch { if 1 {+ 1 0} foobar {+ 0 1} }]
        Test::eq $errored 1
    }

    Test::case "4-arg if with else keyword still works" {
        Test::eq [if 1 {+ 7 0} else {+ 0 99}] 7
        Test::eq [if 0 {+ 99 0} else {+ 0 7}] 7
    }

    Test::case "3-arg if positional-else still works" {
        Test::eq [if 1 {+ 7 0} {+ 0 99}] 7
        Test::eq [if 0 {+ 99 0} {+ 0 7}] 7
    }

    Test::case "2-arg if no-else still works" {
        Test::eq [if 1 {+ 7 0}] 7
        Test::eq [if 0 {+ 7 0}] ""
    }
}

Test::suite " #50: gensym prefix length and counter" {
    Test::case "default gensym produces _GN names" {
        let a [gensym]
        let b [gensym]
        ;; Names must differ; both must start with `_G`.
        Test::assert [!= $a $b]
        Test::assert [== [String::find $a "_G"] 0]
        Test::assert [== [String::find $b "_G"] 0]
    }

    Test::case "custom prefix is honored" {
        let s [gensym myprefix]
        Test::assert [== [String::find $s "myprefix"] 0]
    }

    Test::case "overlong prefix is rejected" {
        ;; Build a 97-byte prefix (> 96-byte cap).
        var p ""
        var i 0
        while {[< $i 97]} {
            set! p "${p}x"
            set! i [+ $i 1]
        }
        let r [catch { gensym $p }]
        Test::eq $r 1
    }

    Test::case "96-byte prefix is accepted" {
        var p ""
        var i 0
        while {[< $i 96]} {
            set! p "${p}x"
            set! i [+ $i 1]
        }
        let r [catch { gensym $p }]
        Test::eq $r 0
    }
}

Test::suite " #48: scanner rejects bad :: tails in variable refs" {
    Test::case "trailing :: is a parse error" {
        ;; Pre-fix: scanner accepted "$foo::", env_get_value split
        ;; "foo::" into segment "foo" + empty rest, and silently
        ;; returned $foo's value.
        let foo 5
        let r [catch { eval "puts \$foo::" }]
        Test::eq $r 1
    }

    Test::case "::digit (non-identifier-start) is a parse error" {
        ;; Pre-fix: scanner happily consumed "::1bad" as part of the
        ;; varname, deferring to a runtime "undefined variable".
        let foo 5
        let r [catch { eval "puts \$foo::1bad" }]
        Test::eq $r 1
    }

    Test::case "valid single :: still parses" {
        namespace ns48a { let x 7 }
        Test::eq $ns48a::x 7
    }

    Test::case "valid nested :: still parses" {
        namespace ns48b { namespace inner { let y 11 } }
        Test::eq $ns48b::inner::y 11
    }

    Test::case "underscore-led segment after :: still parses" {
        namespace ns48c { let _x 13 }
        Test::eq $ns48c::_x 13
    }
}

Test::suite " stdlib errors name the proc" {
    Test::case "arity error names the builtin" {
        let r [catch { % 5 } res err]
        Test::eq $r 1
        Test::eq $err {%: expected 2 arguments, got 1}
    }

    Test::case "conversion failure states expected vs got" {
        let r [catch { % 5 abc } res err]
        Test::eq $r 1
        Test::eq $err {%: expected integer, got "abc"}
    }

    Test::case "comparison names itself" {
        let r [catch { < x y } res err]
        Test::eq $r 1
        Test::eq $err {<: expected number, got "x"}
    }

    Test::case "get reports out-of-range index" {
        let r [catch { get (1 2 3) 9 } res err]
        Test::eq $r 1
        Test::eq $err {get: index 9 out of range}
    }

    Test::case "get reports missing dict key" {
        let r [catch { get #{a 1} missing } res err]
        Test::eq $r 1
        Test::eq $err {get: key "missing" not found}
    }

    Test::case "type mismatch names proc and both types" {
        let r [catch { del (1 2) 0 } res err]
        Test::eq $r 1
        Test::eq $err {del: expected dict, got list}
    }

    Test::case "callable check names the proc" {
        let r [catch { List::map (1 2) (3) } res err]
        Test::eq $r 1
        Test::eq $err {List::map: expected callable, got list}
    }

    Test::case "set! on unbound name says undefined" {
        let r [catch { set! definitely_unbound_68 1 } res err]
        Test::eq $r 1
        Test::eq $err {set!: undefined variable "definitely_unbound_68"}
    }

    Test::case "set! on immutable binding suggests var" {
        let immut68 "1"
        let r [catch { set! immut68 2 } res err]
        Test::eq $r 1
        Test::eq $err {set!: expected cell (declare with 'var'), got "1"}
    }

    Test::case "set! diagnostic names typed int binding" {
        let immut75 1
        let r [catch { set! immut75 2 } res err]
        Test::eq $r 1
        Test::eq $err {set!: expected cell (declare with 'var'), got int}
    }

    Test::case "if arity error names the form" {
        let r [catch { eval "if 1" } res err]
        Test::eq $r 1
        Test::eq $err {if: expected 2 to 4 arguments, got 1}
    }

    Test::case "special form arity via chk (sort family)" {
        let r [catch { List::sort_by (1 2) "5" } res err]
        Test::eq $r 1
        Test::eq $err {List::sort_by: expected callable, got "5"}
    }
}

Test::suite "compile errors carry a message" {
    Test::case "eval of unmatched bracket names the delimiter" {
        let r [catch { eval "puts \[" } res err]
        Test::eq $r 1
        Test::eq $err {unmatched '['}
    }

    Test::case "eval of unmatched quote names the delimiter" {
        let r [catch { eval "puts \"unclosed" } res err]
        Test::eq $r 1
        Test::eq $err {unmatched '"'}
    }

    Test::case "catch traps compile error of its own script" {
        ;; Braces balance, so the body parses as a word; the inner
        ;; unmatched [ only surfaces when catch compiles the script.
        let r [catch {let x [+ 1} res err]
        Test::eq $r 1
        Test::eq $err {unmatched '['}
    }

    Test::case "stray close-bracket is reported" {
        let r [catch { eval "puts \]" } res err]
        Test::eq $r 1
        Test::eq $err {unmatched ']'}
    }

    Test::case "bad :: tail is reported with a message" {
        let r [catch { eval "puts \$foo::" } res err]
        Test::eq $r 1
        Test::eq $err {expected identifier after '::'}
    }
}

Test::suite "unknown bare identifier at head errors (no self-quote)" {
    Test::case "unknown bare id as one-word command errors" {
        let r [catch { i74_no_such_cmd } res err]
        Test::eq $r 1
        Test::eq $err {unknown command: i74_no_such_cmd}
    }

    Test::case "eval of a one-word unknown string errors" {
        let r [catch { eval "i74_no_such_cmd" } res err]
        Test::eq $r 1
        Test::eq $err {unknown command: i74_no_such_cmd}
    }

    Test::case "qualified unknown errors for unresolvable root" {
        let r [catch { i74_nosuch_ns::member } res err]
        Test::eq $r 1
        Test::eq $err {unknown command: i74_nosuch_ns::member}
    }

    Test::case "qualified unknown errors for missing member (symmetry)" {
        namespace i74_cfg { let x 1 }
        let r [catch { i74_cfg::nope } res err]
        Test::eq $r 1
        Test::eq $err {unknown command: i74_cfg::nope}
    }

    Test::case "typo'd zero-arg command in proc tail errors" {
        proc i74_oops {} { i74_no_such_zero_arg }
        let r [catch { i74_oops } res err]
        Test::eq $r 1
        Test::eq $err {unknown command: i74_no_such_zero_arg}
    }

    Test::case "quoted one-word program is a value form" {
        let r ["red"]
        Test::eq $r red
        Test::eq [type ["red"]] string
    }

    Test::case "quoted value branch" {
        let c [if 1 { "red" } else { "blue" }]
        Test::eq $c red
    }

    Test::case "double-braced value branch" {
        let c [if 0 {{red}} else {{blue}}]
        Test::eq $c blue
    }

    Test::case "quoted proc tail returns the string" {
        proc i74_color {} { "red" }
        Test::eq [i74_color] red
    }

    Test::case "numeric one-word programs are value forms" {
        Test::eq [42] 42
        Test::eq [-3] -3
        Test::eq [3.14] 3.14
        Test::eq [1e5] 1e5
        Test::eq [if 1 { 42 }] 42
    }

    Test::case "out-of-range integer literal is a compile error" {
        ;; matching the numeric grammar but overflowing commits
        ;; loudly (never degrades to "the text itself"). Braces/quotes
        ;; remain the spelling for huge digit strings as data.
        let r [catch { eval "99999999999999999999" } res err]
        Test::eq $r 1
        Test::eq $err {integer literal out of range}
        Test::eq [len {99999999999999999999}] 20
    }

    Test::case "non-decimal forms are identifiers, not numbers" {
        let r [catch { eval "0x10" } res err]
        Test::eq $r 1
        Test::eq $err {unknown command: 0x10}
    }

    Test::case "while with numeric literal test still loops" {
        var i74_i 0
        while {1} {
            set! i74_i [+ $i74_i 1]
            if [== $i74_i 3] { break }
        }
        Test::eq $i74_i 3
    }

    Test::case "known bare id still dispatches" {
        proc i74_get {} { return "called" }
        Test::eq [i74_get] called
    }

    Test::case "bare id bound to a non-callable value yields the value" {
        let i74_bound 99
        Test::eq [i74_bound] 99
    }

    Test::case "argument-position bare words are untouched" {
        let w hello
        Test::eq $w hello
        Test::eq [type $w] string
    }
}

;; ============================================================================
;; Lex::commands (reader reflection)
;; ============================================================================

Test::suite "Lex::commands" {
    Test::case "bare words lex to literal word records" {
        let r [Lex::commands {ls -lsa}]
        Test::eq [len $r] 1
        let ws [get [get $r 0] words]
        Test::eq [len $ws] 2
        Test::eq [get [get $ws 0] text] {ls}
        Test::eq [get [get $ws 0] dynamic] 0
        Test::eq [get [get $ws 1] text] {-lsa}
    }

    Test::case "braced word decodes verbatim and is never dynamic" {
        let ws [get [get [Lex::commands {grep {a $x [b] c}}] 0] words]
        Test::eq [get [get $ws 1] text] {a $x [b] c}
        Test::eq [get [get $ws 1] braced] 1
        Test::eq [get [get $ws 1] dynamic] 0
    }

    Test::case "quoted word decodes escapes without substituting" {
        let ws [get [get [Lex::commands {echo "a\tb"}] 0] words]
        Test::eq [get [get $ws 1] text] "a\tb"
        Test::eq [get [get $ws 1] quoted] 1
        Test::eq [get [get $ws 1] dynamic] 0
    }

    Test::case "var reference makes a word dynamic with pieces" {
        let ws [get [get [Lex::commands {echo $foo}] 0] words]
        let w [get $ws 1]
        Test::eq [get $w dynamic] 1
        Test::eq [get $w text] {}
        let p [get [get $w pieces] 0]
        Test::eq [get $p kind] {var}
        Test::eq [get $p name] {foo}
    }

    Test::case "subcommand makes a word dynamic" {
        let ws [get [get [Lex::commands {echo [pwd]}] 0] words]
        Test::eq [get [get $ws 1] dynamic] 1
        Test::eq [get [get [get [get $ws 1] pieces] 0] kind] {sub}
    }

    Test::case "mixed word reports its pieces in order" {
        let ws [get [get [Lex::commands {echo pre$x}] 0] words]
        let ps [get [get $ws 1] pieces]
        Test::eq [len $ps] 2
        Test::eq [get [get $ps 0] kind] {lit}
        Test::eq [get [get $ps 0] text] {pre}
        Test::eq [get [get $ps 1] kind] {var}
    }

    Test::case "list and dict literals lex as dynamic (subcommands)" {
        let ws [get [get [Lex::commands "f () #\{a 1\}"] 0] words]
        Test::eq [get [get $ws 1] dynamic] 1
        Test::eq [get [get $ws 2] dynamic] 1
    }

    Test::case "expand flag is reported" {
        let ws [get [get [Lex::commands {f @$args}] 0] words]
        Test::eq [get [get $ws 1] expand] 1
    }

    Test::case "statements split on newline and semicolon with lines" {
        let r [Lex::commands "puts a\nputs b; puts c"]
        Test::eq [len $r] 3
        Test::eq [get [get $r 0] line] 1
        Test::eq [get [get $r 2] line] 2
    }

    Test::case "statement-level continuation joins statements" {
        let r [Lex::commands "puts a \\\nb"]
        Test::eq [len $r] 1
        Test::eq [len [get [get $r 0] words]] 3
    }

    Test::case "comment-only and empty input lex to no statements" {
        Test::eq [len [Lex::commands {;; nothing}]] 0
        Test::eq [len [Lex::commands {}]] 0
    }

    Test::case "nothing is evaluated by lexing" {
        var lexed_se 0
        let r [Lex::commands {set! lexed_se [+ $lexed_se 1]}]
        Test::eq $lexed_se 0
        Test::eq [len $r] 1
    }

    Test::case "malformed input errors with the compiler's message" {
        var e {}
        var m {}
        let rc [catch { Lex::commands "echo \"open" } e m]
        Test::eq $rc 1
        Test::assert [>= [String::find $m {unmatched}] 0]
    }

    Test::case "word records carry half-open byte spans" {
        let ws [get [get [Lex::commands {ls -lsa}] 0] words]
        Test::eq [get [get $ws 0] span] (0 2)
        Test::eq [get [get $ws 1] span] (3 7)
    }

    Test::case "spans slice original bytes with quoting intact" {
        let src {grep {a $x [b] c} "q\tw" @$args}
        let ws [get [get [Lex::commands $src] 0] words]
        proc wsrc {src w} {
            let sp [get $w span]
            String::range $src [get $sp 0] [get $sp 1]
        }
        Test::eq [wsrc $src [get $ws 1]] {{a $x [b] c}}
        Test::eq [wsrc $src [get $ws 2]] {"q\tw"}
        Test::eq [wsrc $src [get $ws 3]] {@$args}
    }

    Test::case "spans are absolute offsets across lines and comments" {
        let src "puts a\n;; note\nputs zz"
        let w [get [get [get [Lex::commands $src] 1] words] 1]
        Test::eq [String::range $src @[get $w span]] {zz}
    }

    Test::case "span slices rejoin commands without comments or padding" {
        let src "puts   {a  b}  ;; trailing"
        let ws [get [get [Lex::commands $src] 0] words]
        var parts ()
        foreach w $ws {
            set! parts [List::push $parts [String::range $src @[get $w span]]]
        }
        Test::eq [String::join $parts " "] {puts {a  b}}
    }
}

Test::suite "empty program result is the empty string" {
    Test::case "empty subcommand yields empty string" {
        Test::eq [type []] string
        Test::eq [String::from []] {}
    }

    Test::case "empty subcommand binds as empty string" {
        let i85_x []
        Test::eq "got=$i85_x" {got=}
    }

    Test::case "empty subcommand interpolates as empty string" {
        Test::eq "x=[]" {x=}
    }

    Test::case "empty proc body yields empty string" {
        proc i85_empty {} {}
        Test::eq "v=[i85_empty]" {v=}
    }

    Test::case "bare return yields empty string" {
        proc i85_bare {} { return }
        Test::eq "v=[i85_bare]" {v=}
    }

    Test::case "empty subcommand at command head errors" {
        let r [catch { [] x } res err]
        Test::eq $r 1
        Test::eq $err {empty command name}
    }

    Test::case "empty string at command head errors the same way" {
        let r [catch { "" x } res err]
        Test::eq $r 1
        Test::eq $err {empty command name}
    }
}

Test::run

