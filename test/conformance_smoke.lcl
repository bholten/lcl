;; Lcl Conformance Smoke Tests
;; This test suite covers core LCL functionality using the Test framework.
;; Run with: ./lcl test/conformance_smoke.lcl
;; ============================================================================
;; Immutability & Substitution
;; ============================================================================

Test::suite "Immutability & Substitution" {
    Test::case "let creates immutable binding" {
        let x 10
        Test::eq $x 10
    }
}

;; ============================================================================
;; Cells (var/ref) & set!
;; ============================================================================

Test::suite "Cells (var/ref) & set!" {
    Test::case "var creates mutable binding" {
        var n 0
        set! n [+ $n 1]
        Test::eq $n 1
    }

    Test::case "ref creates cell" {
        ;; cell? on direct ref output (not via variable, which dereferences)
        Test::assert [cell? [ref 42]]
    }
}

;; ============================================================================
;; Quoting and Subcommand Substitution
;; ============================================================================

Test::suite "Quoting and Subcommand Substitution" {
    Test::case "quoted string with substitution" {
        let a 10
        let s "x=$a [ + 1 2 ]"
        Test::eq $s {x=10 3}
    }

    Test::case "braced string is literal" {
        let a 10
        let t {x=$a [ + 1 2 ]}
        Test::eq $t {x=$a [ + 1 2 ]}
    }

    Test::case "empty quoted string equals empty braced string" {
        let a ""
        let b {}
        Test::eq $a $b
        Test::eq [String::length $a] 0
        Test::eq [String::length $b] 0
    }

    Test::case "var with empty quoted string" {
        var v ""
        Test::eq $v {}
        set! v "updated"
        Test::eq $v "updated"
    }
}

;; ============================================================================
;; Escape Sequences
;; ============================================================================

Test::suite "Escape Sequences" {
    Test::case "newline escape" {
        let esc_nl "line1\nline2"
        Test::eq [len $esc_nl] 11
    }

    Test::case "tab escape" {
        let esc_tab "col1\tcol2"
        Test::eq [len $esc_tab] 9
    }

    Test::case "backslash escape" {
        let esc_bs "a\\b"
        Test::eq [len $esc_bs] 3
    }

    Test::case "quote escape" {
        let esc_qt "say \"hi\""
        Test::eq [len $esc_qt] 8
    }

    Test::case "dollar escape prevents substitution" {
        let esc_var 100
        let esc_dol "\$esc_var"
        Test::eq $esc_dol {$esc_var}
    }

    Test::case "bracket escape prevents command substitution" {
        let esc_brk "\[+ 1 2\]"
        Test::eq $esc_brk {[+ 1 2]}
    }

    Test::case "escape in unquoted words" {
        let esc_unq hello\nworld
        Test::eq [len $esc_unq] 11
    }

    Test::case "braced strings are literal (no escapes)" {
        let esc_brace {a\nb}
        Test::eq [len $esc_brace] 4
        Test::eq $esc_brace {a\nb}
    }
}

;; ============================================================================
;; User Procs, Return, and Closures
;; ============================================================================

Test::suite "User Procs" {
    Test::case "simple proc with return" {
        proc add {a b} { return [+ $a $b] }
        Test::eq [add 20 22] 42
    }

    Test::case "closure counter" {
        proc makeCounter {start} {
            var n $start
            return [lambda {} { set! n [+ $n 1]; $n }]
        }
        let c [makeCounter 10]
        Test::eq [$c] 11
        Test::eq [$c] 12
    }

    Test::case "lambda expression" {
        let lam [lambda {x} { + $x 10 }]
        Test::eq [$lam 10] 20
    }

    Test::case "nested lambda closure" {
        let lambda_counter [lambda {start} {
            var n $start
            return [lambda {} {
                set! n [+ $n 1]
                return $n
            }]
        }]
        let lam_count [$lambda_counter 10]
        $lam_count
        $lam_count
        $lam_count
        Test::eq [$lam_count] 14
    }
}

;; ============================================================================
;; Named Lambda Self-Recursion
;; ============================================================================

Test::suite "Named Lambda Self-Recursion" {
    Test::case "factorial via named lambda" {
        let factorial [lambda factorial {n} {
            if [<= $n 1] { 1 } else { [* $n [factorial [- $n 1]]] }
        }]
        Test::eq [factorial 5] 120
    }

    Test::case "fibonacci via named lambda" {
        let fib [lambda fib {n} {
            if [< $n 2] { $n } else { [+ [fib [- $n 1]] [fib [- $n 2]]] }
        }]
        Test::eq [fib 10] 55
    }

    Test::case "proc uses named lambda internally" {
        proc fact {n} {
            if [<= $n 1] { 1 } else { [* $n [fact [- $n 1]]] }
        }
        Test::eq [fact 6] 720
    }

    Test::case "anonymous lambda still works" {
        let double [lambda {x} { [* $x 2] }]
        Test::eq [double 21] 42
    }

    Test::case "self-recursive counter" {
        ;; Uses SELF binding, no cycle
        proc counter {n acc} {
            if [== $n 0] { $acc } else { [counter [- $n 1] [+ $acc 1]] }
        }
        Test::eq [counter 100 0] 100
    }

    Test::case "named lambda with closure" {
        let base 10
        let addBase [lambda addBase {n} {
            if [== $n 0] { $base } else { [+ 1 [addBase [- $n 1]]] }
        }]
        Test::eq [addBase 5] 15
    }
}

;; ============================================================================
;; Namespaces
;; ============================================================================

Test::suite "Namespaces" {
    Test::case "namespace creates binding" {
        namespace math {
            let ten 10
        }
        Test::eq $math::ten 10
    }

    Test::case "braced variable form" {
        namespace math2 {
            let val 42
        }
        Test::eq ${math2::val} 42
    }

    Test::case "Ns:: functions" {
        namespace math3 {
            let val 42

            proc test {a b} {
                + $val 23
            }
        }

        Test::eq [Ns::keys $math3] (val test)
        Test::eq [Ns::name $math3] math3
        Test::eq [Ns::has? $math3 test] 1
    }
}

;; ============================================================================
;; Eval
;; ============================================================================

Test::suite "Eval" {
    Test::case "basic eval" {
        Test::eq [eval {+ 1 2}] 3
    }

    Test::case "eval accesses outer variables" {
        let ev_x 42
        Test::eq [eval {+ $ev_x 1}] 43
    }

    Test::case "eval defines in current frame" {
        eval {let ev_y 100}
        Test::eq $ev_y 100
    }

    Test::case "eval with multiple args" {
        let ev_cmd1 "let ev_z"
        let ev_cmd2 "200"
        eval $ev_cmd1 $ev_cmd2
        Test::eq $ev_z 200
    }

    Test::case "return inside eval in proc" {
        proc testEvalReturn {} {
            eval { return 999 }
        }
        Test::eq [testEvalReturn] 999
    }
}

;; ============================================================================
;; Subst
;; ============================================================================

Test::suite "Subst" {
    Test::case "variable substitution" {
        let sub_x 42
        Test::eq [subst {x is $sub_x}] {x is 42}
    }

    Test::case "subcommand substitution" {
        Test::eq [subst {sum=[+ 1 2]}] {sum=3}
    }

    Test::case "braced variable form" {
        let sub_foo bar
        Test::eq [subst {${sub_foo}!}] {bar!}
    }

    Test::case "backslash escapes" {
        Test::eq [subst {literal \$x}] {literal $x}
    }

    Test::case "braces are literal" {
        Test::eq [subst {braces {} ok}] {braces {} ok}
    }
}

;; ============================================================================
;; Namespace
;; ============================================================================

Test::suite "Namespace" {
    Test::case "define values in namespace" {
        namespace myns {
            let val 100
        }
        Test::eq $myns::val 100
    }

    Test::case "define procs in namespace" {
        namespace funcs {
            proc double {n} { return [+ $n $n] }
        }
        Test::eq [funcs::double 7] 14
    }

    Test::case "nested namespace path" {
        namespace outer::inner::leaf {
            let deep 42
        }
        Test::eq $outer::inner::leaf::deep 42
    }

    Test::case "multiple evals on same namespace" {
        namespace ns1 { let x 1 }
        namespace ns1 { let y 2 }
        Test::eq $ns1::x 1
        Test::eq $ns1::y 2
    }

    Test::case "namespace changes lookup resolution" {
        namespace ns3 {
            let x 1

            proc foo {bar} {
                $bar
            }

            namespace ns4 {
                let y 1

                proc qux {} {
                    42
                }
            }
        }

        namespace ns3 {
            Test::eq [foo 123] 123
            Test::eq $x 1

            namespace ns4 {
                Test::eq [qux] 42
            }

            Test::eq [ns4::qux] 42
        }

        Test::eq [ns3::foo 321] 321
        Test::eq $ns3::x 1
        Test::eq [ns3::ns4::qux] 42

        namespace ns5 {
            let v 42

            proc foo {} {
                $v
            }

            proc bar {} {
                foo
            }
        }

        Test::eq [ns5::foo] 42
        Test::eq [ns5::bar] 42

        ;; Reopening should work
        namespace ns5 {
            proc qux {} {
                foo
            }
        }

        Test::eq [ns5::qux] 42
    }
}

;; ============================================================================
;; Import
;; ============================================================================

Test::suite "Import" {
    Test::case "import all bindings from namespace" {
        namespace imp_math_all {
            let imp_ten 10
            proc imp_square {x} { * $x $x }
        }
        import imp_math_all
        Test::eq $imp_ten 10
        Test::eq [imp_square 5] 25
    }

    Test::case "import specific bindings" {
        namespace imp_utils_spec {
            let imp_aa 1
            let imp_bb 2
            let imp_cc 3
        }
        import imp_utils_spec imp_aa imp_cc
        Test::eq $imp_aa 1
        Test::eq $imp_cc 3
        ;; imp_bb should not be imported - accessing it should error
        Test::raises { $imp_bb }
    }

    Test::case "import from nested namespace" {
        namespace imp_outer_nest {
            namespace imp_inner_nest {
                let imp_deep 42
            }
        }
        import imp_outer_nest::imp_inner_nest imp_deep
        Test::eq $imp_deep 42
    }

    Test::case "imported cells share mutation" {
        namespace imp_counter_share {
            var imp_cnt 0
            proc imp_incr {} { set! imp_cnt [+ $imp_cnt 1] }
            proc imp_getval {} { return $imp_cnt }
        }
        import imp_counter_share imp_cnt imp_incr imp_getval
        Test::eq [imp_getval] 0
        imp_incr
        Test::eq [imp_getval] 1
        set! imp_cnt 100
        Test::eq [imp_getval] 100
        Test::eq $imp_counter_share::imp_cnt 100
    }

    Test::case "import inside namespace builder" {
        namespace imp_helpers_ns {
            proc imp_helper {} { return 42 }
        }
        namespace imp_app_ns {
            import imp_helpers_ns imp_helper
            proc imp_run {} { imp_helper }
        }
        Test::eq [imp_app_ns::imp_run] 42
    }

    Test::case "import name conflict errors" {
        namespace imp_conflict_ns {
            let imp_myval 99
        }
        ;; Import twice - second import should conflict with first
        ;; Using catch directly since Test::raises creates a new frame
        import imp_conflict_ns imp_myval
        let caught [catch { import imp_conflict_ns imp_myval }]
        Test::eq $caught 1
    }

    Test::case "import name not found errors" {
        namespace imp_empty_ns {
            let imp_exists 1
        }
        Test::raises { import imp_empty_ns imp_missing }
    }

    Test::case "import with variable reference" {
        namespace imp_ref_ns {
            let imp_refval 123
        }
        let imp_ns $imp_ref_ns
        import $imp_ns imp_refval
        Test::eq $imp_refval 123
    }
}

;; ============================================================================
;; Load
;; ============================================================================

Test::suite "Load" {
    Test::case "load file and call procs" {
        load test/conformance_lib.lcl
        Test::eq [lib_add 10 20] 30
        Test::eq $LIB_CONST 42
    }

    Test::case "load into namespace" {
        namespace imported {
            load test/conformance_lib.lcl
        }
        Test::eq [imported::lib_add 5 5] 10
        Test::eq $imported::LIB_CONST 42
    }
}

;; ============================================================================
;; List Operations
;; ============================================================================

Test::suite "List Operations" {
    Test::case "list creation and length" {
        let mylist [list a b c d e]
        Test::eq [len $mylist] 5
    }

    Test::case "empty list literal ()" {
        let empty ()
        Test::eq [len $empty] 0
        Test::assert [list? $empty]
        Test::eq $empty [list]
    }

    Test::case "get elements by index" {
        let mylist [list a b c d e]
        Test::eq [get $mylist 0] a
        Test::eq [get $mylist 2] c
        Test::eq [get $mylist 4] e
    }

    Test::case "List::slice" {
        let mylist [list a b c d e]
        let slice [List::slice $mylist 1 4]
        Test::eq [len $slice] 3
        Test::eq [get $slice 0] b
        Test::eq [get $slice 2] d
    }

    Test::case "List::concat" {
        let list1 [list 1 2]
        let list2 [list 3 4]
        let combined [List::concat $list1 $list2]
        Test::eq [len $combined] 4
        Test::eq [get $combined 0] 1
        Test::eq [get $combined 3] 4
    }

    Test::case "String::join" {
        let mylist [list a b c d e]
        Test::eq [String::join $mylist -] {a-b-c-d-e}
        Test::eq [String::join $mylist {}] {abcde}
    }

    Test::case "String::split" {
        let parts [String::split "hello,world,test" ","]
        Test::eq [len $parts] 3
        Test::eq [get $parts 0] hello
        Test::eq [get $parts 1] world
    }

    Test::case "List::push" {
        let nums [list 1 2 3]
        let nums [List::push $nums 4]
        let nums [List::push $nums 5]
        Test::eq [len $nums] 5
        Test::eq [get $nums 4] 5
    }

    Test::case "put modifies element" {
        let items [list a b c]
        let items [put $items 1 B]
        Test::eq [get $items 0] a
        Test::eq [get $items 1] B
        Test::eq [get $items 2] c
    }

    Test::case "nested list indexing" {
        let nested [list [list x y] [list z w]]
        Test::eq [get [get $nested 0] 0] x
        Test::eq [get [get $nested 0] 1] y
        Test::eq [get [get $nested 1] 0] z
    }

    Test::case "merge via splat operator" {
        let list1 (1 2 3 4)
        let list2 (5 6 7 8)
        let list3 (@$list1 @$list2)

        Test::eq $list3 (1 2 3 4 5 6 7 8)
        Test::eq $list3 [List::concat $list1 $list2]
        Test::eq [+ [len $list1] [len $list2]] [len $list3]
    }

    Test::case "nested splat" {
        let list1 (1 2 3 4)
        let list2 (4 5 6 7)
        let list3 (1 2 3 (4 5 6 7 @$list2))

        Test::eq $list3 (1 2 3 (4 5 6 7 4 5 6 7))
    }

    Test::case "multi-line lambda inside list literal" {
        ;; Regression test: multi-line lambda bodies in () list literals
        ;; must preserve newlines inside braces for command separation
        let handlers (
            ("key1" [lambda {x} {
                let doubled [* $x 2]
                let result [+ $doubled 10]
                $result
            }])
            ("key2" [lambda {x} {
                let tripled [* $x 3]
                $tripled
            }])
        )
        ;; Verify the list structure
        Test::eq [len $handlers] 2
        Test::eq [get [get $handlers 0] 0] "key1"
        Test::eq [get [get $handlers 1] 0] "key2"
        ;; Call the lambdas and verify they work
        let fn1 [get [get $handlers 0] 1]
        let fn2 [get [get $handlers 1] 1]
        Test::eq [$fn1 5] 20   ;; (5*2) + 10 = 20
        Test::eq [$fn2 5] 15   ;; 5*3 = 15
    }
}

;; ============================================================================
;; Dict Operations
;; ============================================================================

Test::suite "Dict Operations" {
    Test::case "dict create and size" {
        let d [dict a 1 b 2 c 3]
        Test::eq [len $d] 3
    }

    Test::case "empty dict literal #{}" {
        let empty #{}
        Test::eq [len $empty] 0
        Test::assert [dict? $empty]
        Test::eq $empty [dict]
    }

    Test::case "get by key" {
        let d [dict a 1 b 2 c 3]
        Test::eq [get $d a] 1
        Test::eq [get $d b] 2
        Test::eq [get $d c] 3
    }

    Test::case "has? checks key existence" {
        let d [dict a 1 b 2]
        Test::true [has? $d a]
        Test::false [has? $d missing]
    }

    Test::case "Dict::keys" {
        let d [dict a 1 b 2 c 3]
        Test::eq [len [Dict::keys $d]] 3
    }

    Test::case "Dict::values" {
        let d [dict a 1 b 2 c 3]
        Test::eq [len [Dict::values $d]] 3
    }

    Test::case "put updates dict" {
        var md [dict x 10]
        set! md [put $md x 20]
        Test::eq [get $md x] 20
        set! md [put $md y 30]
        Test::eq [get $md y] 30
        Test::eq [len $md] 2
    }

    Test::case "del removes key" {
        var md [dict x 10 y 20]
        set! md [del $md x]
        Test::eq [len $md] 1
        Test::false [has? $md x]
    }

    Test::case "empty dict" {
        let empty [dict]
        Test::eq [len $empty] 0
    }

    Test::case "nested dict" {
        let nested [dict outer [dict inner 42]]
        Test::eq [get [get $nested outer] inner] 42
    }

    Test::case "multi-line lambda inside dict literal" {
        ;; Regression test: multi-line lambda bodies in #{} dict literals
        ;; must preserve newlines inside braces for command separation
        let handlers #{
            process [lambda {x} {
                let doubled [* $x 2]
                let result [+ $doubled 5]
                $result
            }]
            transform [lambda {x} {
                let squared [* $x $x]
                $squared
            }]
        }
        ;; Verify the dict structure
        Test::eq [len $handlers] 2
        Test::true [has? $handlers process]
        Test::true [has? $handlers transform]
        ;; Call the lambdas and verify they work
        let fn1 [get $handlers process]
        let fn2 [get $handlers transform]
        Test::eq [$fn1 10] 25   ;; (10*2) + 5 = 25
        Test::eq [$fn2 5] 25    ;; 5*5 = 25
    }
}

;; ============================================================================
;; Control Flow: if/else
;; ============================================================================

Test::suite "If/Else" {
    Test::case "simple true" {
        var result 0
        if 1 { set! result 1 }
        Test::eq $result 1
    }

    Test::case "simple false" {
        var result 0
        if 0 { set! result 1 }
        Test::eq $result 0
    }

    Test::case "if-else with keyword" {
        var result {}
        if 0 { set! result yes } else { set! result no }
        Test::eq $result no
    }

    Test::case "if-else positional (no keyword)" {
        var result {}
        if 0 { set! result yes } { set! result no }
        Test::eq $result no
    }

    Test::case "nested if (replaces elseif)" {
        var result {}
        if 0 {
            set! result first
        } {
            if 1 {
                set! result second
            } {
                set! result third
            }
        }
        Test::eq $result second
    }

    Test::case "computed condition" {
        let x 5
        var result 0
        if [+ $x 0] { set! result 1 }
        Test::eq $result 1
    }

    Test::case "string truthiness" {
        var result 0
        if hello { set! result 1 }
        Test::eq $result 1
    }

    Test::case "empty string is false" {
        var result 0
        if {} { set! result 1 } else { set! result 2 }
        Test::eq $result 2
    }

    Test::case "if returns last value" {
        let result [if 1 { + 10 20 }]
        Test::eq $result 30
    }
}

;; ============================================================================
;; Control Flow: cond (multi-branch conditional)
;; ============================================================================

Test::suite "Cond" {
    Test::case "first truthy clause wins" {
        let result [cond 0 {first} 1 {second} else {default}]
        Test::eq $result "second"
    }

    Test::case "else clause when no match" {
        let result [cond 0 {first} 0 {second} else {default}]
        Test::eq $result "default"
    }

    Test::case "first clause matches" {
        let result [cond 1 {first} 1 {second} else {default}]
        Test::eq $result "first"
    }

    Test::case "cond with comparisons" {
        let n 5
        let result [cond
                    [== $n 0] {zero}
                    [< $n 0] {negative}
                    else {positive}]
        Test::eq $result "positive"
    }

    Test::case "cond with negative number" {
        let n -3
        let result [cond
                    [== $n 0] {zero}
                    [< $n 0] {negative}
                    else {positive}]
        Test::eq $result "negative"
    }

    Test::case "cond evaluates expression result" {
        let a 10
        let b 20
        let result [cond 0 {wrong} 1 [+ $a $b] else {default}]
        Test::eq $result 30
    }

    Test::case "cond short-circuits" {
        var counter 0
        proc inc_and_check {} {
            set! counter [+ $counter 1]
            0
        }
        ;; Only first two tests should be evaluated
        let result [cond [inc_and_check] {a} [inc_and_check] {b} 1 {c} [inc_and_check] {d}]
        Test::eq $result "c"
        Test::eq $counter 2
    }

    Test::case "cond without else errors on no match" {
        let errored [catch {cond 0 {a} 0 {b}}]
        Test::eq $errored 1
    }
}

;; ============================================================================
;; Control Flow: case (value dispatch)
;; ============================================================================

Test::suite "Case" {
    Test::case "basic string dispatch" {
        let op {add}
        let result [case $op {add} {addition} {sub} {subtraction} else {unknown}]
        Test::eq $result "addition"
    }

    Test::case "else clause when no match" {
        let op {div}
        let result [case $op {add} {addition} {sub} {subtraction} else {unknown}]
        Test::eq $result "unknown"
    }

    Test::case "numeric dispatch" {
        let code 404
        let result [case $code 200 {OK} 404 {Not Found} 500 {Error} else {Other}]
        Test::eq $result "Not Found"
    }

    Test::case "dispatch with variable as key" {
        let expected {mul}
        let op {mul}
        let result [case $op $expected {matched} else {not matched}]
        Test::eq $result "matched"
    }

    Test::case "case evaluates expression result" {
        let op {add}
        let num1 10
        let num2 5
        let result [case $op \
                        {add} [+ $num1 $num2] \
                        {sub} [- $num1 $num2] \
                        else {0}]
        Test::eq $result 15
    }

    Test::case "case short-circuits" {
        var counter 0
        proc inc_and_return {val} {
            set! counter [+ $counter 1]
            $val
        }
        let target {y}
        ;; Only first two keys should be evaluated before match
        let result [case $target \
                        [inc_and_return x] {X} \
                        [inc_and_return y] {Y} \
                        [inc_and_return z] {Z}]
        Test::eq $result "Y"
        Test::eq $counter 2
    }

    Test::case "case without else errors on no match" {
        let errored [catch {case {x} {a} {A} {b} {B}}]
        Test::eq $errored 1
    }

    Test::case "case with list equality" {
        let data [list 1 2 3]
        let result [case $data [list 1 2] {two} [list 1 2 3] {three} else {other}]
        Test::eq $result "three"
    }
}

;; ============================================================================
;; Control Flow: while
;; ============================================================================

Test::suite "While Loop" {
    Test::case "basic countdown" {
        var i 3
        var results [list]
        while $i {
            set! results [List::push $results $i]
            set! i [+ $i -1]
        }
        Test::eq $results [list 3 2 1]
    }

    Test::case "condition false initially" {
        var ran 0
        while 0 { set! ran 1 }
        Test::eq $ran 0
    }

    Test::case "while returns last body value" {
        var x 3
        let result [while $x { set! x [+ $x -1] }]
        Test::eq $result 0
    }
}

;; ============================================================================
;; Control Flow: for
;; ============================================================================

Test::suite "For Loop" {
    Test::case "basic for loop" {
        var results [list]
        for {var i 3} {$i} {set! i [+ $i -1]} {
            set! results [List::push $results $i]
        }
        Test::eq $results [list 3 2 1]
    }

    Test::case "condition false initially" {
        var ran 0
        for {var j 0} {$j} {set! j [+ $j -1]} {
            set! ran 1
        }
        Test::eq $ran 0
    }

    Test::case "for returns last body value" {
        let result [for {var m 3} {$m} {set! m [+ $m -1]} { $m }]
        Test::eq $result 1
    }
}

;; ============================================================================
;; Control Flow: foreach
;; ============================================================================

Test::suite "Foreach Loop" {
    Test::case "basic foreach" {
        var results [list]
        foreach x [list a b c] {
            set! results [List::push $results $x]
        }
        Test::eq $results [list a b c]
    }

    Test::case "foreach over list variable" {
        let items [list 1 2 3]
        var sum 0
        foreach item $items {
            set! sum [+ $sum $item]
        }
        Test::eq $sum 6
    }

    Test::case "empty list" {
        var ran 0
        foreach y [list] {
            set! ran 1
        }
        Test::eq $ran 0
    }

    Test::case "foreach returns last body value" {
        let result [foreach z [list x y z] { $z }]
        Test::eq $result z
    }
}

;; ============================================================================
;; Control Flow: break
;; ============================================================================

Test::suite "Break" {
    Test::case "break in while" {
        var i 5
        var results [list]
        while 1 {
            set! results [List::push $results $i]
            set! i [+ $i -1]
            if $i { } else { break }
        }
        Test::eq $results [list 5 4 3 2 1]
    }

    Test::case "break in for" {
        var count 0
        for {var j 1} {1} {set! j [+ $j 1]} {
            set! count [+ $count 1]
            break
        }
        Test::eq $count 1
    }

    Test::case "break in foreach" {
        var first {}
        foreach x [list a b c] {
            set! first $x
            break
        }
        Test::eq $first a
    }
}

;; ============================================================================
;; Control Flow: continue
;; ============================================================================

Test::suite "Continue" {
    Test::case "continue in while" {
        var i 3
        var results [list]
        while $i {
            let cur $i
            set! i [+ $i -1]
            if [== $cur 2] { continue }
            set! results [List::push $results $cur]
        }
        Test::eq $results [list 3 1]
    }

    Test::case "continue in for" {
        var results [list]
        for {var j 3} {$j} {set! j [+ $j -1]} {
            if [== $j 2] { continue }
            set! results [List::push $results $j]
        }
        Test::eq $results [list 3 1]
    }

    Test::case "continue in foreach" {
        var count 0
        foreach x [list a b c] {
            set! count [+ $count 1]
            continue
        }
        Test::eq $count 3
    }
}

;; ============================================================================
;; Error Handling
;; ============================================================================

Test::suite "Error Handling" {
    Test::case "catch success returns 0" {
        let caught [catch { + 1 2 }]
        Test::eq $caught 0
    }

    Test::case "catch error returns 1" {
        let caught [catch { error "test error" }]
        Test::eq $caught 1
    }

    Test::case "catch with result variable (success)" {
        if [catch { + 10 20 } res msg] {
            Test::assert 0
        } else {
            Test::eq $res 30
        }
    }

    Test::case "catch with error variable" {
        if [catch { error "my error" } res msg] {
            Test::eq $msg {my error}
        } else {
            Test::assert 0
        }
    }

    Test::case "catch nested error" {
        proc may_fail {x} {
            if [== $x 0] {
                error "cannot be zero"
            }
            return [+ $x 1]
        }
        if [catch { may_fail 0 } res msg] {
            Test::eq $msg {cannot be zero}
        } else {
            Test::assert 0
        }
    }

    Test::case "catch nested success" {
        proc may_fail2 {x} {
            if [== $x 0] {
                error "cannot be zero"
            }
            return [+ $x 1]
        }
        if [catch { may_fail2 5 } res msg] {
            Test::assert 0
        } else {
            Test::eq $res 6
        }
    }
}

;; ============================================================================
;; @ Expansion Operator
;; ============================================================================

Test::suite "@ Expansion Operator" {
    Test::case "expand list to operator" {
        let nums [list 1 2 3 4 5]
        Test::eq [+ @$nums] 15
    }

    Test::case "expand in list construction" {
        let a [list 1 2]
        let b [list 3 4]
        let combined [list @$a @$b]
        Test::eq $combined [list 1 2 3 4]
    }

    Test::case "expand single value" {
        let single 42
        Test::eq [+ 1 @$single] 43
    }

    Test::case "expand empty list" {
        let empty [list]
        let result [list a @$empty b]
        Test::eq $result [list a b]
    }

    Test::case "expand in proc arguments" {
        proc sum3 {a b c} { + $a [+ $b $c] }
        let args [list 10 20 30]
        Test::eq [sum3 @$args] 60
    }

    Test::case "multiple expansions" {
        let x [list 1 2]
        let y [list 3 4]
        Test::eq [+ @$x @$y] 10
    }
}

;; ============================================================================
;; Equality Operators
;; ============================================================================

Test::suite "Equality Operators" {
    Test::case "== value equality" {
        Test::true [== 1 1]
        Test::false [== 1 2]
        Test::true [== hello hello]
        Test::false [== hello world]
    }

    Test::case "numeric promotion" {
        Test::true [== 1 1.0]
    }

    Test::case "list deep equality" {
        let l1 [list 1 2 3]
        let l2 [list 1 2 3]
        let l3 [list 1 2 4]
        Test::true [== $l1 $l2]
        Test::false [== $l1 $l3]
    }

    Test::case "dict deep equality" {
        let d1 [dict a 1 b 2]
        let d2 [dict a 1 b 2]
        let d3 [dict a 1 b 3]
        Test::true [== $d1 $d2]
        Test::false [== $d1 $d3]
    }

    Test::case "!= inequality" {
        Test::false [!= 1 1]
        Test::true [!= 1 2]
    }

    Test::case "same? identity" {
        let x 42
        Test::true [same? $x $x]
        let y 42
        Test::false [same? $x $y]
    }

    Test::case "cell? predicate" {
        Test::true [cell? [ref 1]]
        Test::false [cell? 1]
    }

    Test::case "same-binding? for cells" {
        var p 100
        var q 200
        Test::true [same-binding? p p]
        Test::false [same-binding? p q]
    }
}

;; ============================================================================
;; Equality with Control Flow
;; ============================================================================

Test::suite "Equality with Control Flow" {
    Test::case "while with != condition" {
        var i 5
        var target 2
        while [!= $i $target] {
            set! i [+ $i -1]
        }
        Test::eq $i $target
    }

    Test::case "for loop with list comparison" {
        var built [list]
        for {var j 1} {[!= $j 4]} {set! j [+ $j 1]} {
            set! built [List::push $built $j]
        }
        Test::eq $built [list 1 2 3]
    }

    Test::case "foreach find matching element" {
        let haystack [list apple banana cherry date]
        var found 0
        foreach item $haystack {
            if [== $item cherry] {
                set! found 1
                break
            }
        }
        Test::eq $found 1
    }

    Test::case "foreach filter with !=" {
        var kept [list]
        foreach x [list a skip b skip c] {
            if [!= $x skip] {
                set! kept [List::push $kept $x]
            }
        }
        Test::eq $kept [list a b c]
    }

    Test::case "continue with equality check" {
        var sum 0
        foreach n [list 1 2 3 4 5] {
            if [== $n 3] {
                continue
            }
            set! sum [+ $sum $n]
        }
        Test::eq $sum 12
    }
}

;; ============================================================================
;; Lexical Scoping
;; ============================================================================

Test::suite "Lexical Scoping" {
    Test::case "closure captures outer variable" {
        let outer 100
        proc get_outer {} {
            $outer
        }
        Test::eq [get_outer] 100
    }

    Test::case "shadowing" {
        let shadow outer
        proc test_shadow {} {
            let shadow inner
            $shadow
        }
        Test::eq [test_shadow] inner
        Test::eq $shadow outer
    }

    Test::case "closure captures value at definition time" {
        let capture_val A
        proc capture_test {} {
            $capture_val
        }
        let capture_val B
        Test::eq [capture_test] A
    }

    Test::case "cell mutation through closure" {
        var counter 0
        proc incr_counter {} {
            set! counter [+ $counter 1]
            $counter
        }
        Test::eq [incr_counter] 1
        Test::eq [incr_counter] 2
        Test::eq $counter 2
    }

    Test::case "multiple closures sharing cell" {
        var shared 0
        proc add_to_shared {n} {
            set! shared [+ $shared $n]
        }
        proc get_shared {} {
            $shared
        }
        add_to_shared 10
        add_to_shared 5
        Test::eq [get_shared] 15
    }

    Test::case "nested closures" {
        proc make_adder {x} {
            lambda {y} {
                + $x $y
            }
        }
        let add5 [make_adder 5]
        let add10 [make_adder 10]
        Test::eq [$add5 3] 8
        Test::eq [$add10 3] 13
    }

    Test::case "counter factory - independent counters" {
        proc make_counter {} {
            var n 0
            lambda {} {
                set! n [+ $n 1]
                $n
            }
        }
        let c1 [make_counter]
        let c2 [make_counter]
        Test::eq [$c1] 1
        Test::eq [$c1] 2
        Test::eq [$c2] 1
    }

    Test::case "proc parameter shadows outer" {
        let param_test outer_value
        proc param_shadow {param_test} {
            $param_test
        }
        Test::eq [param_shadow inner_value] inner_value
        Test::eq $param_test outer_value
    }

    Test::case "closures capture each iteration value" {
        var closures [list]
        foreach iter_val [list 1 2 3] {
            set! closures [List::push $closures [lambda {} { $iter_val }]]
        }
        Test::eq [[get $closures 0]] 1
        Test::eq [[get $closures 1]] 2
        Test::eq [[get $closures 2]] 3
    }

    Test::case "mutual recursion is rejected" {
        ;; Mutual recursion creates reference cycles that cannot be freed
        ;; with reference counting (no GC). LCL detects and rejects this.
        var is_even_fn {}
        var is_odd_fn {}
        set! is_even_fn [lambda {n} {
            if [== $n 0] { return 1 }
            [$is_odd_fn [+ $n -1]]
        }]
        ;; This should fail - is_odd_fn captures is_even_fn which captures is_odd_fn
        Test::raises {
            set! is_odd_fn [lambda {n} {
                if [== $n 0] { return 0 }
                [$is_even_fn [+ $n -1]]
            }]
        }
    }
}

;; ============================================================================
;; Threading Operators
;; ============================================================================

Test::suite "Threading Operators" {
    Test::case "-> thread-first with get" {
        let d [dict a 1 b 2 c 3]
        Test::eq [-> $d {get b}] 2
    }

    Test::case "-> chained" {
        let d [dict a 1 b 2]
        let d2 [-> $d {put c 3} {del a}]
        Test::true [has? $d2 c]
        Test::false [has? $d2 a]
    }

    Test::case "-> identity" {
        Test::eq [-> 42] 42
    }

    Test::case "-> with String::upper" {
        Test::eq [-> hello {String::upper}] HELLO
    }

    Test::case "->> thread-last" {
        proc greet {greeting name} {
            return "$greeting, $name!"
        }
        Test::eq [->> World {greet Hello}] {Hello, World!}
    }

    Test::case "->> identity" {
        Test::eq [->> hello] hello
    }

    Test::case "-> with lambda" {
        let inc [lambda {x} {+ $x 1}]
        Test::eq [-> 10 {$inc}] 11
    }

    Test::case "-> with inline lambda" {
        Test::eq [-> 10 {[lambda {x} {+ $x 100}]}] 110
    }
}

;; ============================================================================
;; Functional Primitives
;; ============================================================================

Test::suite "Functional Primitives" {
    Test::case "List::map" {
        let lst [list 1 2 3 4 5]
        let doubled [List::map [lambda {x} {* $x 2}] $lst]
        Test::eq $doubled [list 2 4 6 8 10]
    }

    Test::case "List::filter" {
        let lst [list 1 2 3 4 5]
        let evens [List::filter [lambda {x} {== [% $x 2] 0}] $lst]
        Test::eq $evens [list 2 4]
    }

    Test::case "List::reduce" {
        let lst [list 1 2 3 4 5]
        let sum [List::reduce 0 [lambda {acc x} {+ $acc $x}] $lst]
        Test::eq $sum 15
    }

    Test::case "Dict::map" {
        let d [dict a 1 b 2 c 3]
        let mapped [Dict::map [lambda {k v} {* $v 10}] $d]
        Test::eq [len [Dict::keys $mapped]] 3
    }

    Test::case "Dict::filter" {
        let d [dict a 1 b 2 c 3]
        let filtered [Dict::filter [lambda {k v} {> $v 1}] $d]
        Test::eq [len [Dict::keys $filtered]] 2
    }

    Test::case "Dict::reduce" {
        let d [dict a 1 b 2 c 3]
        let sum [Dict::reduce 0 [lambda {acc k v} {+ $acc $v}] $d]
        Test::eq $sum 6
    }
}

;; ============================================================================
;; List:: Namespace Functions
;; ============================================================================

Test::suite "List:: Namespace" {
    Test::case "List::new" {
        Test::eq [List::new a b c] [list a b c]
    }

    Test::case "List::push" {
        Test::eq [List::push [list 1 2] 3] [list 1 2 3]
        Test::eq [List::push [list] x] [list x]
    }

    Test::case "List::pop" {
        Test::eq [List::pop [list a b c]] [list a b]
        Test::eq [len [List::pop [list x]]] 0
    }

    Test::case "List::slice" {
        Test::eq [List::slice [list a b c d e] 1 4] [list b c d]
        Test::eq [List::slice [list 1 2 3 4 5] 0 3] [list 1 2 3]
    }

    Test::case "List::concat" {
        Test::eq [List::concat [list a b] [list c d]] [list a b c d]
        Test::eq [List::concat [list 1 2] [list]] [list 1 2]
    }

    Test::case "List::reverse" {
        Test::eq [List::reverse [list 1 2 3 4]] [list 4 3 2 1]
        Test::eq [List::reverse [list x]] [list x]
        Test::eq [len [List::reverse [list]]] 0
    }

    Test::case "List::index" {
        Test::eq [List::index [list a b c d] 2] c
    }

    Test::case "List::range" {
        Test::eq [List::range 1 5] [list 1 2 3 4]
        Test::eq [List::range 0 10 2] [list 0 2 4 6 8]
        Test::eq [List::range 5 0 -1] [list 5 4 3 2 1]
        Test::eq [len [List::range 5 5]] 0
    }

    Test::case "List::sort" {
        let sorted [List::sort [list banana apple cherry]]
        Test::eq [get $sorted 0] apple
        Test::eq [get $sorted 1] banana
        Test::eq [get $sorted 2] cherry
    }

    Test::case "List::sort_by" {
        let nums [list 10 2 5 1 20]
        let cmp [lambda {a b} { if [< $a $b] { return -1 }; if [> $a $b] { return 1 }; return 0 }]
        let sorted [List::sort_by $cmp $nums]
        Test::eq $sorted [list 1 2 5 10 20]
    }

    Test::case "List::find" {
        let lst [list 1 5 10 15 20]
        Test::eq [List::find [lambda {x} {> $x 8}] $lst] 10
        Test::empty [List::find [lambda {x} {> $x 100}] $lst]
    }

    Test::case "List::any?" {
        let lst [list 1 2 3 4 5]
        Test::true [List::any? [lambda {x} {> $x 4}] $lst]
        Test::false [List::any? [lambda {x} {> $x 100}] $lst]
        Test::false [List::any? [lambda {x} {== $x 1}] [list]]
    }

    Test::case "List::all?" {
        let lst [list 1 2 3 4 5]
        Test::true [List::all? [lambda {x} {> $x 0}] $lst]
        Test::false [List::all? [lambda {x} {> $x 3}] $lst]
        Test::true [List::all? [lambda {x} {== $x impossible}] [list]]
    }

    Test::case "List::unique" {
        let dupes [list a b a c b d a]
        let unique [List::unique $dupes]
        Test::eq [len $unique] 4
        Test::eq [get $unique 0] a
        Test::eq [get $unique 1] b
        Test::eq [get $unique 2] c
        Test::eq [get $unique 3] d
    }

    Test::case "List::flatten" {
        let nested [list [list 1 2] [list 3 4] 5]
        let flat [List::flatten $nested]
        Test::eq [len $flat] 5
        Test::eq [get $flat 0] 1
        Test::eq [get $flat 4] 5
    }
}

;; ============================================================================
;; Dict:: Namespace Functions
;; ============================================================================

Test::suite "Dict:: Namespace" {
    Test::case "Dict::new" {
        let d [Dict::new x 1 y 2]
        Test::eq [len $d] 2
        Test::eq [get $d x] 1
    }

    Test::case "Dict::keys" {
        Test::eq [len [Dict::keys [dict a 1 b 2 c 3]]] 3
    }

    Test::case "Dict::values" {
        Test::eq [len [Dict::values [dict a 10 b 20 c 30]]] 3
    }

    Test::case "Dict::items" {
        let items [Dict::items [dict x 1 y 2]]
        Test::eq [len $items] 2
        Test::eq [len [get $items 0]] 2
    }

    Test::case "Dict::merge" {
        let d1 [dict a 1 b 2]
        let d2 [dict b 20 c 30]
        let merged [Dict::merge $d1 $d2]
        Test::eq [len $merged] 3
        Test::eq [get $merged a] 1
        Test::eq [get $merged b] 20
        Test::eq [get $merged c] 30
    }

    Test::case "Dict::map" {
        let mapped [Dict::map [lambda {k v} {* $v 2}] [dict a 1 b 2 c 3]]
        Test::eq [get $mapped a] 2
        Test::eq [get $mapped b] 4
        Test::eq [get $mapped c] 6
    }

    Test::case "Dict::filter" {
        let filtered [Dict::filter [lambda {k v} {> $v 1}] [dict a 1 b 2 c 3]]
        Test::eq [len [Dict::keys $filtered]] 2
        Test::false [has? $filtered a]
        Test::true [has? $filtered b]
    }

    Test::case "Dict::reduce" {
        let sum [Dict::reduce 0 [lambda {acc k v} {+ $acc $v}] [dict a 1 b 2 c 3]]
        Test::eq $sum 6
    }
}

;; ============================================================================
;; String:: Namespace Functions
;; ============================================================================

Test::suite "String:: Namespace" {
    Test::case "String::upper" {
        Test::eq [String::upper hello] HELLO
        Test::eq [String::upper HeLLo] HELLO
        Test::eq [String::upper abc123] ABC123
    }

    Test::case "String::lower" {
        Test::eq [String::lower HELLO] hello
        Test::eq [String::lower HeLLo] hello
        Test::eq [String::lower ABC123] abc123
    }

    Test::case "String::find" {
        Test::eq [String::find hello ll] 2
        Test::eq [String::find hello h] 0
        Test::eq [String::find hello o] 4
        Test::eq [String::find hello xyz] -1
    }

    Test::case "String::replace" {
        Test::eq [String::replace hello ll LL] heLLo
        Test::eq [String::replace hello he HE] HEllo
        Test::eq [String::replace hello lo LO] helLO
        Test::eq [String::replace hello ll {}] heo
        Test::eq [String::replace hello xyz ZZZ] hello
    }

    Test::case "String::split" {
        Test::eq [String::split "a,b,c" ","] [list a b c]
        Test::eq [len [String::split hello ","]] 1
    }

    Test::case "String::join" {
        Test::eq [String::join [list a b c] -] a-b-c
        Test::eq [String::join [list x y z] {}] xyz
        Test::eq [String::join [list 1 2 3] ", "] {1, 2, 3}
        Test::eq [String::join [list only] -] only
        Test::eq [String::join [list] -] {}
    }

    Test::case "String::length" {
        Test::eq [String::length hello] 5
        Test::eq [String::length {}] 0
        Test::eq [String::length "hello world"] 11
    }

    Test::case "String::index" {
        Test::eq [String::index hello 0] h
        Test::eq [String::index hello 4] o
        Test::eq [String::index hello -1] o
        Test::eq [String::index hello -2] l
    }

    Test::case "String::range" {
        Test::eq [String::range hello 1 4] ell
        Test::eq [String::range hello 0 2] he
        Test::eq [String::range hello 0 -1] hell
        Test::eq [String::range hello -3 -1] ll
    }

    Test::case "String::trim" {
        Test::eq [String::trim "  hello  "] hello
        Test::eq [String::trim "\thello\n"] hello
        Test::eq [String::trim hello] hello
        Test::eq [String::trim "   "] {}
    }
}

;; ============================================================================
;; Tail Call Optimization
;; ============================================================================

Test::suite "Tail Call Optimization" {
    Test::case "deep self-recursion doesn't overflow" {
        proc count {n} {
            if [== $n 0] { 0 } else { [count [- $n 1]] }
        }
        ;; Would overflow without TCO (default max_depth is 1024)
        Test::eq [count 5000] 0
    }

    Test::case "tail position in if branch" {
        proc factorial {n acc} {
            if [<= $n 1] { $acc } else { [factorial [- $n 1] [* $n $acc]] }
        }
        Test::eq [factorial 10 1] 3628800
    }

    Test::case "named lambda gets TCO" {
        let sum_to [lambda sum_to {n acc} {
            if [== $n 0] { $acc } else { [sum_to [- $n 1] [+ $n $acc]] }
        }]
        Test::eq [sum_to 1000 0] 500500
    }

    Test::case "non-tail call still works" {
        proc sum {n} {
            if [== $n 0] { 0 } else { [+ $n [sum [- $n 1]]] }
        }
        ;; Not a tail call - + happens after recursive call
        Test::eq [sum 10] 55
    }

    Test::case "anonymous lambda no TCO" {
        ;; Anonymous lambdas have no self_name so can't do TCO
        ;; This should work for small n but would overflow for large n
        let anon [lambda {n} {
            if [== $n 0] { $n } else { [$anon [- $n 1]] }
        }]
        Test::eq [$anon 10] 0
    }
}

;; ============================================================================
;; Type Conversion
;; ============================================================================

Test::suite "Type Conversion" {
    Test::case "int from integer string" {
        Test::eq [int 42] 42
        Test::eq [int -10] -10
        Test::eq [int 0] 0
    }

    Test::case "int from float string truncates" {
        Test::eq [int 3.14] 3
        Test::eq [int 3.99] 3
        Test::eq [int -2.7] -2
    }

    Test::case "int from float value truncates" {
        let f [float 3.14]
        Test::eq [int $f] 3
    }

    Test::case "int preserves int value" {
        let i [int 42]
        Test::eq [int $i] 42
        Test::true [int? [int 42]]
    }

    Test::case "float from float string" {
        let f [float 3.14]
        Test::true [float? $f]
    }

    Test::case "float from integer" {
        let f [float 42]
        Test::true [float? $f]
    }

    Test::case "float preserves float value" {
        let f [float 3.14]
        Test::true [float? [float $f]]
    }

    Test::case "numeric sort ascending" {
        let nums [list 1 10 2 20 3]
        let sorted [List::sort_by [lambda {a b} { > [int $a] [int $b] }] $nums]
        Test::eq [get $sorted 0] 1
        Test::eq [get $sorted 1] 2
        Test::eq [get $sorted 2] 3
        Test::eq [get $sorted 3] 10
        Test::eq [get $sorted 4] 20
    }

    Test::case "numeric sort descending" {
        let nums [list 1 10 2 20 3]
        let sorted [List::sort_by [lambda {a b} { < [int $a] [int $b] }] $nums]
        Test::eq [get $sorted 0] 20
        Test::eq [get $sorted 1] 10
        Test::eq [get $sorted 2] 3
        Test::eq [get $sorted 3] 2
        Test::eq [get $sorted 4] 1
    }
}

;; ============================================================================
;; Quasiquote
;; ============================================================================

Test::suite "Quasiquote" {
    Test::case "basic unquote with variable" {
        let x 42
        Test::eq [quasiquote {value is ,$x}] {value is 42}
    }

    Test::case "unquote with command substitution" {
        Test::eq [quasiquote {sum is ,[+ 1 2 3]}] {sum is 6}
    }

    Test::case "splice-unquote with string" {
        let items {a b c}
        Test::eq [quasiquote {list: ,@$items end}] {list: a b c end}
    }

    Test::case "splice-unquote with list value" {
        let mylist [list x y z]
        Test::eq [quasiquote {items: ,@$mylist done}] {items: x y z done}
    }

    Test::case "braced literal unquote" {
        ;; ,{...} inserts the literal text
        Test::eq [quasiquote {result: ,{name}}] {result: name}
    }

    Test::case "multiple unquotes" {
        let a 1
        let b 2
        Test::eq [quasiquote {a=,$a b=,$b}] {a=1 b=2}
    }

    Test::case "unquote with computed value" {
        let a 10
        let b 20
        Test::eq [quasiquote {total: ,[+ $a $b]}] {total: 30}
    }

    Test::case "defun macro pattern" {
        ;; Macro returns code, caller evals it
        proc defun {name params body} {
            return [quasiquote {
                proc ,$name {,@$params} {,$body}
            }]
        }
        eval [defun add2 {x y} { + $x $y }]
        Test::eq [add2 3 4] 7
    }

    Test::case "backslash preserves comma" {
        let x 42
        Test::eq [quasiquote {value is \,x}] {value is ,x}
    }

    Test::case "nested quasiquote passes comma through" {
        ;; At depth 2, a single comma should be preserved as literal
        let x 42
        Test::eq [quasiquote {quasiquote {value is ,$x}}] {quasiquote {value is ,$x}}
    }

    Test::case "nested quasiquote with double comma" {
        ;; At depth 2, ,, evaluates outer and preserves inner comma
        ;; Simple values like 42 become bare words (,42), not braced
        let x 42
        Test::eq [quasiquote {quasiquote {value is ,,$x}}] {quasiquote {value is ,42}}
    }

    Test::case "list literal in unquote" {
        ;; ,(a b c) evaluates list literal
        Test::eq [quasiquote {items: ,(a b c)}] {items: a b c}
    }

    Test::case "dict literal in unquote" {
        ;; ,#{...} evaluates dict literal
        let d [quasiquote {data: ,#{name test val 123}}]
        ;; The dict will be stringified - "name" is at position 6
        Test::eq [String::find $d "name"] 6
    }
}

;; ============================================================================
;; Multiline Subcommands
;; ============================================================================

Test::suite "Multiline Subcommands" {
    Test::case "multiline list inside brackets" {
        ;; Inside [...], newlines are whitespace - no backslash needed
        let result [list
            a
            b
            c
        ]
        Test::eq [len $result] 3
        Test::eq [get $result 0] a
        Test::eq [get $result 1] b
        Test::eq [get $result 2] c
    }

    Test::case "nested subcommands across lines" {
        ;; This was the original bug - only the last element was kept
        let result [list
            [list x y]
            [list p q]
            [list m n]
        ]
        Test::eq [len $result] 3
        Test::eq [get $result 0] [list x y]
        Test::eq [get $result 1] [list p q]
        Test::eq [get $result 2] [list m n]
    }

    Test::case "multiline case inside brackets" {
        let op {add}
        let a 10
        let b 5
        let result [case $op
            {add} [+ $a $b]
            {sub} [- $a $b]
            {mul} [* $a $b]
            else  0]
        Test::eq $result 15
    }

    Test::case "multiline cond inside brackets" {
        let x 5
        let result [cond
            [< $x 0]   {negative}
            [== $x 0]  {zero}
            else       {positive}]
        Test::eq $result positive
    }

    Test::case "semicolons inside braces preserved" {
        ;; Semicolons inside {...} must NOT be converted to spaces
        let script {echo hello; echo world}
        Test::eq $script {echo hello; echo world}
    }

    Test::case "semicolons inside braces in subcommand" {
        ;; Even inside [...], braced content keeps its semicolons
        let result [list {a; b} {c; d}]
        Test::eq [get $result 0] {a; b}
        Test::eq [get $result 1] {c; d}
    }

    Test::case "newlines inside quotes preserved" {
        let text "line1
line2"
        Test::eq [String::find $text "\n"] 5
    }

    Test::case "bare command needs backslash continuation" {
        ;; This tests that backslash continuation still works
        let result [list \
            item1 \
            item2 \
            item3]
        Test::eq [len $result] 3
    }

    Test::case "nested brackets with multiline" {
        ;; Deeply nested multiline expressions
        let result [list
            [dict
                a 1
                b 2]
            [dict
                c 3
                d 4]]
        Test::eq [len $result] 2
        Test::eq [get [get $result 0] a] 1
        Test::eq [get [get $result 1] d] 4
    }

    Test::case "multiline with list literals" {
        let result [list
            (nested list)
            (another one)
        ]
        Test::eq [len $result] 2
        Test::eq [get $result 0] (nested list)
    }

    Test::case "eval with multiline block" {
        ;; eval {...} with multiple statements still works
        let result [eval {
            let a 10
            let b 20
            + $a $b
        }]
        Test::eq $result 30
    }
}

;; ============================================================================
;; Optional Parameters
;; ============================================================================

Test::suite "Optional Parameters" {
    Test::case "optional with default" {
        proc greet {name (greeting "Hello")} {
            "$greeting, $name!"
        }
        Test::eq [greet "World"] "Hello, World!"
        Test::eq [greet "Alice" "Hi"] "Hi, Alice!"
    }

    Test::case "multiple optionals" {
        proc range_opts {(start 0) (end 10) (step 1)} {
            list $start $end $step
        }
        Test::eq [range_opts] (0 10 1)
        Test::eq [range_opts 5] (5 10 1)
        Test::eq [range_opts 5 20] (5 20 1)
        Test::eq [range_opts 5 20 2] (5 20 2)
    }

    Test::case "default references earlier param" {
        proc range_end {start (end [+ $start 10])} {
            list $start $end
        }
        Test::eq [range_end 5] (5 15)
        Test::eq [range_end 5 20] (5 20)
    }

    Test::case "default evaluated per call" {
        var counter 0
        proc incr {} { set! counter [+ $counter 1]; $counter }
        proc next_id {(id [incr])} { $id }
        Test::eq [next_id] 1
        Test::eq [next_id] 2
        Test::eq [next_id 99] 99
        Test::eq [next_id] 3
    }

    Test::case "optional with default should work with lambdas" {
        let greet [lambda {name (greeting "Hello")} {
            "$greeting, $name!"
        }]

        Test::eq [greet "world"] "Hello, world!"
        Test::eq [greet "Alice" "Hi"] "Hi, Alice!"
    }

    Test::case "multiple optionals with lambdas" {
        let range_opts [lambda {(start 0) (end 10) (step 1)} {
            list $start $end $step
        }]

        Test::eq [range_opts] (0 10 1)
        Test::eq [range_opts 5] (5 10 1)
        Test::eq [range_opts 5 20] (5 20 1)
        Test::eq [range_opts 5 20 2] (5 20 2)
    }

    Test::case "default references earlier param with lambdas" {
        let range_end [lambda {start (end [+ $start 10])} {
            list $start $end
        }]
        Test::eq [range_end 5] (5 15)
        Test::eq [range_end 5 20] (5 20)
    }

    Test::case "default evaluated per call with lambdas" {
        var counter 0
        let incr [lambda {} { set! counter [+ $counter 1]; $counter }]
        let next_id [lambda {(id [incr])} { $id }]
        Test::eq [next_id] 1
        Test::eq [next_id] 2
        Test::eq [next_id 99] 99
        Test::eq [next_id] 3
    }
}

;; ============================================================================
;; Rest Parameters
;; ============================================================================

Test::suite "Rest Parameters" {
    Test::case "basic rest parameter" {
        proc sum {*xs} {
            var acc 0
            foreach x $xs { set! acc [+ $acc $x] }
            $acc
        }
        Test::eq [sum 1 2 3 4 5] 15
        Test::eq [sum] 0
    }

    Test::case "required and rest" {
        proc join_with {sep *items} {
            if [== [len $items] 0] { return "" }
            var result [get $items 0]
            foreach item [List::slice $items 1 [len $items]] {
                set! result "$result$sep$item"
            }
            $result
        }
        Test::eq [join_with "," "a" "b" "c"] "a,b,c"
        Test::eq [join_with "-" "foo"] "foo"
        Test::eq [join_with "|"] ""
    }

    Test::case "required, optional, and rest" {
        proc window {n (step 1) *xs} {
            list $n $step $xs
        }
        Test::eq [window 3] (3 1 ())
        Test::eq [window 3 2] (3 2 ())
        Test::eq [window 3 2 "a" "b" "c"] (3 2 ("a" "b" "c"))
    }

    Test::case "basic rest parameter with lambdas" {
        let sum [lambda {*xs} {
            var acc 0
            foreach x $xs { set! acc [+ $acc $x] }
            $acc
        }]
        Test::eq [sum 1 2 3 4 5] 15
        Test::eq [sum] 0
    }

    Test::case "required and rest with lambdas" {
        let join_with [lambda {sep *items} {
            if [== [len $items] 0] { return "" }
            var result [get $items 0]
            foreach item [List::slice $items 1 [len $items]] {
                set! result "$result$sep$item"
            }
            $result
        }]
        Test::eq [join_with "," "a" "b" "c"] "a,b,c"
        Test::eq [join_with "-" "foo"] "foo"
        Test::eq [join_with "|"] ""
    }

    Test::case "required, optional, and rest with lambdas" {
        let window [lambda {n (step 1) *xs} {
            list $n $step $xs
        }]
        Test::eq [window 3] (3 1 ())
        Test::eq [window 3 2] (3 2 ())
        Test::eq [window 3 2 "a" "b" "c"] (3 2 ("a" "b" "c"))
    }
}

;; ============================================================================
;; Apply and Arity
;; ============================================================================

Test::suite "Apply and Arity" {
    Test::case "apply with c proc" {
        Test::eq [apply ${+} (1 2 3)] 6
        Test::eq [apply ${*} (2 3 4)] 24
    }

    Test::case "apply with user proc" {
        proc sum {*xs} {
            var acc 0
            foreach x $xs { set! acc [+ $acc $x] }
            $acc
        }
        Test::eq [apply ${sum} (10 20 30)] 60
        Test::eq [apply ${sum} ()] 0
    }

    Test::case "apply with spread" {
        proc window {n (step 1) *xs} { list $n $step $xs }
        let args (3 2 "a" "b" "c")
        Test::eq [apply ${window} $args] (3 2 ("a" "b" "c"))
    }

    Test::case "arity of required-only proc" {
        proc foo {a b c} { + $a $b $c }
        Test::eq [arity ${foo}] (3 3)
    }

    Test::case "arity of optional proc" {
        proc bar {a (b 10)} { + $a $b }
        Test::eq [arity ${bar}] (1 2)
    }

    Test::case "arity of rest proc" {
        proc baz {*xs} { len $xs }
        Test::eq [arity ${baz}] (0 -1)
    }

    Test::case "arity of combined proc" {
        proc qux {a (b 1) *rest} { list $a $b $rest }
        Test::eq [arity ${qux}] (1 -1)
    }

    Test::case "arity of c proc" {
        ;; C procs report (0 -1) since their arity isn't tracked
        Test::eq [arity ${+}] (0 -1)
    }
}

;; ============================================================================
;; Parameter Validation Errors
;; ============================================================================

Test::suite "Parameter Validation Errors" {
    Test::case "too few arguments" {
        proc needs_two {a b} { + $a $b }
        let errored [catch { needs_two 1 }]
        Test::eq $errored 1
    }

    Test::case "too many arguments (no rest)" {
        proc takes_two {a (b 10)} { + $a $b }
        let errored [catch { takes_two 1 2 3 }]
        Test::eq $errored 1
    }

    Test::case "rest accepts any extra" {
        proc takes_rest {a *rest} { list $a $rest }
        let errored [catch { takes_rest 1 2 3 4 5 }]
        Test::eq $errored 0
    }
}

;; ============================================================================
;; Regression Tests (from ISSUES.md audit)
;; ============================================================================

Test::suite "Issue #6: Modulo by zero" {
    Test::case "modulo by zero returns error, not crash" {
        let errored [catch { % 5 0 }]
        Test::eq $errored 1
    }

    Test::case "modulo with valid divisor still works" {
        Test::eq [% 10 3] 1
    }
}

Test::suite "Issue #7: Float precision" {
    Test::case "float conversion preserves double precision" {
        ;; pi to 15 decimal places -- should not be truncated to 32-bit float
        let pi_str "3.141592653589793"
        let pi_val [float $pi_str]
        ;; With correct double parsing, the first 15 digits should be preserved.
        ;; With the bug (32-bit float), it becomes 3.1415927410125732
        Test::assert [!= $pi_val 3.1415927410125732]
    }
}

;; Define strings with unbalanced braces at top level (the brace scanner
;; inside { } doesn't process escapes, so \} would break brace balancing)
let _i14_rbrace "a\}b"
let _i14_lbrace "a\{b"

Test::suite "Issue #14: List brace escaping" {
    Test::case "list element with spaces round-trips" {
        ;; Elements with spaces require bracing in stringified lists
        let mylist [list "hello world" "foo bar"]
        Test::eq [len $mylist] 2
        Test::eq [get $mylist 0] "hello world"
        Test::eq [get $mylist 1] "foo bar"
    }

    Test::case "list element with dollar sign round-trips" {
        let mylist [list "a" "b\$c"]
        Test::eq [len $mylist] 2
        Test::eq [get $mylist 1] "b\$c"
    }

    Test::case "element with unbalanced close brace round-trips" {
        ;; _i14_rbrace contains an unbalanced brace - defined at top level
        let mylist [list $_i14_rbrace]
        Test::eq [len $mylist] 1
        ;; Re-parse stringified list - the element must survive
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $_i14_rbrace
    }

    Test::case "element with unbalanced open brace round-trips" {
        let mylist [list $_i14_lbrace]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $_i14_lbrace
    }

    Test::case "element with bracket round-trips" {
        let elem "x\[y"
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "element with backslash round-trips" {
        let elem "a\\b"
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "element with double quote round-trips" {
        let elem "say \"hi\""
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "element with semicolon round-trips" {
        let elem "a;b"
        let mylist [list $elem]
        Test::eq [len $mylist] 1
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 1
        Test::eq [get $reparsed 0] $elem
    }

    Test::case "mixed bare, braced, and quoted elements" {
        ;; bare: simple, braced: has space, quoted: has unbalanced brace
        let mylist [list simple "hello world" $_i14_rbrace]
        Test::eq [len $mylist] 3
        let reparsed [eval "list $mylist"]
        Test::eq [len $reparsed] 3
        Test::eq [get $reparsed 0] simple
        Test::eq [get $reparsed 1] "hello world"
        Test::eq [get $reparsed 2] $_i14_rbrace
    }
}

Test::suite "Issue #16: Arithmetic type preservation" {
    Test::case "integer addition returns int" {
        Test::assert [int? [+ 1 2]]
    }

    Test::case "float addition returns float" {
        Test::assert [float? [+ 1.5 2.5]]
    }

    Test::case "mixed addition returns float" {
        Test::assert [float? [+ 1 2.5]]
    }

    Test::case "integer subtraction returns int" {
        Test::assert [int? [- 5 3]]
    }

    Test::case "integer multiplication returns int" {
        Test::assert [int? [* 3 4]]
    }
}

Test::run

