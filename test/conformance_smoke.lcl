;; Lcl Conformance Smoke Tests -- runner.
;; The suites live in test/conformance/*.lcl (split 2026-08-15);
;; each part registers its Test::suite blocks via load, then a
;; single Test::run executes everything. Paths are CWD-relative:
;; run from the repo root, as before:
;;   ./build/lcl test/conformance_smoke.lcl

load test/conformance/core.lcl
load test/conformance/namespaces.lcl
load test/conformance/namespace_scoping.lcl
load test/conformance/modules.lcl
load test/conformance/containers.lcl
load test/conformance/control_flow.lcl
load test/conformance/types_operators.lcl
load test/conformance/scoping_functional.lcl
load test/conformance/stdlib_namespaces.lcl
load test/conformance/syntax_eval.lcl
load test/conformance/params_dispatch.lcl
load test/conformance/numerics_literals.lcl
load test/conformance/hardening.lcl
load test/conformance/diagnostics.lcl
load test/conformance/name_resolution.lcl

Test::run
