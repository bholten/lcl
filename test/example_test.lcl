;; Example Test File using the Test Framework
;;
;; This demonstrates how to write tests using lib/Test.lcl
;; Run with: ./lcl test/example_test.lcl

load lib/Test.lcl

;; ============================================================================
;; Testing List:: functions
;; ============================================================================

Test::suite "List::sort" {
    Test::case "sorts strings lexicographically" {
        let result [List::sort [list banana apple cherry]]
        Test::eq [get $result 0] apple
        Test::eq [get $result 1] banana
        Test::eq [get $result 2] cherry
    }

    Test::case "handles empty list" {
        let result [List::sort [list]]
        Test::len_eq $result 0
    }

    Test::case "handles single element" {
        let result [List::sort [list only]]
        Test::eq $result [list only]
    }
}

Test::suite "List::sort_by" {
    Test::case "sorts with custom numeric comparator" {
        let nums [list 10 2 5 1 20]
        let cmp [lambda {a b} {
            if [< $a $b] { return -1 }
            if [> $a $b] { return 1 }
            return 0
        }]
        let result [List::sort_by $cmp $nums]
        Test::eq $result [list 1 2 5 10 20]
    }

    Test::case "sorts descending with reversed comparator" {
        let nums [list 3 1 2]
        let cmp [lambda {a b} {
            if [> $a $b] { return -1 }
            if [< $a $b] { return 1 }
            return 0
        }]
        let result [List::sort_by $cmp $nums]
        Test::eq $result [list 3 2 1]
    }
}

Test::suite "List::find" {
    Test::case "finds first matching element" {
        let nums [list 1 5 10 15 20]
        let result [List::find [lambda {x} {> $x 8}] $nums]
        Test::eq $result 10
    }

    Test::case "returns empty when no match" {
        let nums [list 1 2 3]
        let result [List::find [lambda {x} {> $x 100}] $nums]
        Test::empty $result
    }
}

Test::suite "List::any? and List::all?" {
    Test::case "any? returns true when at least one matches" {
        let nums [list 1 2 3 4 5]
        Test::true [List::any? [lambda {x} {> $x 4}] $nums]
    }

    Test::case "any? returns false when none match" {
        let nums [list 1 2 3]
        Test::false [List::any? [lambda {x} {> $x 100}] $nums]
    }

    Test::case "all? returns true when all match" {
        let nums [list 1 2 3 4 5]
        Test::true [List::all? [lambda {x} {> $x 0}] $nums]
    }

    Test::case "all? returns false when one doesn't match" {
        let nums [list 1 2 3 4 5]
        Test::false [List::all? [lambda {x} {> $x 2}] $nums]
    }
}

Test::suite "List::unique" {
    Test::case "removes duplicates preserving order" {
        let input [list a b a c b d]
        let result [List::unique $input]
        Test::eq $result [list a b c d]
    }

    Test::case "already unique list unchanged" {
        let input [list x y z]
        Test::eq [List::unique $input] $input
    }
}

Test::suite "List::flatten" {
    Test::case "flattens nested lists" {
        let nested [list [list 1 2] [list 3 4] 5]
        let result [List::flatten $nested]
        Test::eq $result [list 1 2 3 4 5]
    }

    Test::case "flat list unchanged" {
        let flat [list a b c]
        Test::eq [List::flatten $flat] $flat
    }
}

;; ============================================================================
;; Testing String:: functions
;; ============================================================================

Test::suite "String::length" {
    Test::case "returns correct length" {
        Test::eq [String::length hello] 5
        Test::eq [String::length {}] 0
        Test::eq [String::length "hello world"] 11
    }
}

Test::suite "String::index" {
    Test::case "gets character at positive index" {
        Test::eq [String::index hello 0] h
        Test::eq [String::index hello 4] o
    }

    Test::case "gets character at negative index" {
        Test::eq [String::index hello -1] o
        Test::eq [String::index hello -2] l
    }
}

Test::suite "String::range" {
    Test::case "extracts substring with positive indices" {
        Test::eq [String::range hello 1 4] ell
        Test::eq [String::range hello 0 2] he
    }

    Test::case "extracts substring with negative indices" {
        Test::eq [String::range hello 0 -1] hell
        Test::eq [String::range hello -3 -1] ll
    }
}

Test::suite "String::trim" {
    Test::case "removes leading and trailing whitespace" {
        Test::eq [String::trim "  hello  "] hello
        Test::eq [String::trim "\thello\n"] hello
    }

    Test::case "handles already trimmed string" {
        Test::eq [String::trim hello] hello
    }

    Test::case "handles all whitespace" {
        Test::eq [String::trim "   "] {}
    }
}

;; ============================================================================
;; Run all tests
;; ============================================================================

Test::run
