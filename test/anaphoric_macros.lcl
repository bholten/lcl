;; Anaphoric Macros in LCL
;;
;; Anaphoric macros are macros that intentionally capture a variable (usually
;; called "it") and make it available in the macro body. This is a powerful
;; metaprogramming technique from Common Lisp.
;;
;; In LCL, macros return code that the caller evaluates with `eval`. Since
;; eval runs in the current frame (no new scope), bindings from the generated
;; code are visible to subsequent code.
;;
;; Quasiquote syntax:
;;   quasiquote { ... }  - template with unquoting
;;   ,$var               - unquote variable: substitute variable value
;;   ,[cmd]              - unquote command: evaluate and insert result
;;   ,@$list             - splice-unquote: insert list elements
;;   \,                  - literal comma (escaped)
;;
;; Literal syntax:
;;   (a b c)             - list literal, desugars to [list a b c]
;;   #{key val ...}      - dict literal, desugars to [dict key val ...]
;;
;; Important notes:
;; - if conditions need [$it] not {$it} for proper evaluation
;; - if requires 'else' keyword for else branch
;; - Recursive macros: compute recursive call BEFORE quasiquote, then insert
;;   via variable. E.g.: let rest_code [macro $rest]; quasiquote { ... ,$rest_code }
;; - Use () list literals for passing structured data to macros:
;;   [macro (({cond1} {body1}) ({cond2} {body2}))]

load lib/Test.lcl

;; ============================================================================
;; aif - Anaphoric If
;; ============================================================================
;;
;; Like Common Lisp's aif: evaluates the condition once, binds it to $it,
;; then $it is available in both branches.
;;
;; Usage:
;;   eval [aif {[get $cache $key]} {
;;       puts "Cache hit: $it"
;;   } {
;;       puts "Cache miss"
;;   }]

proc aif {condition then_body else_body} {
    quasiquote {
        let it ,$condition
        if [$it] {,$then_body} else {,$else_body}
    }
}

;; ============================================================================
;; awhen - Anaphoric When
;; ============================================================================
;;
;; Simpler version: only executes body when condition is truthy.
;; $it is bound to the condition result.

proc awhen {condition body} {
    quasiquote {
        let it ,$condition
        if [$it] {,$body}
    }
}

;; ============================================================================
;; awhile - Anaphoric While
;; ============================================================================
;;
;; Loop while condition is truthy, with $it bound to condition result each
;; iteration. Note: uses var/set! since it changes each iteration.

proc awhile {condition body} {
    quasiquote {
        while {1} {
            var it ,$condition
            if [$it] {,$body} else {break}
        }
    }
}

;; ============================================================================
;; with-it - Builder/Context Pattern
;; ============================================================================
;;
;; Creates a context where $it refers to a mutable value, allowing fluent
;; operations. Returns the final value of $it.
;;
;; Usage (note: initializer must be quoted so it becomes code):
;;   let person [eval [with-it {[dict]} {
;;       set! it [put $it name "Alice"]
;;       set! it [put $it age 30]
;;   }]]

proc with-it {initial body} {
    quasiquote {
        var it ,$initial
        ,$body
        $it
    }
}

;; ============================================================================
;; collect - List Comprehension with Anaphoric Variable
;; ============================================================================
;;
;; Transform each element of a list, with $it bound to current element.
;;
;; Usage:
;;   let squares [eval [collect {1 2 3 4 5} {[* $it $it]}]]
;;   # => {1 4 9 16 25}

proc collect {items transform} {
    quasiquote {
        var _result [list]
        foreach it {,$items} {
            set! _result [List::push $_result ,$transform]
        }
        $_result
    }
}

;; ============================================================================
;; select - Filter with Anaphoric Variable
;; ============================================================================
;;
;; Filter elements where predicate is truthy, with $it bound to current element.
;;
;; Usage:
;;   let big [eval [select {1 2 3 4 5 6} {[> $it 3]}]]
;;   # => {4 5 6}

proc select {items predicate} {
    quasiquote {
        var _result [list]
        foreach it {,$items} {
            if [,$predicate] {
                set! _result [List::push $_result $it]
            }
        }
        $_result
    }
}

;; ============================================================================
;; cond - Multi-branch Conditional (like Lisp cond)
;; ============================================================================
;;
;; Takes pairs of {condition body}. Evaluates conditions in order, runs
;; the body of the first truthy one. $it is bound to the condition result.
;;
;; Usage:
;;   eval [cond {
;;       {[< $x 0]}  {puts "negative"}
;;       {[== $x 0]} {puts "zero"}
;;       {1}         {puts "positive"}
;;   }]

proc cond {clauses} {
    if [== [len $clauses] 0] {
        return {{}}
    }

    let first [get $clauses 0]
    let rest [List::slice $clauses 1 [len $clauses]]
    let condition [get $first 0]
    let body [get $first 1]
    let rest_code [cond $rest]

    quasiquote {
        let it ,$condition
        if [$it] {,$body} else {,$rest_code}
    }
}

;; ============================================================================
;; Tests
;; ============================================================================

Test::suite "Anaphoric Macros" {

    Test::case "aif binds condition to it in then-branch" {
        var result 0
        eval [aif {[+ 10 20]} {
            set! result $it
        } {
            set! result -1
        }]
        Test::eq $result 30
    }

    Test::case "aif else branch when falsy" {
        var result {}
        eval [aif {0} {
            set! result "truthy"
        } {
            set! result "falsy"
        }]
        Test::eq $result "falsy"
    }

    Test::case "awhen executes when truthy" {
        var result 0
        eval [awhen {[+ 5 5]} {
            set! result $it
        }]
        Test::eq $result 10
    }

    Test::case "awhen does nothing when falsy" {
        var result "unchanged"
        eval [awhen {0} {
            set! result "changed"
        }]
        Test::eq $result "unchanged"
    }

    Test::case "with-it builder pattern for dict" {
        ;; Note: initializer must be quoted so it becomes code, not evaluated
        let person [eval [with-it {[dict]} {
            set! it [put $it name "Bob"]
            set! it [put $it age 25]
        }]]
        Test::eq [get $person name] "Bob"
        Test::eq [get $person age] 25
    }

    Test::case "with-it for list building" {
        let nums [eval [with-it {[list]} {
            set! it [List::push $it 1]
            set! it [List::push $it 2]
            set! it [List::push $it 3]
        }]]
        Test::eq $nums [list 1 2 3]
    }

    Test::case "collect transforms list" {
        let squares [eval [collect {1 2 3 4} {[* $it $it]}]]
        Test::eq $squares [list 1 4 9 16]
    }

    Test::case "select filters list" {
        let big [eval [select {1 2 3 4 5 6} {[> $it 3]}]]
        Test::eq $big [list 4 5 6]
    }

    Test::case "awhile loops with it" {
        var count 5
        var sum 0
        eval [awhile {$count} {
            set! sum [+ $sum $it]
            set! count [- $count 1]
        }]
        ;; 5 + 4 + 3 + 2 + 1 = 15
        Test::eq $sum 15
    }

    Test::case "cond multi-branch" {
        var x 5
        var result {}
        eval [cond (
            ({[< $x 0]}  {set! result "negative"})
            ({[== $x 0]} {set! result "zero"})
            ({1}         {set! result "positive"})
        )]
        Test::eq $result "positive"
    }

    Test::case "cond binds it to matching condition" {
        var result 0
        eval [cond (
            ({0}         {set! result "first"})
            ({[+ 10 20]} {set! result $it})
            ({1}         {set! result "default"})
        )]
        Test::eq $result 30
    }
}

;; ============================================================================
;; Advanced Example: Pipeline Macro
;; ============================================================================
;;
;; Compose transformations where each step can use $it

proc pipeline {initial stages} {
    if [== [len $stages] 0] {
        return $initial
    }

    let first [get $stages 0]
    let rest [List::slice $stages 1 [len $stages]]
    let rest_code [pipeline $first $rest]

    quasiquote {
        let it ,$initial
        ,$rest_code
    }
}

Test::suite "Pipeline" {
    Test::case "pipeline threads value" {
        let result [eval [pipeline 10 (
            {[+ $it 5]}
            {[* $it 2]}
        )]]
        ;; (10 + 5) * 2 = 30
        Test::eq $result 30
    }
}

;; ============================================================================
;; Example: Anaphoric Lambda
;; ============================================================================
;;
;; Create a lambda where $it refers to the single argument

proc fn {body} {
    quasiquote {
        lambda {it} {,$body}
    }
}

Test::suite "Anaphoric Lambda" {
    Test::case "fn creates lambda with it binding" {
        let double [eval [fn {[* $it 2]}]]
        Test::eq [$double 21] 42
    }

    Test::case "fn in higher-order context" {
        let add10 [eval [fn {[+ $it 10]}]]
        let data {1 2 3}
        var results [list]
        foreach x $data {
            set! results [List::push $results [$add10 $x]]
        }
        Test::eq $results [list 11 12 13]
    }
}

;; ============================================================================
;; Example: Let-style Binding Chains
;; ============================================================================
;;
;; Bind multiple values in sequence, each can use previous bindings

proc let* {bindings body} {
    if [== [len $bindings] 0] {
        return $body
    }

    let first [get $bindings 0]
    let rest [List::slice $bindings 1 [len $bindings]]
    let name [get $first 0]
    let value [get $first 1]
    let rest_code [let* $rest $body]

    quasiquote {
        let ,$name ,$value
        ,$rest_code
    }
}

Test::suite "Let Star" {
    Test::case "let* chains bindings" {
        let result [eval [let* (
            (a 10)
            (b {[+ $a 5]})
            (c {[* $b 2]})
        ) {$c}]]
        ;; a=10, b=15, c=30
        Test::eq $result 30
    }
}

;; ============================================================================
;; Example: unless (negated if)
;; ============================================================================

proc unless {condition body} {
    quasiquote {
        if [not ,$condition] {,$body}
    }
}

Test::suite "Unless" {
    Test::case "unless runs when false" {
        var ran 0
        eval [unless {0} {set! ran 1}]
        Test::eq $ran 1
    }

    Test::case "unless skips when true" {
        var ran 0
        eval [unless {1} {set! ran 1}]
        Test::eq $ran 0
    }
}

;; ============================================================================
;; Example: dotimes (repeat n times)
;; ============================================================================

proc dotimes {n body} {
    quasiquote {
        var it 0
        while {[< $it ,$n]} {
            ,$body
            set! it [+ $it 1]
        }
    }
}

Test::suite "Dotimes" {
    Test::case "dotimes repeats n times with it as counter" {
        var sum 0
        eval [dotimes 5 {
            set! sum [+ $sum $it]
        }]
        ;; 0 + 1 + 2 + 3 + 4 = 10
        Test::eq $sum 10
    }
}

Test::run
