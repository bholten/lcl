;; Anaphoric Macros in LCL
;;
;; Anaphoric macros are macros that intentionally capture a variable (usually
;; called "it") and make it available in the macro body. This is a powerful
;; metaprogramming technique from Common Lisp.
;;
;; In LCL, the `macro` keyword creates a proc whose return value is
;; automatically compiled and evaluated in the caller's frame — no `eval`
;; wrapper needed.
;;
;; Macros expand only as the command head:
;;   my_macro arg1 arg2      ;; OK — expands and evaluates the template
;;   [my_macro arg1 arg2]    ;; ERROR — macros cannot be in value position
;;
;; For value-position usage, use `macroexpand` + `eval`:
;;   let x [eval [macroexpand my_macro arg1 arg2]]
;;
;; `macroexpand` calls the macro's proc body and returns the raw template
;; string without expanding it. This is also used for recursive macros:
;;   let rest_code [macroexpand acond $rest]
;;   quasiquote { ... ,$rest_code }
;;
;; Quasiquote syntax:
;;   quasiquote { ... }  - template with unquoting
;;   ,$var               - unquote variable: substitute variable value
;;   ,[cmd]              - unquote command: evaluate and insert result
;;   ,@$list             - splice-unquote: insert list elements
;;   \,                  - literal comma (escaped)
;;
;; Literal syntax:
;;   (a b c)             - list literal, desugars to [list a b c]
;;   #{key val ...}      - dict literal, desugars to [dict key val ...]
;;
;; Important notes:
;; - if conditions need [$it] not {$it} for proper evaluation
;; - if requires 'else' keyword for else branch
;; - Use () list literals for passing structured data to macros:
;;   [macro (({cond1} {body1}) ({cond2} {body2}))]
;; ============================================================================
;; aif - Anaphoric If
;; ============================================================================
;;
;; Like Common Lisp's aif: evaluates the condition once, binds it to $it,
;; then $it is available in both branches.
;;
;; Usage:
;;   aif {[get $cache $key]} {
;;       puts "Cache hit: $it"
;;   } {
;;       puts "Cache miss"
;;   }

macro aif {condition then_body else_body} {
    quasiquote {
        let it ,$condition
        if [$it] {,$then_body} else {,$else_body}
    }
}

;; ============================================================================
;; awhen - Anaphoric When
;; ============================================================================
;;
;; Simpler version: only executes body when condition is truthy.
;; $it is bound to the condition result.

macro awhen {condition body} {
    quasiquote {
        let it ,$condition
        if [$it] {,$body}
    }
}

;; ============================================================================
;; awhile - Anaphoric While
;; ============================================================================
;;
;; Loop while condition is truthy, with $it bound to condition result each
;; iteration. Note: uses var/set! since it changes each iteration.

macro awhile {condition body} {
    quasiquote {
        while {1} {
            var it ,$condition
            if [$it] {,$body} else {break}
        }
    }
}

;; ============================================================================
;; with-it - Builder/Context Pattern
;; ============================================================================
;;
;; Creates a context where $it refers to a mutable value, allowing fluent
;; operations. Returns the final value of $it.
;;
;; Usage:
;;   let person [with-it {[dict]} {
;;       set! it [put $it name "Alice"]
;;       set! it [put $it age 30]
;;   }]

macro with-it {initial body} {
    quasiquote {
        var it ,$initial
        ,$body
        $it
    }
}

;; ============================================================================
;; collect - List Comprehension with Anaphoric Variable
;; ============================================================================
;;
;; Transform each element of a list, with $it bound to current element.
;;
;; Usage:
;;   let squares [collect {1 2 3 4 5} {[* $it $it]}]
;;   # => {1 4 9 16 25}

macro collect {items transform} {
    quasiquote {
        var _result [list]
        foreach it {,$items} {
            set! _result [List::push $_result ,$transform]
        }
        $_result
    }
}

;; ============================================================================
;; select - Filter with Anaphoric Variable
;; ============================================================================
;;
;; Filter elements where predicate is truthy, with $it bound to current element.
;;
;; Usage:
;;   let big [select {1 2 3 4 5 6} {[> $it 3]}]
;;   # => {4 5 6}

macro select {items predicate} {
    quasiquote {
        var _result [list]
        foreach it {,$items} {
            if [,$predicate] {
                set! _result [List::push $_result $it]
            }
        }
        $_result
    }
}

;; ============================================================================
;; acond - Anaphoric Cond (Multi-branch Conditional with $it binding)
;; ============================================================================
;;
;; Takes pairs of {condition body}. Evaluates conditions in order, runs
;; the body of the first truthy one. $it is bound to the condition result.
;;
;; Note: This is an anaphoric version that binds $it to the matched condition.
;; For simple dispatch without $it binding, use the built-in `cond` special form.
;;
;; Usage:
;;   acond {
;;       {[< $x 0]}  {puts "negative: $it"}
;;       {[== $x 0]} {puts "zero: $it"}
;;       {1}         {puts "positive: $it"}
;;   }

macro acond {clauses} {
    if [== [len $clauses] 0] {
        return {{}}
    }

    let first [get $clauses 0]
    let rest [List::slice $clauses 1 [len $clauses]]
    let condition [get $first 0]
    let body [get $first 1]
    let rest_code [macroexpand acond $rest]

    quasiquote {
        let it ,$condition
        if [$it] {,$body} else {,$rest_code}
    }
}

;; ============================================================================
;; Tests
;; ============================================================================

Test::suite "Anaphoric Macros" {

    Test::case "aif binds condition to it in then-branch" {
        var result 0
        aif {[+ 10 20]} {
            set! result $it
        } {
            set! result -1
        }
        Test::eq $result 30
    }

    Test::case "aif else branch when falsy" {
        var result {}
        aif {0} {
            set! result "truthy"
        } {
            set! result "falsy"
        }
        Test::eq $result "falsy"
    }

    Test::case "awhen executes when truthy" {
        var result 0
        awhen {[+ 5 5]} {
            set! result $it
        }
        Test::eq $result 10
    }

    Test::case "awhen does nothing when falsy" {
        var result "unchanged"
        awhen {0} {
            set! result "changed"
        }
        Test::eq $result "unchanged"
    }

    Test::case "with-it builder pattern for dict" {
        let person [eval [macroexpand with-it {[dict]} {
            set! it [put $it name "Bob"]
            set! it [put $it age 25]
        }]]
        Test::eq [get $person name] "Bob"
        Test::eq [get $person age] 25
    }

    Test::case "with-it for list building" {
        let nums [eval [macroexpand with-it {[list]} {
            set! it [List::push $it 1]
            set! it [List::push $it 2]
            set! it [List::push $it 3]
        }]]
        Test::eq $nums [list 1 2 3]
    }

    Test::case "collect transforms list" {
        let squares [eval [macroexpand collect {1 2 3 4} {[* $it $it]}]]
        Test::eq $squares [list 1 4 9 16]
    }

    Test::case "select filters list" {
        let big [eval [macroexpand select {1 2 3 4 5 6} {[> $it 3]}]]
        Test::eq $big [list 4 5 6]
    }

    Test::case "awhile loops with it" {
        var count 5
        var sum 0

        awhile {$count} {
            set! sum [+ $sum $it]
            set! count [- $count 1]
        }

        ;; 5 + 4 + 3 + 2 + 1 = 15
        Test::eq $sum 15
    }

    Test::case "acond multi-branch" {
        var x 5
        var result {}
        acond (
            ({[< $x 0]}  {set! result "negative"})
            ({[== $x 0]} {set! result "zero"})
            ({1}         {set! result "positive"})
        )

        Test::eq $result "positive"
    }

    Test::case "acond binds it to matching condition" {
        var result 0
        acond (
            ({0}         {set! result "first"})
            ({[+ 10 20]} {set! result $it})
            ({1}         {set! result "default"})
        )
        Test::eq $result 30
    }
}

;; ============================================================================
;; Advanced Example: Pipeline Macro
;; ============================================================================
;;
;; Compose transformations where each step can use $it

macro pipeline {initial stages} {
    if [== [len $stages] 0] {
        return $initial
    }

    let first [get $stages 0]
    let rest [List::slice $stages 1 [len $stages]]
    let rest_code [macroexpand pipeline $first $rest]

    quasiquote {
        let it ,$initial
        ,$rest_code
    }
}

Test::suite "Pipeline" {
    Test::case "pipeline threads value" {
        let result [eval [macroexpand pipeline 10 (
            {[+ $it 5]}
            {[* $it 2]}
        )]]
        ;; (10 + 5) * 2 = 30
        Test::eq $result 30
    }
}

;; ============================================================================
;; Example: Anaphoric Lambda
;; ============================================================================
;;
;; Create a lambda where $it refers to the single argument

macro fn {body} {
    quasiquote {
        lambda {it} {,$body}
    }
}

Test::suite "Anaphoric Lambda" {
    Test::case "fn creates lambda with it binding" {
        let double [eval [macroexpand fn {[* $it 2]}]]
        Test::eq [$double 21] 42
    }

    Test::case "fn in higher-order context" {
        let incr10 [eval [macroexpand fn {[+ $it 10]}]]
        let data {1 2 3}
        var results [list]
        foreach x $data {
            set! results [List::push $results [$incr10 $x]]
        }
        Test::eq $results [list 11 12 13]
    }
}

;; ============================================================================
;; Example: unless (negated if)
;; ============================================================================

macro unless {condition body} {
    quasiquote {
        if [not ,$condition] {,$body}
    }
}

Test::suite "Unless" {
    Test::case "unless runs when false" {
        var ran 0
        unless {0} {set! ran 1}
        Test::eq $ran 1
    }

    Test::case "unless skips when true" {
        var ran 0
        unless {1} {set! ran 1}
        Test::eq $ran 0
    }
}

;; ============================================================================
;; Example: dotimes (repeat n times)
;; ============================================================================

macro dotimes {n body} {
    quasiquote {
        var it 0
        while [< $it ,$n] {
            ,$body
            set! it [+ $it 1]
        }
    }
}

Test::suite "Dotimes" {
    Test::case "dotimes repeats n times with it as counter" {
        var sum 0
        dotimes 5 {
            set! sum [+ $sum $it]
        }
        ;; 0 + 1 + 2 + 3 + 4 = 10
        Test::eq $sum 10
    }
}

;; ============================================================================
;; Macro-Writing-Macros
;; ============================================================================
;;
;; Macros that generate procs or other definitions.
;; The ,, syntax (demonstrated in the depth tracking test below) allows
;; nested quasiquotes; at depth 2, ,,$var evaluates now and produces
;; ,<value> in the output.

;; make-adder: generates a proc that adds a fixed amount
;; Usage:
;;   make-adder add10 10    ;; defines add10 proc
;;   [add10 5]              ;; => 15
;;
;; Uses ,$amount to bake the amount into the generated proc body.

macro make-adder {name amount} {
    quasiquote {
        proc ,$name {x} {
            + $x ,$amount
        }
    }
}

;; make-greeter: generates a greeting proc with a fixed prefix
;; Usage:
;;   make-greeter greet "Hello"
;;   puts [greet "World"]  ;; => "Hello, World!"

macro make-greeter {name prefix} {
    quasiquote {
        proc ,$name {who} {
            String::join (,$prefix ", " $who "!") {}
        }
    }
}

Test::suite "Macro-Writing-Macros" {
    Test::case "make-adder generates working adder" {
        ;; Generate an add10 proc
        make-adder add10 10

        ;; Use it
        let result [add10 5]
        Test::eq $result 15
    }

    Test::case "make-adder with different values" {
        ;; Generate add100
        make-adder add100 100

        let result [add100 23]
        Test::eq $result 123
    }

    Test::case "make-greeter generates working greeter" {
        ;; Generate a hello greeter
        make-greeter hello "Hello"

        let result [hello "World"]
        Test::eq $result "Hello, World!"
    }

    Test::case "multiple generated procs are independent" {
        ;; Generate two different adders
        make-adder plus5 5
        make-adder plus50 50

        let r1 [plus5 10]
        let r2 [plus50 10]

        Test::eq $r1 15
        Test::eq $r2 60
    }

    Test::case "nested quasiquote depth tracking" {
        ;; Direct test of ,, behavior
        let outer_val 42

        ;; At depth 2, ,,$outer_val evaluates outer_val now
        ;; and produces ,42 in the output (bare word, not braced)
        let template [quasiquote {
            quasiquote {
                the answer is ,,$outer_val
            }
        }]

        ;; template should be: quasiquote { the answer is ,42 }
        ;; When we eval that, we get: the answer is 42
        ;; (with whitespace from template, so we trim)
        let result [String::trim [eval $template]]
        Test::eq $result "the answer is 42"
    }
}

Test::run
