;; Nested chain: this "./" resolves against rel_b.lcl's directory.
require ./sub/rel_c.lcl

namespace rel_b {
    var tag "b"

    ;; Proves the chained module was usable inside this one, via the
    ;; file-level binding closed over by this proc.
    proc c_val {} {
        return $rel_c::val
    }
}
