;; Potential memory leaks with ((a 1) (b 2) (c 3)) nested lists

load lib/Test.lcl

proc foo {inline_list} {
    var result 0

    foreach v $inline_list {
        set! result [+ $result 1]
    }

    return $result
}

Test::suite "List nonsense" {
    Test::case "nested list literals" {
        let nested ((a 1)
                    (b 2)
                    (c 3))

        Test::eq 1 [list? $nested]
        Test::eq 3 [len $nested]

        foreach v $nested {
            Test::eq 1 [list? $v]
            Test::eq 2 [len $v]
        }
    }

    Test::case "nested list inlined into function call" {
        let nested ((a 1)
                    (b 2)
                    (c 3))
        let test [foo ((a 1)
                       (b 2)
                       (c 3))]

        Test::eq 3 $test
        Test::eq 3 [foo $nested]
        Test::eq 3 [foo (1 2 3)]
        Test::eq 3 [foo ((a 1)
                         (b 2)
                         (c 3))]
    }

    Test::case "deeply nested" {
        let deeply_nested ((a 1)
                           (b 2)
                           (c (aa 1
                               bb 2
                               cc (aaa 1 bbb 2))))

        Test::eq 1 [list? $deeply_nested]
        Test::eq 3 [len $deeply_nested]
    }

    Test::case "merge via splat" {
        let list1 (1 2 3 4)
        let list2 (5 6 7 8)
        let list3 (@$list1 @$list2)

        Test::eq $list3 (1 2 3 4 5 6 7 8)
        Test::eq $list3 [List::concat $list1 $list2]
        Test::eq [+ [len $list1] [len $list2]] [len $list3]
    }
}

Test::run
