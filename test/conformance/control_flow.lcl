;; Lcl conformance tests: if/cond/case, loops, break/continue, error handling.
;; Part of the conformance suite; run via test/conformance_smoke.lcl
;; (suites only register here -- the runner calls Test::run).


Test::suite "If/Else" {
    Test::case "simple true" {
        var result 0
        if 1 { set! result 1 }
        Test::eq $result 1
    }

    Test::case "simple false" {
        var result 0
        if 0 { set! result 1 }
        Test::eq $result 0
    }

    Test::case "if-else with keyword" {
        var result {}
        if 0 { set! result yes } else { set! result no }
        Test::eq $result no
    }

    Test::case "if-else positional (no keyword)" {
        var result {}
        if 0 { set! result yes } { set! result no }
        Test::eq $result no
    }

    Test::case "nested if (replaces elseif)" {
        var result {}
        if 0 {
            set! result first
        } {
            if 1 {
                set! result second
            } {
                set! result third
            }
        }
        Test::eq $result second
    }

    Test::case "computed condition" {
        let x 5
        var result 0
        if [+ $x 0] { set! result 1 }
        Test::eq $result 1
    }

    Test::case "string truthiness" {
        var result 0
        if hello { set! result 1 }
        Test::eq $result 1
    }

    Test::case "empty string is false" {
        var result 0
        if {} { set! result 1 } else { set! result 2 }
        Test::eq $result 2
    }

    Test::case "if returns last value" {
        let result [if 1 { + 10 20 }]
        Test::eq $result 30
    }
}

;; ============================================================================
;; Control Flow: cond (multi-branch conditional)
;; ============================================================================

Test::suite "Cond" {
    Test::case "first truthy clause wins" {
        let result [cond 0 "first" 1 "second" else "default"]
        Test::eq $result "second"
    }

    Test::case "else clause when no match" {
        let result [cond 0 "first" 0 "second" else "default"]
        Test::eq $result "default"
    }

    Test::case "first clause matches" {
        let result [cond 1 "first" 1 "second" else "default"]
        Test::eq $result "first"
    }

    Test::case "cond with comparisons" {
        let n 5
        let result [cond
                    [== $n 0] "zero"
                    [< $n 0] "negative"
                    else "positive"]
        Test::eq $result "positive"
    }

    Test::case "cond with negative number" {
        let n -3
        let result [cond
                    [== $n 0] "zero"
                    [< $n 0] "negative"
                    else "positive"]
        Test::eq $result "negative"
    }

    Test::case "cond evaluates expression result" {
        let a 10
        let b 20
        let result [cond 0 "wrong" 1 [+ $a $b] else "default"]
        Test::eq $result 30
    }

    Test::case "cond short-circuits" {
        var counter 0
        proc inc_and_check {} {
            set! counter [+ $counter 1]
            0
        }
        ;; Only first two tests should be evaluated
        let result [cond [inc_and_check] "a" [inc_and_check] "b" 1 "c" [inc_and_check] "d"]
        Test::eq $result "c"
        Test::eq $counter 2
    }

    Test::case "cond without else errors on no match" {
        let errored [catch {cond 0 "a" 0 "b"}]
        Test::eq $errored 1
    }
}

;; ============================================================================
;; Control Flow: case (value dispatch)
;; ============================================================================

Test::suite "Case" {
    Test::case "basic string dispatch" {
        let op {add}
        let result [case $op {add} "addition" {sub} "subtraction" else "unknown"]
        Test::eq $result "addition"
    }

    Test::case "else clause when no match" {
        let op {div}
        let result [case $op {add} "addition" {sub} "subtraction" else "unknown"]
        Test::eq $result "unknown"
    }

    Test::case "numeric dispatch" {
        let code 404
        let result [case $code 200 "OK" 404 "Not Found" 500 "Error" else "Other"]
        Test::eq $result "Not Found"
    }

    Test::case "dispatch with variable as key" {
        let expected {mul}
        let op {mul}
        let result [case $op $expected "matched" else "not matched"]
        Test::eq $result "matched"
    }

    Test::case "case evaluates expression result" {
        let op {add}
        let num1 10
        let num2 5
        let result [case $op \
                        {add} [+ $num1 $num2] \
                        {sub} [- $num1 $num2] \
                        else "0"]
        Test::eq $result 15
    }

    Test::case "case short-circuits" {
        var counter 0
        proc inc_and_return {val} {
            set! counter [+ $counter 1]
            $val
        }
        let target {y}
        ;; Only first two keys should be evaluated before match
        let result [case $target \
                        [inc_and_return x] "X" \
                        [inc_and_return y] "Y" \
                        [inc_and_return z] "Z"]
        Test::eq $result "Y"
        Test::eq $counter 2
    }

    Test::case "case without else errors on no match" {
        let errored [catch {case {x} {a} "A" {b} "B"}]
        Test::eq $errored 1
    }

    Test::case "case with list equality" {
        let data [list 1 2 3]
        let result [case $data [list 1 2] "two" [list 1 2 3] "three" else "other"]
        Test::eq $result "three"
    }
}

;; ============================================================================
;; Control Flow: cond/case branches -- braced = body, otherwise = expression
;; ============================================================================

Test::suite "cond/case branch bodies" {
    Test::case "a braced cond branch runs as code" {
        let x 4
        let r [cond [> $x 3] { let y [* $x 2]; + $y 1 } else { 0 }]
        Test::eq $r 9
    }

    Test::case "a braced case branch runs as code" {
        let op "add"
        let r [case $op {add} { let a 2; + $a 3 } {sub} { - 2 3 } else { 0 }]
        Test::eq $r 5
    }

    Test::case "a bare word in a braced branch is a command" {
        let rc [catch { cond 1 { cf_no_such_value } } res err]
        Test::eq $rc 1
        Test::eq $err {unknown command: cf_no_such_value (a bare word is a command; quote it to use it as a value)}
    }

    Test::case "unbraced branches are expressions" {
        let name "cf_n"
        Test::eq [cond 0 "no" 1 $name] "cf_n"
        Test::eq [cond 0 "no" 1 [+ 1 2]] 3
        Test::eq [cond 0 "no" else 42] 42
        Test::eq [case "b" {a} "A" {b} "B"] "B"
        Test::eq [case 7 6 bare 7 word] "word"
    }

    Test::case "case keys stay values, braced or not" {
        Test::eq [case "add" {add} "ok"] "ok"
        Test::eq [case "Not Found" {Not Found} "ok"] "ok"
    }

    Test::case "an empty braced branch yields the empty string" {
        Test::eq [cond 1 {}] ""
        Test::eq [case 1 1 {}] ""
    }

    Test::case "a branch that does not match is never compiled or run" {
        var hits 0
        let r [cond 0 { set! hits [+ $hits 1]; "a" } 1 { "b" } else { set! hits [+ $hits 1]; "c" }]
        Test::eq $r "b"
        Test::eq $hits 0
    }

    Test::case "break inside a cond branch exits the enclosing loop" {
        var i 0
        while {[< $i 10]} {
            set! i [+ $i 1]
            cond [== $i 3] { break } else { continue }
        }
        Test::eq $i 3
    }

    Test::case "continue inside a case branch skips the rest of the body" {
        var seen ()
        foreach v (1 2 3 4) {
            case $v 2 { continue } else { "" }
            List::push! seen $v
        }
        Test::eq $seen (1 3 4)
    }

    Test::case "return inside a cond branch returns from the proc" {
        proc cf_ret {x} {
            cond [< $x 0] { return "neg" } else { "" }
            "nonneg"
        }
        Test::eq [cf_ret -1] "neg"
        Test::eq [cf_ret 1] "nonneg"
    }

    Test::case "return inside a case branch returns from the proc" {
        proc cf_ret2 {k} {
            case $k {a} { return "A" } {b} { return "B" }
            "unreached"
        }
        Test::eq [cf_ret2 a] "A"
        Test::eq [cf_ret2 b] "B"
    }

    Test::case "an error inside a branch body propagates" {
        let rc [catch { case 1 1 { error "boom" } } res err]
        Test::eq $rc 1
        Test::eq $err "boom"
    }

    Test::case "a self-tail-call inside a cond branch is a tail call" {
        proc cf_count {n acc} {
            cond [== $n 0] { $acc } else { cf_count [- $n 1] [+ $acc 1] }
        }
        Test::eq [cf_count 5000 0] 5000
    }

    Test::case "a self-tail-call inside a case branch is a tail call" {
        proc cf_count2 {n acc} {
            case $n 0 { $acc } else { cf_count2 [- $n 1] [+ $acc 1] }
        }
        Test::eq [cf_count2 5000 0] 5000
    }

    Test::case "a branch body sees the enclosing lexical scope" {
        proc cf_scope {} {
            let inner 7
            case 1 1 { + $inner 1 }
        }
        Test::eq [cf_scope] 8
    }

    Test::case "a compile error in a taken branch is reported" {
        let rc [catch { cond 1 { [ } } res err]
        Test::eq $rc 1
    }
}

;; ============================================================================
;; Control Flow: while
;; ============================================================================

Test::suite "While Loop" {
    Test::case "basic countdown" {
        var i 3
        var results [list]
        while $i {
            set! results [List::push $results $i]
            set! i [+ $i -1]
        }
        Test::eq $results [list 3 2 1]
    }

    Test::case "condition false initially" {
        var ran 0
        while 0 { set! ran 1 }
        Test::eq $ran 0
    }

    Test::case "while returns last body value" {
        var x 3
        let result [while $x { set! x [+ $x -1] }]
        Test::eq $result 0
    }
}

;; ============================================================================
;; Control Flow: for
;; ============================================================================

Test::suite "For Loop" {
    Test::case "basic for loop" {
        var results [list]
        for {var i 3} {$i} {set! i [+ $i -1]} {
            set! results [List::push $results $i]
        }
        Test::eq $results [list 3 2 1]
    }

    Test::case "condition false initially" {
        var ran 0
        for {var j 0} {$j} {set! j [+ $j -1]} {
            set! ran 1
        }
        Test::eq $ran 0
    }

    Test::case "for returns last body value" {
        let result [for {var m 3} {$m} {set! m [+ $m -1]} { $m }]
        Test::eq $result 1
    }
}

;; ============================================================================
;; Control Flow: foreach
;; ============================================================================

Test::suite "Foreach Loop" {
    Test::case "basic foreach" {
        var results [list]
        foreach x [list a b c] {
            set! results [List::push $results $x]
        }
        Test::eq $results [list a b c]
    }

    Test::case "foreach over list variable" {
        let items [list 1 2 3]
        var sum 0
        foreach item $items {
            set! sum [+ $sum $item]
        }
        Test::eq $sum 6
    }

    Test::case "empty list" {
        var ran 0
        foreach y [list] {
            set! ran 1
        }
        Test::eq $ran 0
    }

    Test::case "foreach returns last body value" {
        let result [foreach z [list x y z] { $z }]
        Test::eq $result z
    }

    Test::case "foreach preserves element types" {
        var types [list]
        foreach x (1 2.5 (a b) "s") {
            set! types [List::push $types [type $x]]
        }
        Test::eq $types (int float list string)
    }

    Test::case "foreach over dict yields (key value) pairs" {
        var seen #{}
        foreach kv #{a 1 b 2} {
            Test::eq [len $kv] 2
            set! seen [put $seen [get $kv 0] [get $kv 1]]
        }
        Test::eq $seen #{a 1 b 2}
    }

    Test::case "foreach over dict walks Dict::items order" {
        let d #{x 1 y 2 z 3}
        var pairs [list]
        foreach kv $d {
            set! pairs [List::push $pairs $kv]
        }
        Test::eq $pairs [Dict::items $d]
    }

    Test::case "foreach over empty dict runs zero times" {
        var ran 0
        foreach kv #{} { set! ran 1 }
        Test::eq $ran 0
    }

    Test::case "foreach over string yields one-byte strings" {
        var chars [list]
        foreach c "abc" {
            set! chars [List::push $chars $c]
        }
        Test::eq $chars (a b c)
        Test::eq [type [get $chars 0]] string
    }

    Test::case "foreach over string agrees with String::index" {
        let s "hello"
        var i 0
        foreach c $s {
            Test::eq $c [String::index $s $i]
            set! i [+ $i 1]
        }
        Test::eq $i [String::length $s]
    }

    Test::case "foreach over empty string runs zero times" {
        var ran 0
        foreach c "" { set! ran 1 }
        Test::eq $ran 0
        Test::eq [foreach c "" { 1 }] ""
    }

    Test::case "break and continue inside string iteration" {
        var out ""
        foreach c "abcde" {
            if [== $c b] { continue }
            if [== $c d] { break }
            set! out "$out$c"
        }
        Test::eq $out ac
    }

    Test::case "foreach derefs a cell value once" {
        var acc 0
        foreach x [ref (1 2 3)] { set! acc [+ $acc $x] }
        Test::eq $acc 6
    }

    Test::case "braced literal in iterable position is an error" {
        Test::raises_with { foreach x {a b c} { puts $x } } "is text, not a list"
    }

    Test::case "string variable iterates characters, not words" {
        let s {a b}
        var n 0
        foreach c $s { set! n [+ $n 1] }
        Test::eq $n 3
    }

    Test::case "foreach refuses non-iterable values" {
        Test::raises_with { foreach x 42 {} } "expected list, dict, or string"
        Test::raises_with { foreach x [lambda {} {}] {} } "expected list, dict, or string"
        Test::raises_with { foreach x [namespace {}] {} } "expected list, dict, or string"
    }
}

;; ============================================================================
;; Control Flow: break
;; ============================================================================

Test::suite "Break" {
    Test::case "break in while" {
        var i 5
        var results [list]
        while 1 {
            set! results [List::push $results $i]
            set! i [+ $i -1]
            if $i { } else { break }
        }
        Test::eq $results [list 5 4 3 2 1]
    }

    Test::case "break in for" {
        var count 0
        for {var j 1} {1} {set! j [+ $j 1]} {
            set! count [+ $count 1]
            break
        }
        Test::eq $count 1
    }

    Test::case "break in foreach" {
        var first {}
        foreach x [list a b c] {
            set! first $x
            break
        }
        Test::eq $first a
    }

    Test::case "break through a proc call exits the enclosing loop" {
        proc stop {} { break }
        var seen [list]
        foreach x (1 2 3) {
            List::push! seen $x
            stop
        }
        Test::eq $seen (1)
    }
}

;; A callback invoked from C (List::map, Dict::filter, ...) has no
;; loop of the caller's to reach, so an escaping break/continue is an
;; error there rather than a control code (fuzz find: the payload leaked).
Test::suite "Break/continue escaping a C callback" {
    Test::case "break in a List::map lambda is an error" {
        Test::raises_with { List::map (1 2 3) [lambda {x} { break }] } \
            "break invoked outside a loop"
    }

    Test::case "continue in a List::filter lambda is an error" {
        Test::raises_with { List::filter (1 2 3) [lambda {x} { continue }] } \
            "continue invoked outside a loop"
    }

    Test::case "break in a Dict::reduce lambda is an error" {
        Test::raises_with { Dict::reduce #{a 1} 0 [lambda {acc k v} { break }] } \
            "break invoked outside a loop"
    }

    Test::case "break in a sort_by key proc is an error" {
        Test::raises_with { List::sort_by (3 1 2) [lambda {x} { break }] } \
            "break invoked outside a loop"
    }

    Test::case "the error is catchable and the loop outside is unaffected" {
        var n 0
        foreach x (1 2 3) {
            set! n [+ $n 1]
            catch { List::map (1) [lambda {x} { break }] }
        }
        Test::eq $n 3
    }
}

;; ============================================================================
;; Control Flow: continue
;; ============================================================================

Test::suite "Continue" {
    Test::case "continue in while" {
        var i 3
        var results [list]
        while $i {
            let cur $i
            set! i [+ $i -1]
            if [== $cur 2] { continue }
            set! results [List::push $results $cur]
        }
        Test::eq $results [list 3 1]
    }

    Test::case "continue in for" {
        var results [list]
        for {var j 3} {$j} {set! j [+ $j -1]} {
            if [== $j 2] { continue }
            set! results [List::push $results $j]
        }
        Test::eq $results [list 3 1]
    }

    Test::case "continue in foreach" {
        var count 0
        foreach x [list a b c] {
            set! count [+ $count 1]
            continue
        }
        Test::eq $count 3
    }
}

;; ============================================================================
;; Error Handling
;; ============================================================================

Test::suite "Error Handling" {
    Test::case "catch success returns 0" {
        let caught [catch { + 1 2 }]
        Test::eq $caught 0
    }

    Test::case "catch error returns 1" {
        let caught [catch { error "test error" }]
        Test::eq $caught 1
    }

    Test::case "catch with result variable (success)" {
        if [catch { + 10 20 } res msg] {
            Test::assert 0
        } else {
            Test::eq $res 30
        }
    }

    Test::case "catch with error variable" {
        if [catch { error "my error" } res msg] {
            Test::eq $msg {my error}
        } else {
            Test::assert 0
        }
    }

    Test::case "catch nested error" {
        proc may_fail {x} {
            if [== $x 0] {
                error "cannot be zero"
            }
            return [+ $x 1]
        }
        if [catch { may_fail 0 } res msg] {
            Test::eq $msg {cannot be zero}
        } else {
            Test::assert 0
        }
    }

    Test::case "catch nested success" {
        proc may_fail2 {x} {
            if [== $x 0] {
                error "cannot be zero"
            }
            return [+ $x 1]
        }
        if [catch { may_fail2 5 } res msg] {
            Test::assert 0
        } else {
            Test::eq $res 6
        }
    }

    Test::case "catch unknown command returns 1" {
        let caught [catch { definitely_not_a_command 1 2 } res msg]
        Test::eq $caught 1
    }

    Test::case "catch traps syntax error in dynamic script" {
        let code {this is [syntactically bad}
        let caught [catch $code res msg]
        Test::eq $caught 1
        Test::assert [> [len $msg] 0]
    }

    Test::case "catch traps syntax error in braced literal" {
        let caught [catch {oops [unclosed} res msg]
        Test::eq $caught 1
    }

    Test::case "error variable empty on success" {
        let caught [catch { + 1 1 } res msg]
        Test::eq $caught 0
        Test::eq $msg {}
    }

    Test::case "result variable empty on failure" {
        let caught [catch { error "boom" } res msg]
        Test::eq $caught 1
        Test::eq $res {}
    }

    Test::case "nested catch: inner catches, outer sees success" {
        let outer [catch {
            let inner [catch { error "inner boom" } ires imsg]
            if [!= $inner 1] { error "inner did not catch" }
        } ores omsg]
        Test::eq $outer 0
    }

    Test::case "error state cleared after successful catch" {
        catch { error "transient" } res msg
        ;; a following command must evaluate cleanly
        Test::eq [+ 2 2] 4
    }

    Test::case "catch propagates substitution failure of its argument" {
        ;; $no_such_script fails while constructing the argument, before
        ;; catch owns a script; the outer catch observes that error.
        let outer [catch { catch $no_such_script res msg } ores omsg]
        Test::eq $outer 1
    }
}

;; ============================================================================
;; Type Inspection (type / repr / String::from)
;; ============================================================================

Test::suite "repeat" {
    Test::case "runs the body n times in the current scope" {
        var n 0
        repeat 5 { set! n [+ $n 1] }
        Test::eq $n 5
        repeat 0 { set! n 99 }
        Test::eq $n 5
        Test::eq [repeat 0 { 1 }] ""
        Test::eq [repeat 3 { $n }] 5
    }

    Test::case "bindings made in the body are visible afterwards" {
        repeat 2 { var seen 1 }
        Test::eq $seen 1
    }

    Test::case "break, continue and return work" {
        var n 0
        repeat 10 { set! n [+ $n 1]; if [== $n 3] { break } }
        Test::eq $n 3
        var evens 0
        var i 0
        repeat 6 { set! i [+ $i 1]; if [!= [% $i 2] 0] { continue }; set! evens [+ $evens 1] }
        Test::eq $evens 3
        proc first_hit {} { var k 0; repeat 100 { set! k [+ $k 1]; if [== $k 7] { return $k } }; -1 }
        Test::eq [first_hit] 7
    }

    Test::case "the body can be a string compiled once" {
        let body {set! total [+ $total 2]}
        var total 0
        repeat 4 $body
        Test::eq $total 8
    }

    Test::case "errors" {
        Test::eq [catch { repeat -1 { 1 } } r err] 1
        Test::eq $err {repeat: count must be non-negative}
        Test::eq [catch { repeat x { 1 } } r err] 1
        Test::eq [catch { repeat 2 { error boom } } r err] 1
        Test::eq $err boom
    }
}

;; ============================================================================
;; Control codes escaping a [...] operand of a special for,
;;
;; A special form decides when its operands are evaluated; it never
;; reinterprets the result. Only a loop owns break/continue from its
;; body and only a proc activation owns return, so a control code that
;; surfaces from an operand travels through the form untouched,
;; payload included, and nothing the form would have written is
;; written.
;; ============================================================================

Test::suite "Control codes escaping special-form operands" {
    Test::case "continue through a set! operand (the #109 report)" {
        var out ""
        var seen ()
        foreach x (1 2 3) {
            set! out [case $x 2 { continue } else { "v$x" }]
            List::push! seen $out
        }
        Test::eq $seen (v1 v3)
        Test::eq $out v3
    }

    Test::case "break through a set! operand leaves the old value in place" {
        var y 0
        foreach x (1 2 3) {
            set! y [if [== $x 2] { break } else { $x }]
        }
        Test::eq $y 1
    }

    Test::case "continue through a var operand" {
        var seen ()
        foreach x (1 2 3) {
            var y [if [== $x 2] { continue } else { $x }]
            List::push! seen $y
        }
        Test::eq $seen (1 3)
    }

    Test::case "continue through an if condition" {
        var seen ()
        foreach x (1 2 3) {
            if [if [== $x 2] { continue } else { 1 }] { List::push! seen $x }
        }
        Test::eq $seen (1 3)
    }

    Test::case "break through a cond test" {
        var seen ()
        foreach x (1 2 3) {
            cond [if [== $x 2] { break } else { 1 }] { List::push! seen $x }
        }
        Test::eq $seen (1)
    }

    Test::case "continue through a case scrutinee and a case key" {
        var seen ()
        foreach x (1 2 3) {
            case [if [== $x 2] { continue } else { $x }] 1 { List::push! seen a } else { List::push! seen b }
        }
        Test::eq $seen (a b)
        set! seen ()
        foreach x (1 2 3) {
            case $x [if [== $x 2] { continue } else { 1 }] { List::push! seen a } else { List::push! seen b }
        }
        Test::eq $seen (a b)
    }

    Test::case "a while condition does not own break: it leaves the enclosing loop" {
        var seen ()
        foreach x (1 2 3) {
            while [if [== $x 2] { break } else { 0 }] { }
            List::push! seen $x
        }
        Test::eq $seen (1)
        set! seen ()
        foreach x (1 2 3) {
            while {if [== $x 2] { break } else { 0 }} { }
            List::push! seen $x
        }
        Test::eq $seen (1) "braced and bracketed conditions agree"
    }

    Test::case "a for condition does not own continue either" {
        var seen ()
        foreach x (1 2 3) {
            for {var i 0} [if [== $x 2] { continue } else { < $i 1 }] {set! i [+ $i 1]} { }
            List::push! seen $x
        }
        Test::eq $seen (1 3)
    }

    Test::case "break through a repeat count and a foreach iterable" {
        var seen ()
        foreach x (1 2 3) {
            repeat [if [== $x 2] { break } else { 1 }] { List::push! seen $x }
        }
        Test::eq $seen (1)
        set! seen ()
        foreach x (1 2 3) {
            foreach y [if [== $x 2] { continue } else { (a) }] { List::push! seen $x }
        }
        Test::eq $seen (1 3)
    }

    Test::case "and/or operands propagate, and skipped operands stay skipped" {
        var seen ()
        foreach x (1 2 3) {
            and 1 [if [== $x 2] { break } else { 1 }]
            List::push! seen $x
        }
        Test::eq $seen (1)
        set! seen ()
        foreach x (1 2 3) {
            or 0 [if [== $x 2] { continue } else { 1 }]
            List::push! seen $x
        }
        Test::eq $seen (1 3)
        set! seen ()
        foreach x (1 2 3) {
            and 0 [break]
            or 1 [break]
            List::push! seen $x
        }
        Test::eq $seen (1 2 3) "short-circuited break never ran"
    }

    Test::case "mutation forms commit nothing when the operand escapes" {
        var l ()
        foreach x (1 2 3 4) {
            List::push! l [if [== $x 3] { break } else { $x }]
        }
        Test::eq $l (1 2)
        var d #{}
        foreach x (1 2 3) {
            put! d k$x [if [== $x 2] { continue } else { $x }]
        }
        Test::eq $d #{k1 1 k3 3}
        foreach x (1 2) {
            del! d [if [== $x 1] { continue } else { "k1" }]
        }
        Test::eq $d #{k3 3}
    }

    Test::case "the enclosing loop can be while, for or repeat" {
        var i 0
        var seen ()
        while [< $i 5] {
            set! i [+ $i 1]
            var y [if [== $i 3] { break } else { $i }]
            List::push! seen $y
        }
        Test::eq $seen (1 2)
        set! seen ()
        for {var j 0} [< $j 5] {set! j [+ $j 1]} {
            set! i [if [== $j 2] { continue } else { $j }]
            List::push! seen $j
        }
        Test::eq $seen (0 1 3 4)
        set! seen ()
        set! i 0
        repeat 5 {
            set! i [+ $i 1]
            List::push! seen [cond [== $i 4] { break } else { $i }]
        }
        Test::eq $seen (1 2 3)
    }

    Test::case "return keeps its value through set!, if, and/or, interpolation and a while condition" {
        proc via_set {} {
            var y 0
            foreach x (1 2 3) { set! y [if [== $x 2] { return "done" } else { $x }] }
            "fell"
        }
        Test::eq [via_set] done
        proc via_if {} { if [return "cond"] { "then" } else { "else" } }
        Test::eq [via_if] cond
        proc via_or {} { or 0 [return "or"] 1 }
        Test::eq [via_or] or
        proc via_and {} { and 1 [return "and"] 0 }
        Test::eq [via_and] and
        proc via_str {} { foreach x (1 2) { let s "s[if [== $x 2] { return "str" } else { $x }]" }; "fell" }
        Test::eq [via_str] str
        proc via_while {} { while [return "while"] { }; "fell" }
        Test::eq [via_while] while
        proc via_push {} { var l (); List::push! l [return "push"]; "fell" }
        Test::eq [via_push] push
        proc via_qq {} { quasiquote {a ,[return "qq"] b} }
        Test::eq [via_qq] qq
    }

    Test::case "real errors in an operand keep their message" {
        var y 0
        Test::eq [catch { set! y [error boom] } r e] 1
        Test::eq $e boom
        Test::eq [catch { if [error boom2] { 1 } } r e] 1
        Test::eq $e boom2
        Test::eq [catch { and 1 [error boom3] } r e] 1
        Test::eq $e boom3
        Test::eq [catch { List::push! y [error boom4] } r e] 1
        Test::eq $e boom4
        Test::eq $y 0
    }

    Test::case "thousands of escapes through mutation forms leak nothing" {
        var n 0
        var l ()
        repeat 3000 { set! n [if 1 { continue } else { 7 }] }
        repeat 3000 { List::push! l [if 1 { continue } else { 7 }] }
        repeat 3000 { put! l 0 [if 1 { continue } else { 7 }] }
        Test::eq $n 0
        Test::eq $l ()
    }
}

;; ============================================================================
;; finally {body} {cleanup}
;;
;; The cleanup runs however the body leaves: normal completion, error,
;; return, break or continue. When the cleanup completes normally the
;; body's outcome continues unchanged (value, control code, error
;; message and location). A cleanup that does not complete normally
;; supersedes the body's outcome; a cleanup error raised while an
;; error was already pending keeps the original in its message.
;; ============================================================================

Test::suite "finally" {
    Test::case "the value is the body's, not the cleanup's" {
        Test::eq [finally { "body" } { "cleanup" }] body
        Test::eq [finally { } { 1 }] ""
    }

    Test::case "cleanup runs on every way out of the body" {
        var trace ()
        finally { List::push! trace normal } { List::push! trace c1 }
        catch { finally { error boom } { List::push! trace c2 } }
        proc fin_ret {} { finally { return r } { List::push! trace c3 } }
        Test::eq [fin_ret] r
        foreach x (1 2 3) {
            finally { if [== $x 2] { continue }; List::push! trace b$x } { List::push! trace c$x }
        }
        foreach x (1 2 3) {
            finally { if [== $x 2] { break }; List::push! trace d$x } { List::push! trace e$x }
        }
        Test::eq $trace (normal c1 c2 c3 b1 c1 c2 b3 c3 d1 e1 e2)
    }

    Test::case "return carries its value through the cleanup" {
        var ran 0
        proc fin_val {} {
            finally {
                return 42
            } {
                set! ran 1
            }
            "unreachable"
        }
        Test::eq [fin_val] 42
        Test::eq $ran 1
    }

    Test::case "the body's error message survives a cleanup that catches its own errors" {
        var seen ""
        let rc [catch {
            finally { error "original failure" } {
                catch { error "unrelated, caught in cleanup" } _ seen
            }
        } _ e]
        Test::eq $rc 1
        Test::eq $e "original failure"
        Test::eq $seen "unrelated, caught in cleanup"
    }

    Test::case "cleanup reads and writes the caller's variables" {
        var n 1
        let v [finally { let m [* $n 10]; $m } { set! n [+ $n 1] }]
        Test::eq $v 10
        Test::eq $n 2
    }

    Test::case "nested cleanups run innermost first" {
        var trace ()
        finally {
            finally {
                List::push! trace body
            } {
                List::push! trace inner
            }
        } {
            List::push! trace outer
        }
        Test::eq $trace (body inner outer)
        set! trace ()
        catch {
            finally {
                finally { error boom } { List::push! trace inner }
            } {
                List::push! trace outer
            }
        }
        Test::eq $trace (inner outer)
    }

    Test::case "a failing cleanup supersedes a successful body" {
        let rc [catch { finally { "fine" } { error "cleanup failed" } } r e]
        Test::eq $rc 1
        Test::eq $e "cleanup failed"
    }

    Test::case "a failing cleanup after a failing body keeps the original in its message" {
        let rc [catch { finally { error "first" } { error "second" } } r e]
        Test::eq $rc 1
        Test::eq $e "second (while unwinding: first)"
    }

    Test::case "a cleanup's own control flow supersedes the body's" {
        proc fin_two {} { finally { return body } { return cleanup } }
        Test::eq [fin_two] cleanup
        var trace ()
        foreach x (1 2 3) {
            finally { List::push! trace b$x } { if [== $x 2] { break } }
            List::push! trace after$x
        }
        Test::eq $trace (b1 after1 b2)
        proc fin_err_then_return {} { finally { error boom } { return recovered } }
        Test::eq [fin_err_then_return] recovered
    }

    Test::case "a cleanup error after a body continue propagates out of the loop" {
        var count 0
        let rc [catch {
            foreach x (1 2 3) {
                set! count [+ $count 1]
                finally { continue } { error "cleanup $x" }
            }
        } r e]
        Test::eq $rc 1
        Test::eq $e "cleanup 1"
        Test::eq $count 1
    }

    Test::case "the body is not a tail position: recursion unwinds through each cleanup" {
        ;; With tail-call elimination mistakenly applied to the body, the
        ;; cleanup would run before the recursive call and the trace would
        ;; come out outermost first.
        var trace ()
        proc fin_recur {n} {
            finally {
                if [> $n 0] { fin_recur [- $n 1] }
            } {
                List::push! trace $n
            }
        }
        fin_recur 3
        Test::eq $trace (0 1 2 3)
    }

    Test::case "body and cleanup may be strings, compiled like repeat's body" {
        var trace ()
        let body {List::push! trace b}
        let cleanup {List::push! trace c}
        repeat 2 { finally $body $cleanup }
        Test::eq $trace (b c b c)
    }

    Test::case "errors" {
        Test::eq [catch { finally { 1 } } r e] 1
        Test::eq [catch { finally } r e] 1
        Test::eq [catch { finally { 1 } { 2 } { 3 } } r e] 1
        Test::eq [catch { finally { 1 } { puts "a"b } } r e] 1
    }

    Test::case "many iterations leak nothing" {
        var acc 0
        repeat 2000 {
            finally { let v (1 2 3); set! acc [+ $acc [len $v]] } { let w (4 5) }
        }
        Test::eq $acc 6000
        catch { repeat 2000 { finally { error x } { let w (4 5) } } }
    }
}
