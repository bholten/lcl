;; Minimal LCL Bug Reproduction
;; Run with: lcl -e curl test/lcl_bug_minimal.lcl
;;
;; Bug: `return [proc]` in tail position corrupts lambda closures
;; when the lambda is invoked as a C callback.

proc do_request {} {
    var body {}

    curl::init
    let c [curl::new]
    curl::set_url $c "https://httpbin.org/get"
    curl::set_verb $c "GET"

    curl::set_write_callback $c [lambda {chunk} {
        set! body $chunk
    }]

    curl::perform $c
    return $body
}

;; WORKS: Called directly from top-level
puts "Test 1: Direct call from top-level..."
let r1 [do_request]
puts "OK - length: [String::length $r1]"

;; WORKS: Called from proc with let + return
proc wrapper_ok {} {
    let result [do_request]
    return $result
}

puts "Test 2: Wrapped with let + return..."
let r2 [wrapper_ok]
puts "OK - length: [String::length $r2]"

;; FAILS: Called from proc with direct return (tail call)
proc wrapper_bad {} {
    return [do_request]
}

puts "Test 3: Wrapped with direct return (tail call)..."
let r3 [wrapper_bad]
puts "OK - length: [String::length $r3]"
