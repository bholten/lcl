;; Tests for the Test Framework itself
;; This exercises all the framework features

load lib/Test.lcl

Test::suite "Test::eq assertions" {
    Test::case "equal integers" {
        Test::eq 42 42
    }

    Test::case "equal strings" {
        Test::eq hello hello
    }

    Test::case "equal lists" {
        Test::eq [list 1 2 3] [list 1 2 3]
    }

    Test::case "equal dicts" {
        Test::eq [dict a 1 b 2] [dict a 1 b 2]
    }
}

Test::suite "Test::neq assertions" {
    Test::case "different integers" {
        Test::neq 1 2
    }

    Test::case "different strings" {
        Test::neq hello world
    }
}

Test::suite "Test::assert and boolean assertions" {
    Test::case "assert true" {
        Test::assert 1
    }

    Test::case "assert expression" {
        Test::assert [> 5 3]
    }

    Test::case "Test::true" {
        Test::true [== 1 1]
    }

    Test::case "Test::false" {
        Test::false [== 1 2]
    }
}

Test::suite "Test::empty and Test::not_empty" {
    Test::case "empty string" {
        Test::empty {}
    }

    Test::case "empty list" {
        Test::empty [list]
    }

    Test::case "non-empty string" {
        Test::not_empty hello
    }

    Test::case "non-empty list" {
        Test::not_empty [list 1 2 3]
    }
}

Test::suite "Test::raises" {
    Test::case "catches error" {
        Test::raises {
            error "intentional error"
        }
    }

    Test::case "catches undefined variable error" {
        Test::raises {
            puts $undefined_variable_xyz
        }
    }
}

Test::suite "Test::raises_with" {
    Test::case "matches error message" {
        Test::raises_with {
            error "file not found"
        } "not found"
    }
}

Test::suite "Comparison assertions" {
    Test::case "gt - greater than" {
        Test::gt 10 5
    }

    Test::case "lt - less than" {
        Test::lt 5 10
    }

    Test::case "gte - greater than or equal (greater)" {
        Test::gte 10 5
    }

    Test::case "gte - greater than or equal (equal)" {
        Test::gte 10 10
    }

    Test::case "lte - less than or equal (less)" {
        Test::lte 5 10
    }

    Test::case "lte - less than or equal (equal)" {
        Test::lte 5 5
    }
}

Test::suite "Collection assertions" {
    Test::case "contains - list contains element" {
        Test::contains [list a b c] b
    }

    Test::case "str_contains - string contains substring" {
        Test::str_contains "hello world" "wor"
    }

    Test::case "len_eq - list has expected length" {
        Test::len_eq [list 1 2 3] 3
    }
}

;; Define hook test variable at global scope so hooks can access it
var _hook_test_value 0

Test::suite "Before/After hooks" {
    Test::before {
        set! _hook_test_value 100
    }

    Test::after {
        set! _hook_test_value 0
    }

    Test::case "before hook sets value" {
        Test::eq $_hook_test_value 100
    }

    Test::case "value set again by before hook" {
        Test::eq $_hook_test_value 100
    }
}

Test::suite "Skip functionality" {
    Test::case "this test is skipped" {
        Test::skip "demonstrating skip feature"
    }

    Test::case "this test runs normally" {
        Test::eq 1 1
    }
}

;; Run all tests
Test::run
