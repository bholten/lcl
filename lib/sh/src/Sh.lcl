;;; sh.lcl - Shell scripting sugar layer
;;;
;;; Provides convenient shell scripting functions built on Process::*
;;;
;;; REQUIRES: lcl-process package (provides Process:: namespace)
;;;
;;; Usage:
;;;
;;; ```tcl
;;;   load lib/sh.lcl
;;;
;;;   ;; Simple command execution (returns stdout, trimmed)
;;;   let files [Sh::run (ls -la)]
;;;
;;;   ;; Get output as list of lines
;;;   let items [Sh::lines (ls)]
;;;
;;;   ;; Check if command succeeds
;;;   if [Sh::ok? (which git)] {
;;;       puts "git is installed"
;;;   }
;;;
;;;   ;; Run with options
;;;   Sh::run (./script.sh) #{env #{DEBUG 1} cwd /tmp}
;;;
;;;   ;; Pipe commands (using shell)
;;;   Sh::pipe "ls -la | grep foo | wc -l"
;;; ```

namespace Sh {
    ;;; Sh::run cmd ?opts? - run command and return stdout (trimmed)
    ;;; Options:
    ;;;   throw - 1 (default) to throw on error, 0 to return empty string
    ;;;   stdin - string to send to stdin
    ;;;   env   - dict of environment variables
    ;;;   cwd   - working directory
    proc run {cmd (opts #{})} {
        let do_throw [get $opts throw 1]
        let r [Process::run $cmd $opts]
        let status [get $r status]

        if [and $do_throw [!= $status 0]] {
            let stderr_out [get $r stderr]
            if [empty? $stderr_out] {
                error "Sh::run: command failed with status $status"
            } else {
                error "Sh::run: $stderr_out"
            }
        }

        ;; Return trimmed stdout
        String::trim [get $r stdout]
    }

    ;;; run command, return full result dict
    ;;; Does not throw on error
    proc run! {cmd (opts #{})} {
        Process::run $cmd $opts
    }

    ;;; run command and return stdout as list of lines
    proc lines {cmd} {
        let output [Sh::run $cmd #{throw 0}]
        if [empty? $output] {
            return [list]
        }
        String::split $output "\n"
    }

    ;;; check if command succeeds (exit 0)
    proc ok? {cmd} {
        let r [Process::run $cmd]
        == [get $r status] 0
    }

    ;;; get exit status of command
    proc status {cmd} {
        let r [Process::run $cmd]
        get $r status
    }

    ;;; run shell pipeline
    ;;; cmdline is a string that will be passed to /bin/sh -c
    proc pipe {cmdline} {
        let r [Process::run (sh -c $cmdline)]
        let status [get $r status]
        if [!= $status 0] {
            let stderr_out [get $r stderr]
            if [empty? $stderr_out] {
                error "Sh::pipe: pipeline failed with status $status"
            } else {
                error "Sh::pipe: $stderr_out"
            }
        }
        String::trim [get $r stdout]
    }

    ;;; run shell pipeline, return full result
    proc pipe! {cmdline} {
        Process::run (sh -c $cmdline)
    }
    
    ;;; capture both stdout and stderr
    ;;; Returns #{stdout "..." stderr "..." status N}
    proc capture {cmd} {
        Process::run $cmd
    }
    
    ;;; srun command, discard output, return status
    proc silent {cmd} {
        let r [Process::run $cmd]
        get $r status
    }
    
    ;;; find path to executable (or empty string if not found)
    proc which {name} {
        let r [Process::run (which $name)]
        if [== [get $r status] 0] {
            String::trim [get $r stdout]
        } else {
        ""
        }
    }
    
    ;;; check if executable exists in PATH
    proc exists? {name} {
        Sh::ok? (which $name)
    }
    
    ;;; read file contents
    proc read {path} {
        let r [Process::run (cat $path)]

        if [!= [get $r status] 0] {
            error "Sh::read: cannot read file $path"
        }

        get $r stdout
    }

    ;;; write content to file
    proc write {path content} {
        let r [Process::run (tee $path) #{stdin $content}]

        if [!= [get $r status] 0] {
            error "Sh::write: cannot write to file $path"
        }

        ""
    }

    ;;; append content to file
    proc append {path content} {
        let r [Process::run (tee -a $path) #{stdin $content}]

        if [!= [get $r status] 0] {
            error "Sh::append: cannot append to file $path"
        }

        ""
    }
 
    ;;; expand glob pattern
    proc glob {pattern} {
        let r [Process::run (sh -c "ls -d $pattern 2>/dev/null || true")]
        let output [String::trim [get $r stdout]]

        if [empty? $output] {
            return [list]
        }

        String::split $output "\n"
    }
    
    ;;; get current working directory
    proc pwd {} {
        String::trim [Sh::run (pwd)]
    }
    
    ;;; get hostname
    proc hostname {} {
        String::trim [Sh::run (hostname)]
    }

    ;;; get current user
    proc whoami {} {
        String::trim [Sh::run (whoami)]
    }

    ;;; get current date/time
    ;;; If fmt is empty or not provided, returns default date format
    proc date {(fmt {})} {
        if [empty? $fmt] {
            String::trim [Sh::run (date)]
        } else {
            String::trim [Sh::run (date +$fmt)]
        }
    }
    
    ;;; sleep for specified seconds
    proc sleep {seconds} {
        Sh::silent (sleep $seconds)
        ""
    }

    ;;; create directory (with parents)
    proc mkdir {path} {
        let r [Process::run (mkdir -p $path)]

        if [!= [get $r status] 0] {
            error "Sh::mkdir: cannot create directory $path"
        }

        ""
    }
    
    ;;; remove file or directory
    proc rm {path} {
        let r [Process::run (rm -rf $path)]

        if [!= [get $r status] 0] {
            error "Sh::rm: cannot remove $path"
        }

        ""
    }
    
    ;;; copy file or directory
    proc cp {src dst} {
        let r [Process::run (cp -r $src $dst)]

        if [!= [get $r status] 0] {
            error "Sh::cp: cannot copy $src to $dst"
        }

        ""
    }
    
    ;;; move/rename file or directory
    proc mv {src dst} {
        let r [Process::run (mv $src $dst)]

        if [!= [get $r status] 0] {
            error "Sh::mv: cannot move $src to $dst"
        }

        ""
    }

    ;;; check if path is a regular file
    proc file? {path} {
        Sh::ok? (test -f $path)
    }

    ;;; check if path is a directory
    proc dir? {path} {
        Sh::ok? (test -d $path)
    }

    ;;; check if path is readable
    proc readable? {path} {
        Sh::ok? (test -r $path)
    }

    ;;; check if path is writable
    proc writable? {path} {
        Sh::ok? (test -w $path)
    }

    ;;; check if path is executable
    proc executable? {path} {
        Sh::ok? (test -x $path)
    }

    ;;; run command with environment variables
    ;;; Convenience wrapper that builds opts dict
    proc env {vars cmd} {
        Sh::run $cmd #{env $vars}
    }

    ;;; run command in specified directory
    ;;; Convenience wrapper that builds opts dict
    proc in {dir cmd} {
        Sh::run $cmd #{cwd $dir}
    }

    ;;; run command with stdin input
    ;;; Convenience wrapper that builds opts dict
    proc stdin {input cmd} {
        Sh::run $cmd #{stdin $input}
    }    
}

