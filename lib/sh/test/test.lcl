;; Tests for sh.lcl

Test::suite "Sh::run" {
    Test::case "basic command" {
        let result [Sh::run (echo hello)]
        Test::eq $result "hello"
    }

    Test::case "trims whitespace" {
        let result [Sh::run (echo "  hello  ")]
        Test::eq $result "hello"
    }

    Test::case "throws on error by default" {
        Test::raises {
            Sh::run (false)
        }
    }

    Test::case "no throw with option" {
        let result [Sh::run (false) #{throw 0}]
        Test::eq $result ""
    }
}

Test::suite "Sh::run!" {
    Test::case "returns full result (no opts)" {
        let r [Sh::run! (echo hello)]
        Test::eq [get $r status] 0
        Test::eq [String::trim [get $r stdout]] "hello"
    }
}

Test::suite "Sh::lines" {
    Test::case "splits output into lines" {
        let lines [Sh::lines (sh -c {printf "one\ntwo\nthree"})]
        Test::eq [len $lines] 3
        Test::eq [get $lines 0] "one"
        Test::eq [get $lines 1] "two"
        Test::eq [get $lines 2] "three"
    }

    Test::case "empty output returns empty list" {
        let lines [Sh::lines (true)]
        Test::eq [len $lines] 0
    }
}

Test::suite "Sh::ok?" {
    Test::case "true for exit 0" {
        Test::assert [Sh::ok? (true)]
    }

    Test::case "false for non-zero exit" {
        Test::assert [not [Sh::ok? (false)]]
    }
}

Test::suite "Sh::status" {
    Test::case "returns exit status" {
        Test::eq [Sh::status (true)] 0
        Test::eq [Sh::status (sh -c "exit 42")] 42
    }
}

Test::suite "Sh::env" {
    Test::case "sets environment variables" {
        let result [Sh::env #{MY_VAR testvalue} (sh -c {echo $MY_VAR})]
        Test::eq $result "testvalue"
    }

    Test::case "multiple variables" {
        let result [Sh::env #{A 1 B 2} (sh -c {echo $A$B})]
        Test::eq $result "12"
    }
}

Test::suite "Sh::in" {
    Test::case "runs in directory" {
        let result [Sh::in /tmp (pwd)]
        Test::eq $result "/tmp"
    }
}

Test::suite "Sh::pipe" {
    Test::case "basic pipeline" {
        let result [Sh::pipe "echo hello | cat"]
        Test::eq $result "hello"
    }

    Test::case "complex pipeline" {
        ;; printf "a\nb\nc\n" has 3 newlines, so wc -l returns 3
        let result [Sh::pipe {printf "a\nb\nc\n" | wc -l}]
        Test::eq [String::trim $result] "3"
    }
}

Test::suite "Sh::stdin" {
    Test::case "sends stdin to command" {
        let result [Sh::stdin "hello world" (cat)]
        Test::eq $result "hello world"
    }

    Test::case "multi-line stdin" {
        let result [Sh::stdin "line1\nline2" (wc -l)]
        ;; Note: literal \n in string is not a newline in LCL
        ;; so wc -l counts the literal string as 1 line
        Test::eq [String::trim $result] "1"
    }
}

Test::suite "Sh::which" {
    Test::case "finds executable" {
        let path [Sh::which sh]
        Test::assert [!= [String::find $path "/"] -1]
    }

    Test::case "returns empty for missing" {
        let path [Sh::which nonexistent_command_12345]
        Test::eq $path ""
    }
}

Test::suite "Sh::exists?" {
    Test::case "true for existing command" {
        Test::assert [Sh::exists? sh]
    }

    Test::case "false for missing command" {
        Test::assert [not [Sh::exists? nonexistent_command_12345]]
    }
}

Test::suite "Sh::pwd/hostname/whoami" {
    Test::case "pwd returns path" {
        let pwd [Sh::pwd]
        Test::assert [== [String::find $pwd "/"] 0]
    }

    Test::case "whoami returns username" {
        let user [Sh::whoami]
        Test::assert [> [String::length $user] 0]
    }

    Test::case "hostname returns name" {
        let host [Sh::hostname]
        Test::assert [> [String::length $host] 0]
    }
}

Test::suite "Sh::file operations" {
    Test::case "mkdir, file?, dir?, rm" {
        let ts [Sh::run (date +%s%N)]
        let tmpdir "/tmp/lcl-sh-test-$ts"

        ;; Create directory
        Sh::mkdir $tmpdir
        Test::assert [Sh::dir? $tmpdir]
        Test::assert [not [Sh::file? $tmpdir]]

        ;; Create file
        let tmpfile "$tmpdir/test.txt"
        Sh::write $tmpfile "hello"
        Test::assert [Sh::file? $tmpfile]

        ;; Read file
        let content [Sh::read $tmpfile]
        Test::eq $content "hello"

        ;; Append to file
        Sh::append $tmpfile " world"
        let content2 [Sh::read $tmpfile]
        Test::assert [!= [String::find $content2 "world"] -1]

        ;; Cleanup
        Sh::rm $tmpdir
        Test::assert [not [Sh::dir? $tmpdir]]
    }

    Test::case "cp and mv" {
        let ts [Sh::run (date +%s%N)]
        let tmpdir "/tmp/lcl-sh-cp-test-$ts"
        Sh::mkdir $tmpdir

        let src "$tmpdir/src.txt"
        let dst "$tmpdir/dst.txt"
        let moved "$tmpdir/moved.txt"

        Sh::write $src "content"
        Sh::cp $src $dst
        Test::assert [Sh::file? $dst]
        Test::eq [Sh::read $dst] "content"

        Sh::mv $dst $moved
        Test::assert [not [Sh::file? $dst]]
        Test::assert [Sh::file? $moved]

        Sh::rm $tmpdir
    }
}

Test::suite "Sh::test predicates" {
    Test::case "file? and dir?" {
        Test::assert [Sh::dir? /tmp]
        Test::assert [not [Sh::file? /tmp]]
    }

    Test::case "readable? and writable?" {
        Test::assert [Sh::readable? /tmp]
        Test::assert [Sh::writable? /tmp]
    }

    Test::case "executable?" {
        let sh_path [Sh::which sh]
        Test::assert [Sh::executable? $sh_path]
    }
}

Test::suite "Sh::glob" {
    Test::case "expands pattern" {
        let files [Sh::glob "/tmp/*"]
        ;; /tmp should have some files
        Test::assert [> [len $files] 0]
    }

    Test::case "empty for no match" {
        let files [Sh::glob "/nonexistent_path_12345/*"]
        Test::eq [len $files] 0
    }
}

Test::suite "Sh::date" {
    Test::case "default format (no arg)" {
        let d [Sh::date]
        Test::assert [> [String::length $d] 0]
    }

    Test::case "custom format" {
        let year [Sh::date "%Y"]
        Test::assert [>= [String::length $year] 4]
    }
}

Test::suite "Sh::sleep" {
    Test::case "sleeps briefly" {
        ;; Just verify it doesn't error
        Sh::sleep 0.01
        Test::assert 1
    }
}

exit [Test::run]
