;; Expect Lcl library
;;
;; Provides convenient functions for automating interactive programs,
;; similar to the classic Expect tool.
;;
;; REQUIRES: lcl-process package (provides process:: namespace)
;;           sh package (provdies sh:: namespace)

project Expect {
    def SOURCE src/expect.lcl
    def BUILD  build/expect.h

    task pre_reqs {
        outputs build/
        run {
          mkdir -p build/    
        }
    }

    task build {
        inputs  ${Expect::SOURCE}
        outputs ${Expect::BUILD}
        depends_on Expect::pre_reqs
        run {
            xxd -i ${Expect::SOURCE} >> ${Expect::BUILD}
        }
    }
}
