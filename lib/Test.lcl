# Test Framework for LCL
#
# A simple but capable test framework written in pure LCL.
#
# Usage:
#   load lib/Test.lcl
#
#   Test::suite "My Feature" {
#       Test::before {
#           # Setup code runs before each test
#       }
#
#       Test::case "should do something" {
#           let result [my_func 1 2]
#           Test::eq $result 3
#       }
#
#       Test::case "should fail on bad input" {
#           Test::raises {
#               my_func "bad" "input"
#           }
#       }
#   }
#
#   Test::run  ;# Run all suites and print results

# Create namespace with internal state
namespace eval Test {
    var _suites [list]
    var _current_name {}
    var _current_cases [list]
    var _current_before {}
    var _current_after {}
}

# Register a test suite
proc Test::suite {name body} {
    set! Test::_current_name $name
    set! Test::_current_cases [list]
    set! Test::_current_before {}
    set! Test::_current_after {}

    eval $body

    let suite_data [dict name $name cases $Test::_current_cases before $Test::_current_before after $Test::_current_after]
    set! Test::_suites [List::push $Test::_suites $suite_data]

    set! Test::_current_name {}
}

# Register a test case within the current suite
proc Test::case {name body} {
    let case_data [dict name $name body $body]
    set! Test::_current_cases [List::push $Test::_current_cases $case_data]
}

# Set up code to run before each test in the current suite
proc Test::before {body} {
    set! Test::_current_before $body
}

# Set up code to run after each test in the current suite
proc Test::after {body} {
    set! Test::_current_after $body
}

# Assertion: two values are equal
proc Test::eq {actual expected} {
    if [!= $actual $expected] {
        error "expected '$expected', got '$actual'"
    }
}

# Assertion: two values are equal (with custom message)
proc Test::eq_msg {actual expected msg} {
    if [!= $actual $expected] {
        error $msg
    }
}

# Assertion: two values are not equal
proc Test::neq {actual unexpected} {
    if [== $actual $unexpected] {
        error "expected value to not equal '$unexpected'"
    }
}

# Assertion: condition is true
proc Test::assert {cond} {
    if [not $cond] {
        error "assertion failed"
    }
}

# Assertion: condition is true (with custom message)
proc Test::assert_msg {cond msg} {
    if [not $cond] {
        error $msg
    }
}

# Assertion: condition is true (alias for assert)
proc Test::true {cond} {
    if [not $cond] {
        error "expected true, got false"
    }
}

# Assertion: condition is false
proc Test::false {cond} {
    if $cond {
        error "expected false, got true"
    }
}

# Assertion: value is empty (empty string or empty list)
proc Test::empty {val} {
    if [not [empty? $val]] {
        error "expected empty value, got '$val'"
    }
}

# Assertion: value is not empty
proc Test::not_empty {val} {
    if [empty? $val] {
        error "expected non-empty value"
    }
}

# Assertion: code raises an error
proc Test::raises {body} {
    if [catch { eval $body } _result _err] {
        return 1
    } else {
        error "expected error to be raised"
    }
}

# Assertion: code raises an error containing specific text
proc Test::raises_with {body expected_text} {
    if [catch { eval $body } _result _err] {
        if [== [String::find $_err $expected_text] -1] {
            error "error '$_err' does not contain '$expected_text'"
        }
        return 1
    } else {
        error "expected error to be raised"
    }
}

# Assertion: value is greater than expected
proc Test::gt {actual expected} {
    if [not [> $actual $expected]] {
        error "expected $actual > $expected"
    }
}

# Assertion: value is less than expected
proc Test::lt {actual expected} {
    if [not [< $actual $expected]] {
        error "expected $actual < $expected"
    }
}

# Assertion: value is greater than or equal to expected
proc Test::gte {actual expected} {
    if [not [>= $actual $expected]] {
        error "expected $actual >= $expected"
    }
}

# Assertion: value is less than or equal to expected
proc Test::lte {actual expected} {
    if [not [<= $actual $expected]] {
        error "expected $actual <= $expected"
    }
}

# Assertion: list contains element
proc Test::contains {lst elem} {
    var found 0
    foreach item $lst {
        if [== $item $elem] {
            set! found 1
            break
        }
    }
    if [not $found] {
        error "list does not contain '$elem'"
    }
}

# Assertion: string contains substring
proc Test::str_contains {haystack needle} {
    if [== [String::find $haystack $needle] -1] {
        error "string '$haystack' does not contain '$needle'"
    }
}

# Assertion: list has expected length
proc Test::len_eq {lst expected} {
    let actual [len $lst]
    if [!= $actual $expected] {
        error "expected length $expected, got $actual"
    }
}

# Skip the current test with a reason
proc Test::skip {reason} {
    error "SKIP:$reason"
}

# Run all registered test suites
proc Test::run {} {
    var passed 0
    var failed 0
    var skipped 0
    var failures [list]

    puts ""
    puts "Running tests..."
    puts ""

    foreach suite $Test::_suites {
        let suite_name [get $suite name]
        let cases [get $suite cases]
        let before_hook [get $suite before]
        let after_hook [get $suite after]

        puts "Suite: $suite_name"

        foreach test_case $cases {
            let case_name [get $test_case name]
            let body [get $test_case body]

            # Run before hook if present
            if [not [empty? $before_hook]] {
                if [catch { eval $before_hook } _br _be] {
                    puts "  FAIL: $case_name (before hook failed)"
                    puts "        $_be"
                    set! failed [+ $failed 1]
                    set! failures [List::push $failures [dict suite $suite_name case $case_name error "before: $_be"]]
                    continue
                }
            }

            # Run the test case
            if [catch { eval $body } _result _err] {
                # Check if this is a skip
                if [== [String::find $_err "SKIP:"] 0] {
                    let reason [String::range $_err 5 [String::length $_err]]
                    puts "  SKIP: $case_name ($reason)"
                    set! skipped [+ $skipped 1]
                } else {
                    # Test failed
                    puts "  FAIL: $case_name"
                    puts "        $_err"
                    set! failed [+ $failed 1]
                    set! failures [List::push $failures [dict suite $suite_name case $case_name error $_err]]
                }
            } else {
                # Test passed
                puts "  PASS: $case_name"
                set! passed [+ $passed 1]
            }

            # Run after hook if present
            if [not [empty? $after_hook]] {
                catch { eval $after_hook }
            }
        }

        puts ""
    }

    # Print summary
    let total [+ $passed [+ $failed $skipped]]
    puts "========================================"
    puts "Results: $passed passed, $failed failed, $skipped skipped ($total total)"
    puts "========================================"

    # Print failure details if any
    if [> $failed 0] {
        puts ""
        puts "Failures:"
        foreach f $failures {
            let s [get $f suite]
            let c [get $f case]
            let e [get $f error]
            puts "  $s > $c"
            puts "    $e"
        }
    }

    puts ""

    # Return exit code: 0 for success, 1 for failure
    if [> $failed 0] {
        return 1
    }
    return 0
}

# Clear all registered suites (useful for testing the framework itself)
proc Test::reset {} {
    set! Test::_suites [list]
    set! Test::_current_name {}
    set! Test::_current_cases [list]
    set! Test::_current_before {}
    set! Test::_current_after {}
}
