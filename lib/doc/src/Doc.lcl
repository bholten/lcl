;;; Doc -- documentation tooling for Lcl.
;;;
;;; Extracts `;;;` doc comments from source text using the language's
;;; own reader (`Lex::commands` word spans), renders markdown, and runs
;;; the doctests embedded in `Examples:` sections.
;;;
;;; A run of `;;;` lines immediately above a `proc`, `macro`,
;;; `namespace`, `let`, or `var` command documents that definition. An
;;; unattached run (a blank line or another command between it and
;;; the next definition) is prose: above the first definition of a
;;; file or namespace body it is that module's or namespace's own
;;; documentation; after one, it is a section of text rendered in
;;; place between the entries around it. `;;;` lines inside braced
;;; data are ignored: a line only counts when it is not covered by any
;;; word span, so doc comments inside string blobs never leak into the
;;; docs. Namespace bodies are recursed into by slicing the body span.
;;;
;;; Doc text convention: first line is a one-line summary, then
;;; markdown prose, then an optional `Examples:` section:
;;;
;;; ```tcl
;;;   ;;; Add two numbers, slowly.
;;;   ;;;
;;;   ;;; Examples:
;;;   ;;; >> + 1 2
;;;   ;;; 3
;;;   ;;; >> + 1 (2 3)
;;;   ;;; !! expected number
;;; ```
;;;
;;; Each `>>` line is a command; the following non-blank line is the
;;; expected `repr` of its result (`!!` expects an error whose message
;;; contains the given text; no expectation just checks it runs).
;;; Consecutive `>>` lines join into one multi-line command while the
;;; accumulated text fails to parse (an open `{`, `"`, or `[`); a
;;; line that parses complete closes the command, so single-line
;;; examples behave as before. A bare `>>` is a visual separator.
;;; Comparing against `repr` is deliberate: it keeps examples honest
;;; about list-vs-string.
;;;
;;; An `Examples:` section ends at the first non-blank line that
;;; follows a blank line and is not a `>>` command: prose resumes
;;; there, and another `Examples:` may follow later. Long-form docs
;;; (a manual written as module prose) can therefore interleave text
;;; and executed examples; rendering keeps them in order.

namespace Doc {
    proc _streq {a b} {
        and [== [String::length $a] [String::length $b]] [== [String::find $a $b] 0]
    }

    proc _starts {s p} {
        _streq [String::range $s 0 [String::length $p]] $p
    }

    proc _lines {text} {
        var out ()
        var off 0
        var n 1

        foreach ln [String::split $text "\n"] {
            set! out [List::push $out #{n $n start $off text $ln}]
            set! off [+ $off [String::length $ln] 1]
            set! n [+ $n 1]
        }

        $out
    }

    proc _spans {cmds} {
        var out ()

        foreach c $cmds {
            foreach w [get $c words] {
                set! out [List::push $out [get $w span]]
            }
        }
        $out
    }

    proc _covered {spans off} {
        List::any? $spans [lambda {sp} {
            and [<= [get $sp 0] $off] [< $off [get $sp 1]]
        }]
    }

    proc _line_of {lines off} {
        var n 1

        foreach L $lines {
            if [<= [get $L start] $off] {
                set! n [get $L n]
            }
        }

        $n
    }

    proc _doc_text {ln} {
        let t [String::trim $ln]
        var c [String::range $t 3 [String::length $t]]

        if [_starts $c " "] {
            set! c [String::range $c 1 [String::length $c]]
        }

        $c
    }

    proc _doc_runs {lines spans} {
        var runs ()
        var open 0
        var first 0
        var last 0
        var text {}

        foreach L $lines {
            let ln [get $L text]
            let t [String::trim $ln]
            var hit 0

            if [_starts $t ";;;"] {
                let moff [+ [get $L start] [String::find $ln ";;;"]]
                if [not [_covered $spans $moff]] {
                    set! hit 1
                }
            }

            if $hit {
                if $open {
                    set! text "$text\n[_doc_text $ln]"
                } else {
                    set! open 1
                    set! first [get $L n]
                    set! text [_doc_text $ln]
                }
                set! last [get $L n]
            } else {
                if $open {
                    set! runs [List::push $runs #{first $first last $last text $text}]
                    set! open 0
                }
            }
        }

        if $open {
            set! runs [List::push $runs #{first $first last $last text $text}]
        }

        $runs
    }

    proc _head_kind {c} {
        let ws [get $c words]

        if [< [len $ws] 3] { return {} }

        let w0 [get $ws 0]

        if [get $w0 dynamic] { return {} }
        if [get $w0 quoted] { return {} }
        if [get [get $ws 1] dynamic] { return {} }

        let h [get $w0 text]

        if [and [or [== $h "proc"] [== $h "macro"]] [>= [len $ws] 4]] {
            return $h
        }

        if [== $h "namespace"] {
            return $h
        }

        if [or [== $h "let"] [== $h "var"]] {
            return $h
        }

        return {}
    }

    proc _add_ns {entries name line doc sub} {
        var found -1
        var i 0

        foreach e $entries {
            if [and [== [get $e kind] "namespace"] [== [get $e name] $name]] {
                set! found $i
            }

            set! i [+ $i 1]
        }

        if [< $found 0] {
            return [List::push $entries #{kind "namespace" name $name line $line doc $doc entries $sub}]
        }

        let old [get $entries $found]
        var d [get $old doc]

        if [!= $doc {}] {
            if [!= $d {}] {
                set! d "$d\n\n$doc"
            } else {
                set! d $doc
            }
        }

        let merged #{kind "namespace" name $name line [get $old line] doc $d entries [List::concat [get $old entries] $sub]}

        put $entries $found $merged
    }

    ;;; Extract the doc model from source text.
    ;;;
    ;;; Returns `#{doc <module doc> entries (<entry> ...)}`. Entries are
    ;;; `#{kind proc|macro name N params P line L doc D}`,
    ;;; `#{kind let|var name N line L doc D}` (only when documented), or
    ;;; `#{kind namespace name N line L doc D entries (...)}` with the
    ;;; body extracted recursively, or `#{kind prose name {} line L doc
    ;;; D}` for a section of text between definitions. Names starting
    ;;; with `_` are private and skipped. `base` offsets reported line
    ;;; numbers (used by the recursion; callers can ignore it).
    ;;;
    ;;; Examples:
    ;;; >> let m [Doc::extract ";;; doubles\nproc dbl {x} { + \$x \$x }"]
    ;;; >> get [get [get $m entries] 0] name
    ;;; "dbl"
    ;;; >> get [get [get $m entries] 0] doc
    ;;; "doubles"
    proc extract {text (base 1)} {
        let cmds [Lex::commands $text]
        let lines [_lines $text]
        let spans [_spans $cmds]
        let runs [_doc_runs $lines $spans]
        var used [List::map $runs [lambda {r} { 0 }]]
        var entries ()

        foreach c $cmds {
            let kind [_head_kind $c]

            if [!= $kind {}] {
                let ws [get $c words]
                let cl [get $c line]
                var doc {}
                var ri 0

                foreach r $runs {
                    if [== [get $r last] [- $cl 1]] {
                        set! doc [get $r text]
                        set! used [put $used $ri 1]
                    }

                    set! ri [+ $ri 1]
                }

                let name [get [get $ws 1] text]
                let gline [+ $base $cl -1]

                if [not [_starts $name "_"]] {
                    if [== $kind "namespace"] {
                        let bw [get $ws [- [len $ws] 1]]
                        var sub ()

                        if [not [get $bw dynamic]] {
                            let sp [get $bw span]
                            var s [get $sp 0]
                            var e [get $sp 1]

                            if [get $bw braced] {
                                set! s [+ $s 1]
                                set! e [- $e 1]
                            }

                            let child [extract [String::range $text $s $e] [+ $base [_line_of $lines $s] -1]]
                            set! sub [get $child entries]
                            let subdoc [get $child doc]

                            if [!= $subdoc {}] {
                                if [!= $doc {}] { set! doc "$doc\n\n$subdoc" } else { set! doc $subdoc }
                            }
                        }
                        set! entries [_add_ns $entries $name $gline $doc $sub]
                    } else {
                        if [or [== $kind "proc"] [== $kind "macro"]] {
                            let params [get [get $ws 2] text]
                            set! entries [List::push $entries #{kind $kind name $name params $params line $gline doc $doc}]
                        } else {
                            if [!= $doc {}] {
                                set! entries [List::push $entries #{kind $kind name $name line $gline doc $doc}]
                            }
                        }
                    }
                }
            }
        }

        ;; unattached runs: module prose above the first entry, in-place
        ;; sections after it (merged into the entry order by line)
        var mdoc {}
        var first_line -1
        var ri 0

        if [> [len $entries] 0] {
            set! first_line [get [get $entries 0] line]
        }

        var merged ()
        var ei 0

        foreach r $runs {
            if [not [get $used $ri]] {
                let rline [+ $base [get $r first] -1]

                if [or [< $first_line 0] [< $rline $first_line]] {
                    if [== $mdoc {}] { set! mdoc [get $r text] } else { set! mdoc "$mdoc\n\n[get $r text]" }
                } else {
                    while [and [< $ei [len $entries]] [< [get [get $entries $ei] line] $rline]] {
                        List::push! merged [get $entries $ei]
                        set! ei [+ $ei 1]
                    }

                    List::push! merged #{kind "prose" name {} line $rline doc [get $r text]}
                }
            }

            set! ri [+ $ri 1]
        }

        while [< $ei [len $entries]] {
            List::push! merged [get $entries $ei]
            set! ei [+ $ei 1]
        }

        #{doc $mdoc entries $merged}
    }

    ;;; Extract the doc model from a file (needs the io package).
    proc extract_file {path} {
        extract [Io::read_file $path]
    }

    ;; ---- doc text parsing -----------------------------------------

    ;;; Parse one doc string into its parts.
    ;;;
    ;;; Returns `#{summary S body B blocks (...) examples (...)
    ;;; example_lines (...)}`. `blocks` is the doc in order, each
    ;;; `#{kind prose text T}` or `#{kind examples lines (...)}`;
    ;;; `body` is all prose joined, `example_lines` all example lines,
    ;;; and each example is `#{cmd C kind none|value|error expect E}`.
    ;;;
    ;;; Examples:
    ;;; >> get [Doc::parse "sums\n\nExamples:\n>> + 1 2\n3"] summary
    ;;; "sums"
    ;;; >> len [get [Doc::parse "sums\n\nExamples:\n>> + 1 2\n3"] examples]
    ;;; 1
    ;;; >> let d "x\n\nExamples:\n>> proc add {a b} {\n>>   + \$a \$b\n>> }\n>> add 1 2\n3"
    ;;; >> len [get [Doc::parse $d] examples]
    ;;; 2
    ;;; >> get [get [get [Doc::parse $d] examples] 1] expect
    ;;; "3"
    ;;; >> let two "a\n\nExamples:\n>> + 1 1\n2\n\nMore prose.\n\nExamples:\n>> + 2 2\n4"
    ;;; >> List::map [get [Doc::parse $two] blocks] [lambda {b} { get $b kind }]
    ;;; ("prose" "examples" "prose" "examples")
    ;;; >> len [get [Doc::parse $two] examples]
    ;;; 2
    proc parse {doc} {
        var blocks ()
        var cur ()
        var in_ex 0
        var blank 1

        foreach ln [String::split $doc "\n"] {
            let t [String::trim $ln]

            if $in_ex {
                if [and $blank [!= $t {}] [not [_starts $t ">>"]]] {
                    ;; prose after a blank line ends the examples
                    List::push! blocks #{kind "examples" lines $cur}
                    set! cur ($ln)
                    set! in_ex 0
                } else {
                    List::push! cur $ln
                }
            } else {
                if [== $t "Examples:"] {
                    if [> [len $cur] 0] {
                        List::push! blocks #{kind "prose" text [String::join $cur "\n"]}
                    }

                    set! cur ()
                    set! in_ex 1
                } else {
                    List::push! cur $ln
                }
            }

            set! blank [== $t {}]
        }

        if $in_ex {
            List::push! blocks #{kind "examples" lines $cur}
        } else {
            if [> [len $cur] 0] {
                List::push! blocks #{kind "prose" text [String::join $cur "\n"]}
            }
        }

        var body_lines ()
        var ex_lines ()

        foreach b $blocks {
            if [== [get $b kind] "prose"] {
                List::push! body_lines [get $b text]
            } else {
                set! ex_lines [List::concat $ex_lines [get $b lines]]
            }
        }

        var summary {}

        foreach ln [String::split [String::join $body_lines "\n"] "\n"] {
            if [and [== $summary {}] [!= [String::trim $ln] {}]] {
                set! summary [String::trim $ln]
            }
        }

        var examples ()
        var ex {}

        foreach ln $ex_lines {
            let t [String::trim $ln]

            if [_starts $t ">>"] {
                let rest [String::trim [String::range $t 2 [String::length $t]]]

                if [and [!= $ex {}] [== [get $ex kind] "none"] [catch {Lex::commands [get $ex cmd]}]] {
                    ;; the accumulated command doesn't parse yet (an
                    ;; open brace, quote, or bracket): this >> line
                    ;; continues it
                    set! ex [put $ex cmd "[get $ex cmd]\n$rest"]
                } else {
                    if [and [!= $ex {}] [!= [get $ex cmd] {}]] {
                        List::push! examples $ex
                    }

                    set! ex #{cmd $rest kind "none" expect {}}
                }
            } else {
                if [and [!= $t {}] [!= $ex {}]] {
                    if [_starts $t "!!"] {
                        set! ex [put $ex kind "error"]
                        set! ex [put $ex expect [String::trim [String::range $t 2 [String::length $t]]]]
                    } else {
                        if [== [get $ex kind] "value"] {
                            set! ex [put $ex expect "[get $ex expect]\n$t"]
                        } else {
                            set! ex [put $ex kind "value"]
                            set! ex [put $ex expect $t]
                        }
                    }
                }
            }
        }

        if [and [!= $ex {}] [!= [get $ex cmd] {}]] {
            List::push! examples $ex
        }

        #{summary $summary body [String::join $body_lines "\n"] blocks $blocks examples $examples example_lines $ex_lines}
    }

    ;; ---- markdown generation --------------------------------------

    ;;; The HTML anchor id a rendered entry gets: its qualified name,
    ;;; verbatim. `markdown` emits `<a id="..."></a>` before every
    ;;; heading so links survive signature changes (pandoc's derived
    ;;; heading ids do not), and `?`/`!` are legal in an HTML5 id.
    ;;;
    ;;; Examples:
    ;;; >> Doc::anchor "List::push!"
    ;;; "List::push!"
    proc anchor {qname} {
        $qname
    }

    ;; Resolve one `[...]` in prose. `rest` starts at the `[`; returns
    ;; `#{text T len N}`: the replacement and how many bytes of `rest`
    ;; it covers. A bracket that is not a bare name, has no closing
    ;; bracket, or is already a markdown link (`](` / `][` follows) is
    ;; passed through unchanged.
    proc _link_one {rest link} {
        let n [String::length $rest]
        let b [String::find $rest "]"]

        if [< $b 0] {
            return #{text $rest len $n}
        }

        let name [String::range $rest 1 $b]
        let after [String::range $rest [+ $b 1] [+ $b 2]]
        var url {}

        if [and [!= $name {}] [< [String::find $name " "] 0] [< [String::find $name "\["] 0]] {
            if [and [!= $after "("] [!= $after "\["]] {
                set! url [apply $link $name]
            }
        }

        if [== $url {}] {
            return #{text [String::range $rest 0 [+ $b 1]] len [+ $b 1]}
        }

        #{text "\[`$name`\]($url)" len [+ $b 1]}
    }

    ;; Link `[Name]` references in one span of prose (no code spans).
    proc _link_seg {seg link} {
        var out {}
        var rest $seg

        while 1 {
            let a [String::find $rest "\["]

            if [< $a 0] {
                return "$out$rest"
            }

            let r [_link_one [String::range $rest $a [String::length $rest]] $link]
            set! out "$out[String::range $rest 0 $a][get $r text]"
            set! rest [String::range $rest [+ $a [get $r len]] [String::length $rest]]
        }
    }

    ;; Turn `[Name]` outside code spans into a markdown link when
    ;; `link` (a proc: name -> url, or {} for no link) resolves it;
    ;; everything else is left verbatim. Splitting on backticks keeps
    ;; inline code and fenced blocks untouched: an odd-numbered
    ;; segment is always inside code, whether the fence is one
    ;; backtick or three.
    proc _link_text {text link} {
        if [== $link {}] {
            return $text
        }

        var out {}
        var i 0

        foreach seg [String::split $text "`"] {
            if [> $i 0] {
                set! out "$out`"
            }

            if [== [% $i 2] 1] {
                set! out "$out$seg"
            } else {
                set! out "$out[_link_seg $seg $link]"
            }

            set! i [+ $i 1]
        }

        $out
    }

    ;; Render one doc string: its prose and example blocks, in order,
    ;; examples as fenced code.
    proc _md_doc {doc link} {
        var out {}

        foreach b [get [parse $doc] blocks] {
            if [== [get $b kind] "prose"] {
                let body [String::trim [get $b text]]

                if [!= $body {}] {
                    set! out "$out[_link_text $body $link]\n\n"
                }
            } else {
                let ex [String::trim [String::join [get $b lines] "\n"]]

                if [!= $ex {}] {
                    set! out "$out**Examples:**\n\n```tcl\n$ex\n```\n\n"
                }
            }
        }

        $out
    }

    proc _md_entries {prefix entries link} {
        var out {}

        foreach e $entries {
            let q "$prefix[get $e name]"
            let k [get $e kind]
            let a "<a id=\"[anchor $q]\"></a>\n\n"

            if [== $k "prose"] {
                set! out "$out[_md_doc [get $e doc] $link]"
            } else {
            if [== $k "namespace"] {
                set! out "$out$a## namespace `$q`\n\n[_md_doc [get $e doc] $link][_md_entries "$q::" [get $e entries] $link]"
            } else {
                if [or [== $k "proc"] [== $k "macro"]] {
                    var sig $q
                    let params [String::trim [get $e params]]

                    if [!= $params {}] {
                        set! sig "$q $params"
                    }

                    set! out "$out$a### $k `$sig`\n\n[_md_doc [get $e doc] $link]"
                } else {
                    set! out "$out$a### $k `$q`\n\n[_md_doc [get $e doc] $link]"
                }
            }
            }
        }

        $out
    }

    ;;; Render a doc model to markdown.
    ;;;
    ;;; Module doc first, then `## namespace` sections with `###`
    ;;; entries; proc signatures come from the source's own word
    ;;; records. Every entry heading is preceded by an `<a id>` anchor
    ;;; named by `anchor`. An optional title becomes a leading `#`
    ;;; heading. `link`, when given, is a proc mapping a name to a URL
    ;;; (or `{}`): each `[Name]` in prose outside code spans that it
    ;;; resolves is rendered as a link, so companion docs can
    ;;; cross-reference by qualified name.
    ;;;
    ;;; Examples:
    ;;; >> let m [Doc::extract ";;; See \[M::f\].\nnamespace M { ;;; f\n proc f {} { 1 } }"]
    ;;; >> >= [String::find [Doc::markdown $m] "<a id=\"M::f\"></a>"] 0
    ;;; 1
    ;;; >> let md [Doc::markdown $m {} [lambda {n} { "u#$n" }]]
    ;;; >> >= [String::find $md "See \[`M::f`\](u#M::f)."] 0
    ;;; 1
    proc markdown {model (title {}) (link {})} {
        var out {}

        if [!= $title {}] {
            set! out "# $title\n\n"
        }

        if [!= [String::trim [get $model doc]] {}] {
            set! out "$out[_md_doc [get $model doc] $link]"
        }

        "$out[_md_entries {} [get $model entries] $link]"
    }

    ;;; Extract a file and render it to markdown (needs the io package).
    ;;; The title defaults to the path; `link` is passed to `markdown`.
    proc markdown_file {path (title {}) (link {})} {
        var t $title
        if [== $t {}] { set! t $path }
        markdown [extract_file $path] $t $link
    }

    ;;; Link `[Name]` references in free-form markdown text, the same
    ;;; way `markdown` does for extracted docs. Lets a site builder run
    ;;; plain `.md` pages through the same resolver.
    ;;;
    ;;; Examples:
    ;;; >> Doc::link_text "See \[f\] and `\[f\]`." [lambda {n} { "#$n" }]
    ;;; "See \[`f`](#f) and `\[f]`."
    ;;; >> Doc::link_text "no \[zz\] here" [lambda {n} { {} }]
    ;;; "no \[zz] here"
    proc link_text {text link} {
        _link_text $text $link
    }

    ;; ---- doctests -------------------------------------------------

    proc _dt_merge {a b} {
        #{pass [+ [get $a pass] [get $b pass]] fail [+ [get $a fail] [get $b fail]] failures [List::concat [get $a failures] [get $b failures]]}
    }

    ;; Run the examples of one doc string. All examples in a single doc
    ;; block share one scope, so `>> let x 1` then `>> + $x 1` works.
    proc _dt_doc {_dtname _dtdoc} {
        var _dtpass 0
        var _dtfail 0
        var _dtfails ()
        var _dtres {}
        var _dterr {}

        foreach _dtex [get [parse $_dtdoc] examples] {
            let _dtcmd [get $_dtex cmd]
            let _dtrc [catch {eval $_dtcmd} _dtres _dterr]
            let _dtkind [get $_dtex kind]
            let _dtwant [get $_dtex expect]
            var _dtok 0
            var _dtgot {}

            if [== $_dtkind "error"] {
                if [== $_dtrc 1] {
                    if [or [== $_dtwant {}] [>= [String::find $_dterr $_dtwant] 0]] { set! _dtok 1 }
                    set! _dtgot "(error) $_dterr"
                } else {
                    set! _dtgot "(no error) [repr $_dtres]"
                }
            } else {
                if [== $_dtrc 0] {
                    set! _dtgot [repr $_dtres]

                    if [== $_dtkind "none"] {
                        set! _dtok 1
                    } else {
                        if [_streq $_dtgot $_dtwant] { set! _dtok 1 }
                    }
                } else {
                    set! _dtgot "(error) $_dterr"
                }
            }

            if $_dtok {
                set! _dtpass [+ $_dtpass 1]
            } else {
                var _dtshow $_dtwant

                if [== $_dtkind "error"] {
                    set! _dtshow "!! $_dtwant"
                }

                if [== $_dtkind "none"] {
                    set! _dtshow "(no error)"
                }

                set! _dtfails [List::push $_dtfails #{name $_dtname cmd $_dtcmd expect $_dtshow got $_dtgot}]
                set! _dtfail [+ $_dtfail 1]
            }
        }

        #{pass $_dtpass fail $_dtfail failures $_dtfails}
    }

    proc _dt_entries {prefix entries} {
        var acc #{pass 0 fail 0 failures ()}

        foreach e $entries {
            var q "$prefix[get $e name]"

            if [== [get $e kind] "prose"] {
                set! q "$prefix(prose)"
            }

            if [!= [get $e doc] {}] {
                set! acc [_dt_merge $acc [_dt_doc $q [get $e doc]]]
            }

            if [== [get $e kind] "namespace"] {
                set! acc [_dt_merge $acc [_dt_entries "$q::" [get $e entries]]]
            }
        }

        $acc
    }

    ;;; Run every doctest in a doc model.
    ;;;
    ;;; Examples run in the doctest's own scope; namespaces referenced
    ;;; in examples must already be loaded (e.g. `require` the module
    ;;; under test first). Returns
    ;;; `#{pass N fail N failures (#{name cmd expect got} ...)}`.
    proc doctest {model} {
        var acc #{pass 0 fail 0 failures ()}

        if [!= [get $model doc] {}] {
            set! acc [_dt_merge $acc [_dt_doc "(module)" [get $model doc]]]
        }

        _dt_merge $acc [_dt_entries {} [get $model entries]]
    }

    ;;; Extract a file and run its doctests (needs the io package).
    proc doctest_file {path} {
        doctest [extract_file $path]
    }

    ;;; Print doctest results; returns the number of failures.
    proc report {res} {
        foreach f [get $res failures] {
            puts "FAIL [get $f name]: >> [get $f cmd]"
            puts "  expected: [get $f expect]"
            puts "  got:      [get $f got]"
        }

        puts "doctest: [get $res pass] passed, [get $res fail] failed"
        get $res fail
    }

    ;; ---- live symbols ---------------------------------------------

    ;; Index of extracted docs: source name -> flat entry list. A file
    ;; that could not be read is stored as () so it is not retried.
    var _sources #{}

    proc _flat {prefix entries file} {
        var acc ()

        foreach e $entries {
            if [== [get $e kind] "prose"] { continue }

            let q "$prefix[get $e name]"
            let flat #{kind [get $e kind] qname $q name [get $e name] params [get $e params {}] line [get $e line] doc [get $e doc] file $file}
            set! acc [List::push $acc $flat]

            if [== [get $e kind] "namespace"] {
                set! acc [List::concat $acc [_flat "$q::" [get $e entries] $file]]
            }
        }

        $acc
    }

    ;;; Register the docs in source text under a source name.
    ;;;
    ;;; Indexes the `;;;` docs in `text` so `lookup` and `describe` can
    ;;; find them. `name` is the file the text came from, or any label
    ;;; for source the host owns (an editor buffer, an embedded
    ;;; library). Procs loaded from a file are matched by their
    ;;; `Proc::origin` line when `name` is that file; everything else,
    ;;; including companion docs for C procs, is matched by qualified
    ;;; name. Registering a name again replaces its entries. Returns
    ;;; the number of entries indexed.
    ;;;
    ;;; Examples:
    ;;;
    ;;; >> Doc::register ";;; Two.\nnamespace Tw { ;;; One.\n proc one {} { 1 } }" "tw"
    ;;; 2
    ;;; >> get [Doc::lookup "Tw::one"] doc
    ;;; "One."
    proc register {text (name "<registered>")} {
        let flat [_flat {} [get [extract $text] entries] $name]
        set! _sources [put $_sources $name $flat]
        len $flat
    }

    ;;; Register a file's docs under its path (needs the io package).
    proc register_file {path} {
        register [Io::read_file $path] $path
    }

    ;; Entries for a source, reading the file on first use.
    proc _source {name} {
        let cur [get $_sources $name "none"]

        if [!= $cur "none"] {
            return $cur
        }

        var flat ()
        catch { set! flat [_flat {} [get [extract_file $name] entries] $name] }
        set! _sources [put $_sources $name $flat]
        $flat
    }

    proc _by_line {flat line} {
        foreach e $flat {
            if [== [get $e line] $line] {
                return $e
            }
        }

        #{}
    }

    proc _by_name {name} {
        foreach flat [Dict::values $_sources] {
            foreach e $flat {
                if [== [get $e qname] $name] {
                    return $e
                }
            }
        }

        if [< [String::find $name "::"] 0] {
            var found #{}
            var hits 0

            foreach flat [Dict::values $_sources] {
                foreach e $flat {
                    if [== [get $e name] $name] {
                        set! found $e
                        set! hits [+ $hits 1]
                    }
                }
            }

            if [== $hits 1] {
                return $found
            }
        }

        #{}
    }

    ;; The live value a proc argument names, or {} when it is a name
    ;; that does not resolve.
    proc _live {p} {
        if [!= [type $p] "string"] {
            return $p
        }

        var v {}
        catch { set! v [getvar $p] }
        $v
    }

    ;;; Find the doc entry for a live proc or a name.
    ;;;
    ;;; `p` is a proc value or a name, qualified or not. An Lcl proc is
    ;;; matched by its `Proc::origin` file and line; the file is read
    ;;; and indexed on first use. A C proc, a name that is not live, or
    ;;; a proc whose file is unavailable falls back to the registered
    ;;; docs by qualified name, then (for an unqualified name) by bare
    ;;; name, which must be unique across the index. A line hit whose
    ;;; entry name differs from the proc's own name is treated as stale
    ;;; (the source changed since it was loaded) and ignored. Returns
    ;;; the entry, `#{kind K qname Q name N params P line L doc D file F}`,
    ;;; or `#{}` when nothing is documented.
    ;;;
    ;;; Examples:
    ;;;
    ;;; >> Doc::register ";;; Adds.\nproc lk_add {a b} { + \$a \$b }" "lk"
    ;;; 1
    ;;; >> get [Doc::lookup lk_add] params
    ;;; "a b"
    ;;; >> Doc::lookup lk_nothing
    ;;; #{}
    proc lookup {p} {
        let v [_live $p]
        var hint {}

        if [== [type $p] "string"] {
            set! hint $p
        }

        if [== [type $v] "proc"] {
            let o [Proc::origin $v]
            let file [get $o file {}]

            if [!= $file {}] {
                let e [_by_line [_source $file] [get $o line]]
                let own [Proc::name $v]

                if [and [> [len $e] 0] [or [== $own {}] [== $own [get $e name]]]] {
                    return $e
                }
            }
        }

        if [and [== $hint {}] [or [== [type $v] "proc"] [== [type $v] "cproc"]]] {
            set! hint [Proc::name $v]
        }

        if [== $hint {}] {
            return #{}
        }

        _by_name $hint
    }

    ;;; Describe a live proc or a name: signature, origin, and doc text.
    ;;;
    ;;; The entry comes from `lookup`. When `p` is a name, that name is
    ;;; the one printed (the index may know the same proc under a
    ;;; shorter one). A live proc with no docs still gets its signature
    ;;; from `Proc::params` and its `Proc::origin`. Errors when `p` is
    ;;; neither live nor documented.
    ;;;
    ;;; Examples:
    ;;;
    ;;; >> Doc::register ";;; Adds.\n;;;\n;;; Slowly.\nproc ds_add {a b} { + \$a \$b }" "ds"
    ;;; 1
    ;;; >> String::split [Doc::describe ds_add] "\n"
    ;;; ("proc ds_add {a b}" "  ds:4" "" "Adds." "" "Slowly.")
    ;;; >> String::split [Doc::describe +] "\n"
    ;;; ("proc + {}" "" "(undocumented)")
    ;;; >> Doc::describe ds_nothing
    ;;; !! nothing known about "ds_nothing"
    proc describe {p} {
        let e [lookup $p]
        let v [_live $p]
        let live [or [== [type $v] "proc"] [== [type $v] "cproc"]]

        if [> [len $e] 0] {
            var shown [get $e qname]

            if [== [type $p] "string"] {
                set! shown $p
            }

            var head "[get $e kind] $shown"

            if [or [== [get $e kind] "proc"] [== [get $e kind] "macro"]] {
                set! head "$head {[get $e params]}"
            }

            set! head "$head\n  [get $e file]:[get $e line]"
            let doc [get $e doc]

            if [== $doc {}] {
                return "$head\n\n(undocumented)"
            }

            return "$head\n\n$doc"
        }

        if [not $live] {
            error "Doc::describe: nothing known about \"$p\""
        }

        var name [Proc::name $v]

        if [== [type $p] "string"] {
            set! name $p
        }

        if [== $name {}] {
            set! name "lambda"
        }

        var head "proc $name {[String::join [Proc::params $v] " "]}"
        let o [Proc::origin $v]

        if [> [len $o] 0] {
            set! head "$head\n  [get $o file]:[get $o line]"
        }

        "$head\n\n(undocumented)"
    }

    ;;; Every indexed doc entry, as a flat list.
    ;;;
    ;;; Covers the sources seen so far: registered explicitly, or read
    ;;; on demand by `lookup`. It is not a walk of the live interpreter;
    ;;; `register_file` the files you want covered.
    ;;;
    ;;; Examples:
    ;;;
    ;;; >> Doc::register ";;; A.\nproc en_a {} { 1 }\n;;; B.\nproc en_b {} { 2 }" "en"
    ;;; 2
    ;;; >> List::map [Doc::search "en_"] [lambda {e} { get $e qname }]
    ;;; ("en_a" "en_b")
    proc entries {} {
        var acc ()

        foreach flat [Dict::values $_sources] {
            set! acc [List::concat $acc $flat]
        }

        $acc
    }

    ;;; Search the index: entries whose qualified name or doc text
    ;;; contains `sub`, case-insensitively.
    proc search {sub} {
        let needle [String::lower $sub]

        List::filter [entries] [lambda {e} {
            or [>= [String::find [String::lower [get $e qname]] $needle] 0] [>= [String::find [String::lower [get $e doc]] $needle] 0]
        }]
    }

    ;;; Run the doctests of one documented symbol.
    ;;;
    ;;; `p` is anything `lookup` accepts. Returns
    ;;; `#{pass N fail N failures (...)}` as `doctest` does, and errors
    ;;; when nothing is documented for `p`. Examples run in the
    ;;; doctest's own scope, so the names they use must be live.
    ;;;
    ;;; Examples:
    ;;;
    ;;; >> Doc::register ";;; Adds.\n;;;\n;;; Examples:\n;;; >> + 1 2\n;;; 3\nproc rv_add {a b} { + \$a \$b }" "rv"
    ;;; 1
    ;;; >> get [Doc::run_value rv_add] pass
    ;;; 1
    ;;; >> Doc::run_value rv_nothing
    ;;; !! nothing documented
    proc run_value {p} {
        let e [lookup $p]

        if [== [len $e] 0] {
            error "Doc::run_value: nothing documented for \"$p\""
        }

        _dt_doc [get $e qname] [get $e doc]
    }

    ;; Look up every proc under a live namespace so file-backed docs
    ;; are read into the index before a prefix walk.
    proc _warm {name v} {
        foreach k [Ns::keys $v] {
            let q "${name}::${k}"
            let m [_live $q]

            if [== [type $m] "namespace"] {
                _warm $q $m
            } else {
                lookup $q
            }
        }
    }

    ;;; Run the doctests of a namespace and everything under it.
    ;;;
    ;;; `ns` is a namespace name or value. When it is live, its members
    ;;; are looked up first so file-backed docs are read on demand;
    ;;; then every indexed entry whose qualified name is `ns` or starts
    ;;; with `ns::` runs, the namespace's own doc included. Returns the
    ;;; merged `#{pass N fail N failures (...)}`.
    ;;;
    ;;; Examples:
    ;;;
    ;;; >> Doc::register "namespace Rn { ;;; Examples:\n ;;; >> + 1 1\n ;;; 2\n proc a {} { 1 }\n ;;; Examples:\n ;;; >> + 1 1\n ;;; 3\n proc b {} { 1 } }" "rn"
    ;;; 3
    ;;; >> let r [Doc::run_ns Rn]
    ;;; >> list [get $r pass] [get $r fail] [get [get [get $r failures] 0] name]
    ;;; (1 1 "Rn::b")
    ;;; >> list [get [Doc::run_ns Rn_nothing] pass] [get [Doc::run_ns Rn_nothing] fail]
    ;;; (0 0)
    proc run_ns {ns} {
        var name $ns

        if [!= [type $ns] "string"] {
            set! name [Ns::name $ns]
        }

        let v [_live $name]

        if [== [type $v] "namespace"] {
            _warm $name $v
        }

        var acc #{pass 0 fail 0 failures ()}
        let prefix "${name}::"

        foreach e [entries] {
            let q [get $e qname]

            if [and [!= [get $e doc] {}] [or [== $q $name] [== [String::find $q $prefix] 0]]] {
                set! acc [_dt_merge $acc [_dt_doc $q [get $e doc]]]
            }
        }

        $acc
    }
}
