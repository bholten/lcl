;; Tests for Doc.lcl
Test::suite "Doc::extract" {
    Test::case "attaches a ;;; run to the next definition" {
        let src {;;; Doubles a number.
;;; Second line.
proc dbl {x} { + $x $x }}
        let m [Doc::extract $src]
        let e [get [get $m entries] 0]
        Test::eq [get $e kind] "proc"
        Test::eq [get $e name] "dbl"
        Test::eq [get $e params] "x"
        Test::eq [get $e line] 3
        Test::eq [get $e doc] "Doubles a number.\nSecond line."
    }

    Test::case "blank line detaches: run becomes module doc" {
        let src {;;; Module prose.

proc f {} { 0 }}
        let m [Doc::extract $src]
        Test::eq [get $m doc] "Module prose."
        Test::eq [get [get [get $m entries] 0] doc] ""
    }

    Test::case "run above a non-definition command is module doc" {
        let src {;;; Stray note.
puts hi}
        Test::eq [get [Doc::extract $src] doc] "Stray note."
    }

    Test::case "separate unattached runs join with a blank line" {
        let src {;;; One.

;;; Two.

let x 1}
        Test::eq [get [Doc::extract $src] doc] "One.\n\nTwo."
    }

    Test::case "leading whitespace before ;;; is allowed" {
        let src {    ;;; Indented doc.
    proc f {} { 0 }}
        Test::eq [get [get [get [Doc::extract $src] entries] 0] doc] "Indented doc."
    }

    Test::case ";;; inside braced data is not a doc comment" {
        let src {let blob {
;;; not a doc
}
proc f {} { 0 }}
        let m [Doc::extract $src]
        Test::eq [get $m doc] ""
        Test::eq [get [get [get $m entries] 0] doc] ""
    }

    Test::case "underscore names are private and skipped" {
        let src {;;; Hidden.
proc _helper {} { 0 }
;;; Shown.
proc f {} { 0 }}
        let m [Doc::extract $src]
        Test::eq [len [get $m entries]] 1
        Test::eq [get [get [get $m entries] 0] name] "f"
        ;; the private doc attached; it must not fall back into module doc
        Test::eq [get $m doc] ""
    }

    Test::case "undocumented let/var are skipped, documented kept" {
        let src {let plain 1
;;; The answer.
let answer 42
;;; Mutable counter.
var n 0}
        let m [Doc::extract $src]
        Test::eq [len [get $m entries]] 2
        Test::eq [get [get [get $m entries] 0] kind] "let"
        Test::eq [get [get [get $m entries] 1] kind] "var"
    }

    Test::case "undocumented procs and macros are kept" {
        let src {proc f {} { 0 }
macro m {x} { $x }}
        let m [Doc::extract $src]
        Test::eq [len [get $m entries]] 2
        Test::eq [get [get [get $m entries] 1] kind] "macro"
    }

    Test::case "recurses into namespace bodies with absolute lines" {
        let src {;;; NS doc.
namespace M {
    ;;; Inner doc.
    proc sq {x} { * $x $x }
}}
        let e [get [get [Doc::extract $src] entries] 0]
        Test::eq [get $e kind] "namespace"
        Test::eq [get $e name] "M"
        Test::eq [get $e doc] "NS doc."
        let s [get [get $e entries] 0]
        Test::eq [get $s name] "sq"
        Test::eq [get $s doc] "Inner doc."
        Test::eq [get $s line] 4
    }

    Test::case "unattached runs inside a body extend the namespace doc" {
        let src {;;; Outer.
namespace M {
    ;;; Intro prose.

    proc f {} { 0 }
}}
        let e [get [get [Doc::extract $src] entries] 0]
        Test::eq [get $e doc] "Outer.\n\nIntro prose."
    }

    Test::case "nested namespaces nest in the model" {
        let src {namespace outer {
    namespace inner {
        ;;; Deep.
        let y 1
    }
}}
        let outer [get [get [Doc::extract $src] entries] 0]
        let inner [get [get $outer entries] 0]
        Test::eq [get $inner kind] "namespace"
        Test::eq [get $inner name] "inner"
        Test::eq [get [get [get $inner entries] 0] doc] "Deep."
    }

    Test::case "re-entered namespace merges into one entry" {
        let src {;;; First doc.
namespace M {
    proc a {} { 0 }
}
;;; Second doc.
namespace M {
    proc b {} { 0 }
}}
        let m [Doc::extract $src]
        Test::eq [len [get $m entries]] 1
        let e [get [get $m entries] 0]
        Test::eq [get $e doc] "First doc.\n\nSecond doc."
        Test::eq [len [get $e entries]] 2
    }

    Test::case "dynamic heads and names are not definitions" {
        let src {;;; Not attached to anything documentable.
$f x 1
proc $name {} { 0 }}
        Test::eq [len [get [Doc::extract $src] entries]] 0
    }

    Test::case "empty and comment-only sources" {
        Test::eq [len [get [Doc::extract {}] entries]] 0
        Test::eq [get [Doc::extract {;; plain comment}] doc] ""
    }
}

Test::suite "Doc::parse" {
    Test::case "summary, body, and example kinds" {
        let p [Doc::parse "Sums numbers.\nMore prose.\n\nExamples:\n>> + 1 2\n3\n>> puts hi\n>> + 1 ()\n!! expected"]
        Test::eq [get $p summary] "Sums numbers."
        Test::eq [get $p body] "Sums numbers.\nMore prose.\n"
        let ex [get $p examples]
        Test::eq [len $ex] 3
        Test::eq [get [get $ex 0] kind] "value"
        Test::eq [get [get $ex 0] cmd] "+ 1 2"
        Test::eq [get [get $ex 0] expect] "3"
        Test::eq [get [get $ex 1] kind] "none"
        Test::eq [get [get $ex 2] kind] "error"
        Test::eq [get [get $ex 2] expect] "expected"
    }

    Test::case "no Examples section" {
        let p [Doc::parse "Just prose."]
        Test::eq [len [get $p examples]] 0
        Test::eq [get $p body] "Just prose."
    }

    Test::case ">> lines join while the command is incomplete" {
        let d {x

Examples:
>> proc dt_p {a b} {
>>   + $a $b
>> }
>> dt_p 1 2
3}
        let ex [get [Doc::parse $d] examples]
        Test::eq [len $ex] 2
        Test::eq [get [get $ex 0] cmd] "proc dt_p {a b} {\n+ \$a \$b\n}"
        Test::eq [get [get $ex 0] kind] "none"
        Test::eq [get [get $ex 1] cmd] "dt_p 1 2"
        Test::eq [get [get $ex 1] expect] "3"
    }

    Test::case "complete >> lines never join" {
        let ex [get [Doc::parse "x\n\nExamples:\n>> puts hi\n>> puts yo"] examples]
        Test::eq [len $ex] 2
        Test::eq [get [get $ex 0] cmd] "puts hi"
        Test::eq [get [get $ex 1] cmd] "puts yo"
    }

    Test::case "bare >> separators produce no empty examples" {
        let ex [get [Doc::parse "x\n\nExamples:\n>> + 1 2\n3\n>>\n>> + 2 3\n5"] examples]
        Test::eq [len $ex] 2
        Test::eq [get [get $ex 1] cmd] "+ 2 3"
    }
}

Test::suite "Doc::markdown" {
    Test::case "renders title, sections, signatures, examples" {
        let src {;;; Module prose here.

;;; Squares.
;;;
;;; Examples:
;;; >> M::sq 2
;;; 4
namespace M {
    ;;; Squares.
    proc sq {x} { * $x $x }
}}
        let md [Doc::markdown [Doc::extract $src] "mod.lcl"]
        Test::assert [>= [String::find $md "# mod.lcl"] 0]
        Test::assert [>= [String::find $md "Module prose here."] 0]
        Test::assert [>= [String::find $md "## namespace `M`"] 0]
        Test::assert [>= [String::find $md "### proc `M::sq x`"] 0]
        Test::assert [>= [String::find $md "**Examples:**"] 0]
        Test::assert [>= [String::find $md ">> M::sq 2"] 0]
    }

    Test::case "no title heading when title omitted" {
        let md [Doc::markdown [Doc::extract {proc f {} { 0 }}]]
        Test::neq [String::range $md 0 2] "# "
        Test::assert [== [String::find $md "### proc `f`"] 0]
    }
}

Test::suite "Doc::doctest" {
    Test::case "passes values, errors, and bare-run examples" {
        let src {;;; Doubles.
;;;
;;; Examples:
;;; >> dbl_dt 21
;;; 42
;;; >> dbl_dt x
;;; !! number
;;; >> dbl_dt 1
proc dbl_dt {x} { int [+ $x $x] }}
        eval $src
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r pass] 3
        Test::eq [get $r fail] 0
    }

    Test::case "examples in one doc block share a scope" {
        let src {;;; Examples:
;;; >> let dt_four [+ 2 2]
;;; >> + $dt_four 1
;;; 5
proc dt_f {} { 0 }}
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r fail] 0
    }

    Test::case "failures carry qualified name, cmd, expect, got" {
        let src {namespace DTM {
    ;;; Examples:
    ;;; >> + 2 2
    ;;; 5
    proc g {} { 0 }
}}
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r fail] 1
        let f [get [get $r failures] 0]
        Test::eq [get $f name] "DTM::g"
        Test::eq [get $f cmd] "+ 2 2"
        Test::eq [get $f expect] "5"
        Test::eq [get $f got] "4"
    }

    Test::case "string results compare against their repr" {
        let src {;;; Examples:
;;; >> String::upper "hi"
;;; "HI"
proc dt_h {} { 0 }}
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r fail] 0
    }

    Test::case "expected error that does not happen fails" {
        let src {;;; Examples:
;;; >> + 1 1
;;; !! boom
proc dt_i {} { 0 }}
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r fail] 1
    }

    Test::case "module doc examples run too" {
        let src {;;; Module.
;;;
;;; Examples:
;;; >> + 1 1
;;; 2

let dt_unrelated 1}
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r pass] 1
        Test::eq [get $r fail] 0
    }

    Test::case "multi-line example defines and calls a proc" {
        let src {;;; Examples:
;;; >> proc dt_add {a b} {
;;; >>   + $a $b
;;; >> }
;;; >>
;;; >> dt_add 4 5
;;; 9
proc dt_k {} { 0 }}
        let r [Doc::doctest [Doc::extract $src]]
        Test::eq [get $r pass] 2
        Test::eq [get $r fail] 0
    }
}

Test::suite "Doc self-hosting" {
    Test::case "Doc.lcl's own doctests pass" {
        ;; extract_file needs the io package
        var src {}
        if [catch {set! src [io::read_file "lib/doc/src/Doc.lcl"]}] {
            Test::skip "io package not built"
        }
        let r [Doc::doctest [Doc::extract $src]]
        Test::assert [> [get $r pass] 0]
        Test::eq [get $r fail] 0
    }
}


Test::suite "Doc::lookup / Doc::describe" {
    Test::case "register indexes qualified names" {
        let src {;;; Module.

;;; Adds.
proc lk_add {a b} { + $a $b }

namespace LkNs {
    ;;; Inner doc.
    proc inner {x} { $x }

    namespace Deep {
        ;;; Deepest.
        proc d {} { 0 }
    }
}}
        Test::eq [Doc::register $src "lk-src"] 5
        Test::eq [get [Doc::lookup "LkNs::inner"] doc] "Inner doc."
        Test::eq [get [Doc::lookup "LkNs::Deep::d"] qname] "LkNs::Deep::d"
        Test::eq [get [Doc::lookup "LkNs::Deep::d"] file] "lk-src"
        Test::eq [get [Doc::lookup "LkNs"] kind] "namespace"
        Test::eq [get [Doc::lookup lk_add] params] "a b"
        Test::eq [Doc::lookup lk_missing] #{}
    }

    Test::case "unqualified name falls back to a unique bare-name match" {
        Doc::register ";;; Q.\nnamespace LkQ { ;;; Bare.\n proc bare_only {} { 1 } }" "lk-q"
        Test::eq [get [Doc::lookup bare_only] qname] "LkQ::bare_only"
        Test::eq [Doc::lookup "Other::bare_only"] #{}
        Doc::register "namespace LkQ2 { ;;; Twin.\n proc twin {} { 1 } }" "lk-q2"
        Doc::register "namespace LkQ3 { ;;; Twin.\n proc twin {} { 1 } }" "lk-q3"
        Test::eq [Doc::lookup twin] #{}
        Test::eq [get [Doc::lookup "LkQ3::twin"] file] "lk-q3"
    }

    Test::case "eval_at fragments resolve against the registered buffer" {
        let buffer {;;; Buffer top.

;;; Greets.
proc ea_greet {who} { "hi $who" }

;;; Waves.
proc ea_wave {} { 1 }}
        Doc::register $buffer "*scratch*"
        ;; The REPL evaluates line 7 of the buffer as a one-line fragment.
        eval_at {proc ea_wave {} { 1 }} "*scratch*" 7
        Test::eq [get [Doc::lookup $ea_wave] doc] "Waves."
        Test::eq [get [Doc::lookup ea_wave] file] "*scratch*"
    }

    Test::case "a line hit with a different name is stale and ignored" {
        Doc::register ";;; Old.\nproc ea_old {} { 1 }" "lk-stale"
        eval_at {proc ea_new {} { 1 }} "lk-stale" 2
        Test::eq [Doc::lookup $ea_new] #{}
        ;; A documented let binding a lambda still matches (lambda has no name).
        Doc::register ";;; Bound.\nlet ea_bound [lambda {} { 1 }]" "lk-bound"
        eval_at {let ea_bound [lambda {} { 1 }]} "lk-bound" 2
        Test::eq [get [Doc::lookup $ea_bound] doc] "Bound."
    }

    Test::case "describe prints the name it was asked about" {
        namespace lk_user {
            eval_at ";;; G.\nproc greet2 {} { 1 }" "lk-cos"
        }
        Test::eq [String::find [Doc::describe "lk_user::greet2"] "proc lk_user::greet2 {}\n"] 0
        Test::eq [String::find [Doc::describe ${lk_user::greet2}] "proc greet2 {}\n"] 0
    }

    Test::case "run_value runs one symbol's examples" {
        Doc::register ";;; Adds.\n;;;\n;;; Examples:\n;;; >> + 1 2\n;;; 3\n;;; >> + 1 2\n;;; 4\nproc lk_rv {} { 1 }" "lk-rv"
        let r [Doc::run_value lk_rv]
        Test::eq [get $r pass] 1
        Test::eq [get $r fail] 1
        Test::eq [get [get [get $r failures] 0] name] "lk_rv"
        Test::raises { Doc::run_value lk_rv_nothing }
    }

    Test::case "run_ns runs a namespace's examples, reading files on demand" {
        let path "/tmp/lcl-doc-run-ns-test.lcl"
        let src {;;; Examples:
;;; >> LkRun::twice 2
;;; 4
namespace LkRun {
    ;;; Examples:
    ;;; >> LkRun::twice 3
    ;;; 6
    proc twice {x} { * $x 2 }

    namespace Deep {
        ;;; Examples:
        ;;; >> LkRun::Deep::one
        ;;; 2
        proc one {} { 1 }
    }
}}
        io::write_file $path $src
        load $path
        ;; Nothing registered for this file yet: run_ns warms the index
        ;; from the live namespace's origins.
        let r [Doc::run_ns LkRun]
        Test::eq [get $r pass] 2
        Test::eq [get $r fail] 1
        Test::eq [get [get [get $r failures] 0] name] "LkRun::Deep::one"
        Test::eq [get [Doc::run_ns $LkRun] pass] 2
        Test::eq [Doc::run_ns "LkRun::Deep"] #{pass 0 fail 1 failures (#{name "LkRun::Deep::one" cmd "LkRun::Deep::one" expect 2 got 1})}
    }

    Test::case "entries and search walk the index" {
        Doc::register ";;; Finds APPLES.\nproc lk_s1 {} { 1 }\n;;; Pears.\nproc lk_s2 {} { 1 }" "lk-search"
        let all [Doc::entries]
        Test::eq [> [len $all] 2] 1
        Test::eq [List::map [Doc::search "apples"] [lambda {e} { get $e qname }]] ("lk_s1")
        Test::eq [List::map [Doc::search "LK_S"] [lambda {e} { get $e qname }]] ("lk_s1" "lk_s2")
        Test::eq [Doc::search "zzz-nothing"] ()
    }

    Test::case "re-registering a source replaces its entries" {
        Doc::register ";;; First.\nproc lk_re {} { 1 }" "lk-re"
        Doc::register ";;; Second.\nproc lk_re {} { 1 }" "lk-re"
        Test::eq [get [Doc::lookup lk_re] doc] "Second."
    }

    Test::case "a live proc is matched by origin file and line" {
        let path "/tmp/lcl-doc-lookup-test.lcl"
        let src {;;; Top doc.
proc lk_top {a} { $a }

namespace LkLive {
    ;;; Live inner.
    ;;;
    ;;; Examples:
    ;;; >> LkLive::inner 2
    ;;; 2
    proc inner {x} { $x }
}}
        io::write_file $path $src
        load $path
        let e [Doc::lookup ${LkLive::inner}]
        Test::eq [get $e qname] "LkLive::inner"
        Test::eq [get $e line] 10
        Test::eq [get $e file] $path
        Test::eq [get [Doc::lookup $lk_top] doc] "Top doc."
        Test::eq [get [Doc::lookup ${LkLive::inner}] qname] "LkLive::inner"
    }

    Test::case "describe renders signature, origin, and doc" {
        Doc::register ";;; Adds.\n;;;\n;;; Slowly.\nproc lk_desc {a b} { + \$a \$b }" "lk-desc"
        Test::eq [Doc::describe lk_desc] "proc lk_desc {a b}\n  lk-desc:4\n\nAdds.\n\nSlowly."
        Doc::register "namespace LkD { ;;; Note.\n proc n {} { 1 } }" "lk-d"
        Test::eq [Doc::describe "LkD::n"] "proc LkD::n {}\n  lk-d:2\n\nNote."
        Test::eq [Doc::describe "LkD"] "namespace LkD\n  lk-d:1\n\n(undocumented)"
    }

    Test::case "describe of an undocumented live proc uses Proc::params" {
        proc lk_plain {x (y 1) *rest} { $x }
        let s [Doc::describe $lk_plain]
        Test::eq [String::find $s "proc lk_plain {x ?y *rest}\n  "] 0
        Test::eq [> [String::find $s "\n\n(undocumented)"] 0] 1
        Test::eq [Doc::describe +] "proc + {}\n\n(undocumented)"
        Test::eq [String::find [Doc::describe [lambda {} { 1 }]] "proc lambda {}\n  <eval at "] 0
    }

    Test::case "describe errors for an unknown name" {
        let rc [catch {Doc::describe lk_unknown} r e]
        Test::eq $rc 1
        Test::eq [String::find $e {nothing known about "lk_unknown"}] 15
    }
}

Test::run
