;; lib/Macro.lcl - Macro utilities for LCL
;;
;; Provides utilities for writing hygienic macros in LCL.
;;
;; Usage:
;;   load lib/Macro.lcl

;; ============================================================================
;; gensym - Generate Unique Symbols
;; ============================================================================
;;
;; Creates unique symbol names for use in macros to avoid variable capture.
;; Each call returns a new unique name like _G1, _G2, etc.
;;
;; The counter is encapsulated in a closure, so it's completely private.
;;
;; Usage:
;;   [gensym]        ;; => _G1, _G2, _G3, ...
;;
;; Example in a macro:
;;   proc my-macro {body} {
;;       let tmp [gensym]
;;       quasiquote {
;;           let ,$tmp [expensive-computation]
;;           ;; use ,$tmp multiple times without re-computing
;;           ,$body
;;       }
;;   }

let gensym [[lambda {} {
    var counter 0
    lambda {} {
        set! counter [+ $counter 1]
        "_G$counter"
    }
}]]

;; ============================================================================
;; gensym-with-prefix - Generate Unique Symbols with Custom Prefix
;; ============================================================================
;;
;; Like gensym, but allows a custom prefix for more readable generated code.
;; Shares the same counter as gensym to ensure uniqueness.
;;
;; Usage:
;;   [gensym-prefix tmp]   ;; => tmp1, tmp2, ...
;;   [gensym-prefix loop]  ;; => loop3, loop4, ...

let gensym-prefix [[lambda {} {
    var counter 0
    lambda {prefix} {
        set! counter [+ $counter 1]
        "$prefix$counter"
    }
}]]
