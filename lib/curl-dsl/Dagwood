;; cURL DSL library
;;
;; A library providing nicer DSL for interacting with CURL
;;
;; REQUIRES: lcl-curl package (provides curl:: namespace)
             lcl-json package (provides json:: namespace)

project CurlDSL {
    def SOURCE src/curl-dsl.lcl
    def BUILD  build/curl-dsl-lib-data.h

    task pre_reqs {
        outputs build/
        run {
          mkdir -p build/    
        }
    }

    task build {
        inputs  ${CurlDSL::SOURCE}
        outputs ${CurlDSL::BUILD}
        depends_on CurlDSL:pre_reqs
        run {
            xxd -i ${CurlDSL::SOURCE} >> ${CurlDSL::BUILD}
        }
    }
}
