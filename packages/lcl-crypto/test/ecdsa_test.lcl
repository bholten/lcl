;; Test ECDSA signing

;; EC P-256 test key
let ec_key {-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIET4joyIKlAHzkDXcxINb1X2cG0VQLvXBn+w7VOTtCiOoAoGCCqGSM49
AwEHoUQDQgAEARnCR7Af/nXPFHsyfrLgS8FtjrYTLIcGp3diMwelG37z0DFXpyuD
BJb7kzjgwMkuSw+00zlw027XYYfnarbz7Q==
-----END EC PRIVATE KEY-----}

puts "Testing Crypto::sign_ecdsa..."
let message "Hello, HTTP Signatures!"
let sig [Crypto::sign_ecdsa $ec_key $message p256]
puts "ECDSA P-256 signature (hex): $sig"
puts "Signature length: [String::length $sig] hex chars"

puts ""
puts "ECDSA signing test passed!"
