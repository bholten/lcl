import raylib

let RAYWHITE [color 245 245 245 255]
let BLACK    [color 0 0 0 255]

init_window 640 480 "Hello, Raylib!"

set_target_fps 60

var time 0.0

macro wave {fn ampl offset} {
    quasiquote {
        set! time [+ $time [get_frame_time]]
    
        -> $time {* 2.0} ,$fn {* ,$ampl} {+ ,$offset} {int}
    }
}

proc y_wave {} {
    wave {math::sin} 50 240
}

proc x_wave {} {
    wave {math::cos} 50 240
}

while {not [window_should_close]} {
    begin_drawing

    clear_background $BLACK
    draw_fps 30 30

    let x_pos [x_wave]
    let y_pos [y_wave]
    
    draw_text "First Text!" $x_pos $y_pos 20 [color 125 43 231 255]
    
    end_drawing
}

close_window
