;; expect_test.lcl - Tests for the lcl-expect package

Test::suite "expect library" {
    Test::case "Pattern creation" {
        let pat1 [Expect::pattern "hello"]
        let pat2 [Expect::regex {[a-z]+}]
        let pat3 [Expect::timeout]
        let pat4 [Expect::eof]

        assert_eq literal [Expect::pattern-kind $pat1]
        assert_eq regex [Expect::pattern-kind $pat2]
        assert_eq timeout [Expect::pattern-kind $pat3]
        assert_eq eof [Expect::pattern-kind $pat4]
    }

    Test::case "Pattern matching on buffer" {
        let buf "user@host:~$ ls -la"
        let patterns [list "password:" "$ " "# "]
        let r [Expect::match-buffer $buf $patterns]

        assert_eq 1 [get $r matched]
        assert_eq 1 [get $r index]
        assert_eq user@host:~ [get $r before]
        assert_eq {$ } [get $r match]
        assert_eq "ls -la" [get $r after]
    }

    Test::case "PTY spawning + Send and receive" {
        let s [Expect::spawn (cat)]

        assert_eq 1 [Expect::pty? $s]

        Expect::send-line $s "hello world"

        let r [Expect::wait-for $s "hello"]

        assert_eq 1 [get $r matched]
        assert_eq "hello world" [String::trim [get $r data]]

        Expect::send-line $s "password: secret"

        let result [Expect::match [get $s handle] (
            ("password:" [lambda {m} {
                let d [get $m data]
                String::trim $d
            }])
            ("$ " [lambda {m} { "got prompt" }])
        ) #{timeout 2000}]
        
        assert_eq "password: secret" $result

        Expect::close $s        
    }

    Test::case "Pipe mode spawn" {
        let s2 [Expect::spawn (echo done) #{pty 0}]
        assert_eq 0 [Expect::pty? $s2]
        
        let r [Expect::wait-for $s2 "done"]
        assert_eq 1 [get $r matched]

        Expect::close $s2
    }
}


exit [Test::run]
