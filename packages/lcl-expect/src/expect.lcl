;;; expect.lcl - Lcl layer of lcl-expect
;;;
;;; The session, buffer and matching live in C (lcl-expect.c). This
;;; file adds the lifecycle and terminal pass-throughs that are nothing
;;; more than "the same Process:: call on the session's handle". It is
;;; embedded into the CLI when the package is enabled.

namespace Expect {
    ;;; Expect::alive? session - 1 while the child process is running
    proc alive? {session} {
        Process::alive? [Expect::handle $session]
    }

    ;;; Expect::wait session ?opts? - wait for the child to exit
    proc wait {session (opts #{})} {
        Process::wait [Expect::handle $session] $opts
    }

    ;;; Expect::kill session ?opts? - send the child a signal
    proc kill {session (opts #{})} {
        Process::kill [Expect::handle $session] $opts
    }

    ;;; Expect::close-stdin session - signal end-of-file on the child's input
    proc close-stdin {session} {
        Process::close-stdin [Expect::handle $session]
    }

    ;;; Expect::pty? session - 1 if the session runs on a pseudo-terminal
    proc pty? {session} {
        Process::pty? [Expect::handle $session]
    }

    ;;; Expect::set-winsize session rows cols - resize the pseudo-terminal
    proc set-winsize {session rows cols} {
        Process::set-winsize [Expect::handle $session] $rows $cols
    }

    ;;; Expect::get-winsize session - #{rows N cols M} of the pseudo-terminal
    proc get-winsize {session} {
        Process::get-winsize [Expect::handle $session]
    }
}
