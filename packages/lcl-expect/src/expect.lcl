;; expect.lcl - Lcl convenience layer for expect automation
;;
;; Provides higher-level conveniences built on the C Expect:: primitives.
;; This file is meant to be embedded and loaded automatically when
;; lcl-expect is enabled.
;;
;; REQUIRES: lcl-process, lcl-expect (C package)

namespace Expect {
    ;; Default timeout in milliseconds (10 seconds)
    var _default_timeout 10000

    ;; ========================================================================
    ;; Configuration
    ;; ========================================================================

    ;; Expect::set-timeout ms - set default timeout in milliseconds
    proc set-timeout {ms} {
        set! Expect::_default_timeout $ms
    }

    ;; Expect::get-timeout - get default timeout
    proc get-timeout {} {
        ${Expect::_default_timeout}
    }

    ;; ========================================================================
    ;; Spawning
    ;; ========================================================================

    ;; Expect::spawn cmd ?opts? - spawn a process with PTY by default
    ;;
    ;; Options:
    ;;   pty     - use PTY mode (default: 1)
    ;;   timeout - default timeout for this session
    ;;   rows    - PTY rows (default: 24)
    ;;   cols    - PTY cols (default: 80)
    ;;   env     - environment variables dict
    ;;   cwd     - working directory
    ;;
    ;; Returns: session dict #{handle <h> timeout <t>}
    proc spawn {cmd (opts #{})} {
        let pty_mode [get $opts pty 1]
        let timeout [get $opts timeout ${Expect::_default_timeout}]
        let rows [get $opts rows 24]
        let cols [get $opts cols 80]
        let env [get $opts env #{}]
        let cwd [get $opts cwd ""]

        let spawn_opts #{pty $pty_mode rows $rows cols $cols}
        if [not [empty? $env]] {
            let spawn_opts [put $spawn_opts env $env]
        }
        if [not [empty? $cwd]] {
            let spawn_opts [put $spawn_opts cwd $cwd]
        }

        let h [Process::spawn $cmd $spawn_opts]
        dict handle $h timeout $timeout
    }

    ;; ========================================================================
    ;; Sending
    ;; ========================================================================

    ;; Expect::send session str - send string to process
    proc send {session str} {
        Process::send [get $session handle] $str
    }

    ;; Expect::send-line session str - send string with newline
    proc send-line {session str} {
        Expect::send $session "$str\n"
    }

    ;; Expect::send-ctrl session char - send control character
    ;; char: a-z for Ctrl-A through Ctrl-Z
    proc send-ctrl {session char} {
        ;; Control characters are ASCII 1-26
        let code [- [String::ord $char] 96]
        if [or [< $code 1] [> $code 26]] {
            error "invalid control character"
        }
        Expect::send $session [String::chr $code]
    }

    ;; ========================================================================
    ;; Simple Waiting (non-handler based)
    ;; ========================================================================

    ;; Expect::wait-for session pattern ?opts? - wait for a single pattern
    ;;
    ;; Options:
    ;;   timeout - timeout in ms
    ;;
    ;; Returns: match result dict or empty on timeout
    proc wait-for {session pattern (opts #{})} {
        let timeout [get $opts timeout [get $session timeout]]
        let patterns [list $pattern]
        let r [Expect::read-match [get $session handle] $patterns #{timeout $timeout}]
        $r
    }

    ;; Expect::expect session patterns ?opts? - wait for any of multiple patterns
    ;;
    ;; patterns: string or list of strings/patterns
    ;; Returns: match result dict
    proc expect {session patterns (opts #{})} {
        let timeout [get $opts timeout [get $session timeout]]

        ;; Normalize to list
        let pattern_list $patterns
        if [string? $patterns] {
            let pattern_list [list $patterns]
        }

        let r [Expect::read-match [get $session handle] $pattern_list #{timeout $timeout}]
        $r
    }

    ;; ========================================================================
    ;; Handler-based Matching
    ;; ========================================================================

    ;; Expect::interact session pairs ?opts? - match patterns and call handlers
    ;;
    ;; pairs: list of (pattern handler) pairs
    ;; Returns: result of matched handler
    ;;
    ;; Example:
    ;;   Expect::interact $s (
    ;;       ("password:" [lambda {m} { Expect::send-line $s "secret"; continue }])
    ;;       ("$ " [lambda {m} { get $m data }])
    ;;   )
    proc interact {session pairs (opts #{})} {
        let timeout [get $opts timeout [get $session timeout]]
        Expect::match [get $session handle] $pairs #{timeout $timeout}
    }

    ;; Expect::interact-loop session pairs ?opts? - loop with pattern matching
    ;;
    ;; Like interact but loops until break or normal return.
    proc interact-loop {session pairs (opts #{})} {
        let timeout [get $opts timeout [get $session timeout]]
        Expect::loop [get $session handle] $pairs #{timeout $timeout}
    }

    ;; ========================================================================
    ;; Lifecycle
    ;; ========================================================================

    ;; Expect::alive? session - check if process is running
    proc alive? {session} {
        Process::alive? [get $session handle]
    }

    ;; Expect::wait session ?opts? - wait for process to exit
    proc wait {session (opts #{})} {
        Process::wait [get $session handle] $opts
    }

    ;; Expect::kill session ?opts? - send signal to process
    proc kill {session (opts #{})} {
        Process::kill [get $session handle] $opts
    }

    ;; Expect::close session - close the session
    proc close {session} {
        Process::close [get $session handle]
    }

    ;; Expect::close-stdin session - close stdin to signal EOF
    proc close-stdin {session} {
        Process::close-stdin [get $session handle]
    }

    ;; ========================================================================
    ;; PTY Operations
    ;; ========================================================================

    ;; Expect::pty? session - check if using PTY mode
    proc pty? {session} {
        Process::pty? [get $session handle]
    }

    ;; Expect::set-winsize session rows cols - set terminal size
    proc set-winsize {session rows cols} {
        Process::set-winsize [get $session handle] $rows $cols
    }

    ;; Expect::get-winsize session - get terminal size
    proc get-winsize {session} {
        Process::get-winsize [get $session handle]
    }

    ;; ========================================================================
    ;; Reading
    ;; ========================================================================

    ;; Expect::read session ?opts? - read available output
    proc read {session (opts #{})} {
        Process::read [get $session handle] $opts
    }

    ;; Expect::drain session ?opts? - read all available output
    proc drain {session (opts #{})} {
        var output ""
        while 1 {
            let chunk [Process::read [get $session handle] #{timeout 100}]
            if [empty? $chunk] {
                break
            }
            set! output "$output$chunk"
        }
        $output
    }

    ;; ========================================================================
    ;; Pattern Helpers
    ;; ========================================================================

    namespace Pat {
        ;; Expect::Pat::literal str ?opts? - create literal pattern
        proc literal {s (opts #{})} {
            Expect::pattern $s $opts
        }

        ;; Expect::Pat::regex str ?opts? - create regex pattern
        proc regex {r (opts #{})} {
            Expect::regex $r $opts
        }

        ;; Expect::Pat::timeout - create timeout sentinel
        proc timeout {} {
            Expect::timeout
        }

        ;; Expect::Pat::eof - create EOF sentinel
        proc eof {} {
            Expect::eof
        }

        ;; Expect::Pat::prompt ?opts? - common shell prompt patterns
        proc prompt {(opts #{})} {
            let type [get $opts type "any"]
            case $type \
                {bash}  [Expect::regex {[$#] $}] \
                {zsh}   [Expect::regex {[%#] $}] \
                {sh}    [Expect::regex {[$#] $}] \
                else    [Expect::regex {[$#%>] $}]
        }
    }

    ;; ========================================================================
    ;; Convenience: Combined Operations
    ;; ========================================================================

    ;; Expect::send-expect session str pattern ?opts? - send then wait
    proc send-expect {session str pattern (opts #{})} {
        Expect::send $session $str
        Expect::expect $session $pattern $opts
    }

    ;; Expect::send-line-expect session str pattern ?opts? - send line then wait
    proc send-line-expect {session str pattern (opts #{})} {
        Expect::send-line $session $str
        Expect::expect $session $pattern $opts
    }

    ;; ========================================================================
    ;; Script Runner
    ;; ========================================================================

    ;; Expect::run session script - run expect script (list of actions)
    ;;
    ;; Each action is a list: [type args...]
    ;; Types:
    ;;   [send "text"]
    ;;   [send-line "text"]
    ;;   [expect "pattern"]
    ;;   [expect "pattern" timeout_ms]
    ;;   [sleep ms]
    ;;
    ;; Returns: list of expect results
    proc run {session script} {
        var results ()

        foreach action $script {
            let cmd [String::trim [get $action 0]]

            case $cmd \
                {send}      [Expect::send $session [get $action 1]] \
                {send-line} [Expect::send-line $session [get $action 1]] \
                {expect}    {
                    let pattern [get $action 1]
                    let timeout [get $action 2 [get $session timeout]]
                    let r [Expect::expect $session $pattern #{timeout $timeout}]
                    set! results [List::push $results $r]
                } \
                {sleep}     {
                    ;; Simple sleep using Process::run with sleep command
                    let ms [get $action 1]
                    let secs [/ $ms 1000.0]
                    Process::run (sleep $secs)
                } \
                else        {}
        }

        $results
    }

    ;; Expect::script cmd actions - spawn, run script, close
    ;;
    ;; Returns: list of expect results
    proc script {cmd actions (opts #{})} {
        let session [Expect::spawn $cmd $opts]
        let results [Expect::run $session $actions]
        Expect::close $session
        $results
    }
}
