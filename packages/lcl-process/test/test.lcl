;; Tests for the Process:: namespace

Test::suite "Process::run" {
    Test::case "basic echo" {
        let r [Process::run (echo hello)]
        Test::eq [get $r status] 0
        Test::eq [get $r stdout] "hello\n"
    }

    Test::case "exit status non-zero" {
        let r [Process::run (sh -c "exit 42")]
        Test::eq [get $r status] 42
    }

    Test::case "stderr capture" {
        let r [Process::run (sh -c "echo err >&2")]
        Test::eq [get $r status] 0
        Test::eq [get $r stderr] "err\n"
    }

    Test::case "stdin input" {
        let r [Process::run (cat) #{stdin "hello world"}]
        Test::eq [get $r stdout] "hello world"
    }

    Test::case "merge stderr into stdout" {
        let r [Process::run (sh -c "echo out; echo err >&2") #{merge 1}]
        Test::eq [get $r status] 0
        ;; Both should be in stdout (String::find returns -1 if not found)
        Test::assert [!= [String::find [get $r stdout] "out"] -1]
        Test::assert [!= [String::find [get $r stdout] "err"] -1]
    }

    Test::case "shell option" {
        let r [Process::run (echo hello | cat) #{shell 1}]
        Test::eq [get $r stdout] "hello\n"
    }

    Test::case "environment variables" {
        ;; Use braces to prevent LCL from substituting $MY_VAR
        let r [Process::run (sh -c {echo $MY_VAR}) #{env #{MY_VAR testvalue}}]
        Test::eq [get $r stdout] "testvalue\n"
    }

    Test::case "working directory" {
        ;; `/`, not `/tmp`: on macOS /tmp is a symlink to /private/tmp,
        ;; so pwd would report the resolved path
        let r [Process::run (pwd) #{cwd /}]
        Test::eq [get $r stdout] "/\n"
    }
}

Test::suite "Process::read-until" {
    Test::case "single pattern match" {
        let h [Process::spawn (sh -c {echo "hello world"; echo "done"})]
        let r [Process::read-until $h "world"]
        Test::eq [get $r matched] 1
        Test::eq [get $r pattern] "world"
        Test::eq [get $r data] "hello world"
        Process::close $h
    }

    Test::case "multiple patterns - first match" {
        let h [Process::spawn (sh -c {echo "foo bar baz"})]
        let r [Process::read-until $h (bar baz)]
        Test::eq [get $r matched] 1
        Test::eq [get $r pattern] "bar"
        Test::eq [get $r index] 0
        Process::close $h
    }

    Test::case "multiple patterns - second match" {
        let h [Process::spawn (sh -c {echo "foo qux baz"})]
        let r [Process::read-until $h (bar qux)]
        Test::eq [get $r matched] 1
        Test::eq [get $r pattern] "qux"
        Test::eq [get $r index] 1
        Process::close $h
    }

    Test::case "timeout with no match" {
        let h [Process::spawn (sleep 10)]
        let r [Process::read-until $h "never" #{timeout 100}]
        Test::eq [get $r matched] 0
        Process::kill $h
        Process::close $h
    }

    Test::case "newline in pattern" {
        let h [Process::spawn (sh -c {echo "line1"; echo "line2"})]
        let r [Process::read-until $h "line2"]
        Test::eq [get $r matched] 1
        Test::assert [!= [String::find [get $r data] "line1"] -1]
        Process::close $h
    }
}

Test::suite "Process::eof?" {
    Test::case "pipe: end-of-file after the writer exits" {
        let h [Process::spawn (echo done)]
        Process::wait $h
        Test::eq [Process::eof? $h] 0
        Test::eq [Process::read $h] "done\n"
        Test::eq [Process::read $h] ""
        Test::eq [Process::eof? $h] 1
        Test::eq [Process::eof? $h #{stderr 1}] 0
        Process::close $h
        Test::eq [Process::eof? $h #{stderr 1}] 1
    }

    Test::case "pty: hang-up is end-of-file, output before it survives" {
        let h [Process::spawn (sh -c "echo hi; exit 3") #{pty 1}]
        Process::wait $h #{timeout 5000}
        Test::eq [Process::read $h #{timeout 1000}] "hi\r\n"
        Test::eq [Process::read $h #{timeout 1000}] ""
        Test::eq [Process::eof? $h] 1
        Process::close $h
    }

    Test::case "send to an exited pipe child is an error, not SIGPIPE" {
        let h [Process::spawn (true)]
        Process::wait $h
        Test::raises_with { Process::send $h "data" } "child has closed its input"
        Process::close $h
        Test::raises_with { Process::send $h "data" } "stdin is closed"
    }
}

Test::suite "Process::spawn" {
    Test::case "spawn and wait" {
        let h [Process::spawn (echo spawned)]
        let w [Process::wait $h]
        Test::eq [get $w exited] 1
        Test::eq [get $w status] 0
        Process::close $h
    }

    Test::case "spawn and read" {
        let h [Process::spawn (echo "line1")]
        ;; Give it a moment to produce output
        let w [Process::wait $h]
        let output [Process::read $h]
        Test::eq $output "line1\n"
        Process::close $h
    }

    Test::case "spawn, send, read" {
        let h [Process::spawn (cat)]
        Process::send $h "hello from lcl"
        Process::close-stdin $h
        let w [Process::wait $h]
        let output [Process::read $h]
        Test::eq $output "hello from lcl"
        Process::close $h
    }

    ;; The two pty cases are split so a platform failure says which
    ;; half is broken: the pty round trip itself, or EOF delivery.
    Test::case "pty: sent input is echoed and readable" {
        let h [Process::spawn (cat) #{pty 1}]
        Test::eq [Process::pty? $h] 1
        Process::send $h "pty hello\n"

        let r [Process::read-until $h "pty hello" #{timeout 5000}]

        Test::eq [get $r matched] 1

        Process::kill $h
        Process::wait $h #{timeout 5000}
        Process::close $h
    }

    Test::case "close-stdin on a pty sends EOF and keeps the handle usable" {
        let h [Process::spawn (cat) #{pty 1}]
        Process::send $h "pty hello\n"

        let r [Process::read-until $h "pty hello" #{timeout 5000}]
        Test::eq [get $r matched] 1
        Process::close-stdin $h

        let w [Process::wait $h #{timeout 5000}]
        Test::eq [get $w exited] 1

        Test::eq [type [Process::read $h]] "string"
        Process::close $h
    }

    Test::case "alive? check" {
        let h [Process::spawn (sleep 10)]
        Test::eq [Process::alive? $h] 1
        Process::kill $h
        ;; Give it a moment to die
        Process::wait $h #{timeout 1000}
        Test::eq [Process::alive? $h] 0
        Process::close $h
    }

    Test::case "kill with signal" {
        let h [Process::spawn (sleep 10)]
        Process::kill $h #{signal KILL}
        let w [Process::wait $h #{timeout 1000}]
        Test::eq [get $w exited] 1
        Process::close $h
    }
}

;; spawn returns only once the child has finished its pre-exec setup
;; and reached exec, or exited. The handshake pipe's write end is
;; close-on-exec; if it ever leaked into the child, every spawn of a
;; long-lived program (the `cat` cases above) would hang, so those
;; cases double as the leak check. The interrupt-delivery half of the
;; guarantee is tested in lcl-expect, which can send control
;; characters.
Test::suite "Process::spawn handshake" {
    Test::case "a pre-exec failure (bad cwd) neither hangs nor leaks, pipes" {
        let h [Process::spawn (cat) #{cwd /nonexistent/lcl-spawn-test}]
        let w [Process::wait $h #{timeout 3000}]
        Test::eq [get $w exited] 1
        Test::eq [get $w status] 127
        Process::close $h
    }

    Test::case "a pre-exec failure (bad cwd) neither hangs nor leaks, pty" {
        let h [Process::spawn (cat) #{cwd /nonexistent/lcl-spawn-test pty 1}]
        let w [Process::wait $h #{timeout 3000}]
        Test::eq [get $w exited] 1
        Test::eq [get $w status] 127
        Process::close $h
    }

    Test::case "a program that cannot be executed still exits 127 on a pty" {
        let h [Process::spawn (lcl-no-such-program-xyz) #{pty 1}]
        let w [Process::wait $h #{timeout 3000}]
        Test::eq [get $w exited] 1
        Test::eq [get $w status] 127
        Process::close $h
    }

    Test::case "a pty child is ready to use the moment spawn returns" {
        repeat 10 {
            let h [Process::spawn (cat) #{pty 1}]
            Process::send $h "now\n"
            let r [Process::read-until $h "now" #{timeout 3000}]
            Test::eq [get $r matched] 1
            Process::close $h
        }
    }
}

exit [Test::run]
