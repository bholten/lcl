;; Testing lcl-json
;; Requires:
;; -DBUILD_JSON
;; -DBUILD_TESTS

Test::suite "Load JSON" {
    Test::case "null values" {
        let j {{"value": null}}
        let decoded [Json::decode $j]
        let v [get $decoded value]
        Test::eq [Json::null? $v] 1
    }

    Test::case "boolean predicates" {
        let j {{"t": true, "f": false}}
        let decoded [Json::decode $j]
        Test::eq [Json::bool? [get $decoded t]] 1
        Test::eq [Json::bool? [get $decoded f]] 1
        Test::eq [Json::null? [get $decoded t]] 0
    }

    Test::case "empty structures" {
        Test::eq [Json::encode [Json::decode {{}}]] {{}}
        Test::eq [Json::encode [Json::decode {[]}]] {[]}
    }

    Test::case "direct bool/null creation" {
        let d [dict flag [Json::true] empty [Json::null]]
        let encoded [Json::encode $d]
        let decoded [Json::decode $encoded]
        Test::eq [Json::bool? [get $decoded flag]] 1
        Test::eq [Json::null? [get $decoded empty]] 1
    }

    Test::case "roundtrip JSON decode -> encode -> decode -> encode" {
        let j {
            {
                "user": "Brennan",
                "dogs": [ "Ted", "Yag" ],
                "nested": {
                    "name": "Foo",
                    "b": false,
                    "bar": {
                        "number": 1,
                        "float": 2.4,
                        "nested_again": {
                            "name2": "ABCD",
                            "list_of_nums": [1, 2.4, 1.04, "test"]
                        }
                    },
                    "d": true
                }
            }
        }

        let decoded1 [Json::decode $j]
        let encoded1 [Json::encode $decoded1]
        let decoded2 [Json::decode $encoded1]
        let encoded2 [Json::encode $decoded2]
        Test::eq $encoded1 $encoded2
    }
}

exit [Test::run]
