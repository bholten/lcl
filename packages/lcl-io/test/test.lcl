# io:: Package Tests
# Run with an LCL interpreter that has the io extension loaded
# From project root: ./lcl-io-test packages/lcl-io/test/test.lcl
#
# Test framework (Test::suite, Test::case, etc.) is embedded when built
# with LCL_EMBED_TEST_FRAMEWORK=ON (the default).

# ============================================================================
# Standard Streams
# ============================================================================

Test::suite "Standard Streams" {
    Test::case "io::stdout returns handle" {
        let stdout [io::stdout]
        Test::not_empty $stdout
    }

    Test::case "io::stderr returns handle" {
        let stderr [io::stderr]
        Test::not_empty $stderr
    }

    Test::case "io::fputs writes to stdout" {
        # Just verify it doesn't error - output goes to stdout
        io::fputs [io::stdout] "test output\n"
        Test::assert 1
    }
}

# ============================================================================
# Environment
# ============================================================================

Test::suite "Environment (io::getenv)" {
    Test::case "getenv returns PATH" {
        let path [io::getenv PATH]
        Test::gt [String::length $path] 0
    }

    Test::case "getenv returns empty for non-existent var" {
        let missing [io::getenv LCL_NONEXISTENT_VAR_12345]
        Test::empty $missing
    }
}

# ============================================================================
# Working Directory
# ============================================================================

Test::suite "Working Directory" {
    Test::case "getcwd returns non-empty" {
        let cwd [io::getcwd]
        Test::gt [String::length $cwd] 0
    }

    Test::case "chdir and getcwd round-trip" {
        let original [io::getcwd]
        io::chdir /tmp
        Test::eq [io::getcwd] /tmp
        io::chdir $original
        Test::eq [io::getcwd] $original
    }
}

# ============================================================================
# Directory Operations
# ============================================================================

Test::suite "Directory Operations" {
    Test::before {
        # Clean up from any previous failed runs
        let test_dir "/tmp/lcl_io_test_dir"
        if [io::exists? $test_dir] {
            io::rmdir $test_dir
        }
    }

    Test::case "mkdir creates directory" {
        let test_dir "/tmp/lcl_io_test_dir"
        io::mkdir $test_dir
        Test::true [io::exists? $test_dir]
        Test::true [io::dir? $test_dir]
        io::rmdir $test_dir
    }

    Test::case "rmdir removes directory" {
        let test_dir "/tmp/lcl_io_test_dir"
        io::mkdir $test_dir
        io::rmdir $test_dir
        Test::false [io::exists? $test_dir]
    }
}

# ============================================================================
# File Operations
# ============================================================================

Test::suite "File Operations" {
    Test::case "write_file and read_file" {
        let test_file "/tmp/lcl_io_test.txt"
        let content "Hello, LCL IO!"
        io::write_file $test_file $content
        Test::true [io::exists? $test_file]
        Test::true [io::file? $test_file]
        Test::eq [io::read_file $test_file] $content
        io::remove $test_file
    }

    Test::case "file_size matches content length" {
        let test_file "/tmp/lcl_io_size_test.txt"
        let content "Test content here"
        io::write_file $test_file $content
        Test::eq [io::file_size $test_file] [String::length $content]
        io::remove $test_file
    }

    Test::case "file_mtime returns positive timestamp" {
        let test_file "/tmp/lcl_io_mtime_test.txt"
        io::write_file $test_file "test"
        Test::gt [io::file_mtime $test_file] 0
        io::remove $test_file
    }

    Test::case "copy creates destination file" {
        let src "/tmp/lcl_io_copy_src.txt"
        let dst "/tmp/lcl_io_copy_dst.txt"
        let content "copy test"
        io::write_file $src $content
        io::copy $src $dst
        Test::true [io::exists? $dst]
        Test::eq [io::read_file $dst] $content
        io::remove $src
        io::remove $dst
    }

    Test::case "rename moves file" {
        let src "/tmp/lcl_io_rename_src.txt"
        let dst "/tmp/lcl_io_rename_dst.txt"
        let content "rename test"
        io::write_file $src $content
        io::rename $src $dst
        Test::false [io::exists? $src]
        Test::true [io::exists? $dst]
        Test::eq [io::read_file $dst] $content
        io::remove $dst
    }

    Test::case "remove deletes file" {
        let test_file "/tmp/lcl_io_remove_test.txt"
        io::write_file $test_file "delete me"
        io::remove $test_file
        Test::false [io::exists? $test_file]
    }
}

# ============================================================================
# Directory Listing
# ============================================================================

Test::suite "Directory Listing (io::readdir)" {
    Test::case "readdir returns file list" {
        let test_dir "/tmp/lcl_io_readdir_test"
        io::mkdir $test_dir
        io::write_file "$test_dir/file1.txt" "one"
        io::write_file "$test_dir/file2.txt" "two"
        io::write_file "$test_dir/file3.txt" "three"

        let files [io::readdir $test_dir]
        Test::eq [len $files] 3

        # Clean up
        io::remove "$test_dir/file1.txt"
        io::remove "$test_dir/file2.txt"
        io::remove "$test_dir/file3.txt"
        io::rmdir $test_dir
    }
}

# ============================================================================
# File/Directory Predicates
# ============================================================================

Test::suite "File Predicates" {
    Test::case "non-existent path" {
        Test::false [io::exists? "/tmp/nonexistent_lcl_test_xyz"]
        Test::false [io::file? "/tmp/nonexistent_lcl_test_xyz"]
        Test::false [io::dir? "/tmp/nonexistent_lcl_test_xyz"]
    }

    Test::case "/tmp is a directory" {
        Test::true [io::exists? /tmp]
        Test::true [io::dir? /tmp]
        Test::false [io::file? /tmp]
    }
}

# ============================================================================
# Glob
# ============================================================================

Test::suite "Glob (io::glob)" {
    Test::case "glob finds matching files" {
        io::write_file "/tmp/lcl_glob_test1.txt" "1"
        io::write_file "/tmp/lcl_glob_test2.txt" "2"

        let files [io::glob "/tmp/lcl_glob_test*.txt"]
        Test::gte [len $files] 2

        io::remove "/tmp/lcl_glob_test1.txt"
        io::remove "/tmp/lcl_glob_test2.txt"
    }
}

# ============================================================================
# File Handle Operations
# ============================================================================

Test::suite "File Handle Operations" {
    Test::case "open, write, read lines" {
        let test_file "/tmp/lcl_fh_test.txt"

        # Write with file handle
        let fh [io::open_file $test_file w]
        io::fputs $fh "line one\n"
        io::fputs $fh "line two\n"
        io::close_file $fh

        # Read with file handle
        let fh_read [io::open_file $test_file r]
        let line1 [io::fgets $fh_read 1024]
        let line2 [io::fgets $fh_read 1024]
        io::close_file $fh_read

        Test::eq [String::trim $line1] {line one}
        Test::eq [String::trim $line2] {line two}

        io::remove $test_file
    }

    Test::case "flush works without error" {
        let test_file "/tmp/lcl_flush_test.txt"
        let fh [io::open_file $test_file w]
        io::fputs $fh "test data"
        io::flush $fh
        io::close_file $fh
        Test::true [io::exists? $test_file]
        io::remove $test_file
    }
}

# ============================================================================
# Run Tests
# ============================================================================

Test::run
