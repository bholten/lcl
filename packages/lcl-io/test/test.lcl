puts "testing io"

# open a file
let h [io::open_file packages/lcl-io/include/lcl-io.h rt]

var end 1

while {$end} {
    let line [io::fgets $h 1024]
    puts $line
}

# close file
io::close_file $h

# open again
let file packages/lcl-io/src/lcl-io.c
let contents [io::read_file $file]

puts "contents"
puts $contents

# test stderr and stdout
io::fputs [io::stderr] "Hello, stderr!\n"
io::fputs [io::stdout] "Hello, stdout\n"

puts "Testing glob"
puts "glob *.md"
puts [io::glob *.md]

puts "glob *."
puts [io::glob *]

puts "Testing getenv"
puts [io::getenv PATH]

puts "== done =="
