;; Regex:: Package Tests
;;
;; POSIX ERE via <regex.h>. Every command that takes a pattern accepts
;; either a pattern string or a compiled handle from Regex::compile.

;; ============================================================================
;; Compile & Basic Matching
;; ============================================================================

Test::suite "Compile & Basic Matching" {
    Test::case "compile returns an opaque handle" {
        let re [Regex::compile {re*}]
        Test::assert [opaque? $re]
        Test::eq [Regex::regexec $re "regex"] 1
    }

    Test::case "regcomp remains as an alias" {
        let re [Regex::regcomp {ab+c}]
        Test::eq [Regex::regexec $re "abbbc"] 1
        Test::eq [Regex::regexec $re "ac"] 0
    }

    Test::case "match takes a pattern string" {
        Test::eq [Regex::match {^h.llo$} "hello"] 1
        Test::eq [Regex::match {^h.llo$} "hallo!"] 0
    }

    Test::case "match takes a compiled handle" {
        let re [Regex::compile {[0-9]+}]
        Test::eq [Regex::match $re "abc123"] 1
        Test::eq [Regex::match $re "abcdef"] 0
    }

    Test::case "alternation" {
        let re [Regex::compile {^(issue|bug)-[0-9]+$}]
        Test::eq [Regex::match $re "issue-42"] 1
        Test::eq [Regex::match $re "bug-7"] 1
        Test::eq [Regex::match $re "task-9"] 0
    }

    Test::case "invalid pattern errors" {
        let caught [catch { Regex::match {[unclosed} "x" } res msg]
        Test::eq $caught 1
    }
}

;; ============================================================================
;; Find & Captures
;; ============================================================================

Test::suite "Find & Captures" {
    Test::case "find returns start and end offsets" {
        Test::eq [Regex::find {[0-9]+} "ab123cd"] (2 5)
    }

    Test::case "find returns empty list on no match" {
        Test::eq [len [Regex::find {[0-9]+} "abcdef"]] 0
    }

    Test::case "captures returns whole match then groups" {
        let caps [Regex::captures {(issue|bug)-([0-9]+)} "see issue-42 here"]
        Test::eq [len $caps] 3
        Test::eq [get $caps 0] "issue-42"
        Test::eq [get $caps 1] "issue"
        Test::eq [get $caps 2] "42"
    }

    Test::case "captures returns empty list on no match" {
        Test::eq [len [Regex::captures {([0-9]+)} "abc"]] 0
    }

    Test::case "unmatched optional group is empty string" {
        let caps [Regex::captures {a(x)?b} "ab"]
        Test::eq [len $caps] 2
        Test::eq [get $caps 0] "ab"
        Test::eq [get $caps 1] ""
    }

    Test::case "captures works with compiled handle" {
        let re [Regex::compile {([a-z]+)://(.+)}]
        let caps [Regex::captures $re "https://example.com"]
        Test::eq [get $caps 1] "https"
        Test::eq [get $caps 2] "example.com"
    }
}

;; ============================================================================
;; Search (offset pairs, resumable via ?from?)
;; ============================================================================

Test::suite "Search" {
    Test::case "search returns whole-match and group offset pairs" {
        let r [Regex::search {(issue|bug)-([0-9]+)} "see issue-42 here"]
        Test::eq [len $r] 3
        Test::eq [get $r 0] (4 12)
        Test::eq [get $r 1] (4 9)
        Test::eq [get $r 2] (10 12)
    }

    Test::case "search returns empty list on no match" {
        Test::eq [len [Regex::search {[0-9]+} "abc"]] 0
    }

    Test::case "search from resumes past earlier matches" {
        let r [Regex::search {[0-9]+} "a1b22c333" 2]
        Test::eq [get $r 0] (3 5)
    }

    Test::case "search offsets are absolute not from-relative" {
        let r [Regex::search {[0-9]+} "a1b22c333" 6]
        Test::eq [get $r 0] (6 9)
    }

    Test::case "search unmatched group is (-1 -1)" {
        let r [Regex::search {a(x)?b} "ab"]
        Test::eq [len $r] 2
        Test::eq [get $r 0] (0 2)
        Test::eq [get $r 1] (-1 -1)
    }

    Test::case "search does not rematch anchors mid-string" {
        Test::eq [len [Regex::search {^[0-9]+} "1a2b" 2]] 0
    }

    Test::case "search from past end returns empty" {
        Test::eq [len [Regex::search {a} "abc" 10]] 0
    }

    Test::case "search from equal to length allows end anchor" {
        let r [Regex::search {$} "abc" 3]
        Test::eq [get $r 0] (3 3)
    }

    Test::case "search zero-width match reports position" {
        Test::eq [get [Regex::search {x*} "ab"] 0] (0 0)
        Test::eq [get [Regex::search {x*} "ab" 1] 0] (1 1)
    }

    Test::case "search works with compiled handle" {
        let re [Regex::compile {([a-z]+)://}]
        let r [Regex::search $re "go https://x"]
        Test::eq [get $r 0] (3 11)
        Test::eq [get $r 1] (3 8)
    }

    Test::case "search negative from errors" {
        let caught [catch { Regex::search {a} "abc" -1 } res msg]
        Test::eq $caught 1
    }

    Test::case "search iteration via progress rule" {
        let re [Regex::compile {[0-9]+}]
        let text "a1b22c333"
        var spans ()
        var pos 0
        while {[<= $pos [len $text]]} {
            let m [Regex::search $re $text $pos]
            if [== [len $m] 0] { break }
            let span [get $m 0]
            set! spans [List::push $spans $span]
            let so [get $span 0]
            let eo [get $span 1]
            if [> $eo $so] {
                set! pos $eo
            } else {
                set! pos [+ $so 1]
            }
        }
        Test::eq $spans ((1 2) (3 5) (6 9))
    }
}

;; ============================================================================
;; Find All, Replace, Split
;; ============================================================================

Test::suite "Find All, Replace, Split" {
    Test::case "find_all collects every match" {
        Test::eq [Regex::find_all {[0-9]+} "a1b22c333"] (1 22 333)
    }

    Test::case "find_all with no matches is empty" {
        Test::eq [len [Regex::find_all {[0-9]+} "abc"]] 0
    }

    Test::case "find_all does not rematch anchors mid-string" {
        Test::eq [Regex::find_all {^[0-9]+} "1a2b"] (1)
    }

    Test::case "replace substitutes every match" {
        Test::eq [Regex::replace {[0-9]+} "N" "a1b22c"] "aNbNc"
    }

    Test::case "replace expands group references" {
        Test::eq [Regex::replace {(bug)-([0-9]+)} {\2:\1} "bug-42"] "42:bug"
    }

    Test::case "replace backslash-zero is the whole match" {
        Test::eq [Regex::replace {[0-9]+} {<\0>} "a12b"] "a<12>b"
    }

    Test::case "replace with no matches returns input" {
        Test::eq [Regex::replace {[0-9]+} "N" "abc"] "abc"
    }

    Test::case "split on separators" {
        Test::eq [Regex::split {,[ ]*} "a, b,c"] (a b c)
    }

    Test::case "split with no match returns whole string" {
        Test::eq [Regex::split {,} "abc"] (abc)
    }

    Test::case "split skips empty matches, including one at the end" {
        Test::eq [Regex::split {x*} "abc"] (abc)
        Test::eq [Regex::split {x*} "axb"] (a b)
        Test::eq [Regex::split {x*} "axxb"] (a b)
        Test::eq [Regex::split {x*} ""] ("")
        Test::eq [Regex::split {b*} "abc"] (a c)
    }

    Test::case "split keeps empty leading and trailing fields" {
        let parts [Regex::split {,} ",a,"]
        Test::eq [len $parts] 3
        Test::eq [get $parts 0] ""
        Test::eq [get $parts 1] "a"
        Test::eq [get $parts 2] ""
    }
}

;; ============================================================================
;; Run Tests
;; ============================================================================

exit [Test::run]
